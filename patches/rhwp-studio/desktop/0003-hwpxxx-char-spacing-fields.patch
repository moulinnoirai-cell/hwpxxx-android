+  /**
+   * [hwpxxx] 장평·자간 입력 칸 + ▲▼.
+   * 숫자를 넣고 Enter(또는 칸을 벗어나면) 7개 언어 모두에 적용한다. ▲▼는 기존 1% 증감 명령
+   * (Alt+Shift+K/J, Alt+Shift+W/N)을 그대로 쓴다. 범위는 글자 모양 대화상자와 같다.
+   */
+  private setupCharSpacingFields(): void {
+    const fields: Array<[string, string, string, string, keyof CharProperties, number, number]> = [
+      ['#char-ratio-input', '#btn-ratio-up', '#btn-ratio-down', 'format:char-ratio', 'ratios', 50, 200],
+      ['#char-spacing-input', '#btn-spacing-up', '#btn-spacing-down', 'format:char-spacing', 'spacings', -50, 50],
+    ];
+    for (const [inputSel, upSel, downSel, command, key, min, max] of fields) {
+      const input = this.container.querySelector<HTMLInputElement>(inputSel);
+      const up = this.container.querySelector<HTMLButtonElement>(upSel);
+      const down = this.container.querySelector<HTMLButtonElement>(downSel);
+      if (!input || !up || !down) continue;
+      if (key === 'ratios') this.ratioInput = input; else this.spacingInput = input;
+      let shown = input.value;
+      const commit = () => {
+        const value = Number.parseFloat(input.value.replace('%', '').trim());
+        if (!Number.isFinite(value)) { input.value = shown; return; }
+        const clamped = Math.max(min, Math.min(max, Math.round(value)));
+        input.value = clamped + ' %';
+        if (input.value === shown) return;
+        shown = input.value;
+        this.eventBus.emit('format-char', { [key]: Array(7).fill(clamped) } as CharProperties);
+      };
+      input.addEventListener('focus', () => { shown = input.value; input.select(); });
+      input.addEventListener('keydown', (e) => {
+        if (e.key === 'Enter') { e.preventDefault(); commit(); input.blur(); }
+        else if (e.key === 'Escape') { e.preventDefault(); input.value = shown; input.blur(); }
+        else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
+          e.preventDefault();
+          this.dispatcher.dispatch(command + (e.key === 'ArrowUp' ? '-increase' : '-decrease'));
+        }
+      });
+      input.addEventListener('blur', () => { if (input.value !== shown) commit(); });
+      for (const [button, suffix] of [[up, '-increase'], [down, '-decrease']] as const) {
+        button.addEventListener('mousedown', (e) => {
+          e.preventDefault();
+          this.dispatcher.dispatch(command + suffix);
+        });
+        button.addEventListener('click', (event) => { if (event.detail === 0) this.dispatcher.dispatch(command + suffix); });
+      }
+    }
+  }
+
