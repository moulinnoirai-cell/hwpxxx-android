     }
-    const paraProps = normalizeFormatCopyParaProps(
-      pickDefined(this.getParaProperties(), FORMAT_COPY_PARA_KEYS) as Partial<ParaProperties>,
-    );
+    if (Object.keys(state.charProps).length > 0) {
