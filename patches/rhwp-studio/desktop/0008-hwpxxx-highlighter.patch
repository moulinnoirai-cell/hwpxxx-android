diff --git a/rhwp-studio/src/hwpxxx/highlighter.ts b/rhwp-studio/src/hwpxxx/highlighter.ts
new file mode 100644
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/highlighter.ts
@@ -0,0 +1,101 @@
+// [hwpxxx] 형광펜 모드: 형광펜 단추를 먼저 누르고 본문 글자를 드래그할 때마다 칠한다(한글과 같은 방식).
+// 칠한 뒤에도 모드는 풀리지 않아 여러 번 칠할 수 있고, Esc 로 푼다. '색 없음'을 고르면 드래그한 글자의 형광펜을 지운다.
+// 글자에 칠하는 일은 서식바의 형광펜 팔레트와 같은 `format-char`(shadeColor) 경로를 써서 되돌리기(Ctrl+Z)로 한 번씩 취소된다.
+import type { CommandServices } from '@/command/types';
+import { showToast } from '@/ui/toast';
+
+export const HIGHLIGHT_NONE = '#ffffff';   // 서식바의 '색 없음'이 보내는 값
+
+type SelectionReader = { hasSelection?: () => boolean; cursor?: { clearSelection(): void }; updateSelection?: () => void; updateCaret?: () => void };
+
+/** 마우스 포인터 모양: 펜 끝에 현재 색이 보이는 형광펜. 색 없음이면 지우개. */
+function cursorUrl(color: string, eraser: boolean): string {
+  const body = eraser
+    ? '<path d="M5 24 L16 8 L26 15 L15 30 Z" fill="#f4a6b7" stroke="#333" stroke-width="1.5"/><path d="M5 24 L15 30 L9 31 L3 27 Z" fill="#fff" stroke="#333" stroke-width="1.5"/>'
+    : `<path d="M14 3 L28 14 L17 24 L8 17 Z" fill="#555" stroke="#222" stroke-width="1.5"/><path d="M8 17 L17 24 L9 30 L2 30 L2 26 Z" fill="${color}" stroke="#222" stroke-width="1.5"/>`;
+  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">${body}</svg>`;
+  return `url("data:image/svg+xml,${encodeURIComponent(svg)}") ${eraser ? 4 : 2} 30, text`;
+}
+
+export class Highlighter {
+  private color: string | null = null;
+  private pressedInDocument = false;
+  private readonly style = document.createElement('style');
+
+  constructor(private readonly services: CommandServices) {
+    const eventBus = services.eventBus;
+    this.style.id = 'hwpxxx-highlighter-cursor';
+    document.head.append(this.style);
+    // 문서 창 안에서 시작한 드래그가 끝날 때(창 밖에서 놓아도) 칠한다.
+    document.addEventListener('mousedown', event => {
+      this.pressedInDocument = this.isActive() && event.button === 0 && !!(event.target as Element | null)?.closest?.('#scroll-container');
+    }, true);
+    document.addEventListener('mouseup', event => {
+      if (!this.pressedInDocument || event.button !== 0) return;
+      this.pressedInDocument = false;
+      // 편집기의 마우스 처리가 선택 범위를 확정한 다음에 칠한다.
+      window.setTimeout(() => this.paintSelection(), 0);
+    }, true);
+    // Esc 로 해제. 대화상자나 메뉴가 열려 있으면 그쪽이 먼저 닫히도록 둔다.
+    window.addEventListener('keydown', event => {
+      if (event.key !== 'Escape' || !this.isActive()) return;
+      if (document.querySelector('.modal-overlay, .context-menu, .md-dropdown.open, .sb-dropdown.open')) return;
+      event.preventDefault();
+      event.stopPropagation();
+      this.stop();
+    }, true);
+    // 문서를 바꾸면 해제한다.
+    eventBus.on('document-swapped', () => this.stop());
+    // 서식바의 형광펜 단추·팔레트가 보내는 요청.
+    eventBus.on('hwpxxx-highlighter-request', (request) => {
+      const { color, toggle } = request as { color: string; toggle: boolean };
+      this.request(color, toggle);
+    });
+  }
+
+  /**
+   * 단추를 누르거나 팔레트에서 색을 골랐을 때: 이미 글자가 선택돼 있으면 그 글자에 바로 칠하고(기존 동작),
+   * 아니면 형광펜 모드를 켠다. `toggle`(단추 본체를 다시 누름)이면 켜져 있던 모드를 끈다.
+   */
+  private request(color: string, toggle: boolean): void {
+    if (toggle && this.isActive()) { this.stop(); return; }
+    const handler = this.services.getInputHandler();
+    if (handler?.hasSelection()) { this.services.eventBus.emit('format-char', { shadeColor: color }); return; }
+    this.start(color);
+  }
+
+  isActive(): boolean { return this.color !== null; }
+  currentColor(): string | null { return this.color; }
+
+  start(color: string): void {
+    if (!this.services.getContext().isEditable) { showToast({ message: '이 문서는 편집할 수 없는 상태라 형광펜을 쓸 수 없습니다.' }); return; }
+    const first = !this.isActive();
+    this.color = color;
+    const eraser = color.toLowerCase() === HIGHLIGHT_NONE;
+    this.style.textContent = `#scroll-container, #scroll-container * { cursor: ${cursorUrl(color, eraser)} !important; }`;
+    document.body.classList.add('hwpxxx-highlighter-on');
+    this.services.eventBus.emit('hwpxxx-highlighter-changed', { active: true, color });
+    if (first) showToast({ message: eraser ? '형광펜 지우기: 지울 글자를 드래그하세요. Esc 를 누르면 해제됩니다.' : '형광펜: 칠할 글자를 드래그하세요. 여러 번 칠할 수 있고 Esc 를 누르면 해제됩니다.' });
+  }
+
+  stop(): void {
+    if (!this.isActive()) return;
+    this.color = null;
+    this.style.textContent = '';
+    document.body.classList.remove('hwpxxx-highlighter-on');
+    this.services.eventBus.emit('hwpxxx-highlighter-changed', { active: false, color: '' });
+  }
+
+  /** 지금 선택된 글자에 칠한다. 칠한 뒤 선택을 풀어 색이 바로 보이게 한다. */
+  private paintSelection(): void {
+    const color = this.color;
+    const handler = this.services.getInputHandler() as unknown as SelectionReader | null;
+    if (color === null || !handler?.hasSelection?.()) return;
+    this.services.eventBus.emit('format-char', { shadeColor: color });
+    try { handler.cursor?.clearSelection(); handler.updateSelection?.(); handler.updateCaret?.(); } catch { /* 선택을 못 풀어도 칠하기는 끝났다 */ }
+  }
+}
+
+let highlighter: Highlighter | null = null;
+/** main.ts 가 서비스를 만든 직후 한 번 부른다. */
+export const installHighlighter = (services: CommandServices): Highlighter => (highlighter ??= new Highlighter(services));
