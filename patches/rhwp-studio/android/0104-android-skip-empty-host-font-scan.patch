diff --git a/rhwp-studio/tests/hwpxxx-android-host-font-scan.test.ts b/rhwp-studio/tests/hwpxxx-android-host-font-scan.test.ts
new file mode 100644
index 0000000..e69461b
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-host-font-scan.test.ts
@@ -0,0 +1,29 @@
+// [hwpxxx-android] 호스트 글꼴이 없을 때 문서 전체 레이어 트리 훑기를 건너뛴다(큰 문서 여는 시간).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+test('호스트 글꼴이 0개면 쪽마다 레이어 트리를 내보내지 않는다', () => {
+  const bridge = source('core/wasm-bridge.ts');
+  const start = bridge.indexOf('async prepareCanvasMetrics(');
+  assert.ok(start >= 0);
+  const body = bridge.slice(start, bridge.indexOf('await this.hostCanvasFonts.prepare(records', start));
+  // 개수는 카탈로그 준비(await) 뒤에 읽어야 한다.
+  assert.ok(body.indexOf('await prepareHostFontCatalog()') < body.indexOf('const hostFaceCount = getHostFontState().count;'));
+  assert.match(body, /for \(let page = 0; hostFaceCount > 0 && page < this\.pageCount; page\+\+\) \{\s+for \(const record of collectHostFontRequests\(this\.getPageLayerTreeObject\(page\)\)\)/);
+  assert.equal(body.split('getPageLayerTreeObject(').length - 1, 1, '다른 전체 훑기가 생기지 않았다');
+  // 원래 쓰던 PUA 글꼴 기록은 그대로 고른다.
+  assert.match(body, /this\.nativePuaFonts\.records\(/);
+});
+
+test('고를 수 있는 것은 hostReference 가 있는 기록뿐이다(건너뛰어도 결과가 같다는 근거)', () => {
+  const requests = source('core/host-font-requests.ts');
+  const start = requests.indexOf('export function collectHostFontRequests(');
+  const body = requests.slice(start);
+  const sets = body.match(/selected\.set\(/g) ?? [];
+  const guarded = body.match(/if \(\w+\??\.hostReference\) selected\.set\(/g) ?? [];
+  assert.ok(sets.length > 0);
+  assert.equal(guarded.length, sets.length, 'hostReference 없이 고르는 경로가 없다');
+});
