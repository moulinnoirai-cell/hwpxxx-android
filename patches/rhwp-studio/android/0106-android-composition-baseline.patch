diff --git a/rhwp-studio/src/hwpxxx/composition-font.ts b/rhwp-studio/src/hwpxxx/composition-font.ts
index 8f8de6c..aac2839 100644
--- a/rhwp-studio/src/hwpxxx/composition-font.ts
+++ b/rhwp-studio/src/hwpxxx/composition-font.ts
@@ -89,3 +89,30 @@ export function compositionCssFont(input: CompositionFontInput, resolve: FontRes
   const style = `${input.italic ? 'italic ' : ''}${input.bold ? 'bold ' : ''}`;
   return resolve(`${style}${Math.round(px * 100) / 100}px ${family}`);
 }
+
+/** 엔진의 캐럿 사각형은 `y = 기준선 - 글자 크기 × 0.8`, `height = 글자 크기` 다(`cursor_rect.rs`). */
+export const CARET_BASELINE_RATIO = 0.8;
+
+/**
+ * [hwpxxx] 조합 오버레이 상자 위쪽에서 글자 기준선까지의 거리(쪽 좌표, 줌 적용 전).
+ *
+ * 오버레이는 500ms 마다 켜졌다 꺼지며, 꺼진 동안에는 캔버스가 그린 같은 글자가 보인다. 예전에는 DOM 글자를 상자 세로 가운데
+ * (`line-height = 상자 높이`)에 두었는데, 그 위치는 글꼴의 ascent/descent 에 따라 달라 캔버스 글자의 기준선과 어긋났다.
+ * 그래서 깜빡일 때마다 글자가 위아래로 흔들려 보였다. 캔버스는 기준선을 캐럿 사각형의 `y + height × 0.8` 에 두므로
+ * 오버레이도 같은 자리에 기준선을 둔다. 셀 경계로 상자가 옮겨졌으면(`boxY`) 그만큼 보정하고, 상자 밖으로 나가지 않게 한다.
+ */
+export function compositionBaselineOffset(rect: { y: number; height: number }, boxY: number, boxHeight: number): number {
+  const offset = rect.y + rect.height * CARET_BASELINE_RATIO - boxY;
+  if (!Number.isFinite(offset)) return Math.max(0, boxHeight * CARET_BASELINE_RATIO);
+  return Math.min(Math.max(offset, 0), Math.max(0, boxHeight));
+}
+
+/**
+ * [hwpxxx] 조합 글자의 가로 비율(장평). 캔버스는 글자를 장평만큼 가로로 늘이거나 줄여 그리므로 오버레이도 같은 비율을 쓴다.
+ * `ratios` 는 언어별 값(%)이고 조합 중인 글자는 한글이므로 첫 값을 쓴다. 값이 없거나 범위(50~200%) 밖이면 1.
+ */
+export function compositionWidthRatio(ratios: readonly number[] | undefined): number {
+  const percent = ratios?.[0];
+  if (typeof percent !== 'number' || !Number.isFinite(percent) || percent < 50 || percent > 200) return 1;
+  return percent / 100;
+}
