+    });
+    await androidPrintDocument(wasm.fileName, job.pageCount, async (index) => {
+      if (statusEl) statusEl.textContent = printProgressText(intent, index + 1, job.pageCount);
+      return job.renderPage(index);
+    }, intent, controller.signal);
+    if (statusEl) statusEl.textContent = originalStatus;
+  } catch (err) {
+    if (statusEl) statusEl.textContent = originalStatus;
+    // 사용자가 대상 선택을 취소했거나 앱이 내려간 경우는 오류가 아니다.
+    if (err instanceof DOMException && err.name === 'AbortError') return;
+    const msg = err instanceof Error ? err.message : String(err);
+    console.error('[file:print-android]', msg);
+    if (statusEl) statusEl.textContent = t('command.file.statusEl.text', { p1: msg });
+    showToast({ message: t('command.file.runPdfPrint.message', { p1: msg }), durationMs: 5000 });
