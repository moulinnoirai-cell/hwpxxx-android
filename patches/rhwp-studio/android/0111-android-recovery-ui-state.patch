+    assert.deepEqual(ui.restoredDraftToast('x.hwp', falsy), ui.restoredDraftToast('x.hwp', {}), '손실 표시가 정확히 true 일 때만 경고');
+  }
+  const named = ui.restoredDraftToast('<b>"이름"</b>\n.hwp', { lossy: true });
+  assert.ok(named.message.includes('<b>"이름"</b>\n.hwp'), '이름은 가공 없이 텍스트로 들어간다(그리는 쪽이 textContent)');
+});
+
+function restoreFixture(over: { load?: (b: Uint8Array, n: string) => Promise<unknown>; del?: (id: string) => Promise<void> } = {}) {
+  const events: string[] = []; const toasts: any[] = []; const warnings: string[] = [];
+  const deps = {
+    loadBytes: over.load ?? (async (_b: Uint8Array, name: string) => { events.push(`load:${name}`); }),
+    deleteDraft: over.del ?? (async (id: string) => { events.push(`delete:${id}`); }),
+    markDirty: () => { events.push('dirty'); },
+    showToast: (t: unknown) => { toasts.push(t); events.push('toast'); },
+    warn: (m: string) => { warnings.push(m); },
+  };
+  return { deps, events, toasts, warnings };
+}
+
+test('복원: 성공하면 열기 → dirty 표시 → 복구본 삭제 → 안내 순서이고, 손실 복구본은 경고 안내를 낸다', async () => {
+  const f = restoreFixture();
+  const lossy = draft({ fileName: '원본.hwpx', sourceFormat: 'hwpx', lossy: true });
+  await ui.restoreDraftWithNotice(lossy as never, f.deps);
+  assert.deepEqual(f.events, [`load:${recoveryFileName('원본.hwpx')}`, 'dirty', `delete:${lossy.id}`, 'toast']);
+  assert.ok(f.toasts[0].message.includes(ui.LOSSY_DRAFT_NOTICE));
+  assert.equal(f.toasts[0].durationMs, 0);
+  const g2 = restoreFixture();
+  await ui.restoreDraftWithNotice(draft({ fileName: '정상.hwp' }) as never, g2.deps);
+  assert.ok(!g2.toasts[0].message.includes('일부 개체'), '일반 복구본에는 경고가 없다');
+  assert.equal(g2.toasts[0].durationMs, 5000);
+});
+
+test('복원: 열기가 실패하거나 취소되면(암호 입력 취소 포함) 복구본을 지우지도 dirty/안내를 내지도 않고 그대로 던진다', async () => {
+  const cancel = new Error('DocumentOpenCancelled');
+  const f = restoreFixture({ load: async () => { throw cancel; } });
+  await assert.rejects(ui.restoreDraftWithNotice(draft({ lossy: true, encrypted: true }) as never, f.deps), (e) => e === cancel);
+  assert.deepEqual(f.events, []);
+  assert.deepEqual(f.toasts, []);
+});
+
+test('복원: 복구본 삭제가 실패해도 복원은 성공이고(dirty 표시·안내 유지) 경고만 남긴다', async () => {
+  const f = restoreFixture({ del: async () => { throw new Error('native 삭제 실패'); } });
+  await ui.restoreDraftWithNotice(draft({ lossy: true }) as never, f.deps);
+  assert.deepEqual(f.events, [`load:${recoveryFileName('문서.hwp')}`, 'dirty', 'toast']);
+  assert.equal(f.warnings.length, 1);
+  assert.ok(f.toasts[0].message.includes(ui.LOSSY_DRAFT_NOTICE));
+});
+
+test('복원: 바이트는 복사본으로 넘기고 파일 이름은 recoveryFileName 규칙을 따른다', async () => {
+  let received: Uint8Array | null = null;
+  const f = restoreFixture({ load: async (b: Uint8Array) => { received = b; } });
+  const d = draft({ data: new Uint8Array([9, 8, 7]), fileName: 'a.hml', sourceFormat: 'hml' });
+  await ui.restoreDraftWithNotice(d as never, f.deps);
+  assert.deepEqual([...received!], [9, 8, 7]);
+  assert.notEqual(received, d.data);
+});
