+// ── 선택창 ────────────────────────────────────────────────────────────────────────────
+test('선택창: 손실 보고가 있는 복구본(lossy===true)에만 경고를 붙이고, 없거나 true 가 아닌 값에는 아무 경고도 붙이지 않는다', () => {
