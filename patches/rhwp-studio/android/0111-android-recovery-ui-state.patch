+// ── 상태 줄 · 저장소 거절 · 종단 ─────────────────────────────────────────────────────────
+const nativeStore = (extra: Record<string, unknown> = {}) => {
+  const rowsSaved = new Map<string, any>();
+  return {
+    rowsSaved,
+    store: {
+      saveDraft: async (d: any) => { rowsSaved.set(d.id, structuredClone(d)); },
+      getDraft: async (id: string) => rowsSaved.get(id) ?? null,
+      listDrafts: async () => [...rowsSaved.values()],
+      deleteDraft: async (id: string) => { rowsSaved.delete(id); },
+      clearDrafts: async () => { rowsSaved.clear(); },
+      ...extra,
+    },
+  };
+};
+const hostWith = (store: unknown) => { g.AndroidStudioHost = { recovery: store }; };
+const noHost = () => { delete g.AndroidStudioHost; delete g.rhwpAndroidHost; };
+
+test('상태 줄: 손실 표시를 못 담는 저장소의 거절(0107 저장소의 실제 오류)만 따로 알리고, 다른 오류는 기존 문구 그대로', async () => {
+  const { store, rowsSaved } = nativeStore();
+  hostWith(store);
+  try {
+    let refusal: unknown;
+    await saveAutosaveDraft(draft({ lossy: true }) as never).catch((e) => { refusal = e; });
+    assert.ok(refusal, '지원을 알리지 않은 저장소는 손실 복구본을 거절한다');
+    assert.equal(rowsSaved.size, 0, '표시 없이 저장하지 않는다');
+    assert.match(ui.autosaveErrorMessage(refusal), /일부 개체가 빠졌을 수 있어 복구용 자동 저장을 하지 않습니다/);
+    assert.equal(ui.autosaveErrorMessage(new Error('디스크 가득')), '복구용 자동 저장 실패');
+    assert.equal(ui.autosaveErrorMessage(undefined), '복구용 자동 저장 실패');
+    assert.equal(ui.autosaveErrorMessage('문자열 오류'), '복구용 자동 저장 실패');
+  } finally { noHost(); }
+});
+
+test('종단: 손실 표시를 지원하는 셸이면 lossy 가 저장 → 목록 → 선택창 경고로 이어지고, 일반 복구본에는 이어지지 않는다', async () => {
+  const { store } = nativeStore({ supportsLossyDrafts: true });
+  hostWith(store);
+  try {
+    await saveAutosaveDraft(draft({ id: 'L', fileName: '손실.hwp', lossy: true }) as never);
+    await saveAutosaveDraft(draft({ id: 'N', fileName: '정상.hwp' }) as never);
+    const listed = await listAutosaveDrafts();
+    assert.equal(listed.find((d) => d.id === 'L')?.lossy, true);
+    assert.equal('lossy' in listed.find((d) => d.id === 'N')!, false);
+    const el = body(listed as never);
+    const byTitle = (name: string) => rows(el).find((r) => r.find((e) => e.className.includes('recovery-draft-title'))[0].textContent === name)!;
+    assert.equal(lossyLines(byTitle('손실.hwp')).length, 1);
+    assert.equal(lossyLines(byTitle('정상.hwp')).length, 0);
+    assert.equal((await getAutosaveDraft('L'))?.lossy, true);
+  } finally { noHost(); }
+});
+
+test('종단: 암호 + 손실 복구본 — 자동 저장은 암호화된 바이트와 lossy 를 함께 보내고, 복원은 비밀번호 입력 취소 시 복구본을 남기며, 성공하면 암호가 이어진다', async () => {
+  const password = synthPassword();
+  const { store, rowsSaved } = nativeStore({ supportsLossyDrafts: true });
+  hostWith(store);
+  try {
+    const bridge = new WasmBridge();
+    const plain = new Doc(sample('biz_plan.hwp'));
+    const encryptedBytes = plain.exportHwpWithPassword(password) as Uint8Array;
+    bridge.loadDocumentWithPassword(encryptedBytes, password, '암호.hwp');
+    const original = bridge.exportHwpWithPasswordAndReport.bind(bridge);
+    bridge.exportHwpWithPasswordAndReport = (p: string) => ({ ...original(p), contentLoss: { schemaVersion: 1, outputFormat: 'hwp', count: 1, losses: [{ path: 'x', kind: 'test' }] } });
+    const manager = new AutosaveManager({
+      exportBytes: () => bridge.exportAndroidRecoveryBytes(),
+      isEncrypted: () => bridge.requiresPasswordForSave,
+      isRecoveryBlocked: () => !bridge.canExportAndroidRecovery(),
+      logger: { warn() {}, debug() {} } as never,
+    });
+    await manager.beginDocument({ fileName: '암호.hwp', sourceFormat: 'hwp' });
+    await manager.flushNow('android-lifecycle');
+    assert.equal(rowsSaved.size, 1);
+    const saved = [...rowsSaved.values()][0];
+    assert.equal(saved.encrypted, true);
+    assert.equal(saved.lossy, true);
+    assert.throws(() => new Doc(saved.data).free(), /비밀번호가 필요한/, '저장소로 가는 바이트는 암호화돼 있다');
+    assert.ok(!JSON.stringify({ ...saved, data: undefined }).includes(password));
+
+    const listed = await listAutosaveDrafts();
+    const el = body(listed as never);
+    assert.equal(lossyLines(el).length, 1); assert.equal(encryptedLines(el).length, 1);
+
+    // 비밀번호 입력을 취소하면 복구본이 남는다
+    const restored = new WasmBridge();
+    const cancelled = restoreFixture({ load: async () => { throw new Error('DocumentOpenCancelled'); }, del: async (id) => { await store.deleteDraft(id); } });
+    await assert.rejects(ui.restoreDraftWithNotice(listed[0] as never, cancelled.deps));
+    assert.equal(rowsSaved.size, 1, '취소하면 복구본이 그대로 남는다');
+    assert.deepEqual(cancelled.toasts, []);
+
+    // 비밀번호를 입력하면 복원되고, 복구본이 지워지고, 경고가 나가며, 이후 복구본도 같은 비밀번호로 암호화된다
+    const ok = restoreFixture({
+      load: async (bytes) => { restored.loadDocumentWithPassword(bytes, password, '복구.hwp'); },
+      del: async (id) => { await store.deleteDraft(id); },
+    });
+    await ui.restoreDraftWithNotice(listed[0] as never, ok.deps);
+    assert.equal(rowsSaved.size, 0);
+    assert.ok(ok.toasts[0].message.includes(ui.LOSSY_DRAFT_NOTICE));
+    assert.equal(restored.requiresPasswordForSave, true);
+    const next = restored.exportAndroidRecoveryBytes();
+    assert.throws(() => new Doc(next).free(), /비밀번호가 필요한/);
+    assert.equal(core.HwpDocument.openWithPassword(next, password).free(), undefined);
+  } finally { noHost(); }
+});
