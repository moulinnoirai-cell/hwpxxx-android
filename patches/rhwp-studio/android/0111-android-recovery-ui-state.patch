+// 비밀번호는 시험마다 새로 만든 합성 값, 문서는 저장소 샘플뿐이다. 선택창은 작은 가짜 DOM 에서 실제 코드를 실행한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import { register } from 'node:module';
+import { fileURLToPath } from 'node:url';
+
+const g = globalThis as Record<string, any>;
+const pkg = (name: string) => fileURLToPath(new URL(`../../pkg/${name}`, import.meta.url));
+const sample = (name: string) => new Uint8Array(readFileSync(fileURLToPath(new URL(`../public/samples/${name}`, import.meta.url))));
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+const synthPassword = () => `synthetic-${randomUUID()}`;
+
+// ── 가짜 DOM: ModalDialog.createBody 가 쓰는 만큼만 ──────────────────────────────────────
+class FakeElement {
+  tagName: string; children: Array<FakeElement | string> = []; style: Record<string, string> = {};
+  attrs: Record<string, string> = {}; listeners: Record<string, Array<() => void>> = {};
+  private classes = new Set<string>(); own = ''; type = ''; name = ''; value = ''; checked = false; title = ''; htmlSet = false;
+  constructor(tag: string) { this.tagName = tag.toUpperCase(); }
+  get classList() { return { add: (c: string) => { this.classes.add(c); }, contains: (c: string) => this.classes.has(c) }; }
+  set className(v: string) { this.classes = new Set(v.split(/\s+/).filter(Boolean)); }
+  get className() { return [...this.classes].join(' '); }
+  set textContent(v: string) { this.own = v; this.children = []; }
+  get textContent(): string { return this.own + this.children.map((c) => (typeof c === 'string' ? c : c.textContent)).join(''); }
+  set innerHTML(_v: string) { this.htmlSet = true; }
+  setAttribute(k: string, v: string) { this.attrs[k] = v; }
+  appendChild(c: FakeElement) { this.children.push(c); return c; }
+  append(...cs: Array<FakeElement | string>) { this.children.push(...cs); }
+  addEventListener(type: string, fn: () => void) { (this.listeners[type] ??= []).push(fn); }
+  fire(type: string) { for (const fn of this.listeners[type] ?? []) fn(); }
+  walk(visit: (el: FakeElement) => void) { visit(this); for (const c of this.children) if (typeof c !== 'string') c.walk(visit); }
+  find(pred: (el: FakeElement) => boolean): FakeElement[] { const out: FakeElement[] = []; this.walk((el) => { if (pred(el)) out.push(el); }); return out; }
+}
+const createdTags: string[] = [];
+g.document = { createElement: (tag: string) => { createdTags.push(tag.toLowerCase()); return new FakeElement(tag); } };
+g.window ??= new EventTarget();
+
+register(new URL('./support/studio-alias-hooks.mjs', import.meta.url), import.meta.url);
