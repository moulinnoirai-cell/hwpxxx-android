+test('선택창: 암호 복구본에만 암호 안내를 붙이고, 손실 경고와 독립적으로 나온다', () => {
+  const el = body([draft({ encrypted: true, lossy: true }), draft({ encrypted: true }), draft({}), draft({ encrypted: 'yes' })]);
+  const [both, onlyEnc, plain, truthy] = rows(el);
+  assert.equal(encryptedLines(both).length, 1); assert.equal(lossyLines(both).length, 1);
+  assert.equal(encryptedLines(onlyEnc).length, 1); assert.equal(lossyLines(onlyEnc).length, 0);
