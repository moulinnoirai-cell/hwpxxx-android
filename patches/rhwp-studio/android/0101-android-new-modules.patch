+    if (/&(?!#x[0-9a-fA-F]+;|#\d+;|amp;|lt;|gt;|quot;|apos;)/.test(s)) return fieldEvidenceError();
+    return s.replace(/&(#x[0-9a-fA-F]+|#\d+|amp|lt|gt|quot|apos);/g, (_, e: string) => {
+      if (e[0] === '#') { const n = e[1] === 'x' ? parseInt(e.slice(2), 16) : Number(e.slice(1)); if (!Number.isInteger(n) || n < 0 || n > 0x10ffff) return fieldEvidenceError(); return String.fromCodePoint(n); }
