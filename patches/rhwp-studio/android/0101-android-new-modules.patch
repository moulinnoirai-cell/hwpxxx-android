+    const coverage = bridge.verifyAndroidSave(artifact.bytes, 'hwp', password);
+    assert.ok(coverage && coverage.bodyParagraphs > 0);
+    const messages: string[] = [];
+    const rejects = (fn: () => unknown, pattern: RegExp) => assert.throws(fn, (e: Error) => { messages.push(e.message); return pattern.test(e.message); });
+    rejects(() => bridge.verifyAndroidSave(artifact.bytes, 'hwp', synthPassword()), /다시 열 수 없어/);
+    rejects(() => bridge.verifyAndroidSave(artifact.bytes, 'hwp'), /다시 열 수 없어/);
