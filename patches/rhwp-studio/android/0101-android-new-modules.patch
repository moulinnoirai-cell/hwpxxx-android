+test('봉투 포장: 보호 복구본의 봉투를 암호문 앞에 붙였다가 그대로 풀고, 포장이 아니거나 손상된 바이트는 null', async () => {
+  const cipher = await RecoveryCipher.create(synthPassword());
+  try {
+    const draft = await cipher.protect({ id: 'p', fileName: 'a.hwp', sourceFormat: 'hwp', savedAt: 7, byteLength: 3, data: new Uint8Array([1, 2, 3]) } as never);
+    assert.ok(draft.protection);
+    const packed = packProtectedDraftData(draft.data, draft.protection!);
+    const unpacked = unpackProtectedDraftData(packed)!;
+    assert.deepEqual(Array.from(unpacked.data), Array.from(draft.data));
+    assert.deepEqual(unpacked.protection, draft.protection);
+    assert.equal(unpackProtectedDraftData(draft.data), null, '포장이 아니면 null');
+    assert.equal(unpackProtectedDraftData(packed.slice(0, 20)), null, '잘린 포장은 null');
+    const badHeader = packed.slice(); badHeader[14] ^= 0xff;
+    assert.equal(unpackProtectedDraftData(badHeader), null, '손상된 헤더는 null');
+    assert.equal(unpackProtectedDraftData(new Uint8Array(0)), null);
+  } finally { cipher.dispose(); }
+});
