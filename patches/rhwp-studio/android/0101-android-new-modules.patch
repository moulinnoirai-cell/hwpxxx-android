+  assert.equal(r.log.opened.length, 1); assert.equal(r.log.opened[0].fileHandle.via, 'h1'); assert.equal(r.log.perm, 0, 'the host already re-checked permission: Studio does not guess');
+
+  r = deps({ hostOpen: async () => { throw dom('NotFoundError'); } });
+  assert.equal(await openRecentEntry(entry, r.deps), 'removed'); assert.deepEqual(r.log.removed, ['h1']); assert.equal(r.log.opened.length, 0);
+
+  r = deps({ hostOpen: async () => { throw dom('NotAllowedError'); } });
+  assert.equal(await openRecentEntry(entry, r.deps), 'needs-pick');
+  assert.deepEqual(r.log.removed, [], 'entry kept'); assert.equal(r.log.reopen, 1, 'the standard picker opens so the user can re-grant'); assert.match(r.log.toasts[0], /다시 선택/);
+
+  r = deps({ hostOpen: async () => { throw dom('SomethingElse', '디스크 오류'); } });
+  assert.equal(await openRecentEntry(entry, r.deps), 'failed'); assert.match(r.log.toasts[0], /디스크 오류/); assert.deepEqual(r.log.removed, []); assert.equal(r.log.reopen, 0);
+
+  r = deps({ hostOpen: async () => ({ kind: 'file', name: 'x.hwp' }), readFile: async () => { throw dom('NotFoundError'); } });
