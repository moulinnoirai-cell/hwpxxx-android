+// ───────────────────────────── WasmBridge: 암호 문서 복구본(upstream 복구 암호) ─────────────────────────────
+const enableHost = () => { g.AndroidStudioHost = {}; };
+const disableHost = () => { delete g.AndroidStudioHost; delete g.rhwpAndroidHost; };
+const needsPassword = (bytes: Uint8Array) => { try { new Doc(bytes).free(); return false; } catch (e) { return String((e as Error | undefined)?.message ?? e).includes('비밀번호가 필요한'); } };
+function encryptedBytes(password: string, source = 'biz_plan.hwp') {
+  const d = new Doc(sample(source));
+  try { return d.exportHwpWithPassword(password) as Uint8Array; } finally { d.free(); }
+}
+function openEncrypted(password: string): { bridge: any } {
+  const bridge = new WasmBridge();
+  bridge.loadDocumentWithPassword(encryptedBytes(password), password, '암호.hwp');
+  return { bridge };
+}
+const opensWith = (bytes: Uint8Array, password: string) => { try { Doc.openWithPassword(bytes, password).free(); return true; } catch { return false; } };
+
+test('복구본: 암호 문서도 브리지는 비밀번호를 보관하지 않고, 복구 바이트는 평문 HWP 다(보호는 upstream 복구 암호가 맡는다)', () => {
+  enableHost();
+  try {
+    const password = synthPassword();
+    const { bridge } = openEncrypted(password);
+    assert.equal(bridge.requiresPasswordForSave, true);
+    const seen = new Set<unknown>();
+    const holdsPassword = (value: unknown, depth = 0): boolean => {
+      if (typeof value === 'string') return value.includes(password);
+      if (!value || typeof value !== 'object' || depth > 3 || seen.has(value)) return false;
+      seen.add(value);
+      return Reflect.ownKeys(value).some((key) => { try { return holdsPassword((value as any)[key], depth + 1); } catch { return false; } });
+    };
+    assert.equal(holdsPassword(bridge), false, '브리지 어디에도 비밀번호가 없다');
+    assert.ok(!JSON.stringify(bridge).includes(password));
+    for (const name of ['stageAndroidPassword', 'commitAndroidPassword', 'exportAndroidRecoveryBytes', 'canExportAndroidRecovery']) {
+      assert.equal(typeof bridge[name], 'undefined', `${name} 은(는) 더 이상 없다`);
+    }
+    const recovery = bridge.exportRecoveryBytes();
+    assert.equal(needsPassword(recovery), false, '복구 바이트는 평문 — 세션 키로 감싸지기 전 단계');
+    assert.equal(new Doc(recovery).getTextFileUnicode(), bridge.doc.getTextFileUnicode());
+  } finally { disableHost(); }
+});
