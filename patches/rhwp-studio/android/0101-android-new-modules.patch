+    const found = at < 0 ? xml.length : at; next.set(prefix, found); return found;
+  };
+  let offset = 0;
+  while (offset < xml.length) {
+    const start = Math.min(nextTag('<hp:header', offset), nextTag('<hp:footer', offset));
+    const strayClose = Math.min(nextTag('</hp:header', offset), nextTag('</hp:footer', offset));
+    if (strayClose < start) return fieldEvidenceError();
+    if (start === xml.length) return;
+    const name = xml.startsWith('<hp:header', start) ? 'hp:header' : 'hp:footer';
+    const close = xml.indexOf(`</${name}>`, start);
+    const nested = Math.min(nextTag('<hp:header', start + 1), nextTag('<hp:footer', start + 1));
+    if (close < 0 || nested < close || strayClose !== close) return fieldEvidenceError();
+    offset = close + name.length + 3;
+    yield xml.slice(start, offset);
+  }
