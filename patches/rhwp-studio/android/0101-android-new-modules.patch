index 0000000..06ee707
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/android-host.ts
@@ -0,0 +1,300 @@
+// [hwpxxx-android] Android 셸(WebView)과 Studio 를 잇는 얇은 호스트 통합면.
+//
+// - `window.AndroidStudioHost`(별칭 `window.rhwpAndroidHost`)가 있으면(셸이 Studio 번들보다 먼저 `studio-host.js` 로
+//   설치) Android 모드다.
+//   Android 모드에서는 실패를 조용히 삼키지 않는다: 저장 폴백(브라우저 다운로드)과 IndexedDB 평문
+//   복구본을 끄고, 네이티브가 준 핸들·복구 저장소만 쓴다.
+// - `window.rhwpStudio.android` 는 셸이 부르는 API 다. WASM·DEV 개체는 노출하지 않는다.
+//
+// 이 파일은 데스크톱 편집 기능을 바꾸지 않는다. 상태·저장 흐름은 main.ts 가 넘겨준 의존성으로만 읽는다.
+
+export type AndroidSaveMode = 'save' | 'save-as';
+
+export interface AndroidSaveGuardInput {
+  bytes: Uint8Array;
+  format: 'hwp' | 'hwpx' | 'hml';
+  fileName: string;
+  encrypted: boolean;
+  contentLoss: unknown;
+  mode: AndroidSaveMode;
+}
+
+export type AndroidSaveGuard = (input: AndroidSaveGuardInput) => void | Promise<void>;
+
+export interface AndroidRecoveryDraft {
+  id: string;
+  fileName: string;
+  sourceFormat: string;
+  savedAt: number;
+  byteLength: number;
+  data: Uint8Array;
+  dirtyReason?: string;
+  /** 비밀번호로 암호화된 복구본(HWP). 비밀번호는 어디에도 저장하지 않는다. */
+  encrypted?: boolean;
+}
+
+/** 셸이 `rhwpAndroidHost.recoveryStore` 로 건네는 비공개(암호화) 복구 저장소. */
+export interface AndroidRecoveryStore {
+  saveDraft(draft: AndroidRecoveryDraft): Promise<void>;
+  getDraft(id: string): Promise<AndroidRecoveryDraft | null>;
+  listDrafts(): Promise<AndroidRecoveryDraft[]>;
+  deleteDraft(id: string): Promise<void>;
+  clearDrafts(): Promise<void>;
+}
+
+export interface AndroidPrintPage {
+  /** 화면과 같은 Canvas2D 로 그린 쪽 PNG(호스트 글꼴 반영). 호스트는 이쪽을 우선한다. */
+  png?: Uint8Array;
+  /** 호환용: 가져온 글꼴이 SVG 에 들어가지 않으므로 글꼴 보존을 주장하지 않는다. Studio 는 이 경로를 쓰지 않는다. */
+  svg?: string;
+  /** CSS 픽셀(96dpi). 셸이 PDF 포인트(×0.75)로 바꾼다. */
+  width: number;
+  height: number;
+}
+
+/**
+ * 쪽을 하나씩 받아 가는 인쇄 요청. 셸이 대상(시스템 인쇄/저장 위치)을 정한 뒤 쪽마다 `renderPage` 를 부르므로
+ * 쪽 PNG 를 한꺼번에 메모리에 모으지 않는다. `signal` 이 중단되면 셸은 만든 PDF 를 버린다.
+ */
+export interface AndroidPrintRequest {
+  fileName: string;
+  intent: 'print' | 'pdf';
+  pages?: AndroidPrintPage[];
+  pageCount?: number;
+  renderPage?: (index: number) => Promise<AndroidPrintPage>;
+  signal?: AbortSignal;
+}
+
+/**
+ * [hwpxxx-android] 문서 작업 공간(탭) 호스트 API. 셸 `studio-host.js` 가 `AndroidStudioHost.workspace` 로 건넨다.
+ * 없거나 `enabled !== true` 이면 옛 단일 문서 동작(현재 문서를 제자리에서 바꾸는 열기/새 문서)이 그대로다.
+ * `enabled` 는 네이티브가 동기로 알려 준 고정 능력이라 핸드셰이크 전에도 켜져 있다(그 사이에도 현재 문서를 바꾸지 않는다).
+ * 셸은 다른 문서의 핸들·바이트를 이쪽으로 넘기지 않는다: 새 탭은 자기 WebView 에서 자기 핸들로 연다.
+ */
+export interface AndroidWorkspaceHost {
+  version?: number;
+  /** 네이티브 작업 공간이 준비됐을 때만 true. */
+  enabled?: boolean;
+  /** true: 새 탭으로 처리했다(오류 안내 포함). false: 작업 공간이 없어 옛 동작으로. */
+  newDocument?: () => Promise<boolean>;
+  openDocument?: () => Promise<boolean>;
+  openRecent?: (id: string) => Promise<boolean>;
+}
+
+interface AndroidHostGlobal {
+  version?: number;
+  workspace?: AndroidWorkspaceHost;
+  /** 계약 이름은 `recovery`, 별칭 `recoveryStore`. */
+  recovery?: AndroidRecoveryStore;
+  recoveryStore?: AndroidRecoveryStore;
+  printPages?: (request: AndroidPrintRequest) => Promise<unknown>;
+  exportFile?: (blob: Blob, fileName: string) => Promise<unknown>;
+  onReady?: (studio: unknown) => void;
+}
+
+export type AndroidFlushResult =
+  | { ok: true }
+  | { ok: false; skipped: 'no-document' | 'clean' | 'encrypted' | 'no-password' | 'no-store' | 'busy' | 'error' };
+
+export function getAndroidHost(): AndroidHostGlobal | null {
+  const g = globalThis as { AndroidStudioHost?: unknown; rhwpAndroidHost?: unknown };
+  const host = g.AndroidStudioHost ?? g.rhwpAndroidHost;
+  return host && typeof host === 'object' ? host as AndroidHostGlobal : null;
+}
+
+/** 셸의 비공개(암호화) 복구 저장소. 셸은 있는데 저장소가 없으면 null, 셸이 없으면 undefined. */
+export function getAndroidRecoveryStore(): AndroidRecoveryStore | null | undefined {
+  const host = getAndroidHost();
+  if (!host) return undefined;
+  return host.recovery ?? host.recoveryStore ?? null;
+}
+
+export type AndroidWorkspaceAction = 'new' | 'open' | 'recent';
+
+/** 호스트가 자식 탭의 첫 동작을 제자리(옛 경로)로 실행시키는 명령별 표식. 전역 플래그가 아니라 명령과 함께 다닌다. */
+export const ANDROID_WORKSPACE_IN_PLACE = 'androidWorkspaceInPlace';
+
+/**
+ * 열기/새 문서를 새 탭으로 보내야 하는가. 호스트가 없거나 작업 공간이 꺼졌거나, 명령이 제자리 표식을 달고 왔으면 false(옛 동작).
+ * 표식은 명령 params 에만 있다 — 자동화가 준비/미들웨어를 기다린 뒤 늦게 실행해도 같은 명령이 같은 판단을 한다.
+ */
+export function androidWorkspaceRouting(params?: Record<string, unknown>): boolean {
+  const workspace = getAndroidHost()?.workspace;
+  return !!workspace && workspace.enabled === true && params?.[ANDROID_WORKSPACE_IN_PLACE] !== true;
+}
+
+/** 새 탭으로 처리했으면 true. 작업 공간이 처리하지 않겠다고 하면 false(호출자가 옛 동작으로). 오류는 그대로 던진다. */
+export async function routeAndroidWorkspaceAction(action: AndroidWorkspaceAction, recentId?: string): Promise<boolean> {
+  const workspace = getAndroidHost()?.workspace;
+  if (!workspace || workspace.enabled !== true) return false;
+  if (action === 'new') return typeof workspace.newDocument === 'function' ? await workspace.newDocument() : false;
+  if (action === 'open') return typeof workspace.openDocument === 'function' ? await workspace.openDocument() : false;
+  return typeof workspace.openRecent === 'function' && typeof recentId === 'string' && recentId !== '' ? await workspace.openRecent(recentId) : false;
+}
+
+/**
+ * 새 탭 라우팅 + 오류 처리. true: 처리했다(실패해도 현재 문서를 대신 바꾸지 않는다). false: 호스트가 처리하지 않겠다 → 호출자가 옛 동작.
+ * `reportError` 는 사용자에게 보이는 안내(토스트)다.
+ */
+export async function handleAndroidWorkspaceAction(
+  action: AndroidWorkspaceAction,
+  recentId: string | undefined,
+  reportError: (message: string) => void,
+): Promise<boolean> {
+  try {
+    return await routeAndroidWorkspaceAction(action, recentId);
+  } catch (error) {
+    reportError(`새 탭을 열지 못했어요: ${error instanceof Error ? error.message : String(error)}`);
+    return true;
+  }
+}
+
+export function isAndroidHost(): boolean {
+  return getAndroidHost() !== null;
+}
+
+/** 복구용 자동 저장을 쓸 수 없는 Android 모드(비공개 저장소가 없음)인가. */
+export function androidRecoveryUnavailable(): boolean {
+  return getAndroidRecoveryStore() === null;
+}
+
+let saveGuard: AndroidSaveGuard | null = null;
+
+/** 저장 직전에 실제 내보내기 바이트를 검사한다. 던지면 저장을 막고 문서는 dirty 로 남는다. */
+export async function runAndroidSaveGuard(input: AndroidSaveGuardInput): Promise<void> {
+  if (saveGuard) await saveGuard(input);
+}
+
+/**
+ * Android 모드에서 브라우저 다운로드로 내보낼 수 없을 때 호스트 저장 선택기(FSA 어댑터)로 쓴다.
+ * 어댑터가 거절하면(확장자·정책) 그대로 던진다.
+ */
+export async function androidExportBlob(blob: Blob, fileName: string): Promise<void> {
+  const exportFile = getAndroidHost()?.exportFile;
+  if (typeof exportFile === 'function') {
+    await getAndroidHost()!.exportFile!(blob, fileName);
+    return;
+  }
+  const picker = (window as unknown as {
+    showSaveFilePicker?: (options: { suggestedName: string }) => Promise<{
+      createWritable(): Promise<{ write(data: Blob): Promise<void>; close(): Promise<void> }>;
+    }>;
+  }).showSaveFilePicker;
+  if (typeof picker !== 'function') {
+    throw new Error('이 앱에서는 파일 저장 위치를 고를 수 없어 내보내지 못했습니다.');
+  }
+  const handle = await picker.call(window, { suggestedName: fileName });
+  const writable = await handle.createWritable();
+  await writable.write(blob);
+  await writable.close();
+}
+
+/** 인쇄·PDF: 쪽 이미지를 셸의 네이티브 PDF/인쇄 서비스로 넘긴다(iframe·창을 만들지 않는다). */
+export async function androidPrintPages(
+  fileName: string,
+  pages: AndroidPrintPage[],
+  intent: 'print' | 'pdf',
+): Promise<void> {
+  const printPages = getAndroidHost()?.printPages;
+  if (typeof printPages !== 'function') {
+    throw new Error('이 앱에서는 인쇄/PDF 서비스를 사용할 수 없습니다.');
+  }
+  await getAndroidHost()!.printPages!({ fileName, pages, intent });
+}
+
+/** 쪽을 하나씩 만들어 넘기는 인쇄·PDF(메모리에는 한 쪽만). 셸이 취소·실패하면 던진다. */
+export async function androidPrintDocument(
+  fileName: string,
+  pageCount: number,
+  renderPage: (index: number) => Promise<AndroidPrintPage>,
+  intent: 'print' | 'pdf',
+  signal?: AbortSignal,
+): Promise<void> {
+  const printPages = getAndroidHost()?.printPages;
+  if (typeof printPages !== 'function') {
+    throw new Error('이 앱에서는 인쇄/PDF 서비스를 사용할 수 없습니다.');
+  }
+  await getAndroidHost()!.printPages!({ fileName, intent, pageCount, renderPage, signal });
+}
+
+let lastAutosaveStatus: unknown = null;
+
+/** main.ts 의 자동 저장 상태 콜백이 호출한다. */
+export function recordAutosaveStatus(status: unknown): void {
+  lastAutosaveStatus = status;
+}
+
+export interface AndroidHostDeps {
+  hasDocument(): boolean;
+  getFileName(): string;
+  isDirty(): boolean;
+  isEncrypted(): boolean;
+  getFormat(): 'hwp' | 'hwpx' | 'hml';
+  getFileHandle(): unknown;
+  discardRecovery(reason: string): Promise<void>;
+  /** 일반 '저장하지 않은 변경' 확인(저장/버리기/취소). 계속해도 되면 true. */
+  canReplaceDocument(): Promise<boolean>;
+  flushAutosave(reason: string): Promise<void>;
+  newDocument(): void;
+}
+
+export function createAndroidHostApi(deps: AndroidHostDeps) {
+  return {
+    version: 1,
+    getState() {
+      const hasDocument = deps.hasDocument();
+      return {
+        hasDocument,
+        fileName: hasDocument ? deps.getFileName() : '',
+        dirty: hasDocument && deps.isDirty(),
+        encrypted: hasDocument && deps.isEncrypted(),
+        format: hasDocument ? deps.getFormat() : null,
+        fileHandle: hasDocument ? deps.getFileHandle() ?? null : null,
+      };
+    },
+    /**
+     * 떠나도 되면 true(저장했거나 깨끗하거나 버리기를 골랐을 때). 취소·저장 실패는 false.
+     * 버리기를 골랐다면 이 문서의 복구본을 지운다. 이동은 셸이 직접 한다.
+     */
+    async confirmClose(): Promise<boolean> {
+      const wasDirty = deps.hasDocument() && deps.isDirty();
+      const ok = await deps.canReplaceDocument();
+      if (ok && wasDirty && deps.isDirty()) await deps.discardRecovery('android-discard');
+      return ok;
+    },
+    async close(): Promise<boolean> {
+      return this.confirmClose();
+    },
+    async flushRecovery(): Promise<AndroidFlushResult> {
+      if (!deps.hasDocument()) return { ok: false, skipped: 'no-document' };
+      if (androidRecoveryUnavailable()) return { ok: false, skipped: 'no-store' };
+      if (!deps.isDirty()) return { ok: false, skipped: 'clean' };
+      lastAutosaveStatus = null;
+      await deps.flushAutosave('android-lifecycle');
+      const status = lastAutosaveStatus as { state?: string } | null;
+      if (status === null) return { ok: false, skipped: 'busy' };
+      if (status.state === 'saved') return { ok: true };
+      if (status.state === 'blocked') return { ok: false, skipped: 'no-password' };
+      return { ok: false, skipped: 'error' };
+    },
+    setSaveGuard(guard: AndroidSaveGuard | null): void {
+      saveGuard = typeof guard === 'function' ? guard : null;
+    },
+    /** 새 문서(저장하지 않은 변경 확인 포함). 열기는 표준 launchQueue / showOpenFilePicker 로 한다. */
+    newDocument(): void {
+      deps.newDocument();
+    },
+  };
+}
+
+/** Studio 가 초기화를 마친 뒤(launchQueue 소비자 설치 후) 셸에 알린다. */
+export function notifyAndroidReady(studio: unknown): void {
+  const host = getAndroidHost();
+  if (host && typeof host.onReady === 'function') {
+    try {
+      host.onReady(studio);
+    } catch (error) {
+      console.warn('[android-host] onReady 실패:', error);
+    }
+  }
+}
diff --git a/rhwp-studio/src/hwpxxx/android-print.ts b/rhwp-studio/src/hwpxxx/android-print.ts
new file mode 100644
index 0000000..8ee91d6
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/android-print.ts
@@ -0,0 +1,198 @@
+// [hwpxxx-android] 인쇄/PDF 쪽 래스터: 화면과 같은 Canvas2D 렌더러 + 같은 호스트 글꼴 세션으로 쪽마다 PNG 를 만든다.
+//
+// 왜 SVG 가 아닌가: 가져온(비공개) 글꼴은 WasmBridge 의 HostCanvasFontSession 이 FontFace 별칭으로만 등록한다.
+// SVG 를 Image 로 그리면 그 별칭이 없어 글꼴이 바뀐다. 그래서 `renderPageToCanvasFiltered(..., 'print')` 로 직접 그린다.
+//
+// 한 번에 한 쪽만 메모리에 둔다(쪽 PNG 를 100장 모아 두지 않는다). 편집기 캐럿·선택·여백 안내선은 DOM/오버레이라 이 경로에
+// 들어오지 않고, 문단부호·조판부호·투명선은 보기 옵션이라 그리는 동안만 끄고 즉시 되돌린다(동기 구간, await 없음).
+
+import type { LayerRenderProfile, PageInfo } from '@/core/types';
+
+/** 네이티브 한도와 같다: 인쇄/PDF 한 번에 100쪽, 쪽 PNG ≤ 8MiB, 디코딩 픽셀 ≤ 5,000,000. */
+export const ANDROID_PRINT_MAX_PAGES = 100;
+export const ANDROID_PRINT_MAX_PAGE_BYTES = 8 * 1024 * 1024 - 1024;
+export const ANDROID_PRINT_MAX_PIXELS = 4_800_000;
+export const ANDROID_PRINT_MAX_SCALE = 2.25;
+export const ANDROID_PRINT_MIN_SCALE = 1;
+const MAX_LONG_EDGE_PX = 2700;
+
+export class AndroidPrintInterrupted extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'AndroidPrintInterrupted';
+  }
+}
+
+export interface AndroidPrintPageImage {
+  png: Uint8Array;
+  /** CSS 픽셀(96dpi). 호스트가 PDF 포인트(×0.75)로 바꾼다. */
+  width: number;
+  height: number;
+}
+
+/** WasmBridge 의 이 모듈이 쓰는 부분만 좁힌 표면(시험에서 실제 WasmBridge 를 그대로 넣는다). */
+export interface AndroidPrintBridge {
+  readonly pageCount: number;
+  readonly documentGeneration: number;
+  prepareCanvasMetrics(backend: string, isCurrent?: () => boolean): Promise<boolean>;
+  getPageInfo(pageNum: number): Pick<PageInfo, 'width' | 'height'>;
+  getPageSourceImageKeys(pageNum: number): string | null;
+  renderPageToCanvasFiltered(
+    pageNum: number,
+    canvas: HTMLCanvasElement,
+    scale: number,
+    layerKind: 'all',
+    profile: LayerRenderProfile,
+  ): void;
+  getShowParagraphMarks(): boolean;
+  setShowParagraphMarks(enabled: boolean): void;
+  getShowControlCodes(): boolean;
+  setShowControlCodes(enabled: boolean): void;
+  getShowTransparentBorders(): boolean;
+  setShowTransparentBorders(enabled: boolean): void;
+}
+
+export interface AndroidPrintJobOptions {
+  signal?: AbortSignal;
+  /** 문서가 바뀌었거나 교체되었으면 false. 쪽 사이마다 확인한다. */
+  isCurrent?: () => boolean;
+  /** 시험에서 캔버스·대기를 바꿔 끼운다. */
+  createCanvas?: () => HTMLCanvasElement;
+  settle?: () => Promise<void>;
+}
+
+export interface AndroidPrintJob {
+  pageCount: number;
+  renderPage(index: number): Promise<AndroidPrintPageImage>;
+}
+
+function abortError(): DOMException {
+  return new DOMException('취소했습니다.', 'AbortError');
+}
+
+/**
+ * 래스터 배율: 화면 CSS px → 캔버스 px. 긴 변 2700px, 총 480만 픽셀(네이티브 한도 500만) 이하이고 A4 는 2.25배.
+ * 한도 때문에 1배 아래가 되는 아주 큰 용지도 그대로 그린다(호스트가 포인트 한도로 따로 거절한다).
+ */
+export function printRasterScale(widthPx: number, heightPx: number): number {
+  if (!(widthPx > 0 && heightPx > 0) || !Number.isFinite(widthPx) || !Number.isFinite(heightPx)) {
+    throw new Error('페이지 크기를 확인하지 못했어요.');
+  }
+  return Math.min(
+    ANDROID_PRINT_MAX_SCALE,
+    MAX_LONG_EDGE_PX / Math.max(widthPx, heightPx),
+    Math.sqrt(ANDROID_PRINT_MAX_PIXELS / (widthPx * heightPx)),
+  );
+}
+
+function pageHasPictures(bridge: AndroidPrintBridge, index: number): boolean {
+  const keys = bridge.getPageSourceImageKeys(index);
+  if (keys === null) return true; // 구형 WASM: 그림 유무를 모르므로 한 번 더 그린다.
+  try {
+    const parsed = JSON.parse(keys) as { keys?: unknown[] };
+    return Array.isArray(parsed.keys) && parsed.keys.length > 0;
+  } catch {
+    return true;
+  }
+}
+
+/** 보기 옵션(문단부호·조판부호·투명선)을 끄고 그린 뒤 반드시 되돌린다. 이 안에서는 await 하지 않는다. */
+function renderWithoutViewAids(
+  bridge: AndroidPrintBridge,
+  index: number,
+  canvas: HTMLCanvasElement,
+  scale: number,
+): void {
+  const marks = bridge.getShowParagraphMarks();
+  const codes = bridge.getShowControlCodes();
+  const borders = bridge.getShowTransparentBorders();
+  try {
+    if (marks) bridge.setShowParagraphMarks(false);
+    if (codes) bridge.setShowControlCodes(false);
+    if (borders) bridge.setShowTransparentBorders(false);
+    bridge.renderPageToCanvasFiltered(index, canvas, scale, 'all', 'print');
+  } finally {
+    if (marks) bridge.setShowParagraphMarks(true);
+    if (codes) bridge.setShowControlCodes(true);
+    if (borders) bridge.setShowTransparentBorders(true);
+  }
+}
+
+function canvasToPng(canvas: HTMLCanvasElement): Promise<Uint8Array | null> {
+  return new Promise((resolve, reject) => {
+    canvas.toBlob((blob) => {
+      if (!blob) { resolve(null); return; }
+      blob.arrayBuffer().then((buffer) => resolve(new Uint8Array(buffer)), reject);
+    }, 'image/png');
+  });
+}
+
+function isPng(bytes: Uint8Array): boolean {
+  return bytes.length > 8 && bytes[0] === 137 && bytes[1] === 80 && bytes[2] === 78 && bytes[3] === 71
+    && bytes[4] === 13 && bytes[5] === 10 && bytes[6] === 26 && bytes[7] === 10;
+}
+
+const nextFrame = () => new Promise<void>((resolve) => requestAnimationFrame(() => resolve()));
+const defaultSettle = async () => {
+  await nextFrame();
+  await new Promise<void>((resolve) => setTimeout(resolve, 80));
+  await nextFrame();
+};
+
+/**
+ * 인쇄 작업을 준비한다: 호스트 글꼴·캔버스 지표를 먼저 맞추고(`prepareCanvasMetrics('canvas2d')`),
+ * 쪽 수를 확인한 뒤 쪽마다 PNG 를 만드는 함수를 돌려준다.
+ */
+export async function prepareAndroidPrintJob(
+  bridge: AndroidPrintBridge,
+  options: AndroidPrintJobOptions = {},
+): Promise<AndroidPrintJob> {
+  const generation = bridge.documentGeneration;
+  const current = () => bridge.documentGeneration === generation && (options.isCurrent?.() ?? true);
+  const interrupted = () => new AndroidPrintInterrupted('문서가 바뀌어 인쇄를 멈췄어요. 다시 시도해 주세요.');
+  const assertActive = () => {
+    if (options.signal?.aborted) throw abortError();
+    if (!current()) throw interrupted();
+  };
+  assertActive();
+  // 글꼴 FontFace·측정값 준비. 가져온 글꼴은 이 단계에서 별칭으로 올라간다. 실패한 글꼴은 화면과 같은 대체 글꼴로 그려진다.
+  await bridge.prepareCanvasMetrics('canvas2d', current);
+  assertActive();
+  const pageCount = bridge.pageCount;
+  if (pageCount < 1) throw new Error('인쇄할 쪽이 없어요.');
+  if (pageCount > ANDROID_PRINT_MAX_PAGES) {
+    throw new Error(`PDF와 인쇄는 한 번에 ${ANDROID_PRINT_MAX_PAGES}쪽까지 지원해요. 지금 문서는 ${pageCount}쪽이에요.`);
+  }
+  const createCanvas = options.createCanvas ?? (() => document.createElement('canvas'));
+  const settle = options.settle ?? defaultSettle;
+
+  async function renderPage(index: number): Promise<AndroidPrintPageImage> {
+    assertActive();
+    if (!Number.isInteger(index) || index < 0 || index >= pageCount) throw new Error('쪽 번호가 올바르지 않아요.');
+    const info = bridge.getPageInfo(index);
+    let scale = printRasterScale(info.width, info.height);
+    const pictures = pageHasPictures(bridge, index);
+    for (;;) {
+      const canvas = createCanvas();
+      try {
+        renderWithoutViewAids(bridge, index, canvas, scale);
+        if (pictures) {
+          // 일부 그림(SVG/WMF/EMF 등)은 엔진이 비동기로 디코드한다. 첫 렌더가 디코드를 시작하고, 잠시 뒤 다시 그리면 채워진다.
+          await settle();
+          assertActive();
+          renderWithoutViewAids(bridge, index, canvas, scale);
+        }
+        const png = await canvasToPng(canvas);
+        assertActive();
+        if (!png || !isPng(png)) throw new Error('인쇄 페이지를 만들지 못했어요.');
+        if (png.length <= ANDROID_PRINT_MAX_PAGE_BYTES) return { png, width: info.width, height: info.height };
+        if (scale <= ANDROID_PRINT_MIN_SCALE) throw new Error(`${index + 1}쪽 이미지가 너무 커서 인쇄할 수 없어요.`);
+        scale = Math.max(ANDROID_PRINT_MIN_SCALE, scale * 0.75);
+      } finally {
+        canvas.width = 0;
+        canvas.height = 0;
+      }
+    }
+  }
+  return { pageCount, renderPage };
+}
