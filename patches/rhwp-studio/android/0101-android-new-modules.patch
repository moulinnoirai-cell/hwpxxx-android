+  const rows = new Map<string, { meta: any; data: Uint8Array }>(); const calls: string[] = [];
+  return {
+    rows, calls,
+    async list() { calls.push('list'); if (opts.failList) throw new Error('native list failed'); return [...rows.values()].map((r) => r.meta); },
