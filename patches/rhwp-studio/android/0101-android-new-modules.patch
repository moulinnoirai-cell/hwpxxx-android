+    bodyParagraphs: 0, bodyCharSamples: 0, tables: 0, nestedTables: 0, cellParagraphs: 0, cellCharSamples: 0,
+    textBoxLists: 0, headerFooterParagraphs: 0, headerFooterFields: 0, memos: 0, uncovered: [],
