+});
+test('duplicate or missing section ZIP entries remain mandatory and fail closed', () => {
+  const live = new core.HwpDocument(pathSource()), bytes = exported(live), re = new core.HwpDocument(bytes), parts = entries(bytes), sec = parts.find(([name]) => name === 'Contents/section0.xml')!;
