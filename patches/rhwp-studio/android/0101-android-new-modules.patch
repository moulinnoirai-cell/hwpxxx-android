index 0000000..bbda6cd
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-font-picker.test.ts
@@ -0,0 +1,124 @@
+// [hwpxxx-android] 가져온(호스트) 글꼴이 글꼴 선택 UI(도구 모음 글꼴 상자 · 글자 모양 · 대표 글꼴 세트)에 나오는지 시험한다.
+// 순수 목록 함수만 시험한다(화면·저장·다시 열기는 실제 UI 시험이 한다). 합성 글꼴 메타데이터만 사용한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import type { HostFontProvider, HostFontSnapshot } from '../src/core/host-font-provider.ts';
+import {
+  getFontPickerNames, getHostFontPickerNames, getLocalFonts, loadStoredLocalFonts, onHostFontsChanged,
+  prepareHostFontCatalog, resetLocalFontsForTests, resolveRendererLocalFont, setHostFontProvider,
+} from '../src/core/local-fonts.ts';
+
+const g = globalThis as Record<string, any>;
+const face = (id: string, family: string, style: string, weight = 400, slant: 'normal' | 'italic' | 'oblique' = 'normal', extra: Record<string, unknown> = {}) => ({
+  id, family, fullName: style === 'Regular' ? family : `${family} ${style}`, postscriptName: `${family.replace(/\s+/g, '')}-${style.replace(/\s+/g, '')}`,
+  style, weight, slant, aliases: [], ...extra,
+});
+
+function host(initial: HostFontSnapshot) {
+  let snapshot = initial; let change = () => {};
+  const provider: HostFontProvider = {
+    getSnapshot: async () => snapshot,
+    readFace: async () => ({ bytes: Uint8Array.of(1).buffer }),
+    subscribe: (listener) => { change = listener; return () => {}; },
+  };
+  return { provider, publish: async (next: HostFontSnapshot) => { snapshot = next; change(); await prepareHostFontCatalog(); } };
+}
+const sorted = (v: string[]) => [...v].sort((a, b) => a.localeCompare(b, 'ko'));
+
+test.beforeEach(async () => { resetLocalFontsForTests(); await setHostFontProvider(null); delete g.localStorage; });
+test.after(async () => { await setHostFontProvider(null); resetLocalFontsForTests(); delete g.localStorage; });
+
+test('without a host provider the picker list is exactly the detected local fonts (PC behaviour unchanged)', async () => {
+  assert.deepEqual(getHostFontPickerNames(), []);
+  assert.deepEqual(getFontPickerNames(), getLocalFonts());
+});
+
+test('an imported single-face font appears by its family name, is resolvable by that name, and the count is the real one', async () => {
+  const f = host({ revision: 'r1', faces: [face('a', '큐에이 글꼴', 'Regular')] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), ['큐에이 글꼴']);
+  assert.deepEqual(getFontPickerNames(), ['큐에이 글꼴']);
+  const record = resolveRendererLocalFont('큐에이 글꼴', { weight: 400, slant: 'normal' });
+  assert.equal(record?.hostReference?.face.id, 'a', 'the name offered by the picker is the name the renderer resolves to the imported face');
+});
+
+test('one family with Regular/Bold/Italic/BoldItalic is ONE entry (bold/italic come from the character flags)', async () => {
+  const f = host({ revision: 'r1', faces: [
+    face('r', 'Fam', 'Regular'), face('b', 'Fam', 'Bold', 700), face('i', 'Fam', 'Italic', 400, 'italic'), face('bi', 'Fam', 'Bold Italic', 700, 'italic'),
+  ] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), ['Fam']);
+  assert.equal(resolveRendererLocalFont('Fam', { weight: 700, slant: 'italic' })?.hostReference?.face.id, 'bi');
+});
+
+test('faces a family name plus bold/italic cannot reach (Light, Medium, no Regular, duplicates) get their exact full name too', async () => {
+  const f = host({ revision: 'r1', faces: [
+    face('r', 'Wide', 'Regular'), face('l', 'Wide', 'Light', 300), face('m', 'Wide', 'Medium', 500), face('b', 'Wide', 'Bold', 700),
+    face('x', 'OnlyBold', 'Bold', 700),
+    face('n1', 'Dup', 'Regular'), face('n2', 'Dup', 'Regular', 400, 'normal', { fullName: 'Dup Condensed', postscriptName: 'Dup-Cond' }),
+  ] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), sorted(['Wide', 'Wide Light', 'Wide Medium', 'OnlyBold Bold', 'Dup-Regular', 'Dup Condensed']));
+  // the pinned names really resolve to exactly that face
+  assert.equal(resolveRendererLocalFont('Wide Light', { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'l');
+  assert.equal(resolveRendererLocalFont('OnlyBold Bold', { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'x');
+  for (const name of getHostFontPickerNames()) {
+    assert.ok(resolveRendererLocalFont(name, { weight: 400, slant: 'normal' })?.hostReference, `offered name ${name} must load an imported face without requiring undisclosed style flags`);
+  }
+});
+
+test('a non-Regular face whose full name equals its family uses its exact PostScript name instead of a dead family choice', async () => {
+  const f = host({ revision: 'light', faces: [face('l', 'Only Light', 'Light', 300, 'normal', { fullName: 'Only Light' })] });
+  await setHostFontProvider(f.provider);
+  assert.equal(resolveRendererLocalFont('Only Light', { weight: 400, slant: 'normal' }), null);
+  assert.deepEqual(getHostFontPickerNames(), ['OnlyLight-Light']);
+  assert.equal(resolveRendererLocalFont(getHostFontPickerNames()[0], { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'l');
+});
+
+test('duplicates collapse (case, spaces, NFC) across host faces and against the detected system fonts; system entries keep their spelling', async () => {
+  g.localStorage = { getItem: (k: string) => k === 'rhwp-local-fonts' ? JSON.stringify({ version: 1, detectedAt: '2026-06-21T00:00:00.000Z', families: ['Shared Font', '시스템 전용'], source: 'local-font-access' }) : null, setItem() {}, removeItem() {}, clear() {}, key() { return null; }, length: 0 };
+  await loadStoredLocalFonts();
+  assert.deepEqual(getLocalFonts(), sorted(['Shared Font', '시스템 전용']));
+  const f = host({ revision: 'r1', faces: [face('s', 'shared  font', 'Regular'), face('u', 'Host Unique', 'Regular'), face('u2', 'HOST UNIQUE', 'Bold', 700)] });
+  await setHostFontProvider(f.provider);
+  const names = getFontPickerNames();
+  assert.equal(names.filter((n) => n.toLowerCase().replace(/\s+/g, ' ') === 'shared font').length, 1, 'one entry for the shared family');
+  assert.equal(names.filter((n) => n.toLowerCase() === 'host unique').length, 1);
+  assert.deepEqual(names, sorted(names), 'sorted like the system list');
+  assert.ok(names.includes('시스템 전용') && names.includes('Shared Font'));
+});
+
+test('import / delete / replace are reflected immediately: no stale entry, no stale count', async () => {
+  const f = host({ revision: 'r1', faces: [face('a', 'First', 'Regular')] });
+  let notified = 0; const off = onHostFontsChanged(() => { notified++; });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getFontPickerNames(), ['First']);
+  await f.publish({ revision: 'r2', faces: [face('a', 'First', 'Regular'), face('b', 'Second 글꼴', 'Regular')] });
+  assert.deepEqual(getFontPickerNames(), sorted(['First', 'Second 글꼴']), 'imported font appears without reloading anything');
+  await f.publish({ revision: 'r3', faces: [face('b', 'Second 글꼴', 'Regular')] });
+  assert.deepEqual(getFontPickerNames(), ['Second 글꼴'], 'deleted font disappears');
+  await f.publish({ revision: 'r4', faces: [] });
+  assert.deepEqual(getFontPickerNames(), [], 'empty catalog = empty list');
+  await setHostFontProvider(null);
+  assert.deepEqual(getHostFontPickerNames(), [], 'provider disconnected');
+  assert.ok(notified >= 3, 'the toolbar is told about every change');
+  off();
+});
+
+test('the picker never owns document fonts: base/document font lists are untouched and selection keeps a document font that is not installed', () => {
+  const root = (rel: string) => readFileSync(fileURLToPath(new URL(`../src/${rel}`, import.meta.url)), 'utf8');
+  const toolbar = root('ui/toolbar.ts');
+  // PC defaults and document fonts still come first/unchanged; only the system/all lists use the merged names
+  assert.match(toolbar, /const documentFonts = this\.fontMenuDocumentFonts\.map/);
+  assert.match(toolbar, /const baseFonts = BASE_FONTS\.map/);
+  assert.equal((toolbar.match(/getFontPickerNames\(\)/g) ?? []).length, 2, 'system and all categories');
+  assert.doesNotMatch(toolbar, /getLocalFonts\(\)/);
+  assert.match(toolbar, /onHostFontsChanged\(\(\) => \{\s*void prepareHostFontCatalog\(\)\.then\(\(\) => \{\s*if \(this\.fontMenu\) this\.renderFontMenu\(this\.fontMenu\)/);
+  const dialog = root('ui/char-shape-dialog.ts');
+  assert.match(dialog, /const localFonts = getFontPickerNames\(\)/);
+  assert.match(dialog, /if \(this\.fontSelect\.value !== fontName && fontName\)/, 'a document font absent from the list is still shown (option added)');
+  assert.match(root('ui/font-set-edit-dialog.ts'), /const localFonts = getFontPickerNames\(\)/);
+  for (const file of ['ui/toolbar.ts', 'ui/char-shape-dialog.ts', 'ui/font-set-edit-dialog.ts']) assert.doesNotMatch(root(file), /import \{ getLocalFonts \}/, file);
+});
diff --git a/rhwp-studio/tests/hwpxxx-android-host.test.ts b/rhwp-studio/tests/hwpxxx-android-host.test.ts
new file mode 100644
index 0000000..ae9a100
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-host.test.ts
@@ -0,0 +1,145 @@
+// [hwpxxx-android] 셸 통합면(android-host)과 저장 검증(android-save-verify) 시험.
+// 저장 검증은 이 빌드의 실제 Android 코어(`../pkg/rhwp.js`, `rhwp_bg.wasm`)로 문서를 열고 내보내 다시 비교한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { createAndroidHostApi, getAndroidHost, getAndroidRecoveryStore, androidRecoveryUnavailable, runAndroidSaveGuard } from '../src/hwpxxx/android-host.ts';
+import { verifyReopenedDocument } from '../src/hwpxxx/android-save-verify.ts';
+
+const g = globalThis as Record<string, unknown>;
+const pkg = (name: string) => fileURLToPath(new URL(`../../pkg/${name}`, import.meta.url));
+
+function deps(overrides: Record<string, unknown> = {}) {
+  const calls: string[] = [];
+  const base = {
+    hasDocument: () => true, getFileName: () => 'a.hwp', isDirty: () => true, isEncrypted: () => false,
+    getFormat: () => 'hwp' as const, getFileHandle: () => ({ name: 'a.hwp' }),
+    discardRecovery: async (r: string) => { calls.push('discard:' + r); },
+    canReplaceDocument: async () => true,
+    flushAutosave: async (r: string) => { calls.push('flush:' + r); },
+    newDocument: () => { calls.push('new'); },
+    ...overrides,
+  };
+  return { base, calls };
+}
+
+test('셸이 없으면 Android 모드가 아니다(데스크톱 동작 유지)', () => {
+  delete g.AndroidStudioHost; delete g.rhwpAndroidHost;
+  assert.equal(getAndroidHost(), null);
+  assert.equal(getAndroidRecoveryStore(), undefined);
+  assert.equal(androidRecoveryUnavailable(), false);
+});
+
+test('AndroidStudioHost 와 별칭 rhwpAndroidHost, recovery/recoveryStore 이름을 모두 받는다', () => {
+  const store = { saveDraft: async () => {} };
+  g.rhwpAndroidHost = { recoveryStore: store };
+  assert.equal(getAndroidRecoveryStore(), store);
+  delete g.rhwpAndroidHost;
+  g.AndroidStudioHost = { recovery: store };
+  assert.equal(getAndroidRecoveryStore(), store);
+  g.AndroidStudioHost = {};
+  assert.equal(getAndroidRecoveryStore(), null); // 셸은 있는데 비공개 저장소가 없다 → 평문 복구본 금지
+  assert.equal(androidRecoveryUnavailable(), true);
+  delete g.AndroidStudioHost;
+});
+
+test('getState 는 핸들·암호·형식을 알리고 confirmClose 는 버리기에서만 복구본을 지운다', async () => {
+  g.AndroidStudioHost = { recovery: {} };
+  const { base, calls } = deps();
+  const api = createAndroidHostApi(base as never);
+  assert.deepEqual(api.getState(), { hasDocument: true, fileName: 'a.hwp', dirty: true, encrypted: false, format: 'hwp', fileHandle: { name: 'a.hwp' } });
+  assert.equal(await api.confirmClose(), true);
+  assert.deepEqual(calls, ['discard:android-discard'], '여전히 dirty 인 채로 계속 → 버리기');
+  const state = { dirty: true };
+  const saved = deps({ isDirty: () => state.dirty, canReplaceDocument: async () => { state.dirty = false; return true; } });
+  assert.equal(await createAndroidHostApi(saved.base as never).close(), true);
+  assert.deepEqual(saved.calls, [], '저장 후 닫기는 복구본을 따로 지우지 않는다(저장이 이미 지운다)');
+  const cancel = deps({ canReplaceDocument: async () => false });
+  assert.equal(await createAndroidHostApi(cancel.base as never).confirmClose(), false);
+  delete g.AndroidStudioHost;
+});
+
+test('flushRecovery: 저장소 없음·깨끗함·문서 없음은 쓰지 않고, 저장소가 있으면 android-lifecycle 로 즉시 저장', async () => {
+  g.AndroidStudioHost = {};
+  assert.deepEqual(await createAndroidHostApi(deps().base as never).flushRecovery(), { ok: false, skipped: 'no-store' });
+  g.AndroidStudioHost = { recovery: {} };
+  assert.deepEqual(await createAndroidHostApi(deps({ isDirty: () => false }).base as never).flushRecovery(), { ok: false, skipped: 'clean' });
+  assert.deepEqual(await createAndroidHostApi(deps({ hasDocument: () => false }).base as never).flushRecovery(), { ok: false, skipped: 'no-document' });
+  const { base, calls } = deps();
+  const result = await createAndroidHostApi(base as never).flushRecovery();
+  assert.deepEqual(calls, ['flush:android-lifecycle']);
+  assert.equal(result.ok, false); // 시험용 flushAutosave 는 상태 콜백을 부르지 않았다 → busy
+  delete g.AndroidStudioHost;
+});
+
+test('저장 검사 훅이 던지면 저장 흐름도 던진다', async () => {
+  g.AndroidStudioHost = {};
+  const api = createAndroidHostApi(deps().base as never);
+  api.setSaveGuard(() => { throw new Error('거절'); });
+  await assert.rejects(runAndroidSaveGuard({ bytes: new Uint8Array(), format: 'hwp', fileName: 'a.hwp', encrypted: false, contentLoss: null, mode: 'save' }), /거절/);
+  api.setSaveGuard(null);
+  await runAndroidSaveGuard({ bytes: new Uint8Array(), format: 'hwp', fileName: 'a.hwp', encrypted: false, contentLoss: null, mode: 'save' });
+  delete g.AndroidStudioHost;
+});
+
+// ── 저장 검증(실제 코어) ───────────────────────────────────────────────────────────────
+async function engine() {
+  const mod = await import(pkg('rhwp.js'));
+  await mod.default({ module_or_path: readFileSync(pkg('rhwp_bg.wasm')) });
+  return mod.HwpDocument as { new (b: Uint8Array): any; openWithPassword(b: Uint8Array, p: string): any };
+}
+const sample = (name: string) => new Uint8Array(readFileSync(fileURLToPath(new URL(`../public/samples/${name}`, import.meta.url))));
+
+test('같은 형식으로 저장한 문서는 글·서식·표·메모 비교를 통과한다', async () => {
+  const Doc = await engine();
+  for (const [name, fmt] of [['biz_plan.hwp', 'hwp'], ['form-002.hwpx', 'hwpx']] as const) {
+    const live = new Doc(sample(name));
+    const ex = fmt === 'hwp' ? live.exportHwpWithReport() : live.exportHwpxWithReport();
+    const bytes = ex.takeBytes(); ex.free();
+    const reopened = new Doc(bytes);
+    verifyReopenedDocument(live, reopened, bytes.length);
+  }
+});
+
+test('내보낸 뒤 문서가 바뀌었거나(글·글자 서식·문단 서식) 파일이 손상되면 거절한다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const ex = live.exportHwpWithReport(); const bytes = ex.takeBytes(); ex.free();
+  const reopened = new Doc(bytes);
+  verifyReopenedDocument(live, reopened, bytes.length);
+  live.insertText(0, 0, 0, '가');
+  assert.throws(() => verifyReopenedDocument(live, reopened, bytes.length), /내용이 달라/);
+  const live2 = new Doc(sample('biz_plan.hwp'));
+  let para = 0;
+  while (live2.getParagraphLength(0, para) < 2) para += 1;
+  const ex2 = live2.exportHwpWithReport(); const bytes2 = ex2.takeBytes(); ex2.free();
+  const re2 = new Doc(bytes2);
+  const len = live2.getParagraphLength(0, para);
+  live2.applyCharFormat(0, para, 0, len, JSON.stringify({ bold: !JSON.parse(live2.getCharPropertiesAt(0, para, 0)).bold }));
+  assert.throws(() => verifyReopenedDocument(live2, re2, bytes2.length), /글자 서식/);
+  const live3 = new Doc(sample('biz_plan.hwp'));
+  const ex3 = live3.exportHwpWithReport(); const bytes3 = ex3.takeBytes(); ex3.free();
+  const re3 = new Doc(bytes3);
+  live3.applyParaFormat(0, 0, JSON.stringify({ alignment: JSON.parse(live3.getParaPropertiesAt(0, 0)).alignment === 'center' ? 'left' : 'center' }));
+  assert.throws(() => verifyReopenedDocument(live3, re3, bytes3.length), /문단 서식/);
+  assert.throws(() => verifyReopenedDocument(live3, re3, 33 * 1024 * 1024), /32MB/);
+});
+
+test('암호 문서: 같은 비밀번호로 다시 열어 비교하고, 다른 비밀번호 파일은 열리지 않는다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const bytes = live.exportHwpWithPassword('시험-비밀번호');
+  const reopened = Doc.openWithPassword(bytes, '시험-비밀번호');
+  verifyReopenedDocument(live, reopened, bytes.length);
+  assert.throws(() => Doc.openWithPassword(bytes, '틀린-비밀번호'));
+});
+
+test('HWP↔HWPX 변환에서만 기본값 표기 차이를 허용한다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const ex = live.exportHwpxWithReport(); const bytes = ex.takeBytes(); ex.free();
+  const reopened = new Doc(bytes);
+  assert.throws(() => verifyReopenedDocument(live, reopened, bytes.length), /서식/);
+  verifyReopenedDocument(live, reopened, bytes.length, { crossFormat: true });
+});
diff --git a/rhwp-studio/tests/hwpxxx-android-no-local-font-prompt.test.ts b/rhwp-studio/tests/hwpxxx-android-no-local-font-prompt.test.ts
new file mode 100644
index 0000000..bcef923
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-no-local-font-prompt.test.ts
@@ -0,0 +1,12 @@
+// [hwpxxx-android] 셸에서는 로컬 글꼴 접근 허가 창을 띄우지 않는다: 문서 초기화가 그 창의 답을 기다리며 그리기가 멈추기 때문이다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+test('promptLocalFontsIfNeeded 는 Android 셸에서 가장 먼저 빠져나온다(글꼴 분석·허가 창 이전)', () => {
+  const main = readFileSync(new URL('../src/main.ts', import.meta.url), 'utf8');
+  const fn = main.slice(main.indexOf('async function promptLocalFontsIfNeeded'), main.indexOf('class DocumentOpenCancelledError'));
+  assert.ok(fn.includes('if (isAndroidHost()) return;'));
+  assert.ok(fn.indexOf('if (isAndroidHost()) return;') < fn.indexOf('loadStoredLocalFonts'), '저장된 글꼴 로드·분석보다 앞');
+  assert.ok(fn.indexOf('if (isAndroidHost()) return;') < fn.indexOf('showLocalFontsModalIfNeeded'), '허가 창보다 앞');
+});
diff --git a/rhwp-studio/tests/hwpxxx-android-recovery-ui.test.ts b/rhwp-studio/tests/hwpxxx-android-recovery-ui.test.ts
new file mode 100644
index 0000000..a7010b8
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-recovery-ui.test.ts
@@ -0,0 +1,231 @@
+// [hwpxxx-android] 복구 선택창·복원 안내 시험: 손실 보고가 있는 복구본(lossy)에만 경고가 나가고, 이름·내용은 텍스트로만 그려지며,
+// 복원 안내가 손실 표시를 따르고, 암호/평문 보호와 손실 표시를 못 담는 저장소의 거절이 이어지는지 확인한다.
+// 비밀번호는 시험마다 새로 만든 합성 값, 문서는 저장소 샘플뿐이다. 선택창은 작은 가짜 DOM 에서 실제 코드를 실행한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { randomUUID } from 'node:crypto';
+import { register } from 'node:module';
+import { fileURLToPath } from 'node:url';
+
+const g = globalThis as Record<string, any>;
+const pkg = (name: string) => fileURLToPath(new URL(`../../pkg/${name}`, import.meta.url));
+const sample = (name: string) => new Uint8Array(readFileSync(fileURLToPath(new URL(`../public/samples/${name}`, import.meta.url))));
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+const synthPassword = () => `synthetic-${randomUUID()}`;
+
+// ── 가짜 DOM: ModalDialog.createBody 가 쓰는 만큼만 ──────────────────────────────────────
+class FakeElement {
+  tagName: string; children: Array<FakeElement | string> = []; style: Record<string, string> = {};
+  attrs: Record<string, string> = {}; listeners: Record<string, Array<() => void>> = {};
+  private classes = new Set<string>(); own = ''; type = ''; name = ''; value = ''; checked = false; title = ''; htmlSet = false;
+  constructor(tag: string) { this.tagName = tag.toUpperCase(); }
+  get classList() { return { add: (c: string) => { this.classes.add(c); }, contains: (c: string) => this.classes.has(c) }; }
+  set className(v: string) { this.classes = new Set(v.split(/\s+/).filter(Boolean)); }
