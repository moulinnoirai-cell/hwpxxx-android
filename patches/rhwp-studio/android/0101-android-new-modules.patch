+      ensurePermission: async () => { log.perm++; return true; },
+      readFile: async (h: any) => ({ bytes: new Uint8Array([1, 2, 3]), name: h.name }),
+      remove: async (id: string) => { log.removed.push(id); },
+      toast: (m: string) => { log.toasts.push(m); },
