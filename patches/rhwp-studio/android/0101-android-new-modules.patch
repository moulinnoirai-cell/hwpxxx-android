index 0000000..9316144
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/android-draft-envelope.ts
@@ -0,0 +1,62 @@
+import type { RecoveryEnvelope } from '../recovery/recovery-crypto.ts';
+
+/**
+ * [hwpxxx-android] upstream 의 보호 복구본(`draft.protection`)을 Android 셸의 비공개 저장소에 싣는 방법.
+ *
+ * 셸 저장소는 고정된 메타데이터(이름·형식·`encrypted` 등)와 바이트만 보관하고 봉투(`protection`)를 담을 자리가 없다.
+ * 그래서 저장할 때 봉투를 암호문 앞에 붙인 한 덩어리 바이트로 포장하고(`encrypted: true` 로 표시), 읽을 때 다시 푼다.
+ * 비밀번호·키는 어디에도 들어가지 않는다 — 봉투에는 솔트·IV·반복 횟수 같은 공개 값만 있다.
+ *
+ * 형식: MAGIC(8) | 헤더 길이(u32, big-endian) | 헤더(JSON, UTF-8) | 암호문
+ */
+const MAGIC = Uint8Array.from([0x52, 0x48, 0x45, 0x4e, 0x56, 0x31, 0x0a, 0x00]); // "RHENV1\n\0"
+const MAX_HEADER = 4096;
+
+function isBytes(value: unknown, length: number): value is number[] {
+  return Array.isArray(value) && value.length === length && value.every(n => Number.isInteger(n) && n >= 0 && n <= 255);
+}
+
+export function packProtectedDraftData(data: Uint8Array, envelope: RecoveryEnvelope): Uint8Array {
+  const header = new TextEncoder().encode(JSON.stringify({
+    version: envelope.version,
+    scheme: envelope.scheme,
+    iterations: envelope.iterations,
+    salt: Array.from(envelope.salt),
+    iv: Array.from(envelope.iv),
+    epoch: envelope.epoch,
+    revision: envelope.revision,
+  }));
+  if (header.length > MAX_HEADER) throw new Error('복구본 봉투가 너무 큽니다.');
+  const out = new Uint8Array(MAGIC.length + 4 + header.length + data.length);
+  out.set(MAGIC, 0);
+  new DataView(out.buffer).setUint32(MAGIC.length, header.length, false);
+  out.set(header, MAGIC.length + 4);
+  out.set(data, MAGIC.length + 4 + header.length);
+  return out;
+}
+
+/** 포장된 바이트를 풀어 암호문과 봉투를 돌려준다. 포장이 아니거나 손상됐으면 null(던지지 않는다). */
+export function unpackProtectedDraftData(bytes: Uint8Array): { data: Uint8Array; protection: RecoveryEnvelope } | null {
+  if (bytes.length < MAGIC.length + 4) return null;
+  for (let i = 0; i < MAGIC.length; i++) if (bytes[i] !== MAGIC[i]) return null;
+  const headerLength = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength).getUint32(MAGIC.length, false);
+  const start = MAGIC.length + 4;
+  if (headerLength < 2 || headerLength > MAX_HEADER || start + headerLength >= bytes.length) return null;
+  let parsed: any;
+  try {
+    parsed = JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes.subarray(start, start + headerLength)));
+  } catch {
+    return null;
+  }
+  if (!parsed || typeof parsed !== 'object' || !isBytes(parsed.salt, 16) || !isBytes(parsed.iv, 12)) return null;
+  const protection = {
+    version: parsed.version,
+    scheme: parsed.scheme,
+    iterations: parsed.iterations,
+    salt: Uint8Array.from(parsed.salt),
+    iv: Uint8Array.from(parsed.iv),
+    epoch: parsed.epoch,
+    revision: parsed.revision,
+  } as RecoveryEnvelope;
+  return { data: bytes.slice(start + headerLength), protection };
+}
diff --git a/rhwp-studio/src/hwpxxx/android-host.ts b/rhwp-studio/src/hwpxxx/android-host.ts
