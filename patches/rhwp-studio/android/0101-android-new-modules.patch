+// Portable synthetic specimens: real pinned WASM + verifier, ZIP edits in memory.
+// No user documents, binary fixtures, network, or non-Node build dependencies.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { inflateRawSync } from 'node:zlib';
+import { verifyReopenedDocument } from '../src/hwpxxx/android-save-verify.ts';
+const core = await import('../../pkg/rhwp.js');
+await core.default({ module_or_path: readFileSync(new URL('../../pkg/rhwp_bg.wasm', import.meta.url)) });
+type Format = 'hwp' | 'hwpx';
+function blank(): any {
+  const d = core.HwpDocument.createEmpty(); d.createBlankDocument(); d.insertText(0, 0, 0, 'body'); d.setFileName('a.hwp'); return d;
+}
+function exported(d: any, format: Format = 'hwpx'): Uint8Array {
+  const ex = format === 'hwp' ? d.exportHwpWithReport() : d.exportHwpxWithReport();
+  try { assert.equal(JSON.parse(ex.contentLoss()).count, 0); return ex.takeBytes(); } finally { ex.free(); }
+}
+function entries(bytes: Uint8Array): Array<[string, Buffer]> {
+  const b = Buffer.from(bytes); let end = b.length - 22;
+  while (end >= 0 && b.readUInt32LE(end) !== 0x06054b50) end--;
+  assert.ok(end >= 0); const count = b.readUInt16LE(end + 10); let cursor = b.readUInt32LE(end + 16);
+  const result: Array<[string, Buffer]> = [];
+  for (let i = 0; i < count; i++) {
+    assert.equal(b.readUInt32LE(cursor), 0x02014b50);
+    const method = b.readUInt16LE(cursor + 10), size = b.readUInt32LE(cursor + 20), nl = b.readUInt16LE(cursor + 28), local = b.readUInt32LE(cursor + 42);
+    const name = b.toString('utf8', cursor + 46, cursor + 46 + nl), start = local + 30 + b.readUInt16LE(local + 26) + b.readUInt16LE(local + 28);
+    const data = b.subarray(start, start + size); assert.ok(method === 0 || method === 8);
+    result.push([name, method === 8 ? inflateRawSync(data) : data]);
+    cursor += 46 + nl + b.readUInt16LE(cursor + 30) + b.readUInt16LE(cursor + 32);
+  }
+  return result;
+}
+function crc32(data: Uint8Array): number {
+  let crc = 0xffffffff;
+  for (const byte of data) { crc ^= byte; for (let i = 0; i < 8; i++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0); }
+  return (crc ^ 0xffffffff) >>> 0;
+}
+function zip(parts: Array<[string, Buffer]>): Uint8Array {
+  const locals: Buffer[] = [], central: Buffer[] = []; let offset = 0;
+  for (const [name, data] of parts) {
+    const n = Buffer.from(name), crc = crc32(data), h = Buffer.alloc(30), c = Buffer.alloc(46);
+    h.writeUInt32LE(0x04034b50); h.writeUInt16LE(20, 4); h.writeUInt32LE(crc, 14); h.writeUInt32LE(data.length, 18); h.writeUInt32LE(data.length, 22); h.writeUInt16LE(n.length, 26);
+    c.writeUInt32LE(0x02014b50); c.writeUInt16LE(20, 4); c.writeUInt16LE(20, 6); c.writeUInt32LE(crc, 16); c.writeUInt32LE(data.length, 20); c.writeUInt32LE(data.length, 24); c.writeUInt16LE(n.length, 28); c.writeUInt32LE(offset, 42);
+    locals.push(h, n, data); central.push(c, n); offset += h.length + n.length + data.length;
+  }
+  const directory = Buffer.concat(central), end = Buffer.alloc(22); end.writeUInt32LE(0x06054b50); end.writeUInt16LE(parts.length, 8); end.writeUInt16LE(parts.length, 10); end.writeUInt32LE(directory.length, 12); end.writeUInt32LE(offset, 16);
+  return Buffer.concat([...locals, directory, end]);
+}
+function edited(bytes: Uint8Array, edit: (xml: string) => string): Uint8Array {
+  return zip(entries(bytes).map(([name, data]) => [name, name === 'Contents/section0.xml' ? Buffer.from(edit(data.toString())) : data]));
+}
+function section(bytes: Uint8Array): string { return entries(bytes).find(([name]) => name === 'Contents/section0.xml')![1].toString(); }
+function pathSource(): Uint8Array {
+  const d = blank(); d.createHeaderFooter(0, true, 0); d.insertFieldInHf(0, true, 0, 0, 0, 3);
+  try { return exported(d); } finally { d.free(); }
+}
+function check(live: any, re: any, bytes: Uint8Array): void {
+  verifyReopenedDocument(live, re, bytes.length, { crossFormat: true });
+}
+function roundTrip(bytes: Uint8Array, format: Format): void {
+  const live = new core.HwpDocument(bytes), out = exported(live, format), re = new core.HwpDocument(out);
+  const before = exported(live);
+  try { check(live, re, out); assert.deepEqual(exported(live), before, 'verification leaves live export unchanged'); }
+  finally { live.free(); re.free(); }
+}
+function paragraph(xml: string): string {
+  const start = xml.indexOf('<hp:p '); assert.ok(start >= 0); let depth = 0;
+  for (const m of xml.slice(start).matchAll(/<\/?hp:p(?=[\s>])[^>]*>/g)) {
+    depth += m[0].startsWith('</') ? -1 : 1;
+    if (depth === 0) return xml.slice(start, start + m.index! + m[0].length);
+  }
+  throw new Error('missing body paragraph close');
+}
+function repeated(bytes: Uint8Array, header: boolean): Uint8Array {
+  return edited(bytes, xml => {
+    const p = paragraph(xml), duplicate = p.replace(/<hp:secPr\b[\s\S]*?<\/hp:secPr>/, '');
+    const name = header ? 'header' : 'footer'; assert.ok(duplicate.includes(`<hp:${name} `));
+    return xml.replace('</hs:sec>', duplicate + duplicate + '</hs:sec>');
+  });
+}
+for (const format of ['hwp', 'hwpx'] as const) {
+  test(`F1: ${format} 14300-cell table and plain footer exceeds old 8 MiB XML cap faithfully`, () => {
+    const live = blank(); live.createTable(0, 0, 4, 1300, 11); live.createHeaderFooter(0, false, 0); live.insertTextInHeaderFooter(0, false, 0, 0, 0, 'plain footer text');
+    const evidence = exported(live); assert.ok(section(evidence).length > 8 * 1024 * 1024); assert.ok(evidence.length < 256 * 1024);
+    const out = exported(live, format), re = new core.HwpDocument(out);
+    try { check(live, re, out); } finally { live.free(); re.free(); }
+  });
+  for (const header of [true, false]) test(`F2: ${format} repeated same-scope ${header ? 'headers' : 'footers'} survive`, () => {
+    const d = blank(); d.createHeaderFooter(0, header, 0); d.insertFieldInHf(0, header, 0, 0, 0, 3);
+    try { roundTrip(repeated(exported(d), header), format); } finally { d.free(); }
+  });
+  test(`F2: ${format} different scopes may be canonically regrouped while each scope stays ordered`, () => {
+    for (const reverse of [false, true]) {
+      const live = blank(); const scopes: Array<[boolean, number]> = [[true, 2], [false, 0], [true, 0], [false, 1], [true, 1], [false, 2]];
+      if (reverse) scopes.reverse();
+      for (const [header, applyTo] of scopes) { live.createHeaderFooter(0, header, applyTo); live.insertFieldInHf(0, header, applyTo, 0, 0, 3); }
+      const out = exported(live, format), re = new core.HwpDocument(out);
+      try { check(live, re, out); } finally { live.free(); re.free(); }
+    }
+  });
+  test(`F3: ${format} PATH Command=$P is preserved and accepted`, () => {
+    roundTrip(edited(pathSource(), xml => xml.replace('name="Command">$F<', 'name="Command">$P<')), format);
+  });
+  test(`F2: ${format} changed/reordered later same-scope occurrences are refused`, () => {
+    const bytes = repeated(pathSource(), true);
+    const original = edited(bytes, xml => { let n = 0; return xml.replace(/name="Command">\$F</g, () => `name="Command">${['$F', '$P', '$P$F'][n++]}<`); });
+    const live = new core.HwpDocument(original);
+    for (const commands of [['$F', '$P$F', '$P'], ['$F', '$P', '$F']]) {
+      const changed = edited(original, xml => { let n = 0; return xml.replace(/name="Command">[^<]*</g, () => `name="Command">${commands[n++]}<`); });
+      const other = new core.HwpDocument(changed), out = exported(other, format), re = new core.HwpDocument(out);
+      try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); }
+      finally { other.free(); re.free(); }
+    }
+    live.free();
+  });
+  test(`F3: ${format} changed PATH Command is refused even with the same rendered text`, () => {
+    const source = pathSource(), live = new core.HwpDocument(source), changed = new core.HwpDocument(edited(source, xml => xml.replace('name="Command">$F<', 'name="Command">$P<')));
+    const out = exported(changed, format), re = new core.HwpDocument(out);
+    try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); } finally { live.free(); changed.free(); re.free(); }
+  });
+}
+test('F1: body beyond 250000 XML nodes does not spend the HF node budget', () => {
+  const live = blank(); live.createTable(0, 0, 4, 2500, 11); live.createHeaderFooter(0, false, 0); live.insertTextInHeaderFooter(0, false, 0, 0, 0, 'footer');
+  const bytes = exported(live); assert.ok([...section(bytes).matchAll(/<[^>]*>|[^<]+/g)].length > 250000);
+  const re = new core.HwpDocument(bytes); try { check(live, re, bytes); } finally { live.free(); re.free(); }
+});
+test('F3: nondefault PATH Format=$P$F is faithful in HWPX and accepted', () => {
+  roundTrip(edited(pathSource(), xml => xml.replace('name="Format">$F<', 'name="Format">$P$F<')), 'hwpx');
+});
+test('F3: HWP drops nondefault PATH Format and must still refuse', () => {
+  const source = edited(pathSource(), xml => xml.replace('name="Format">$F<', 'name="Format">$P$F<'));
+  const live = new core.HwpDocument(source), out = exported(live, 'hwp'), re = new core.HwpDocument(out);
+  assert.ok(section(exported(live)).includes('name="Format">$P$F<'));
+  assert.ok(!section(exported(re)).includes('name="Format">$P$F<'));
+  try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); } finally { live.free(); re.free(); }
+});
+test('F3: changed nondefault PATH Format is refused in HWPX', () => {
+  const source = edited(pathSource(), xml => xml.replace('name="Format">$F<', 'name="Format">$P$F<'));
+  const live = new core.HwpDocument(source), changed = new core.HwpDocument(edited(source, xml => xml.replace('name="Format">$P$F<', 'name="Format">$P<'))), out = exported(changed), re = new core.HwpDocument(out);
+  try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); } finally { live.free(); changed.free(); re.free(); }
+});
+// Evidence faults are injected through export only; every other API is the actual document.
+function evidence(d: any, bytes: Uint8Array): any {
+  return new Proxy(d, { get(t, k) { if (k === 'exportHwpxWithReport') return () => ({ takeBytes: () => bytes, free() {} }); const v = Reflect.get(t, k); return typeof v === 'function' ? v.bind(t) : v; } });
+}
+test('bounded evidence refuses oversized decoded XML with an honest limit reason', () => {
+  const live = new core.HwpDocument(pathSource()), bytes = exported(live), re = new core.HwpDocument(bytes), bad = Buffer.from(bytes);
+  const end = bad.length - 22; let p = bad.readUInt32LE(end + 16);
+  while (!bad.toString('utf8', p + 46, p + 46 + bad.readUInt16LE(p + 28)).startsWith('Contents/section0.xml')) p += 46 + bad.readUInt16LE(p + 28) + bad.readUInt16LE(p + 30) + bad.readUInt16LE(p + 32);
