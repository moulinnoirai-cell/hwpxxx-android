+    assert.deepEqual(JSON.parse(new TextDecoder().decode(stored.data)), snap, 'payload is the UTF-8 JSON of the upstream snapshot');
+    assert.equal(stored.meta.storageKind, 'ir'); assert.equal(stored.meta.byteLength, stored.data.byteLength); assert.equal(stored.meta.sourceFileName, '문서.hwp');
+    assert.deepEqual(Object.keys(stored.meta).sort(), ['byteLength', 'createdAt', 'id', 'label', 'sourceFileName', 'storageKind']);
+    assert.equal(historyVolatileReason(meta.id), undefined);
+    assert.deepEqual((await listHistoryMeta()).map((m) => m.id), [meta.id]);
+    assert.deepEqual(await getHistoryPayload(meta.id), { kind: 'ir', snapshot: snap });
+    assert.equal(await getHistoryPayload('nope'), null);
+    await deleteHistorySnapshot(meta.id); assert.equal(host.rows.size, 0);
+    await saveHistoryIrSnapshot('a', 'a.hwp', snapshot(1)); await clearHistory(); assert.equal(host.rows.size, 0);
+    assert.deepEqual(touched, [], 'no IndexedDB / localStorage access');
+  } finally { unguardGlobals(); }
+});
+
+test('Android: at most 24 snapshots are kept (oldest deleted through the host), size bounds refuse before any native call', async () => {
+  guardGlobals(); const host = memoryHistory(); g.AndroidStudioHost = { history: host };
+  try {
+    for (let i = 0; i < 26; i++) { await saveHistoryIrSnapshot('s' + i, 'a.hwp', snapshot(i)); await new Promise((r) => setTimeout(r, 2)); }
+    assert.equal(host.rows.size, 24);
+    const labels = [...host.rows.values()].map((r) => r.meta.label); assert.equal(labels.includes('s0'), false); assert.equal(labels.includes('s25'), true);
