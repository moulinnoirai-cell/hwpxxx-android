+++ b/rhwp-studio/tests/support/android-workspace-routing.runner.mjs
@@ -0,0 +1,135 @@
+// [hwpxxx-android] 작업 공간 라우팅 러너: 실제 file.ts 명령을 합성 호스트(AndroidStudioHost.workspace)로 실행한다.
+// file.ts 가 끌어오는 UI 모듈의 매개변수 속성 때문에 부모 시험이 --experimental-transform-types 로 띄운다.
+// 문서·핸들은 모두 합성 값이다.
+import { registerHooks } from 'node:module';
+import { pathToFileURL, fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+import assert from 'node:assert/strict';
+
+const srcDir = join(dirname(fileURLToPath(import.meta.url)), '..', '..', 'src');
+const WASM_ENTRY_STUB = 'data:text/javascript,export default async function init() {}'
+  + ' export class HwpDocument {} export function version() { return "0"; }';
+registerHooks({
+  resolve(specifier, context, nextResolve) {
+    if (specifier === '@wasm/rhwp.js') return { url: WASM_ENTRY_STUB, shortCircuit: true };
+    if (specifier.startsWith('@/')) {
+      const abs = join(srcDir, specifier.slice(2));
+      return { url: pathToFileURL(abs.endsWith('.ts') ? abs : abs + '.ts').href, shortCircuit: true };
+    }
+    if ((specifier.startsWith('./') || specifier.startsWith('../')) && !/\.[cm]?[tj]s$/.test(specifier)) {
+      const parent = context.parentURL ? dirname(fileURLToPath(context.parentURL)) : srcDir;
+      return { url: pathToFileURL(join(parent, specifier + '.ts')).href, shortCircuit: true };
+    }
+    return nextResolve(specifier, context);
+  },
+});
+
+// 토스트가 쓰는 최소 DOM: 안내 문구를 모은다.
+const toasts = [];
+const node = () => {
+  const el = { style: {}, children: [], setAttribute() {}, appendChild(child) { this.children.push(child); }, addEventListener() {}, remove() {}, classList: { add() {}, remove() {} } };
+  Object.defineProperty(el, 'textContent', { set(value) { toasts.push(String(value)); }, get() { return ''; } });
+  return el;
+};
+globalThis.document = { getElementById: () => null, createElement: () => node(), body: node() };
+globalThis.requestAnimationFrame = (callback) => setTimeout(callback, 0);
+globalThis.window = globalThis;
+const { fileCommands } = await import(pathToFileURL(join(srcDir, 'command', 'commands', 'file.ts')).href);
+const command = (id) => fileCommands.find((c) => c.id === id);
+const flush = async () => { for (let i = 0; i < 10; i++) await Promise.resolve(); await new Promise((r) => setTimeout(r, 0)); };
+
+function setup(workspace, recents = []) {
+  const calls = [], emitted = [];
+  globalThis.AndroidStudioHost = {
+    ...(workspace ? { workspace: { version: 1,
+      newDocument: async () => { calls.push('new'); return true; },
+      openDocument: async () => { calls.push('open'); return true; },
+      openRecent: async (id) => { calls.push('recent:' + id); return true; },
+      ...workspace } } : {}),
+    recent: { list: async () => recents, open: async () => { throw new DOMException('gone', 'NotFoundError'); }, remove: async () => {} },
+  };
+  toasts.length = 0;
+  return { calls, emitted, services: { wasm: {}, eventBus: { emit: (name) => { emitted.push(name); } }, getContext: () => ({ hasDocument: false, isDirty: false }) } };
+}
+let pickerCalls = 0;
+globalThis.showOpenFilePicker = async () => { pickerCalls++; throw new DOMException('cancel', 'AbortError'); };
+let verified = 0;
+const ok = (name, fn) => Promise.resolve(fn()).then(() => { verified++; }, (error) => { console.error('FAIL:', name); throw error; });
+
+await ok('new: workspace tab only', async () => {
+  const r = setup({ enabled: true });
+  command('file:new-doc').execute(r.services); await flush();
+  assert.deepEqual(r.calls, ['new']); assert.deepEqual(r.emitted, []);
+});
+await ok('new: disabled/absent => legacy event synchronously', async () => {
+  for (const workspace of [{ enabled: false }, undefined]) {
+    const r = setup(workspace);
+    command('file:new-doc').execute(r.services);
+    assert.deepEqual(r.emitted, ['create-new-document']); assert.deepEqual(r.calls, []);
+  }
+});
+await ok('new: host false => legacy; host error => toast, no in-place replace', async () => {
+  let r = setup({ enabled: true, newDocument: async () => false });
