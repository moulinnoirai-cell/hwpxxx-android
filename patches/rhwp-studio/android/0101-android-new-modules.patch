--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-field-save.test.ts
@@ -0,0 +1,82 @@
+// Real pinned WASM + real verifier. No SVG/text-only stand-in for field semantics.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { verifyReopenedDocument } from '../src/hwpxxx/android-save-verify.ts';
+const core = await import('../../pkg/rhwp.js');
+await core.default({ module_or_path: readFileSync(new URL('../../pkg/rhwp_bg.wasm', import.meta.url)) });
+type Part = string | number;
+function make(parts: Part[] | null, header = true, applyTo = 0): any {
+  const d = core.HwpDocument.createEmpty(); d.createBlankDocument(); d.insertText(0, 0, 0, 'same body'); d.setFileName('검증 & review.hwp');
+  if (parts !== null) {
+    d.createHeaderFooter(0, header, applyTo); let offset = 0;
+    for (const part of parts) {
+      if (typeof part === 'number') { d.insertFieldInHf(0, header, applyTo, 0, offset, part); offset += 1; }
+      else { d.insertTextInHeaderFooter(0, header, applyTo, 0, offset, part); offset += Array.from(part).length; }
+    }
+  }
+  return d;
+}
+function exported(d: any, format: 'hwp' | 'hwpx'): Uint8Array {
+  const ex = format === 'hwp' ? d.exportHwpWithReport() : d.exportHwpxWithReport();
+  try { assert.equal(JSON.parse(ex.contentLoss()).count, 0); return ex.takeBytes(); } finally { ex.free(); }
+}
+function verify(live: any, reopened: any, bytes: Uint8Array, format: string): void {
+  verifyReopenedDocument(live, reopened, bytes.length, { crossFormat: format !== 'hwp' });
+}
+for (const format of ['hwp', 'hwpx'] as const) {
+  for (const header of [true, false]) for (const applyTo of [0, 1, 2]) for (const kind of [1, 2, 3]) {
+    test(`valid ${format} ${header ? 'header' : 'footer'} scope ${applyTo}, field ${kind}`, () => {
+      const live = make(['앞 & <', kind, '> 뒤'], header, applyTo);
+      const before = live.getHeaderFooterParaInfo(0, header, applyTo, 0);
+      const bytes = exported(live, format), re = new core.HwpDocument(bytes);
+      try {
+        verify(live, re, bytes, format);
+        assert.equal(live.getHeaderFooterParaInfo(0, header, applyTo, 0), before, 'verification does not change live header text');
+        // A later generation has no live marker characters, but still checks actual serialized fields.
+        const again = exported(re, format), re2 = new core.HwpDocument(again);
+        try { verify(re, re2, again, format); } finally { re2.free(); }
+      } finally { live.free(); re.free(); }
+    });
+  }
+  const changes: Array<[string, Part[], Part[] | null]> = [
+    ['PAGE becomes TOTAL_PAGE with identical one-page glyph', [1], [2]],
+    ['TOTAL_PAGE becomes PAGE with identical one-page glyph', [2], [1]],
+    ['field order changes although one-page text stays 1-1', [1, '-', 2], [2, '-', 1]],
+    ['literal header text changes', ['A', 1, 'B'], ['A', 1, 'C']],
+    ['literal text reorders with the same glyph multiset', ['A', 1, 'B'], ['B', 1, 'A']],
+    ['field becomes literal space', [1], [' ']],
+    ['field becomes literal rendered number', [1], ['1']],
+    ['filename becomes its literal rendered text', [3], ['검증 & review.hwp']],
+    ['field disappears', ['A', 1, 'B'], ['AB']],
+    ['entire header disappears', [1], null],
+  ];
+  for (const [name, a, b] of changes) test(`refuse ${format}: ${name}`, () => {
+    const live = make(a), other = make(b), bytes = exported(other, format), re = new core.HwpDocument(bytes);
+    try { assert.throws(() => verify(live, re, bytes, format), /달라|검증 정보/); }
+    finally { live.free(); other.free(); re.free(); }
+  });
+  test(`refuse ${format}: existing reopened field kind changes`, () => {
+    const source = make([1]), changed = make([2]);
+    const a = exported(source, format), b = exported(changed, format), live = new core.HwpDocument(a), re = new core.HwpDocument(b);
+    try { assert.throws(() => verify(live, re, b, format), /필드 종류/); }
+    finally { source.free(); changed.free(); live.free(); re.free(); }
+  });
+  test(`refuse ${format}: field paragraph and character formatting still checked`, () => {
+    const live = make(['ABC', 1, 'DEF']), bytes = exported(live, format), re = new core.HwpDocument(bytes);
+    try {
+      re.applyCharFormatInHeaderFooter(0, true, 0, 0, 4, 0, 6, JSON.stringify({ bold: true }));
+      assert.throws(() => verify(live, re, bytes, format), /글자 서식/);
+    } finally { live.free(); re.free(); }
+  });
+}
+test('semantic evidence is mandatory and failure is closed; exported handle always freed', () => {
+  const live = make([1]), bytes = exported(live, 'hwp'), re = new core.HwpDocument(bytes); let freed = 0;
+  const missing = new Proxy(live, { get(t, k) { if (k === 'exportHwpxWithReport') return undefined; const v = Reflect.get(t, k); return typeof v === 'function' ? v.bind(t) : v; } });
+  const invalid = new Proxy(live, { get(t, k) { if (k === 'exportHwpxWithReport') return () => ({ takeBytes: () => new Uint8Array(22), free: () => { freed += 1; } }); const v = Reflect.get(t, k); return typeof v === 'function' ? v.bind(t) : v; } });
+  try {
+    assert.throws(() => verify(missing, re, bytes, 'hwp'), /검증 정보/);
+    assert.throws(() => verify(invalid, re, bytes, 'hwp'), /검증 정보/);
+    assert.equal(freed, 1);
+  } finally { live.free(); re.free(); }
+});
