+// Portable synthetic specimens: real pinned WASM + verifier, ZIP edits in memory.
+// No user documents, binary fixtures, network, or non-Node build dependencies.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { inflateRawSync } from 'node:zlib';
+import { verifyReopenedDocument } from '../src/hwpxxx/android-save-verify.ts';
+const core = await import('../../pkg/rhwp.js');
+await core.default({ module_or_path: readFileSync(new URL('../../pkg/rhwp_bg.wasm', import.meta.url)) });
+type Format = 'hwp' | 'hwpx';
+function blank(): any {
+  const d = core.HwpDocument.createEmpty(); d.createBlankDocument(); d.insertText(0, 0, 0, 'body'); d.setFileName('a.hwp'); return d;
+}
+function exported(d: any, format: Format = 'hwpx'): Uint8Array {
+  const ex = format === 'hwp' ? d.exportHwpWithReport() : d.exportHwpxWithReport();
+  try { assert.equal(JSON.parse(ex.contentLoss()).count, 0); return ex.takeBytes(); } finally { ex.free(); }
+}
+function entries(bytes: Uint8Array): Array<[string, Buffer]> {
+  const b = Buffer.from(bytes); let end = b.length - 22;
+  while (end >= 0 && b.readUInt32LE(end) !== 0x06054b50) end--;
+  assert.ok(end >= 0); const count = b.readUInt16LE(end + 10); let cursor = b.readUInt32LE(end + 16);
+  const result: Array<[string, Buffer]> = [];
+  for (let i = 0; i < count; i++) {
+    assert.equal(b.readUInt32LE(cursor), 0x02014b50);
+    const method = b.readUInt16LE(cursor + 10), size = b.readUInt32LE(cursor + 20), nl = b.readUInt16LE(cursor + 28), local = b.readUInt32LE(cursor + 42);
+    const name = b.toString('utf8', cursor + 46, cursor + 46 + nl), start = local + 30 + b.readUInt16LE(local + 26) + b.readUInt16LE(local + 28);
+    const data = b.subarray(start, start + size); assert.ok(method === 0 || method === 8);
+    result.push([name, method === 8 ? inflateRawSync(data) : data]);
+    cursor += 46 + nl + b.readUInt16LE(cursor + 30) + b.readUInt16LE(cursor + 32);
+  }
+  return result;
+}
+function crc32(data: Uint8Array): number {
+  let crc = 0xffffffff;
+  for (const byte of data) { crc ^= byte; for (let i = 0; i < 8; i++) crc = (crc >>> 1) ^ (crc & 1 ? 0xedb88320 : 0); }
+  return (crc ^ 0xffffffff) >>> 0;
+}
