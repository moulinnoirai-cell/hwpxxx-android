+    for (const reverse of [false, true]) {
+      const live = blank(); const scopes: Array<[boolean, number]> = [[true, 2], [false, 0], [true, 0], [false, 1], [true, 1], [false, 2]];
+      if (reverse) scopes.reverse();
+      for (const [header, applyTo] of scopes) { live.createHeaderFooter(0, header, applyTo); live.insertFieldInHf(0, header, applyTo, 0, 0, 3); }
+      const out = exported(live, format), re = new core.HwpDocument(out);
+      try { check(live, re, out); } finally { live.free(); re.free(); }
+    }
+  });
+  test(`F3: ${format} PATH Command=$P is preserved and accepted`, () => {
+    roundTrip(edited(pathSource(), xml => xml.replace('name="Command">$F<', 'name="Command">$P<')), format);
+  });
+  test(`F2: ${format} changed/reordered later same-scope occurrences are refused`, () => {
+    const bytes = repeated(pathSource(), true);
+    const original = edited(bytes, xml => { let n = 0; return xml.replace(/name="Command">\$F</g, () => `name="Command">${['$F', '$P', '$P$F'][n++]}<`); });
+    const live = new core.HwpDocument(original);
+    for (const commands of [['$F', '$P$F', '$P'], ['$F', '$P', '$F']]) {
+      const changed = edited(original, xml => { let n = 0; return xml.replace(/name="Command">[^<]*</g, () => `name="Command">${commands[n++]}<`); });
+      const other = new core.HwpDocument(changed), out = exported(other, format), re = new core.HwpDocument(out);
+      try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); }
+      finally { other.free(); re.free(); }
+    }
+    live.free();
+  });
+  test(`F3: ${format} changed PATH Command is refused even with the same rendered text`, () => {
+    const source = pathSource(), live = new core.HwpDocument(source), changed = new core.HwpDocument(edited(source, xml => xml.replace('name="Command">$F<', 'name="Command">$P<')));
+    const out = exported(changed, format), re = new core.HwpDocument(out);
+    try { assert.throws(() => check(live, re, out), /필드 종류·순서·내용/); } finally { live.free(); changed.free(); re.free(); }
