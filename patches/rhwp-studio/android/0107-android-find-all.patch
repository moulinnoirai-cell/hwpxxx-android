+/* [hwpxxx] 모두 찾기 — hwpxxx/find-all.ts */
+.hwpxxx-find-all { border-top: 1px solid var(--color-primary-subtle, #d0d7e2); padding: 6px 8px 8px; }
+.hwpxxx-find-all[hidden] { display: none; }
+.hwpxxx-find-all-summary { font-size: var(--font-size-sm, 12px); color: var(--color-text-secondary, #555); padding: 2px 2px 6px; }
+.hwpxxx-find-all-list { list-style: none; margin: 0; padding: 0; max-height: min(40vh, 320px); overflow-y: auto; overscroll-behavior: contain; }
+.hwpxxx-find-all-list:empty { display: none; }
+.hwpxxx-find-all-list > li { display: flex; gap: 8px; align-items: baseline; padding: 7px 6px; border-radius: 4px; cursor: pointer; }
+.hwpxxx-find-all-list > li:hover, .hwpxxx-find-all-list > li:focus-visible { background: var(--color-primary-subtle, #e6eefb); outline: none; }
+.hwpxxx-find-all-list > li.current { background: var(--color-primary-subtle, #e6eefb); font-weight: 600; }
+.hwpxxx-find-all-page { flex: 0 0 3.2em; text-align: right; color: var(--color-text-muted, #777); font-size: var(--font-size-sm, 12px); white-space: nowrap; }
+.hwpxxx-find-all-text { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.hwpxxx-find-all-text > mark { background: #ffe58a; color: inherit; padding: 0 1px; border-radius: 2px; }
+/* 스크롤바가 읽는 자리 표시: 화면에는 보이지 않는다. */
+.hwpxxx-find-marks { position: absolute; left: 0; top: 0; width: 0; height: 0; pointer-events: none; }
+.hwpxxx-find-hit { position: absolute; left: 0; width: 1px; height: 1px; visibility: hidden; }
