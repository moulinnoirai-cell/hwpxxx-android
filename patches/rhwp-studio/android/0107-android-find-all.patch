diff --git a/rhwp-studio/tests/hwpxxx-find-all.test.ts b/rhwp-studio/tests/hwpxxx-find-all.test.ts
new file mode 100644
index 0000000..c880cc1
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-find-all.test.ts
@@ -0,0 +1,54 @@
+// [hwpxxx] 모두 찾기: 앞뒤 글 자르기, 칸 안 경로, 대화상자·스크롤바 연결.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+import { snippetParts, snippetWindow, hitSteps, MAX_FIND_ALL_ROWS } from '../src/hwpxxx/find-all-text.ts';
+
+test('앞뒤 글 범위: 찾은 글 앞뒤로 정해진 글자 수만 가져온다', async () => {
+  assert.deepEqual(snippetWindow(100, 3, 16), { from: 84, count: 35 });
+  assert.deepEqual(snippetWindow(5, 2, 16), { from: 0, count: 23 });
+  assert.deepEqual(snippetWindow(0, 4, 16), { from: 0, count: 20 });
+});
+
+test('앞뒤 글: 찾은 글을 가르고, 잘린 쪽에만 말줄임표를 붙이며, 제어 문자는 빈칸으로 바꾼다', async () => {
+  // 문단 전체가 조각 안에 들어온 경우
+  assert.deepEqual(snippetParts('가나다 예산 라마바', 0, 4, 2, 10), { before: '가나다 ', match: '예산', after: ' 라마바' });
+  // 앞뒤가 모두 잘린 경우
+  assert.deepEqual(snippetParts('다 예산 라', 2, 4, 2, 10), { before: '…다 ', match: '예산', after: ' 라…' });
+  // 줄바꿈·탭
+  assert.deepEqual(snippetParts('가\n예산\t나', 0, 2, 2, 6), { before: '가 ', match: '예산', after: ' 나' });
+  // 보충 문자(이모지 등)도 글자 하나로 센다
+  assert.deepEqual(snippetParts('😀예산😀', 0, 1, 2, 4), { before: '😀', match: '예산', after: '😀' });
+  // 조각이 찾은 글에서 끝나는 경우(칸 안)
+  assert.deepEqual(snippetParts('앞글 예산', 0, 3, 2, 5), { before: '앞글 ', match: '예산', after: '' });
+});
+
+test('칸 안에서 찾은 곳은 전체 경로를, 없으면 한 단계 칸 정보를 쓴다', async () => {
+  assert.equal(hitSteps({ sec: 0, para: 1, charOffset: 0, length: 2 }), null);
+  assert.deepEqual(hitSteps({ sec: 0, para: 1, charOffset: 0, length: 2, cellContext: { parentPara: 1, ctrlIdx: 2, cellIdx: 3, cellPara: 4 } }), [{ controlIndex: 2, cellIndex: 3, cellParaIndex: 4 }]);
+  assert.deepEqual(hitSteps({ sec: 0, para: 1, charOffset: 0, length: 2, cellContext: { parentPara: 1, ctrlIdx: 2, cellIdx: 3, cellPara: 4 },
+    cellPath: [{ controlIndex: 2, cellIndex: 3, cellParaIndex: 0 }, { controlIndex: 0, cellIndex: 1, cellParaIndex: 4 }] }),
+    [{ controlIndex: 2, cellIndex: 3, cellParaIndex: 0 }, { controlIndex: 0, cellIndex: 1, cellParaIndex: 4 }]);
+});
+
+test('찾기 대화상자에 모두 찾기 단추와 목록을 붙이고, 닫으면 정리한다', () => {
+  const dialog = source('ui/find-dialog.ts');
+  assert.match(dialog, /const allBtn = this\.createButton\('모두 찾기', \(\) => this\.doFindAll\(\)\);/);
+  assert.match(dialog, /this\.wrap\.appendChild\(this\.findAll\.element\);/);
+  assert.match(dialog, /this\.currentHit = \{ found: true, \.\.\.hit \};\s+this\.navigateToHit\(this\.currentHit\);/);
+  assert.match(dialog, /this\.findAll\?\.dispose\(\);/);
+  const code = source('hwpxxx/find-all.ts');
+  assert.match(code, /wasm\.searchAllText\(query, caseSensitive, true\)/, '표 칸 안도 찾는다');
+  assert.match(code, /hits\.slice\(0, MAX_FIND_ALL_ROWS\)/);
+  assert.equal(MAX_FIND_ALL_ROWS, 300);
+  assert.match(code, /'document-mutated', 'document-changed', 'document-swapped', 'history-jumped'/, '편집하면 다시 찾는다');
+  assert.doesNotMatch(code, /replaceText|replaceAll|insertText/, '문서 내용을 바꾸지 않는다');
+});
+
