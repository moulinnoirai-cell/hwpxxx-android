+ * 글 안에서 offset 자리의 낱말 범위(글자 위치, UTF-16 아님: 문자 단위 배열 기준).
+ * 낱말 바로 뒤(빈칸 앞)를 눌렀으면 앞 낱말을 잡는다. 낱말이 아닌 곳(빈칸 줄)은 같은 종류가 이어진 범위를 잡는다.
+ */
+export function wordRangeAt(chars: readonly string[], offset: number): { start: number; end: number } | null {
+  if (!chars.length) return null;
+  let at = Math.max(0, Math.min(offset, chars.length - 1));
+  if (!isWordChar(chars[at]) && at > 0 && isWordChar(chars[at - 1])) at -= 1;
+  const word = isWordChar(chars[at]);
+  let start = at;
+  let end = at + 1;
+  while (start > 0 && isWordChar(chars[start - 1]) === word) start--;
+  while (end < chars.length && isWordChar(chars[end]) === word) end++;
+  return { start, end };
