+  const pending: any[] = [];
+  let updates = 0;
+  handler.stagePendingCharShape = (props: any) => pending.push(props);
+  handler.emitCursorFormatState = () => { updates++; };
+  handler.executeOperation = () => assert.fail('기존 글에 서식 명령을 적용하면 안 된다');
+  handler.applyCharPropsAtCursor({ fontSize: 1400 });
