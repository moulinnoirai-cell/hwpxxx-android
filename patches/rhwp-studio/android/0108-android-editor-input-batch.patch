+    dialog.onApply({ alignment: 'center', lineSpacing: 200 });
+    assert.deepEqual(calls, [mode === 'footnote' ? [2, 7, 3, 4] : [2, mode === 'header', 1, 4]]);
+    assert.equal(state().alignment, 'center');
+    const command = history.at(-1);
+    assert.equal(command.editContext().mode, mode === 'footnote' ? 'footnote' : 'headerFooter');
+    assert.equal(command.editContext().charOffset, 5);
+    command.undo(wasm);
