+    assert.equal(state().lineSpacing, 160);
+    command.execute(wasm);
+    assert.equal(state().alignment, 'center');
+    assert.equal(state().lineSpacing, 200);
+    assert.match(input, /desc\.editContext[\s\S]*?new SubmodeSnapshotCommand\(/);
