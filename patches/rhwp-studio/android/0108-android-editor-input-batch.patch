diff --git a/rhwp-studio/tests/hwpxxx-android-save-format.test.ts b/rhwp-studio/tests/hwpxxx-android-save-format.test.ts
new file mode 100644
index 0000000..ec5947d
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-save-format.test.ts
@@ -0,0 +1,70 @@
+// [hwpxxx-android] HWPX 저장: 저장할 파일의 확장자를 따르고, 저장 창에서 고른 형식으로 다시 내보낸다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+import { resolveSaveTarget } from '../src/command/save-target.ts';
+import { saveDocumentToFileSystem } from '../src/command/file-system-access.ts';
+
+function handle(name: string) {
+  const writes: Blob[] = [];
+  return {
+    writes,
+    kind: 'file' as const,
+    name,
+    async getFile() { return new File([], name); },
+    async createWritable() { return { async write(data: Blob) { writes.push(data); }, async close() {} }; },
+  };
+}
+
+test('Ctrl+S 는 지금 파일의 확장자를 따른다: HWP 문서를 HWPX 로 저장한 뒤에는 HWPX 로 저장한다', () => {
+  assert.equal(resolveSaveTarget('hwp', '보고서.hwpx', handle('보고서.hwpx')).format, 'hwpx');
+  assert.equal(resolveSaveTarget('hwpx', '보고서.hwp', handle('보고서.hwp')).format, 'hwp');
+  // 핸들이 없으면 예전처럼 원래 형식
+  assert.equal(resolveSaveTarget('hwp', '보고서.hwp', null).format, 'hwp');
+  assert.equal(resolveSaveTarget('hwpx', '보고서.hwpx', null).format, 'hwpx');
+  // HML 출처는 원래 흐름(변환 저장 핸들 표식이 있을 때만)
+  assert.equal(resolveSaveTarget('hml', '보고서.hml', handle('보고서.hwpx')).format, 'hml');
+});
+
+test('저장 창에서 다른 형식을 고르면 그 형식으로 다시 만든 바이트를 쓴다', async () => {
+  const picked = handle('보고서.hwpx');
+  let offered: unknown = null;
+  const converted: string[] = [];
+  const result = await saveDocumentToFileSystem({
+    blob: new Blob(['HWP-BYTES']),
+    suggestedName: '보고서.hwp',
+    currentHandle: null,
+    forceSaveAs: true,
+    saveFormat: 'hwp',
+    windowLike: { showSaveFilePicker: async (options) => { offered = options?.hwpxxxFormats; return picked; } },
+    convert: { formats: ['hwpx', 'hwp'], to: async (format) => { converted.push(format); return new Blob([`${format.toUpperCase()}-BYTES`]); } },
+  });
+  assert.deepEqual(offered, ['hwpx', 'hwp'], '저장 창에 고를 형식을 알린다');
+  assert.deepEqual(converted, ['hwpx']);
+  assert.equal(result.format, 'hwpx');
+  assert.equal(await picked.writes[0].text(), 'HWPX-BYTES');
+});
+
+test('같은 형식이면 다시 내보내지 않고, 변환을 주지 않은 저장은 예전처럼 확장자를 검사한다', async () => {
+  const same = handle('보고서.hwp');
+  let calls = 0;
+  const result = await saveDocumentToFileSystem({
+    blob: new Blob(['HWP-BYTES']), suggestedName: '보고서.hwp', currentHandle: null, forceSaveAs: true, saveFormat: 'hwp',
+    windowLike: { showSaveFilePicker: async () => same },
+    convert: { formats: ['hwpx', 'hwp'], to: async () => { calls++; return new Blob(['X']); } },
+  });
+  assert.equal(calls, 0);
+  assert.equal(result.format, 'hwp');
+  await assert.rejects(saveDocumentToFileSystem({
+    blob: new Blob(['HWP-BYTES']), suggestedName: '보고서.hwp', currentHandle: null, forceSaveAs: true, saveFormat: 'hwp',
+    windowLike: { showSaveFilePicker: async () => handle('보고서.hwpx') },
+  }), /\.hwp 확장자/);
+});
+
+test('새 문서의 첫 저장은 HWPX, 일반 "다른 이름으로 저장"만 형식을 고를 수 있다', () => {
+  const file = readFileSync(new URL('../src/command/commands/file.ts', import.meta.url), 'utf8');
+  assert.match(file, /function androidDefaultFormat\(services: CommandServices, format: SaveFormat, hasHandle: boolean\): SaveFormat \{\n  return isAndroidHost\(\) && format === 'hwp' && services\.wasm\.isNewDocument && !hasHandle \? 'hwpx' : format;/);
+  assert.match(file, /if \(format !== null\) await saveAsFormat\(services, format, true\);/);
+  assert.match(file, /\(saveResult as SaveDocumentResult\)\.format \?\? target\.format/);
+});
diff --git a/rhwp-studio/tests/hwpxxx-ime-recompose.test.ts b/rhwp-studio/tests/hwpxxx-ime-recompose.test.ts
new file mode 100644
index 0000000..bb1bc6d
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-ime-recompose.test.ts
@@ -0,0 +1,28 @@
+// [hwpxxx] 입력기가 캐럿 앞 낱말을 다시 조합할 때 글자가 겹치지 않게: 겹침 길이 판단과 편집기 연결.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { recomposedPrefixLength } from '../src/hwpxxx/ime-recompose.ts';
+
+test('캐럿 앞 낱말로 시작하는 조합은 그 길이만큼 다시 조합하는 것으로 본다', () => {
+  assert.equal(recomposedPrefixLength('21제', '21'), 2);          // 숫자 뒤 한글: "2121제" 가 되던 경우
+  assert.equal(recomposedPrefixLength('21ㅈ', '보고서 21'), 2);    // 빈칸 앞은 낱말이 아니다
+  assert.equal(recomposedPrefixLength('안녀', '안'), 1);           // 한 글자 + 새 글자
+  assert.equal(recomposedPrefixLength('21', '21'), 2);            // 새 글자 없이 다시 잡기만 해도 두 글자 이상이면
+});
+
+test('한 글자씩 조합하는 입력기와 새 낱말은 건드리지 않는다', () => {
+  assert.equal(recomposedPrefixLength('ㄱ', '가'), 0);
+  assert.equal(recomposedPrefixLength('2', '2'), 0);               // 같은 숫자를 또 누름
+  assert.equal(recomposedPrefixLength('ㅈ', '21'), 0);
+  assert.equal(recomposedPrefixLength('제', ''), 0);
+  assert.equal(recomposedPrefixLength('21제', '21 '), 0);          // 빈칸 뒤 새 낱말
+  assert.equal(recomposedPrefixLength('', '21'), 0);
+});
+
+test('편집기는 조합 첫 갱신에서만, 덮어쓰기·선택 삭제가 없을 때 앞 글자를 조합 구간에 넣는다', () => {
+  const code = readFileSync(new URL('../src/engine/input-handler-text.ts', import.meta.url), 'utf8');
+  assert.match(code, /this\._hwpxxxRecomposeCheck = !this\.cursor\.hasSelection\(\);/);
+  assert.match(code, /if \(!this\._compositionCovered && this\.compositionLength === 0 && !this\.compositionBodyLogical && text/);
+  assert.match(code, /this\._compositionCovered = prefix;/, '되돌리기는 덮어쓰기와 같이 원래 글자를 되살린다');
+});
diff --git a/rhwp-studio/tests/hwpxxx-input-batch.test.ts b/rhwp-studio/tests/hwpxxx-input-batch.test.ts
