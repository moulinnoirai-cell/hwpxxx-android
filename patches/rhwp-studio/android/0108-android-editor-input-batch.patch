+// [hwpxxx] DOM 이벤트 대역은 캡처 등록 여부와 동기 blur 재진입까지 재현한다.
+class Element {
+  value = '10.0';
+  listeners = new Map<string, Function[]>();
+  addEventListener(name: string, callback: Function) {
+    this.listeners.set(name, [...(this.listeners.get(name) ?? []), callback]);
+  }
+  fire(name: string, props: any = {}) {
+    const event = { key: '', target: this, preventDefault() {}, ...props };
+    for (const callback of this.listeners.get(name) ?? []) callback(event);
+  }
+}
+function sizeControls() {
+  const mouseListeners: any[] = [];
+  const document: any = { activeElement: null, addEventListener: (name: string, callback: Function, capture: boolean) => {
+    mouseListeners.push({ name, callback, capture });
+  } };
+  const handler = subject(toolbar, ['setupFontControls', 'updateState'], { document });
+  handler.fontSize = new Element();
+  handler.lastFontSize = '10.0';
+  handler.fontName = new Element(); handler.fontLang = new Element();
+  handler.btnSizeUp = new Element(); handler.btnSizeDown = new Element();
+  handler.populateFontSetOptions = () => {};
+  handler.setActive = () => {};
+  handler.getDisplayFontFamily = () => '';
+  handler.charfxMenu = { querySelectorAll: () => [] };
+  const emitted: any[] = [];
+  handler.eventBus = { emit: (name: string, props: any) => {
+    emitted.push({ name, props });
+    // [hwpxxx] 실제 format-char 수신부처럼 알림 후 포커스를 본문으로 옮긴다.
+    handler.updateState(props);
+    if (document.activeElement === handler.fontSize) {
+      document.activeElement = null;
+      handler.fontSize.fire('blur');
+    }
+  } };
+  handler.setupFontControls();
+  const enter = (value: string) => {
+    document.activeElement = handler.fontSize;
+    handler.fontSize.value = value;
+    handler.fontSize.fire('input');
+  };
+  return { handler, document, emitted, enter, mouseListeners };
+}
+
+for (const event of ['change', 'blur', 'keydown']) {
+  test(`크기 ${event}: 유효한 값을 한 번 적용하고 후속 change·blur는 중복 적용하지 않는다`, () => {
+    const { handler, emitted, enter } = sizeControls();
+    enter('12.34');
+    handler.fontSize.fire(event, { key: 'Enter' });
+    handler.fontSize.fire('change');
+    handler.fontSize.fire('blur');
+    assert.deepEqual(emitted, [{ name: 'format-char', props: { fontSize: 1234 } }]);
+    assert.equal(handler.fontSize.value, '12.34');
+  });
+}
+
+test('크기: 본문 클릭은 캐럿 이동 전에 기존 선택에 적용한다', () => {
+  const { handler, emitted, enter, mouseListeners } = sizeControls();
+  enter('15');
+  const listener = mouseListeners.find(entry => entry.name === 'mousedown');
+  assert.equal(listener.capture, true);
+  listener.callback({ target: handler.fontSize });
+  assert.equal(emitted.length, 0, '입력칸 내부 클릭은 확정하지 않는다');
+  listener.callback({ target: {} });
+  assert.deepEqual(emitted, [{ name: 'format-char', props: { fontSize: 1500 } }]);
+});
+
+test('크기: 잘못된 입력은 마지막 문서 값으로 복원하고 서식을 발행하지 않는다', () => {
+  const { handler, emitted, enter } = sizeControls();
+  handler.updateState({ fontSize: 1650 });
+  for (const invalid of ['', ' ', 'abc', '12pt', '12abc', 'Infinity', 'NaN', '0', '-2']) {
+    enter(invalid);
+    handler.fontSize.fire('change');
+    handler.fontSize.fire('blur');
+    assert.equal(handler.fontSize.value, '16.5', invalid);
