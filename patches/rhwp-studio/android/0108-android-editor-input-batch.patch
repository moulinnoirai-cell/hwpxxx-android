+// [hwpxxx] 블록(선택 영역) 편집: 바꿔 쓰기 되돌리기 한 번, ←·→ 로 블록 접기, Esc, Tab, 섞인 서식 토글, 두세 번 누르기, 서식 되돌리기 뒤 블록 유지.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { wordRangeAt, isWordChar } from '../src/hwpxxx/select-by-click.ts';
+
+const source = (path: string) => readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+
+test('낱말 범위: 낱말 위·낱말 바로 뒤·빈칸·한글', () => {
+  const chars = Array.from('alpha beta  gamma');
+  assert.deepEqual(wordRangeAt(chars, 7), { start: 6, end: 10 });   // beta 안
+  assert.deepEqual(wordRangeAt(chars, 10), { start: 6, end: 10 });  // beta 바로 뒤(빈칸 앞)
+  assert.deepEqual(wordRangeAt(chars, 11), { start: 10, end: 12 }); // 빈칸 두 칸
+  assert.deepEqual(wordRangeAt(Array.from('대한민국 만세'), 1), { start: 0, end: 4 });
+  assert.equal(wordRangeAt([], 0), null);
+  assert.equal(isWordChar('가'), true); assert.equal(isWordChar(','), false);
+});
+
+test('블록 위에 쓴 글·한글 조합·Enter·Tab 은 블록 지우기와 되돌리기 한 번으로 묶는다', () => {
+  const history = source('src/engine/history.ts');
+  assert.match(history, /export class JoinedCommand implements EditCommand/);
+  assert.match(history, /joinNextWithPrevious\(\): void \{\n    this\.joinBase = this\.undoStack\[this\.undoStack\.length - 1\] \?\? null;/);
+  assert.match(history, /if \(this\.takeJoin\(command\)\) \{/);
+  const handler = source('src/engine/input-handler.ts');
+  assert.match(handler, /private deleteSelectionForReplace\(\): boolean \{\n    const before = this\.history\.peekUndoTop\(\);\n    this\.deleteSelection\(\);\n    const after = this\.history\.peekUndoTop\(\);\n    if \(!after \|\| after === before\) return false;/, '지우기가 실제로 기록됐을 때만 묶는다');
+  assert.match(handler, /cmd\.discard\?\.\(this\.wasm\);/, '기록하지 않는 삭제의 복원 자료는 바로 돌려준다');
+  assert.equal((source('src/engine/input-handler-text.ts').match(/this\.deleteSelectionForReplace\(\);/g) ?? []).length, 2);
+  const keyboard = source('src/engine/input-handler-keyboard.ts');
+  assert.match(keyboard, /if \(this\.cursor\.hasSelection\(\)\) this\.deleteSelectionForReplace\(\);/);
+  assert.match(keyboard, /if \(this\.getNonEmptySelection\?\.\(\)\) this\.deleteSelectionForReplace\(\);\n      \/\/ 탭 문자 삽입/);
+  assert.match(history, /for \(let i = done - 1; i >= 0; i--\) \{ try \{ this\.parts\[i\]\.undo\(wasm\); \}/, '묶음 다시 실행이 중간에 실패하면 한 부분을 되돌린다');
+});
+
+test('←·→ 는 블록 시작·끝으로 접고, Esc 는 블록만 푼다', () => {
+  const keyboard = source('src/engine/input-handler-keyboard.ts');
+  assert.match(keyboard, /this\.cursor\.moveTo\(moveH === 1 \|\| moveV === 1 \? block\.end : block\.start\);/);
+  assert.match(keyboard, /if \(e\.key === 'Escape'\) \{\n    e\.preventDefault\(\);\n    \/\/ \[hwpxxx\][^\n]*\n[^\n]*\n    if \(this\.cursor\.hasSelection\(\) && this\.getNonEmptySelection\?\.\(\)\) \{/);
+});
+
+test('섞인 서식 블록에 토글하면 먼저 모두 켜고, 서식을 되돌려도 블록은 남는다', () => {
+  const handler = source('src/engine/input-handler.ts');
+  assert.match(handler, /const allOn = toggleBlock \? null : this\.selectionAllHave\(prop\);/);
+  assert.match(handler, /if \(!props\[prop\]\) return false;/);
+  const command = source('src/engine/command.ts');
+  assert.match(command, /selectionBefore\(\): EditSelectionSnapshot \| null \{ return \{ start: \{ \.\.\.this\.start \}, end: \{ \.\.\.this\.end \}, blockPhase: null \}; \}/);
+  assert.match(handler, /installClickSelection\(this, container\);/);
+});
+
+test('표: 칸 안 블록의 섞인 서식 토글, F5 한 칸에서 Shift+방향키로 넓히기, 셀 블록에 서식 단축키', () => {
+  const handler = source('src/engine/input-handler.ts');
+  assert.match(handler, /if \(start\.parentParaIndex !== undefined \|\| end\.parentParaIndex !== undefined\) return this\.cellSelectionAllHave\(prop, start, end\);/);
+  assert.match(handler, /this\.wasm\.getCharShapeRunsInCellByPath\(start\.sectionIndex, start\.parentParaIndex!, path, from, to\)/);
+  const keyboard = source('src/engine/input-handler-keyboard.ts');
+  assert.match(keyboard, /if \(phase === 2 \|\| \(phase === 1 && e\.shiftKey\)\) \{/);
+  assert.match(keyboard, /if \(cmdId && cmdId\.startsWith\('format:'\)\) \{\n        e\.preventDefault\(\);\n        this\.dispatcher\.dispatch\(cmdId\);/);
+});
diff --git a/rhwp-studio/tests/hwpxxx-format-fixes.test.ts b/rhwp-studio/tests/hwpxxx-format-fixes.test.ts
