+  const applied: any[] = [];
+  let focused = false;
+  class CharShapeDialog {
+    constructor() { dialog = this; }
+    show(props: any) { assert.deepEqual(props, initial); }
+  }
+  const handler = {
+    getCharProperties: () => initial, getSelection: () => null,
+    applyCharPropsAtCursor: (props: any) => applied.push(props), focus: () => { focused = true; },
+  };
+  dialogCommand('char-shape', { CharShapeDialog }).execute({
+    getInputHandler: () => handler, wasm: { findOrCreateFontId: () => 11 },
