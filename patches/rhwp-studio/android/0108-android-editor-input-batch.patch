+  assert.deepEqual(emitted, []);
+});
+
+test('크기: 범위 보정·백분의 일 pt·재입력·증감 버튼을 함께 처리한다', () => {
+  const { handler, emitted, enter } = sizeControls();
+  for (const [value, expected] of [['0.5', 100], ['9999', 409600], ['12.345', 1235], [' 14.5 ', 1450]]) {
+    enter(value);
+    handler.fontSize.fire('blur');
+    assert.equal(emitted.at(-1).props.fontSize, expected);
+  }
+  enter('14.5');
+  handler.fontSize.fire('change');
+  assert.equal(emitted.length, 5, '같은 값을 다시 입력하면 혼합 서식 블록도 통일한다');
+  handler.fontSize.fire('keydown', { key: 'Enter' });
+  assert.equal(emitted.length, 6, '기존 Enter 확정도 유지한다');
+  handler.btnSizeUp.fire('mousedown');
+  assert.equal(emitted.at(-1).props.fontSize, 1550);
+  handler.btnSizeDown.fire('mousedown');
+  assert.equal(emitted.at(-1).props.fontSize, 1450);
+  assert.equal(handler.fontSize.value, '14.5');
+});
+
+test('크기: 입력 중 커서 알림이 와도 편집값은 유지하고 잘못된 값의 복원 기준은 갱신한다', () => {
+  const { handler, enter, emitted } = sizeControls();
+  enter('잘못된 값');
