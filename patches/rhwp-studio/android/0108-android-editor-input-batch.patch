index 0000000..1d557ff
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/keep-arrows-in-document.ts
@@ -0,0 +1,42 @@
+/**
+ * [hwpxxx-android] 화살표 키는 본문 안에서만 움직인다.
+ *
+ * 태블릿에서 메뉴·도구 상자·서식 막대의 단추를 누르면 그 단추가 키보드 초점을 가질 수 있고, 이어서 누른 화살표 키가 본문 캐럿이 아니라
+ * 도구 상자 사이를 옮겨 다녔다(한글·워드는 단추를 누른 뒤에도 화살표가 본문 캐럿을 움직인다). 열린 메뉴·입력칸·목록 상자가 아닌
+ * 도구 단추에 초점이 있을 때 화살표 키를 받으면, 초점을 본문으로 돌리고 같은 키를 본문 입력기에 넘긴다.
+ * 네이티브 쪽(MainActivity.dispatchKeyEvent)은 페이지가 쓰지 않은 화살표 키로 Android 가 초점을 WebView 밖으로 옮기지 못하게 막는다.
+ */
+const ARROWS = new Set(['ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown']);
+const TOOL_AREAS = '#menu-bar, #icon-toolbar, #style-bar';
+/** 화살표가 원래 뜻대로 쓰여야 하는 곳: 열린 메뉴, 글·숫자 입력칸, 목록 상자, 대화상자. */
+const KEEP_NATIVE = 'input, select, textarea, [contenteditable=""], [contenteditable="true"], .menu-item.open, .menu-dropdown, [role="menu"], [role="listbox"], .dialog-wrap, .modal-overlay';
+
+export interface ArrowRedirectTarget {
+  /** 본문 입력기(숨은 textarea)로 초점을 돌린다. */
+  focus(): void;
+}
+
+/** 이 키 입력을 본문으로 돌려야 하는지(순수 판단, 시험용). */
+export function shouldRedirectArrow(event: Pick<KeyboardEvent, 'key' | 'ctrlKey' | 'altKey' | 'metaKey' | 'isComposing'>, target: Element | null): boolean {
+  if (!ARROWS.has(event.key) || event.ctrlKey || event.altKey || event.metaKey || event.isComposing) return false;
+  if (!target || !target.closest(TOOL_AREAS)) return false;
+  return !target.closest(KEEP_NATIVE);
+}
+
+export function installKeepArrowsInDocument(editor: ArrowRedirectTarget, doc: Document = document): () => void {
+  const onKeyDown = (event: KeyboardEvent) => {
+    const target = event.target instanceof Element ? event.target : doc.activeElement;
+    if (!shouldRedirectArrow(event, target)) return;
+    event.preventDefault();
+    event.stopPropagation();
+    (target as HTMLElement | null)?.blur?.();
+    editor.focus();
+    const input = doc.activeElement;
+    if (!input || input === target || input === doc.body) return;
+    input.dispatchEvent(new KeyboardEvent('keydown', {
+      key: event.key, code: event.code, shiftKey: event.shiftKey, bubbles: true, cancelable: true,
+    }));
+  };
+  doc.addEventListener('keydown', onKeyDown, true);
+  return () => doc.removeEventListener('keydown', onKeyDown, true);
+}
