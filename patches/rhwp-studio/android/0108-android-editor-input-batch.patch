--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-format-fixes.test.ts
@@ -0,0 +1,372 @@
+// [hwpxxx] 서식 결함 5건의 회귀 시험. 실제 소스에서 메서드·명령을 분리해 실행하고 DOM/WASM 경계만 대역으로 둔다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { stripTypeScriptTypes } from 'node:module';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+const input = source('engine/input-handler.ts');
+const toolbar = source('ui/toolbar.ts');
+const format = source('command/commands/format.ts');
+const commands = source('engine/command.ts');
+const position = { sectionIndex: 0, paragraphIndex: 3, charOffset: 2 };
+
+// [hwpxxx] 구현을 복사하지 않고 저장된 소스를 실행해 실제 분기와 이벤트 연결을 검증한다.
+function method(text: string, name: string): string {
+  const start = text.search(new RegExp(`^  (?:private )?${name}\\(`, 'm'));
+  assert.notEqual(start, -1, `${name} 메서드가 있어야 한다`);
+  const end = text.indexOf('\n  }', start);
+  assert.notEqual(end, -1);
+  return text.slice(start, end + 4);
+}
+function evaluate(code: string, result: string, dependencies: Record<string, any> = {}): any {
+  const js = stripTypeScriptTypes(code, { mode: 'transform' });
+  return new Function(...Object.keys(dependencies), `${js}\nreturn ${result};`)(...Object.values(dependencies));
+}
+function subject(text: string, names: string[], dependencies: Record<string, any> = {}): any {
+  const Subject = evaluate(`class Subject {\n${names.map(name => method(text, name)).join('\n')}\n}`, 'Subject', dependencies);
+  return new Subject();
+}
+function classSource(name: string): string {
+  const start = commands.indexOf(`export class ${name} `);
+  assert.notEqual(start, -1);
+  return commands.slice(start, commands.indexOf('\n}', start) + 2).replace('export class', 'class');
+}
+function dialogCommand(id: string, dependencies: Record<string, any>): any {
+  const start = format.indexOf(`id: 'format:${id}'`);
+  const end = format.indexOf('\n  },', start);
+  const block = format.slice(start, end);
+  const execute = block.slice(block.indexOf('    execute('), block.lastIndexOf('\n    },') + 6);
+  return evaluate(`class Command { ${execute} }`, 'new Command()', dependencies);
+}
+const paraStart = commands.indexOf('function getParaShapeId(');
+const paraCode = commands.slice(paraStart, commands.indexOf('// ─── 문단 끝에서 Delete', paraStart)).replace('export class', 'class');
+const { ApplyParaFormatCommand, SubmodeSnapshotCommand } = evaluate(
+  `${paraCode}\n${classSource('SnapshotCommand')}\n${classSource('SubmodeSnapshotCommand')}`,
+  '({ ApplyParaFormatCommand, SubmodeSnapshotCommand })',
+);
+
+// [hwpxxx] 모양 ID와 스냅샷 저장소를 대역으로 두고 실제 서식 명령의 undo/redo를 왕복한다.
+function paragraph(initial: Record<string, unknown>) {
+  const shapes = [{ ...initial }];
+  let shapeId = 0;
+  const snapshots = new Map<number, number>();
+  let nextSnapshot = 0;
+  const state = () => ({ ...shapes[shapeId], paraShapeId: shapeId });
+  const apply = (json: string) => { shapes.push({ ...shapes[shapeId], ...JSON.parse(json) }); shapeId = shapes.length - 1; };
+  const wasm: any = {
+    getParaPropertiesAt: state,
+    applyParaFormat: (_sec: number, _para: number, json: string) => apply(json),
+    setParaShapeId: (_sec: number, _para: number, id: number) => { shapeId = id; },
+    runInBatch: (callback: () => void) => callback(),
+    saveSnapshot: () => { snapshots.set(++nextSnapshot, shapeId); return nextSnapshot; },
+    restoreSnapshot: (id: number) => { assert.ok(snapshots.has(id)); shapeId = snapshots.get(id)!; },
+    discardSnapshot: (id: number) => snapshots.delete(id),
+    ensureDefaultNumbering: () => 17,
+  };
+  const handler = subject(input, [
+    'applyParaPropsToRange', 'applyParaFormatInNoteOrHeader', 'applyParaFormat',
+    'executeParaFormatCommand', 'changeOutlineLevel', 'toggleNumbering',
+  ], { ApplyParaFormatCommand });
+  handler.wasm = wasm;
