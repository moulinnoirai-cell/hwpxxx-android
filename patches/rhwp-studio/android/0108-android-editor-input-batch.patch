+});
+
+test('문자표는 칸 크기를 고정하고 세로로만 스크롤한다', () => {
+  const css = source('src/styles/symbols-dialog.css');
+  assert.match(css, /grid-template-columns: repeat\(auto-fill, minmax\(36px, 1fr\)\);/);
+  assert.match(css, /overflow-x: hidden;\n  overflow-y: auto;/);
+  assert.doesNotMatch(css, /repeat\(16, 1fr\)/);
+});
+
+test('도구 단추에 초점이 있을 때 화살표는 본문으로 보낸다(열린 메뉴·입력칸·조합 중은 제외)', () => {
+  const doc = new (class { querySelector() { return null; } })();
+  void doc;
+  const el = (match: Record<string, boolean>) => ({ closest: (sel: string) => (Object.keys(match).some(k => match[k] && sel.includes(k)) ? {} : null) }) as unknown as Element;
+  const key = (k: string, extra: Partial<KeyboardEvent> = {}) => ({ key: k, ctrlKey: false, altKey: false, metaKey: false, isComposing: false, ...extra });
+  const toolButton = el({ '#style-bar': true });
+  assert.equal(shouldRedirectArrow(key('ArrowLeft'), toolButton), true);
+  assert.equal(shouldRedirectArrow(key('ArrowLeft', { isComposing: true }), toolButton), false);
+  assert.equal(shouldRedirectArrow(key('ArrowLeft', { ctrlKey: true }), toolButton), false);
+  assert.equal(shouldRedirectArrow(key('Enter'), toolButton), false);
+  assert.equal(shouldRedirectArrow(key('ArrowDown'), el({ '#style-bar': true, 'select': true })), false, '목록 상자는 그대로');
+  assert.equal(shouldRedirectArrow(key('ArrowDown'), el({ '#menu-bar': true, '.menu-dropdown': true })), false, '열린 메뉴는 그대로');
+  assert.equal(shouldRedirectArrow(key('ArrowDown'), el({})), false, '도구 영역 밖(본문 등)은 손대지 않는다');
+  assert.match(source('src/main.ts'), /if \(isAndroidHost\(\)\) \{ const editor = inputHandler; installKeepArrowsInDocument\(\{ focus: \(\) => editor\.focus\(\) \}\); \}/);
+});
+
+test('조합 중 단축키·클릭은 먼저 조합을 확정하고, 늦게 오는 compositionend 는 한 번 무시한다', () => {
+  const handler = source('src/engine/input-handler.ts');
+  assert.match(handler, /finishCompositionNow\(\): void \{\n    if \(!this\.isComposing\) return;\n    _text\.onCompositionEnd\.call\(this\);\n    \(this as any\)\._hwpxxxCompositionFinishedEarly = true;/);
+  const keyboard = source('src/engine/input-handler-keyboard.ts');
+  assert.match(keyboard, /e\.preventDefault\(\);\n        \/\/ \[hwpxxx\] 명령 전에 조합을 확정한다[^\n]*\n        this\.finishCompositionNow\?\.\(\);/);
+  assert.match(source('src/engine/input-handler-mouse.ts'), /if \(this\.isComposing && e\.button === 0\) this\.finishCompositionNow\?\.\(\);/);
+  const text = source('src/engine/input-handler-text.ts');
+  assert.match(text, /if \(this\._hwpxxxCompositionFinishedEarly && !this\.isComposing\) \{/);
+  assert.match(text, /export function onCompositionStart\(this: any\): void \{\n  this\._hwpxxxCompositionFinishedEarly = false;/);
+});
+
+test('서식 토글·크기 증감은 캐럿 대기 서식까지 본다(Ctrl+B 두 번 = 끄기, 크기 두 번 = +2pt), 도구 막대도 바로 보인다', () => {
+  const code = source('src/engine/input-handler.ts');
+  assert.match(code, /private getEffectiveCharPropertiesAtCursor\(\): CharProperties \{\n    const base = this\.getCharPropertiesAtCursor\(\);\n    if \(this\.getNonEmptySelection\(\)\) return base;/);
+  assert.match(code, /: this\.getEffectiveCharPropertiesAtCursor\(\);\n\n    if \(prop === 'emboss'\)/);
+  for (const name of ['adjustFontSize', 'adjustCharRatio', 'adjustCharSpacing']) {
+    assert.match(code, new RegExp(`${name}\\(delta: number\\): void \\{[\\s\\S]{0,160}const current = this\\.getEffectiveCharPropertiesAtCursor\\(\\);`), name);
+  }
+  assert.match(code, /this\.stagePendingCharShape\(props\);\n      this\.emitCursorFormatState\(\);/);
+});
+
+test('되돌리기 단위는 낱말: 입력 사이 1.5초 이내, 빈칸 뒤 새 낱말에서 끊는다', async () => {
+  const code = source('src/engine/command.ts');
+  assert.match(code, /export const INSERT_MERGE_GAP_MS = 1500;/);
+  assert.match(code, /export const INSERT_MERGE_MAX_CHARS = 80;/);
+  assert.match(code, /if \(overwriting\) \{\n      if \(other\.timestamp - this\.timestamp > 300\) return null;/, '덮어쓰기는 원래 기준');
+  assert.match(code, /if \(other\.timestamp - this\.lastInputAt > INSERT_MERGE_GAP_MS\) return null;/);
+  assert.match(code, /if \(\/\\s\$\/u\.test\(this\.text\) && !\/\^\\s\/u\.test\(other\.text\)\) return null;/);
+});
+
+test('유령 입력 방지는 조합 확정 직후(300ms)에만, 잠긴 문서는 조합 입력도 막고, 메뉴 붙이기는 클립보드 API 로 대신한다', () => {
+  const text = source('src/engine/input-handler-text.ts');
+  assert.match(text, /const GHOST_INPUT_WINDOW_MS = 300;/);
+  assert.match(text, /if \(this\._lastComposedText && text === this\._lastComposedText && ghostWindow\) \{/);
+  assert.match(text, /export function onInput\(this: any, e\?: InputEvent\): void \{\n  if \(!this\.active\) return;\n  \/\/ \[hwpxxx\][^\n]*\n  if \(editingLocked\.call\(this\)\) \{/);
+  const handler = source('src/engine/input-handler.ts');
