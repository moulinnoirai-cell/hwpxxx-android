+test('글자 모양: 빈 선택·선택 없음은 기존 글을 바꾸지 않고 대기 서식으로 예약한다', () => {
+  const handler = subject(input, ['applyCharPropsToRange', 'applyCharPropsAtCursor', 'applyCharFormat'], {
+    CursorState: { comparePositions: (a: any, b: any) => a.charOffset - b.charOffset },
+  });
+  handler.cursor = { isInHeaderFooter: () => false, isInFootnote: () => false };
+  handler.getSelectedCellBlock = () => null;
