+      isRecoveryBlocked: () => !bridge.canExportAndroidRecovery(),
+      logger: { warn() {}, debug() {} } as never,
+    });
+    await manager.beginDocument({ fileName: '암호.hwp', sourceFormat: 'hwp' });
+    await manager.flushNow('android-lifecycle');
+    assert.equal(recorded.length, 1);
+    const draft = recorded[0];
+    assert.equal(draft.encrypted, true);
+    assert.equal(needsPassword(draft.data), true, '네이티브로 가는 바이트는 암호화돼 있다');
+    assert.ok(!JSON.stringify({ ...draft, data: undefined }).includes(password), '메타데이터에 비밀번호가 없다');
+    assert.ok(!Buffer.from(draft.data).includes(Buffer.from(password)), '바이트에 비밀번호 평문이 없다');
+    const restored = new WasmBridge();
