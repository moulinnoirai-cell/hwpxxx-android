+// ───────────────────────────── WasmBridge: 비밀번호 수명·복구본 ─────────────────────────────
+const enableHost = () => { g.AndroidStudioHost = {}; };
+const disableHost = () => { delete g.AndroidStudioHost; delete g.rhwpAndroidHost; };
+const needsPassword = (bytes: Uint8Array) => { try { new Doc(bytes).free(); return false; } catch (e) { return String((e as Error | undefined)?.message ?? e).includes('비밀번호가 필요한'); } };
+function encryptedBytes(password: string, source = 'biz_plan.hwp') {
+  const d = new Doc(sample(source));
+  try { return d.exportHwpWithPassword(password) as Uint8Array; } finally { d.free(); }
+}
+function openEncrypted(password: string): { bridge: any } {
+  const bridge = new WasmBridge();
+  bridge.loadDocumentWithPassword(encryptedBytes(password), password, '암호.hwp');
+  return { bridge };
+}
+const opensWith = (bytes: Uint8Array, password: string) => { try { Doc.openWithPassword(bytes, password).free(); return true; } catch { return false; } };
+
+test('비밀번호: 암호 문서를 연 비밀번호로 암호화된 복구본을 만든다(평문 아님), 평문 문서는 평문 복구본이다', () => {
+  enableHost();
+  try {
+    const password = synthPassword();
+    const { bridge } = openEncrypted(password);
+    assert.equal(bridge.requiresPasswordForSave, true);
+    assert.equal(bridge.canExportAndroidRecovery(), true);
+    const recovery = bridge.exportAndroidRecoveryBytes();
+    assert.equal(needsPassword(recovery), true, '비밀번호 없이는 열리지 않는다');
+    assert.equal(opensWith(recovery, password), true);
+    assert.equal(opensWith(recovery, synthPassword()), false);
+    const reopened = Doc.openWithPassword(recovery, password);
+    assert.equal(reopened.getTextFileUnicode(), bridge.doc.getTextFileUnicode());
+
+    const plain = new WasmBridge();
+    plain.loadDocument(sample('biz_plan.hwp'), 'a.hwp');
+    assert.equal(plain.canExportAndroidRecovery(), true);
+    assert.equal(needsPassword(plain.exportAndroidRecoveryBytes()), false);
+  } finally { disableHost(); }
+});
