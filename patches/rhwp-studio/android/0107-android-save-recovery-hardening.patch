+    assert.ok(restored.doc.getTextFileUnicode().includes('복구 시험 문장'));
+  } finally { disableHost(); }
+});
+
+test('file.ts 호출 순서 보호: 내보내기 직후 검증 → 저장 시작, 성공 때만 보호 상태·기준 반영, 종료 때 대기 기록 폐기', () => {
+  const file = readFileSync(new URL('../src/command/commands/file.ts', import.meta.url), 'utf8');
+  const create = file.slice(file.indexOf('async function createSavePayload'), file.indexOf('function showExportContentLoss'));
+  assert.ok(create.indexOf('verifyAndroidSave(') > 0 && create.indexOf('verifyAndroidSave(') < create.indexOf('stageAndroidPassword('), '검증이 끝난 뒤에만 저장을 시작한다');
+  assert.ok(create.indexOf('stageAndroidPassword(') < create.indexOf('runAndroidSaveGuard('), '호스트 훅보다 앞에서 시작 기록');
+  const complete = file.slice(file.indexOf('function completeHandleSave'), file.indexOf('function exportHtmlBasedFile'));
+  assert.ok(complete.indexOf('requiresPasswordForSave = passwordProtected') < complete.indexOf('commitAndroidPassword(passwordProtected)'));
+  assert.equal((file.match(/discardStagedAndroidPassword\(\)/g) ?? []).length, 2, '두 저장 흐름의 finally 가 대기 기록을 버린다');
+});
+
+// ───────────────────────────── 복구본의 내용 손실 표시(옛 Android 작업기의 lossy) ─────────────────────────────
+const LOSS_REPORT = { schemaVersion: 1, outputFormat: 'hwp', count: 1, losses: [{ path: 'section[0]/para[1]/ctrl[0]', kind: 'test' }] };
+/** 코어 보고서를 쓰는 내보내기를 그대로 두고 내용 손실 보고만 덧씌운다(실제 샘플에는 손실 보고가 없다). */
+function withInjectedLoss(bridge: any, method: 'exportHwpWithReport' | 'exportHwpWithPasswordAndReport') {
+  const original = bridge[method].bind(bridge);
+  bridge[method] = (...args: unknown[]) => ({ ...original(...args), contentLoss: LOSS_REPORT });
+}
+
+test('복구본 손실: 엔진이 내용 손실을 보고하면 바이트는 그대로 두고 lossy 로 표시하며, 손실이 없으면 표시하지 않는다(평문·암호 모두)', () => {
+  enableHost();
+  try {
+    const plain = new WasmBridge();
+    plain.loadDocument(sample('biz_plan.hwp'), 'a.hwp');
+    assert.equal(plain.exportAndroidRecoveryBytes().lossy, undefined);
+    withInjectedLoss(plain, 'exportHwpWithReport');
+    const lossyPlain = plain.exportAndroidRecoveryBytes();
+    assert.equal(lossyPlain.lossy, true);
+    assert.equal(needsPassword(lossyPlain), false);
+    new Doc(lossyPlain).free(); // 손실 표시와 무관하게 유효한 HWP 다
+
+    const password = synthPassword();
+    const { bridge } = openEncrypted(password);
+    assert.equal(bridge.exportAndroidRecoveryBytes().lossy, undefined);
+    withInjectedLoss(bridge, 'exportHwpWithPasswordAndReport');
+    const lossyEncrypted = bridge.exportAndroidRecoveryBytes();
+    assert.equal(lossyEncrypted.lossy, true);
+    assert.equal(needsPassword(lossyEncrypted), true, '손실이 있어도 평문 복구본으로 돌지 않는다');
+    assert.equal(opensWith(lossyEncrypted, password), true);
+  } finally { disableHost(); }
+});
+
+test('복구본 손실: AutosaveManager 는 lossy 를 초안 메타데이터로 넘기고, 저장소는 표시를 저장할 수 있다고 알린 셸에만 맡긴다', async () => {
+  const f = managerFixture({ exportBytes: () => Object.assign(new Uint8Array([1, 2, 3]), { lossy: true }) });
+  await f.manager.beginDocument({ fileName: 'a.hwp', sourceFormat: 'hwpx' });
+  await f.manager.flushNow('typing');
+  assert.equal(f.saved[0].lossy, true);
+  const clean = managerFixture();
+  await clean.manager.beginDocument({ fileName: 'a.hwp', sourceFormat: 'hwp' });
+  await clean.manager.flushNow('typing');
+  assert.equal('lossy' in clean.saved[0], false);
+
+  const sent: any[] = [];
+  const store = { saveDraft: async (d: any) => { sent.push(d); }, getDraft: async () => null, listDrafts: async () => [{ id: 'x', fileName: 'x.hwp', sourceFormat: 'hwp', savedAt: 1, byteLength: 1, data: new Uint8Array([1]), lossy: true }, { id: 'y', fileName: 'y.hwp', sourceFormat: 'hwp', savedAt: 2, byteLength: 1, data: new Uint8Array([1]), lossy: 'maybe' }], deleteDraft: async () => {}, clearDrafts: async () => {} };
+  const lossyDraft = { id: 'd', fileName: 'a.hwp', sourceFormat: 'hwp', savedAt: 5, byteLength: 1, data: new Uint8Array([9]), lossy: true };
+  g.AndroidStudioHost = { recovery: store }; // 표시 저장을 지원한다고 알리지 않은 셸
+  try {
+    await assert.rejects(saveAutosaveDraft(lossyDraft as never), /표시할 수 없어/);
+    assert.equal(sent.length, 0, '표시 없이 저장하지 않는다');
+    await saveAutosaveDraft({ ...lossyDraft, lossy: undefined } as never);
+    assert.equal(sent.length, 1, '손실 보고가 없는 복구본은 그대로 저장된다');
+  } finally { disableHost(); }
+  g.AndroidStudioHost = { recovery: { ...store, supportsLossyDrafts: true } };
+  try {
+    await saveAutosaveDraft(lossyDraft as never);
+    assert.equal(sent.at(-1).lossy, true);
+    const listed = await listAutosaveDrafts();
+    assert.equal(listed.find((d) => d.id === 'x')?.lossy, true);
+    assert.equal('lossy' in (listed.find((d) => d.id === 'y') ?? {}), false, 'true 가 아닌 값은 표시로 인정하지 않는다');
+  } finally { disableHost(); }
+});
