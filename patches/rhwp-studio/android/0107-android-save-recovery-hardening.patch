+function blank(): any { const d = Doc.createEmpty(); d.createBlankDocument(); return d; }
+function exportDoc(d: any, fmt: 'hwp' | 'hwpx') {
+  const ex = fmt === 'hwp' ? d.exportHwpWithReport() : d.exportHwpxWithReport();
