+test('비밀번호: 인스턴스 속성·직렬화·공개 메서드 어디에도 비밀번호가 드러나지 않는다', () => {
+  enableHost();
+  try {
+    const password = synthPassword();
+    const { bridge } = openEncrypted(password);
+    const seen = new Set<unknown>();
+    const scan = (value: unknown, depth: number): void => {
+      if (typeof value === 'string') { assert.ok(!value.includes(password), '문자열 값에 비밀번호가 있다'); return; }
+      if (!value || typeof value !== 'object' || depth > 2 || seen.has(value) || ArrayBuffer.isView(value)) return;
+      seen.add(value);
+      for (const key of [...Object.getOwnPropertyNames(value), ...Object.getOwnPropertySymbols(value).map(String)]) {
+        assert.ok(!String(key).includes(password));
+        try { scan((value as Record<string, unknown>)[key as string], depth + 1); } catch (e) { if (e instanceof assert.AssertionError) throw e; }
+      }
+    };
+    scan(bridge, 0);
