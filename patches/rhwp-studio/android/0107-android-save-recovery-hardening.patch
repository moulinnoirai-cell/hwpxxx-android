+// 시험용 모듈 해석 훅: Vite 처럼 별칭(`@/` → src/, `@wasm/` → ../pkg/)과 확장자 없는 상대 경로를 Node 가 따라가게 한다. 시험 전용이다.
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { existsSync, statSync } from 'node:fs';
+import path from 'node:path';
+const src = fileURLToPath(new URL('../../src/', import.meta.url));
+const pkg = fileURLToPath(new URL('../../../pkg/', import.meta.url));
+const isFile = (p) => existsSync(p) && statSync(p).isFile();
+function withExtension(base) {
+  for (const candidate of [base, `${base}.ts`, path.join(base, 'index.ts')]) if (isFile(candidate)) return candidate;
+  return null;
+}
+export async function resolve(specifier, context, next) {
+  let base = null;
+  if (specifier.startsWith('@wasm/')) base = pkg + specifier.slice(6);
+  else if (specifier.startsWith('@/')) base = src + specifier.slice(2);
+  else if ((specifier.startsWith('./') || specifier.startsWith('../')) && context.parentURL?.startsWith('file:') && !path.extname(specifier)) {
+    base = path.resolve(path.dirname(fileURLToPath(context.parentURL)), specifier);
+  }
+  if (base) {
+    const found = withExtension(base);
+    if (found) return next(pathToFileURL(found).href, context);
+  }
+  return next(specifier, context);
+}
+
+// Vite 가 채우는 `import.meta.env` 를 프로덕션 값으로 대신한다(DEV 아님).
+export async function load(url, context, next) {
+  const result = await next(url, context);
+  if (url.includes('/rhwp-studio/src/') && result.source != null) {
+    const text = result.source.toString();
+    if (text.includes('import.meta.env')) {
+      return { ...result, source: text.replaceAll('import.meta.env', '({ DEV: false, PROD: true, MODE: "production", BASE_URL: "/studio/" })') };
+    }
+  }
+  return result;
+}
