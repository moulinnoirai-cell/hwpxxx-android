diff --git a/rhwp-studio/tests/hwpxxx-android-host.test.ts b/rhwp-studio/tests/hwpxxx-android-host.test.ts
new file mode 100644
index 0000000..ae9a100
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-host.test.ts
@@ -0,0 +1,145 @@
+// [hwpxxx-android] 셸 통합면(android-host)과 저장 검증(android-save-verify) 시험.
+// 저장 검증은 이 빌드의 실제 Android 코어(`../pkg/rhwp.js`, `rhwp_bg.wasm`)로 문서를 열고 내보내 다시 비교한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { createAndroidHostApi, getAndroidHost, getAndroidRecoveryStore, androidRecoveryUnavailable, runAndroidSaveGuard } from '../src/hwpxxx/android-host.ts';
+import { verifyReopenedDocument } from '../src/hwpxxx/android-save-verify.ts';
+
+const g = globalThis as Record<string, unknown>;
+const pkg = (name: string) => fileURLToPath(new URL(`../../pkg/${name}`, import.meta.url));
+
+function deps(overrides: Record<string, unknown> = {}) {
+  const calls: string[] = [];
+  const base = {
+    hasDocument: () => true, getFileName: () => 'a.hwp', isDirty: () => true, isEncrypted: () => false,
+    getFormat: () => 'hwp' as const, getFileHandle: () => ({ name: 'a.hwp' }),
+    discardRecovery: async (r: string) => { calls.push('discard:' + r); },
+    canReplaceDocument: async () => true,
+    flushAutosave: async (r: string) => { calls.push('flush:' + r); },
+    newDocument: () => { calls.push('new'); },
+    ...overrides,
+  };
+  return { base, calls };
+}
+
+test('셸이 없으면 Android 모드가 아니다(데스크톱 동작 유지)', () => {
+  delete g.AndroidStudioHost; delete g.rhwpAndroidHost;
+  assert.equal(getAndroidHost(), null);
+  assert.equal(getAndroidRecoveryStore(), undefined);
+  assert.equal(androidRecoveryUnavailable(), false);
+});
+
+test('AndroidStudioHost 와 별칭 rhwpAndroidHost, recovery/recoveryStore 이름을 모두 받는다', () => {
+  const store = { saveDraft: async () => {} };
+  g.rhwpAndroidHost = { recoveryStore: store };
+  assert.equal(getAndroidRecoveryStore(), store);
+  delete g.rhwpAndroidHost;
+  g.AndroidStudioHost = { recovery: store };
+  assert.equal(getAndroidRecoveryStore(), store);
+  g.AndroidStudioHost = {};
+  assert.equal(getAndroidRecoveryStore(), null); // 셸은 있는데 비공개 저장소가 없다 → 평문 복구본 금지
+  assert.equal(androidRecoveryUnavailable(), true);
+  delete g.AndroidStudioHost;
+});
+
+test('getState 는 핸들·암호·형식을 알리고 confirmClose 는 버리기에서만 복구본을 지운다', async () => {
+  g.AndroidStudioHost = { recovery: {} };
+  const { base, calls } = deps();
+  const api = createAndroidHostApi(base as never);
+  assert.deepEqual(api.getState(), { hasDocument: true, fileName: 'a.hwp', dirty: true, encrypted: false, format: 'hwp', fileHandle: { name: 'a.hwp' } });
+  assert.equal(await api.confirmClose(), true);
+  assert.deepEqual(calls, ['discard:android-discard'], '여전히 dirty 인 채로 계속 → 버리기');
+  const state = { dirty: true };
+  const saved = deps({ isDirty: () => state.dirty, canReplaceDocument: async () => { state.dirty = false; return true; } });
+  assert.equal(await createAndroidHostApi(saved.base as never).close(), true);
+  assert.deepEqual(saved.calls, [], '저장 후 닫기는 복구본을 따로 지우지 않는다(저장이 이미 지운다)');
+  const cancel = deps({ canReplaceDocument: async () => false });
+  assert.equal(await createAndroidHostApi(cancel.base as never).confirmClose(), false);
+  delete g.AndroidStudioHost;
+});
+
+test('flushRecovery: 저장소 없음·깨끗함·문서 없음은 쓰지 않고, 저장소가 있으면 android-lifecycle 로 즉시 저장', async () => {
+  g.AndroidStudioHost = {};
+  assert.deepEqual(await createAndroidHostApi(deps().base as never).flushRecovery(), { ok: false, skipped: 'no-store' });
+  g.AndroidStudioHost = { recovery: {} };
+  assert.deepEqual(await createAndroidHostApi(deps({ isDirty: () => false }).base as never).flushRecovery(), { ok: false, skipped: 'clean' });
+  assert.deepEqual(await createAndroidHostApi(deps({ hasDocument: () => false }).base as never).flushRecovery(), { ok: false, skipped: 'no-document' });
+  const { base, calls } = deps();
+  const result = await createAndroidHostApi(base as never).flushRecovery();
+  assert.deepEqual(calls, ['flush:android-lifecycle']);
+  assert.equal(result.ok, false); // 시험용 flushAutosave 는 상태 콜백을 부르지 않았다 → busy
+  delete g.AndroidStudioHost;
+});
+
+test('저장 검사 훅이 던지면 저장 흐름도 던진다', async () => {
+  g.AndroidStudioHost = {};
+  const api = createAndroidHostApi(deps().base as never);
+  api.setSaveGuard(() => { throw new Error('거절'); });
+  await assert.rejects(runAndroidSaveGuard({ bytes: new Uint8Array(), format: 'hwp', fileName: 'a.hwp', encrypted: false, contentLoss: null, mode: 'save' }), /거절/);
+  api.setSaveGuard(null);
+  await runAndroidSaveGuard({ bytes: new Uint8Array(), format: 'hwp', fileName: 'a.hwp', encrypted: false, contentLoss: null, mode: 'save' });
+  delete g.AndroidStudioHost;
+});
+
+// ── 저장 검증(실제 코어) ───────────────────────────────────────────────────────────────
+async function engine() {
+  const mod = await import(pkg('rhwp.js'));
+  await mod.default({ module_or_path: readFileSync(pkg('rhwp_bg.wasm')) });
+  return mod.HwpDocument as { new (b: Uint8Array): any; openWithPassword(b: Uint8Array, p: string): any };
+}
+const sample = (name: string) => new Uint8Array(readFileSync(fileURLToPath(new URL(`../public/samples/${name}`, import.meta.url))));
+
+test('같은 형식으로 저장한 문서는 글·서식·표·메모 비교를 통과한다', async () => {
+  const Doc = await engine();
+  for (const [name, fmt] of [['biz_plan.hwp', 'hwp'], ['form-002.hwpx', 'hwpx']] as const) {
+    const live = new Doc(sample(name));
+    const ex = fmt === 'hwp' ? live.exportHwpWithReport() : live.exportHwpxWithReport();
+    const bytes = ex.takeBytes(); ex.free();
+    const reopened = new Doc(bytes);
+    verifyReopenedDocument(live, reopened, bytes.length);
+  }
+});
+
+test('내보낸 뒤 문서가 바뀌었거나(글·글자 서식·문단 서식) 파일이 손상되면 거절한다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const ex = live.exportHwpWithReport(); const bytes = ex.takeBytes(); ex.free();
+  const reopened = new Doc(bytes);
+  verifyReopenedDocument(live, reopened, bytes.length);
+  live.insertText(0, 0, 0, '가');
+  assert.throws(() => verifyReopenedDocument(live, reopened, bytes.length), /내용이 달라/);
+  const live2 = new Doc(sample('biz_plan.hwp'));
+  let para = 0;
+  while (live2.getParagraphLength(0, para) < 2) para += 1;
+  const ex2 = live2.exportHwpWithReport(); const bytes2 = ex2.takeBytes(); ex2.free();
+  const re2 = new Doc(bytes2);
+  const len = live2.getParagraphLength(0, para);
+  live2.applyCharFormat(0, para, 0, len, JSON.stringify({ bold: !JSON.parse(live2.getCharPropertiesAt(0, para, 0)).bold }));
+  assert.throws(() => verifyReopenedDocument(live2, re2, bytes2.length), /글자 서식/);
+  const live3 = new Doc(sample('biz_plan.hwp'));
+  const ex3 = live3.exportHwpWithReport(); const bytes3 = ex3.takeBytes(); ex3.free();
+  const re3 = new Doc(bytes3);
+  live3.applyParaFormat(0, 0, JSON.stringify({ alignment: JSON.parse(live3.getParaPropertiesAt(0, 0)).alignment === 'center' ? 'left' : 'center' }));
+  assert.throws(() => verifyReopenedDocument(live3, re3, bytes3.length), /문단 서식/);
+  assert.throws(() => verifyReopenedDocument(live3, re3, 33 * 1024 * 1024), /32MB/);
+});
+
+test('암호 문서: 같은 비밀번호로 다시 열어 비교하고, 다른 비밀번호 파일은 열리지 않는다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const bytes = live.exportHwpWithPassword('시험-비밀번호');
+  const reopened = Doc.openWithPassword(bytes, '시험-비밀번호');
+  verifyReopenedDocument(live, reopened, bytes.length);
+  assert.throws(() => Doc.openWithPassword(bytes, '틀린-비밀번호'));
+});
+
+test('HWP↔HWPX 변환에서만 기본값 표기 차이를 허용한다', async () => {
+  const Doc = await engine();
+  const live = new Doc(sample('biz_plan.hwp'));
+  const ex = live.exportHwpxWithReport(); const bytes = ex.takeBytes(); ex.free();
+  const reopened = new Doc(bytes);
+  assert.throws(() => verifyReopenedDocument(live, reopened, bytes.length), /서식/);
+  verifyReopenedDocument(live, reopened, bytes.length, { crossFormat: true });
+});
