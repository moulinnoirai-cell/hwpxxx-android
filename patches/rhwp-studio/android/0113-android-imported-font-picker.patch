+/**
+ * [hwpxxx-android] 글꼴 선택 UI(도구 모음 글꼴 상자·글자 모양·대표 글꼴 세트)가 보여 줄 호스트(가져온) 글꼴 이름.
+ *
+ * 호스트 목록은 문서 렌더러용으로 감지 snapshot 과 일부러 분리돼 있어 `getLocalFonts()` 에 없다. 선택기는 따로 합친다:
+ * - 기본 글자 서식으로 실제 face 를 고를 수 있는 가족명만 낸다. 굵게/기울임은 같은 가족의 face 를 고른다.
+ * - 가족명 + 플래그로 닿지 않는 face 는 실제로 그 face 에 닿는 전체 이름 또는 PostScript 이름으로 낸다.
+ *   굵은 글꼴만 가져온 경우나 같은 가족·굵기의 face 가 여러 개인 경우에도 무효한 선택지를 내지 않는다.
+ * 호스트 공급자가 없으면 빈 목록이다. 계산은 호출 때마다 현재 목록으로 한다(가져오기·삭제 뒤 바로 반영).
+ */
+export function getHostFontPickerNames(): string[] {
+  if (!hostFontSource.active) return [];
+  const byFamily = new Map<string, LocalFontRecord[]>();
+  for (const record of currentHostRecords()) {
+    const key = normalizeFontAlias(record.family);
+    if (!key) continue;
+    const faces = byFamily.get(key);
+    if (faces) faces.push(record); else byFamily.set(key, [record]);
+  }
+  const names: string[] = [];
+  const normal = { weight: 400, slant: 'normal' } as const;
+  const resolves = (name: string, record: LocalFontRecord, style = normal) =>
+    resolveRendererLocalFont(name, style)?.hostReference?.face.id === record.hostReference?.face.id;
+  for (const faces of byFamily.values()) {
+    const family = faces[0].family;
+    const hasDefault = faces.some(r => resolves(family, r));
+    if (hasDefault) names.push(family);
+    for (const r of faces) {
+      const weight = r.hostReference?.face.weight;
+      const slant = r.hostReference?.face.slant === 'normal' ? 'normal' : 'italic';
+      const reachableByFlags = hasDefault && (weight === 400 || weight === 700)
+        && resolveRendererLocalFont(family, { weight, slant })?.hostReference?.face.id === r.hostReference?.face.id;
+      if (!reachableByFlags) {
+        const exact = [r.fullName, r.postscriptName].find(name => name && resolves(name, r));
+        if (exact) names.push(exact);
+      }
+    }
+  }
+  return normalizeFontNames(names);
+}
+
+/** 글꼴 선택 UI 의 시스템/로컬 글꼴 목록 = 감지된 로컬 글꼴 + 호스트(가져온) 글꼴. 같은 이름(대소문자·공백·NFC 무시)은 하나로 합친다. */
+export function getFontPickerNames(): string[] {
+  return normalizeFontNames([...getLocalFonts(), ...getHostFontPickerNames()]);
+}
+
 /** 캐시된 전체 로컬 글꼴 목록을 반환한다. */
 export function getDetectedLocalFonts(): string[] {
   return cachedSnapshot ? [...cachedSnapshot.families] : [];
