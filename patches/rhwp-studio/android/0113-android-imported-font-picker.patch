index 0000000..bbda6cd
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-font-picker.test.ts
@@ -0,0 +1,124 @@
+// [hwpxxx-android] 가져온(호스트) 글꼴이 글꼴 선택 UI(도구 모음 글꼴 상자 · 글자 모양 · 대표 글꼴 세트)에 나오는지 시험한다.
+// 순수 목록 함수만 시험한다(화면·저장·다시 열기는 실제 UI 시험이 한다). 합성 글꼴 메타데이터만 사용한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import type { HostFontProvider, HostFontSnapshot } from '../src/core/host-font-provider.ts';
+import {
+  getFontPickerNames, getHostFontPickerNames, getLocalFonts, loadStoredLocalFonts, onHostFontsChanged,
+  prepareHostFontCatalog, resetLocalFontsForTests, resolveRendererLocalFont, setHostFontProvider,
+} from '../src/core/local-fonts.ts';
+
+const g = globalThis as Record<string, any>;
+const face = (id: string, family: string, style: string, weight = 400, slant: 'normal' | 'italic' | 'oblique' = 'normal', extra: Record<string, unknown> = {}) => ({
+  id, family, fullName: style === 'Regular' ? family : `${family} ${style}`, postscriptName: `${family.replace(/\s+/g, '')}-${style.replace(/\s+/g, '')}`,
+  style, weight, slant, aliases: [], ...extra,
+});
+
+function host(initial: HostFontSnapshot) {
+  let snapshot = initial; let change = () => {};
+  const provider: HostFontProvider = {
+    getSnapshot: async () => snapshot,
+    readFace: async () => ({ bytes: Uint8Array.of(1).buffer }),
+    subscribe: (listener) => { change = listener; return () => {}; },
+  };
+  return { provider, publish: async (next: HostFontSnapshot) => { snapshot = next; change(); await prepareHostFontCatalog(); } };
+}
+const sorted = (v: string[]) => [...v].sort((a, b) => a.localeCompare(b, 'ko'));
+
+test.beforeEach(async () => { resetLocalFontsForTests(); await setHostFontProvider(null); delete g.localStorage; });
+test.after(async () => { await setHostFontProvider(null); resetLocalFontsForTests(); delete g.localStorage; });
+
+test('without a host provider the picker list is exactly the detected local fonts (PC behaviour unchanged)', async () => {
+  assert.deepEqual(getHostFontPickerNames(), []);
+  assert.deepEqual(getFontPickerNames(), getLocalFonts());
+});
+
+test('an imported single-face font appears by its family name, is resolvable by that name, and the count is the real one', async () => {
+  const f = host({ revision: 'r1', faces: [face('a', '큐에이 글꼴', 'Regular')] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), ['큐에이 글꼴']);
+  assert.deepEqual(getFontPickerNames(), ['큐에이 글꼴']);
+  const record = resolveRendererLocalFont('큐에이 글꼴', { weight: 400, slant: 'normal' });
+  assert.equal(record?.hostReference?.face.id, 'a', 'the name offered by the picker is the name the renderer resolves to the imported face');
+});
+
+test('one family with Regular/Bold/Italic/BoldItalic is ONE entry (bold/italic come from the character flags)', async () => {
+  const f = host({ revision: 'r1', faces: [
+    face('r', 'Fam', 'Regular'), face('b', 'Fam', 'Bold', 700), face('i', 'Fam', 'Italic', 400, 'italic'), face('bi', 'Fam', 'Bold Italic', 700, 'italic'),
+  ] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), ['Fam']);
+  assert.equal(resolveRendererLocalFont('Fam', { weight: 700, slant: 'italic' })?.hostReference?.face.id, 'bi');
+});
+
+test('faces a family name plus bold/italic cannot reach (Light, Medium, no Regular, duplicates) get their exact full name too', async () => {
+  const f = host({ revision: 'r1', faces: [
+    face('r', 'Wide', 'Regular'), face('l', 'Wide', 'Light', 300), face('m', 'Wide', 'Medium', 500), face('b', 'Wide', 'Bold', 700),
+    face('x', 'OnlyBold', 'Bold', 700),
+    face('n1', 'Dup', 'Regular'), face('n2', 'Dup', 'Regular', 400, 'normal', { fullName: 'Dup Condensed', postscriptName: 'Dup-Cond' }),
+  ] });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getHostFontPickerNames(), sorted(['Wide', 'Wide Light', 'Wide Medium', 'OnlyBold Bold', 'Dup-Regular', 'Dup Condensed']));
+  // the pinned names really resolve to exactly that face
+  assert.equal(resolveRendererLocalFont('Wide Light', { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'l');
+  assert.equal(resolveRendererLocalFont('OnlyBold Bold', { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'x');
+  for (const name of getHostFontPickerNames()) {
+    assert.ok(resolveRendererLocalFont(name, { weight: 400, slant: 'normal' })?.hostReference, `offered name ${name} must load an imported face without requiring undisclosed style flags`);
+  }
+});
+
+test('a non-Regular face whose full name equals its family uses its exact PostScript name instead of a dead family choice', async () => {
+  const f = host({ revision: 'light', faces: [face('l', 'Only Light', 'Light', 300, 'normal', { fullName: 'Only Light' })] });
+  await setHostFontProvider(f.provider);
+  assert.equal(resolveRendererLocalFont('Only Light', { weight: 400, slant: 'normal' }), null);
+  assert.deepEqual(getHostFontPickerNames(), ['OnlyLight-Light']);
+  assert.equal(resolveRendererLocalFont(getHostFontPickerNames()[0], { weight: 400, slant: 'normal' })?.hostReference?.face.id, 'l');
+});
+
+test('duplicates collapse (case, spaces, NFC) across host faces and against the detected system fonts; system entries keep their spelling', async () => {
+  g.localStorage = { getItem: (k: string) => k === 'rhwp-local-fonts' ? JSON.stringify({ version: 1, detectedAt: '2026-06-21T00:00:00.000Z', families: ['Shared Font', '시스템 전용'], source: 'local-font-access' }) : null, setItem() {}, removeItem() {}, clear() {}, key() { return null; }, length: 0 };
+  await loadStoredLocalFonts();
+  assert.deepEqual(getLocalFonts(), sorted(['Shared Font', '시스템 전용']));
+  const f = host({ revision: 'r1', faces: [face('s', 'shared  font', 'Regular'), face('u', 'Host Unique', 'Regular'), face('u2', 'HOST UNIQUE', 'Bold', 700)] });
+  await setHostFontProvider(f.provider);
+  const names = getFontPickerNames();
+  assert.equal(names.filter((n) => n.toLowerCase().replace(/\s+/g, ' ') === 'shared font').length, 1, 'one entry for the shared family');
+  assert.equal(names.filter((n) => n.toLowerCase() === 'host unique').length, 1);
+  assert.deepEqual(names, sorted(names), 'sorted like the system list');
+  assert.ok(names.includes('시스템 전용') && names.includes('Shared Font'));
+});
+
+test('import / delete / replace are reflected immediately: no stale entry, no stale count', async () => {
+  const f = host({ revision: 'r1', faces: [face('a', 'First', 'Regular')] });
+  let notified = 0; const off = onHostFontsChanged(() => { notified++; });
+  await setHostFontProvider(f.provider);
+  assert.deepEqual(getFontPickerNames(), ['First']);
+  await f.publish({ revision: 'r2', faces: [face('a', 'First', 'Regular'), face('b', 'Second 글꼴', 'Regular')] });
+  assert.deepEqual(getFontPickerNames(), sorted(['First', 'Second 글꼴']), 'imported font appears without reloading anything');
+  await f.publish({ revision: 'r3', faces: [face('b', 'Second 글꼴', 'Regular')] });
+  assert.deepEqual(getFontPickerNames(), ['Second 글꼴'], 'deleted font disappears');
+  await f.publish({ revision: 'r4', faces: [] });
+  assert.deepEqual(getFontPickerNames(), [], 'empty catalog = empty list');
+  await setHostFontProvider(null);
+  assert.deepEqual(getHostFontPickerNames(), [], 'provider disconnected');
+  assert.ok(notified >= 3, 'the toolbar is told about every change');
+  off();
+});
+
+test('the picker never owns document fonts: base/document font lists are untouched and selection keeps a document font that is not installed', () => {
+  const root = (rel: string) => readFileSync(fileURLToPath(new URL(`../src/${rel}`, import.meta.url)), 'utf8');
+  const toolbar = root('ui/toolbar.ts');
+  // PC defaults and document fonts still come first/unchanged; only the system/all lists use the merged names
+  assert.match(toolbar, /const documentFonts = this\.fontMenuDocumentFonts\.map/);
+  assert.match(toolbar, /const baseFonts = BASE_FONTS\.map/);
+  assert.equal((toolbar.match(/getFontPickerNames\(\)/g) ?? []).length, 2, 'system and all categories');
+  assert.doesNotMatch(toolbar, /getLocalFonts\(\)/);
+  assert.match(toolbar, /onHostFontsChanged\(\(\) => \{\s*void prepareHostFontCatalog\(\)\.then\(\(\) => \{\s*if \(this\.fontMenu\) this\.renderFontMenu\(this\.fontMenu\)/);
+  const dialog = root('ui/char-shape-dialog.ts');
+  assert.match(dialog, /const localFonts = getFontPickerNames\(\)/);
+  assert.match(dialog, /if \(this\.fontSelect\.value !== fontName && fontName\)/, 'a document font absent from the list is still shown (option added)');
+  assert.match(root('ui/font-set-edit-dialog.ts'), /const localFonts = getFontPickerNames\(\)/);
+  for (const file of ['ui/toolbar.ts', 'ui/char-shape-dialog.ts', 'ui/font-set-edit-dialog.ts']) assert.doesNotMatch(root(file), /import \{ getLocalFonts \}/, file);
+});
