 }
 
-export type OpenRecentResult = 'opened' | 'permission-denied' | 'removed' | 'needs-pick';
+export type OpenRecentResult = 'opened' | 'permission-denied' | 'removed' | 'needs-pick' | 'failed';
+
+/**
+ * [hwpxxx-android] 셸이 관리하는 항목의 재열기. 셸이 권한·존재·읽기를 재확인해 새 핸들을 준다.
+ * - NotFoundError   → 항목 제거 + 안내
+ * - NotAllowedError → 항목 유지 + 안내 + 파일 선택 창(권한이 사라졌어도 죽은 명령이 되지 않는다)
+ * - 그 밖의 오류    → 안내(항목 유지)
+ * 성공하면 일반 열기 경로(open-document-bytes, 저장하지 않은 변경 확인 포함)로 넘긴다.
+ */
+async function openHostRecent(entry: RecentDoc, deps: OpenRecentDeps): Promise<OpenRecentResult> {
+  const open = deps.hostOpen ?? ((id: string) => {
+    const store = androidRecentStore();
+    if (!store) throw new DOMException('셸의 최근 문서 저장소가 없습니다.', 'NotAllowedError');
+    return store.open(id);
+  });
+  const fail = async (err: unknown): Promise<OpenRecentResult> => {
+    const name = (err as { name?: string } | null)?.name;
+    if (name === 'NotFoundError') {
+      await deps.remove(entry.id);
+      deps.toast(`"${entry.fileName}" 파일을 찾을 수 없어 목록에서 제거했습니다.`, 3500);
+      return 'removed';
+    }
+    if (name === 'NotAllowedError') {
+      deps.toast(`"${entry.fileName}"에 접근할 수 없어요(권한이 바뀌었을 수 있어요). 파일을 다시 선택해 주세요.`, 4500);
+      deps.requestReopen?.();
+      return 'needs-pick';
+    }
+    const message = err instanceof Error ? err.message : String(err);
+    deps.toast(`"${entry.fileName}"을(를) 열지 못했어요: ${message}`, 4500);
+    return 'failed';
+  };
+  let handle: FileSystemFileHandleLike;
+  try {
+    handle = await open(entry.id);
+  } catch (err) {
+    return fail(err);
+  }
+  try {
+    const { bytes, name } = await deps.readFile(handle);
+    deps.emitOpen({ bytes, fileName: name, fileHandle: handle });
+    return 'opened';
+  } catch (err) {
+    return fail(err);
+  }
+}
 
