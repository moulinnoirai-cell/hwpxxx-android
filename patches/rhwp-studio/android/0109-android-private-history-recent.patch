diff --git a/rhwp-studio/src/hwpxxx/android-state.ts b/rhwp-studio/src/hwpxxx/android-state.ts
new file mode 100644
index 0000000..718747f
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/android-state.ts
@@ -0,0 +1,77 @@
+// [hwpxxx-android] 문서 이력·최근 문서의 영속 저장을 Android 셸의 비공개(암호화) 저장소로 돌리는 얇은 어댑터.
+//
+// 셸(`window.AndroidStudioHost`, 별칭 `rhwpAndroidHost`)이 있으면 브라우저 저장소(IndexedDB 등)는 이 두 기능에 쓰지 않는다.
+//   - 이력 스냅샷은 전체 문서(IR JSON)이므로 평문으로 남기면 안 된다: 셸의 `history` 저장소(AES-GCM)에만 맡긴다.
+//     저장소가 없거나 암호 문서이면 이 세션의 메모리에만 두고 사용자에게 알린다(기기 키로만 보호된 사본이 문서 암호를 우회하지 않게).
+//   - 최근 문서는 네이티브 핸들을 구조화 복제할 수 없어 메타데이터만 남던 항목을, 셸의 `recent` 저장소(불투명 ID)로 대신한다.
+// 계약: /workspace/.cloud-setup/dex-parity-task/builder-persistence-contract.md (이 저장소의 docs 에도 같은 내용).
+
+import { getAndroidHost } from './android-host.ts';
+
+export const MAX_HISTORY_SNAPSHOT_BYTES = 32 * 1024 * 1024;
+export const MAX_HISTORY_META_BYTES = 4 * 1024;
+
+export interface HostHistoryMeta {
+  id: string;
+  label: string;
+  createdAt: number;
+  sourceFileName: string;
+  byteLength: number;
+  storageKind: 'ir';
+}
+
+export interface HostHistoryStore {
+  list(): Promise<HostHistoryMeta[]>;
+  put(meta: HostHistoryMeta, snapshot: Uint8Array): Promise<void>;
+  get(id: string): Promise<Uint8Array | null>;
+  delete(id: string): Promise<void>;
+  clear(): Promise<void>;
+}
+
+export interface HostRecentEntry {
+  id: string;
+  fileName: string;
+  sourceFormat: string;
+  openedAt: number;
+  /** 셸이 이 항목을 권한·존재 재확인 뒤 다시 열 수 있는가. false 면 파일을 다시 고르게 한다. */
+  reopenable: boolean;
+}
+
+export interface HostRecentStore {
+  list(): Promise<HostRecentEntry[]>;
+  add(entry: { fileName: string; sourceFormat: string }, handle: unknown): Promise<void>;
+  open(id: string): Promise<any>;
+  remove(id: string): Promise<void>;
+  clear(): Promise<void>;
+}
+
+interface StateHost { history?: HostHistoryStore; recent?: HostRecentStore }
+
+/** undefined: 셸 없음(데스크톱 동작) · null: 셸은 있는데 저장소가 없음 · 그 밖: 셸의 저장소. */
+export function androidHistoryStore(): HostHistoryStore | null | undefined {
+  const host = getAndroidHost() as unknown as StateHost | null;
+  if (!host) return undefined;
+  return host.history ?? null;
+}
+
+export function androidRecentStore(): HostRecentStore | null | undefined {
+  const host = getAndroidHost() as unknown as StateHost | null;
+  if (!host) return undefined;
+  return host.recent ?? null;
+}
+
+export type HistoryVolatileReason = 'encrypted' | 'no-store';
+
+const volatileReasons = new Map<string, HistoryVolatileReason>();
+
+export function markHistoryVolatile(id: string, reason: HistoryVolatileReason): void { volatileReasons.set(id, reason); }
+export function forgetHistoryVolatile(id: string): void { volatileReasons.delete(id); }
+export function clearHistoryVolatile(): void { volatileReasons.clear(); }
+/** 이 스냅샷이 메모리에만 있고 이유가 무엇인가(저장된 것이면 undefined). */
+export function historyVolatileReason(id: string): HistoryVolatileReason | undefined { return volatileReasons.get(id); }
+
+export function historyVolatileNotice(reason: HistoryVolatileReason): string {
+  return reason === 'encrypted'
+    ? '암호 문서의 이력은 기기에 저장하지 않고 이 앱을 닫을 때까지만 보관해요.'
+    : '이 기기에 비공개 저장소가 없어 이력을 이 앱을 닫을 때까지만 보관해요.';
+}
