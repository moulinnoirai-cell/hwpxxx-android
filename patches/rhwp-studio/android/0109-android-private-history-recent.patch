+// [hwpxxx-android] 문서 이력·최근 문서의 Android 영속화(셸의 비공개 저장소 어댑터) 시험.
+// 셸 저장소는 메모리 시험용 구현이며(실제 암호화·Keystore 는 PrivateStateStoreTest.java 가 확인), 여기서는 Studio 쪽 규칙만 고정한다:
+//   · 셸이 있으면 IndexedDB·localStorage 를 건드리지 않는다  · 저장소 오류는 숨기지 않는다  · 암호 문서·저장소 없음 → 세션 메모리만 + 알림
+//   · 최근 문서는 불투명 ID 로 다시 열고, 권한 취소는 죽은 명령이 아니라 다시 고르기로 이어진다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import {
+  clearHistory, deleteHistorySnapshot, getHistoryPayload, listHistoryMeta, saveHistoryIrSnapshot,
+} from '../src/history/idb-store.ts';
+import { addRecentDoc, clearRecentDocs, listRecentDocs, removeRecentDoc } from '../src/recent/recent-store.ts';
+import { openRecentEntry } from '../src/recent/recent-open.ts';
+import { androidHistoryStore, androidRecentStore, historyVolatileNotice, historyVolatileReason } from '../src/hwpxxx/android-state.ts';
+
+const g = globalThis as Record<string, any>;
+const src = (rel: string) => readFileSync(fileURLToPath(new URL(`../src/${rel}`, import.meta.url)), 'utf8');
+
+// Any IndexedDB / localStorage use while the shell exists is a failure of the whole point of this patch.
+let touched: string[] = [];
+const guardGlobals = () => {
+  touched = [];
+  g.indexedDB = { open() { touched.push('indexedDB.open'); throw new Error('IndexedDB must not be used in Android mode'); }, databases() { touched.push('indexedDB.databases'); return Promise.resolve([]); } };
+  g.localStorage = new Proxy({}, { get(_t, k) { touched.push(`localStorage.${String(k)}`); throw new Error('localStorage must not be used'); } });
+};
+const unguardGlobals = () => { delete g.indexedDB; delete g.localStorage; delete g.AndroidStudioHost; delete g.rhwpAndroidHost; };
+
+function memoryHistory(opts: { failPut?: boolean; failList?: boolean } = {}) {
+  const rows = new Map<string, { meta: any; data: Uint8Array }>(); const calls: string[] = [];
+  return {
+    rows, calls,
+    async list() { calls.push('list'); if (opts.failList) throw new Error('native list failed'); return [...rows.values()].map((r) => r.meta); },
+    async put(meta: any, data: Uint8Array) { calls.push('put'); if (opts.failPut) throw new Error('native put failed'); rows.set(meta.id, { meta, data: new Uint8Array(data) }); },
+    async get(id: string) { calls.push('get'); return rows.get(id)?.data ?? null; },
+    async delete(id: string) { calls.push('delete'); rows.delete(id); },
+    async clear() { calls.push('clear'); rows.clear(); },
+  };
+}
+function memoryRecent() {
+  const rows = new Map<string, any>(); const calls: any[] = []; let next = 1;
+  const store: any = {
+    rows, calls, openError: null as any,
+    async list() { calls.push(['list']); return [...rows.values()]; },
+    async add(entry: any, handle: any) { calls.push(['add', entry, handle]); rows.set('h' + next, { id: 'h' + next++, ...entry, openedAt: Date.now() + next, reopenable: !!handle }); },
+    async open(id: string) { calls.push(['open', id]); if (store.openError) throw store.openError; return { kind: 'file', name: rows.get(id).fileName, opened: id }; },
+    async remove(id: string) { calls.push(['remove', id]); rows.delete(id); },
+    async clear() { calls.push(['clear']); rows.clear(); },
+  };
+  return store;
+}
+const snapshot = (n = 1) => ({ label: 'L' + n, paragraphs: [{ text: '본문 ' + n, stable_id: 'p' + n }] }) as any;
+const dom = (name: string, message = name) => Object.assign(new Error(message), { name });
+
