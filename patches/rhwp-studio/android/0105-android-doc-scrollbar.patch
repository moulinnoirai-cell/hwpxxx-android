@@ -0,0 +1,163 @@
+/**
+ * [hwpxxx] 문서 영역 오른쪽의 항상 보이는 세로 스크롤바.
+ *
+ * Android WebView 의 스크롤바는 스크롤할 때만 잠깐 나타났다 사라지고 손가락·마우스로 잡을 수 없다. 긴 문서에서 지금 위치를
+ * 알기 어렵고 먼 쪽으로 한 번에 갈 수 없어, 문서 영역(`#scroll-container`) 오른쪽에 늘 보이는 막대를 따로 둔다.
+ * 막대는 스크롤 위치를 그대로 비추기만 한다: 손잡이를 끌거나 빈 곳을 누르면 `scrollTop` 을 바꾸고, 나머지(쪽 그리기·캐럿)는
+ * 기존 scroll 이벤트 경로가 처리한다. 문서가 화면보다 짧으면 길만 보이고 손잡이는 숨는다.
+ * 손잡이를 끄는 동안에는 옆에 지금 쪽(상태 표시줄과 같은 글)을 띄우고, 길 위에는 메모가 달린 자리를 작은 표시로 보여 준다.
+ */
+export interface DocScrollbarOptions {
+  /** 끄는 동안 손잡이 옆에 띄울 글(예: "3 / 12 쪽"). 빈 글이면 띄우지 않는다. */
+  pageLabel?: () => string;
+  /** 문서 내용(`#scroll-content`) 안에서 길에 표시할 요소(메모 상자 등)의 선택자. */
+  markSelector?: string;
+}
+
+export const MAX_TRACK_MARKS = 200;
+
+/**
+ * 문서 안 세로 위치들(px) → 길 위 표시 위치(px). 문서 전체 높이에 대한 비율로 놓고, 같은 자리(2px 이내)에 겹치는 것은 하나로 줄인다.
+ * 표시가 길 밖으로 나가지 않게 `markHeight` 만큼 안쪽에 둔다.
+ */
+export function trackMarkOffsets(positions: readonly number[], scrollHeight: number, trackHeight: number, markHeight = 3, limit: number = MAX_TRACK_MARKS): number[] {
+  if (!(scrollHeight > 0) || !(trackHeight > markHeight)) return [];
+  const out: number[] = [];
+  const sorted = positions.filter(y => Number.isFinite(y)).map(y => Math.min(1, Math.max(0, y / scrollHeight)) * (trackHeight - markHeight)).sort((a, b) => a - b);
+  for (const offset of sorted) {
+    if (out.length && offset - out[out.length - 1] < 2) continue;
+    out.push(Math.round(offset * 100) / 100);
+    if (out.length >= limit) break;
+  }
+  return out;
+}
+
+export interface ThumbGeometry {
+  /** 손잡이 길이(px). 스크롤할 것이 없으면 0. */
+  size: number;
+  /** 길 위쪽에서 손잡이 위쪽까지(px). */
+  offset: number;
+}
+
+export const MIN_THUMB_PX = 36;
+
+/** 스크롤 상태 → 손잡이 위치·길이. */
+export function thumbGeometry(scrollTop: number, scrollHeight: number, clientHeight: number, trackHeight: number, minThumb: number = MIN_THUMB_PX): ThumbGeometry {
+  const range = scrollHeight - clientHeight;
+  if (!(range > 0.5) || !(trackHeight > 0) || !(clientHeight > 0)) return { size: 0, offset: 0 };
+  const size = Math.min(trackHeight, Math.max(Math.min(minThumb, trackHeight), trackHeight * clientHeight / scrollHeight));
+  const travel = trackHeight - size;
+  const ratio = Math.min(1, Math.max(0, scrollTop / range));
+  return { size, offset: travel * ratio };
+}
+
+/** 손잡이 위쪽 위치(px) → scrollTop. `thumbGeometry` 의 역. */
+export function scrollTopForThumbOffset(offset: number, scrollHeight: number, clientHeight: number, trackHeight: number, minThumb: number = MIN_THUMB_PX): number {
+  const range = scrollHeight - clientHeight;
+  if (!(range > 0.5) || !(trackHeight > 0)) return 0;
+  const size = Math.min(trackHeight, Math.max(Math.min(minThumb, trackHeight), trackHeight * clientHeight / scrollHeight));
+  const travel = trackHeight - size;
+  if (!(travel > 0)) return 0;
+  return Math.min(range, Math.max(0, offset / travel * range));
+}
+
+/** 문서 영역에 세로 스크롤바를 붙인다. 정리 함수를 돌려준다. */
+export function installDocScrollbar(container: HTMLElement, options: DocScrollbarOptions = {}): () => void {
+  const host = container.parentElement;
+  if (!host || host.querySelector(':scope > .hwpxxx-vscroll')) return () => {};
+  const track = document.createElement('div');
+  track.className = 'hwpxxx-vscroll';
+  track.setAttribute('aria-hidden', 'true'); // 키보드·보조 기술은 문서 영역 자체의 스크롤을 쓴다
+  const thumb = document.createElement('div');
+  thumb.className = 'hwpxxx-vscroll-thumb';
+  const marks = document.createElement('div');
+  marks.className = 'hwpxxx-vscroll-marks';
+  const bubble = document.createElement('div');
+  bubble.className = 'hwpxxx-vscroll-bubble';
+  bubble.hidden = true;
+  track.append(marks, thumb, bubble);
+  container.insertAdjacentElement('afterend', track);
+  document.body.classList.add('hwpxxx-vscroll-on');
+
+  let frame = 0;
+  let marksStale = true;
+  let drag: { pointerId: number; grab: number } | null = null;
+  const content = container.querySelector<HTMLElement>('#scroll-content');
+  const renderMarks = () => {
+    marksStale = false;
+    const found = options.markSelector && content ? Array.from(content.querySelectorAll<HTMLElement>(options.markSelector)) : [];
+    const top = content?.getBoundingClientRect().top ?? 0;
+    // 문서 내용 위쪽에서 잰 위치: 스크롤 위치와 무관하다.
+    const offsets = trackMarkOffsets(found.map(el => el.getBoundingClientRect().top - top + (content?.offsetTop ?? 0)), container.scrollHeight, track.clientHeight);
+    while (marks.childElementCount > offsets.length) marks.lastElementChild!.remove();
+    while (marks.childElementCount < offsets.length) marks.appendChild(document.createElement('i'));
+    offsets.forEach((offset, i) => { (marks.children[i] as HTMLElement).style.transform = `translateY(${offset}px)`; });
+  };
+  const render = () => {
+    frame = 0;
+    const g = thumbGeometry(container.scrollTop, container.scrollHeight, container.clientHeight, track.clientHeight);
+    thumb.hidden = g.size <= 0;
+    if (g.size > 0) {
+      thumb.style.height = `${g.size}px`;
+      thumb.style.transform = `translateY(${g.offset}px)`;
+    }
+    if (marksStale) renderMarks();
+    const label = drag && g.size > 0 ? (options.pageLabel?.() ?? '').trim() : '';
+    bubble.hidden = !label;
+    if (label) {
+      bubble.textContent = label;
+      bubble.style.transform = `translateY(${g.offset + g.size / 2}px) translateY(-50%)`;
+    }
+  };
+  const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
+  const scheduleMarks = () => { marksStale = true; schedule(); };
+
+  const moveTo = (clientY: number, grab: number) => {
+    const top = track.getBoundingClientRect().top;
+    container.scrollTop = scrollTopForThumbOffset(clientY - top - grab, container.scrollHeight, container.clientHeight, track.clientHeight);
+  };
+  const onDown = (e: PointerEvent) => {
+    if (e.button !== 0 || thumb.hidden) return;
+    e.preventDefault(); // 문서의 글자 선택·포커스 이동을 일으키지 않는다
+    const rect = thumb.getBoundingClientRect();
+    // 손잡이를 잡으면 잡은 자리를 유지하고, 빈 길을 누르면 손잡이 가운데가 그 자리로 온다.
+    const grab = e.target === thumb ? e.clientY - rect.top : rect.height / 2;
+    drag = { pointerId: e.pointerId, grab };
+    try { track.setPointerCapture(e.pointerId); } catch { /* 합성 이벤트 */ }
+    track.classList.add('dragging');
+    moveTo(e.clientY, grab);
+    schedule(); // 스크롤 위치가 그대로여도 쪽 표시를 띄운다
+  };
+  const onMove = (e: PointerEvent) => { if (drag && e.pointerId === drag.pointerId) { e.preventDefault(); moveTo(e.clientY, drag.grab); } };
+  const onUp = (e: PointerEvent) => {
+    if (!drag || e.pointerId !== drag.pointerId) return;
+    drag = null;
+    track.classList.remove('dragging');
+    try { track.releasePointerCapture(e.pointerId); } catch { /* 이미 풀림 */ }
+    schedule(); // 쪽 표시를 지운다
+  };
+  track.addEventListener('pointerdown', onDown);
+  track.addEventListener('pointermove', onMove);
+  track.addEventListener('pointerup', onUp);
+  track.addEventListener('pointercancel', onUp);
+  container.addEventListener('scroll', schedule, { passive: true });
+  window.addEventListener('resize', scheduleMarks);
+  const observer = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(scheduleMarks) : null;
+  observer?.observe(container);
+  observer?.observe(track);
+  if (content) observer?.observe(content);
+  // 메모가 생기거나 지워지면(요소가 바뀌면) 표시를 다시 놓는다. 스타일 변화(캐럿 깜빡임 등)는 보지 않는다.
+  const mutations = options.markSelector && content && typeof MutationObserver !== 'undefined' ? new MutationObserver(scheduleMarks) : null;
+  if (content) mutations?.observe(content, { childList: true, subtree: true });
+  schedule();
+
+  return () => {
+    if (frame) cancelAnimationFrame(frame);
+    observer?.disconnect();
+    mutations?.disconnect();
+    container.removeEventListener('scroll', schedule);
+    window.removeEventListener('resize', scheduleMarks);
+    track.remove();
+    document.body.classList.remove('hwpxxx-vscroll-on');
+  };
+}
