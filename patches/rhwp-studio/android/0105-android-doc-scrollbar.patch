@@ -0,0 +1,53 @@
+/* [hwpxxx] 문서 영역 오른쪽의 항상 보이는 세로 스크롤바 — hwpxxx/doc-scrollbar.ts */
+.hwpxxx-vscroll {
+  grid-column: 2;
+  grid-row: 2;
+  justify-self: end;
+  position: relative;
+  width: 16px;
+  z-index: 20;
+  background: var(--ruler-bg, #f0f0f0);
+  border-left: 1px solid var(--ui-border-strong, #c8c8c8);
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  cursor: default;
+}
+.hwpxxx-vscroll-thumb {
+  position: absolute;
+  top: 0;
+  left: 3px;
+  right: 3px;
+  border-radius: 5px;
+  background: var(--color-text-muted, #8a8a8a);
+  opacity: 0.75;
+  will-change: transform;
+}
+.hwpxxx-vscroll:hover .hwpxxx-vscroll-thumb,
+.hwpxxx-vscroll.dragging .hwpxxx-vscroll-thumb { opacity: 1; }
+.hwpxxx-vscroll-thumb[hidden] { display: none; }
+/* 메모가 달린 자리 */
+.hwpxxx-vscroll-marks { position: absolute; inset: 0; pointer-events: none; }
+.hwpxxx-vscroll-marks > i { position: absolute; top: 0; left: 1px; right: 1px; height: 3px; border-radius: 1px; background: #e0a800; }
+/* 끄는 동안 손잡이 옆에 띄우는 쪽 표시 */
+.hwpxxx-vscroll-bubble {
+  position: absolute;
+  top: 0;
+  right: 22px;
+  padding: 6px 10px;
+  border-radius: 6px;
+  background: rgba(32, 32, 32, 0.92);
+  color: #fff;
+  font-size: 13px;
+  line-height: 1.2;
+  white-space: nowrap;
+  pointer-events: none;
+}
+.hwpxxx-vscroll-bubble[hidden] { display: none; }
+/* 막대 자리만큼 문서 영역을 줄이고, 겹치는 기본 세로 스크롤바는 숨긴다(가로는 그대로). */
+body.hwpxxx-vscroll-on #scroll-container { margin-right: 16px; }
+body.hwpxxx-vscroll-on #scroll-container::-webkit-scrollbar { width: 0; height: 10px; }
+body.hwpxxx-vscroll-on #scroll-container::-webkit-scrollbar-thumb { background: var(--color-text-muted, #8a8a8a); border-radius: 5px; border: 2px solid transparent; background-clip: padding-box; }
+body.hwpxxx-vscroll-on #scroll-container::-webkit-scrollbar-track,
+body.hwpxxx-vscroll-on #scroll-container::-webkit-scrollbar-corner { background: transparent; }
+@media print { .hwpxxx-vscroll { display: none !important; } body.hwpxxx-vscroll-on #scroll-container { margin-right: 0; } }
diff --git a/rhwp-studio/tests/hwpxxx-doc-scrollbar.test.ts b/rhwp-studio/tests/hwpxxx-doc-scrollbar.test.ts
new file mode 100644
index 0000000..ea4442f
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-doc-scrollbar.test.ts
@@ -0,0 +1,71 @@
+// [hwpxxx] 문서 영역의 항상 보이는 세로 스크롤바: 손잡이 위치 계산과 편집기 연결.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { thumbGeometry, scrollTopForThumbOffset, trackMarkOffsets, MIN_THUMB_PX, MAX_TRACK_MARKS } from '../src/hwpxxx/doc-scrollbar.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+test('스크롤할 것이 없으면 손잡이가 없다', () => {
+  assert.deepEqual(thumbGeometry(0, 500, 500, 500), { size: 0, offset: 0 });
+  assert.deepEqual(thumbGeometry(0, 400, 500, 500), { size: 0, offset: 0 });
+  assert.deepEqual(thumbGeometry(0, 1000, 500, 0), { size: 0, offset: 0 });
+});
+
+test('손잡이 길이는 보이는 비율을 따르고, 위치는 처음과 끝에서 길의 양 끝에 닿는다', () => {
+  assert.deepEqual(thumbGeometry(0, 2000, 500, 500), { size: 125, offset: 0 });
+  assert.deepEqual(thumbGeometry(1500, 2000, 500, 500), { size: 125, offset: 375 });
+  assert.deepEqual(thumbGeometry(750, 2000, 500, 500), { size: 125, offset: 187.5 });
+  // 범위를 벗어난 값(탄성 스크롤)은 양 끝에 붙인다.
+  assert.equal(thumbGeometry(-50, 2000, 500, 500).offset, 0);
+  assert.equal(thumbGeometry(9999, 2000, 500, 500).offset, 375);
+});
+
+test('아주 긴 문서에서도 손잡이는 잡을 수 있는 최소 길이를 지킨다', () => {
+  const g = thumbGeometry(500000, 1000000, 500, 500);
+  assert.equal(g.size, MIN_THUMB_PX);
+  assert.ok(Math.abs(g.offset - (500 - MIN_THUMB_PX) * 500000 / 999500) < 1e-9);
+  // 길이 최소 길이보다 짧으면 길 전체를 넘지 않는다.
+  assert.equal(thumbGeometry(0, 1000000, 20, 20).size, 20);
+});
+
+test('손잡이 위치 → scrollTop 은 위치 계산의 역이다', () => {
+  for (const [scrollHeight, client, track] of [[2000, 500, 500], [1000000, 700, 640], [900, 600, 580]] as const) {
+    for (const top of [0, 1, (scrollHeight - client) / 3, scrollHeight - client]) {
+      const g = thumbGeometry(top, scrollHeight, client, track);
+      assert.ok(Math.abs(scrollTopForThumbOffset(g.offset, scrollHeight, client, track) - top) < 1e-6, `${scrollHeight}/${client}/${track}@${top}`);
+    }
+    assert.equal(scrollTopForThumbOffset(-100, scrollHeight, client, track), 0);
+    assert.equal(scrollTopForThumbOffset(1e9, scrollHeight, client, track), scrollHeight - client);
+  }
+  assert.equal(scrollTopForThumbOffset(10, 500, 500, 500), 0);
+});
+
+test('편집기가 문서 영역에 스크롤바를 붙이고, 기본 세로 스크롤바 자리를 비운다', () => {
+  assert.match(source('main.ts'), /installDocScrollbar\(container, \{ pageLabel: \(\) => sbPage\(\)\.textContent \?\? '', markSelector: '\.hwpxxx-memo-box' \}\)/);
+  const css = source('styles/hwpxxx-scrollbar.css');
+  assert.match(css, /body\.hwpxxx-vscroll-on #scroll-container \{ margin-right: 16px; \}/);
+  assert.match(css, /\.hwpxxx-vscroll \{[^}]*width: 16px;/);
+  assert.match(css, /@media print \{ \.hwpxxx-vscroll \{ display: none !important; \}/);
+});
+
+test('메모 자리는 문서 높이에 대한 비율로 길 위에 놓고, 겹치는 것은 하나로 줄인다', () => {
+  // 문서 1000px, 길 503px(표시 높이 3) → 쓸 수 있는 길 500px
+  assert.deepEqual(trackMarkOffsets([0, 500, 1000], 1000, 503), [0, 250, 500]);
+  // 순서와 무관하고, 2px 안에 겹치면 하나만 남긴다
+  assert.deepEqual(trackMarkOffsets([502, 100, 500, 101], 1000, 503), [50, 250]);
+  // 범위 밖·이상한 값
+  assert.deepEqual(trackMarkOffsets([-50, 2000, Number.NaN], 1000, 503), [0, 500]);
+  assert.deepEqual(trackMarkOffsets([10], 0, 503), []);
+  assert.deepEqual(trackMarkOffsets([10], 1000, 2), []);
+  // 표시 수 한도
+  const many = Array.from({ length: 5000 }, (_, i) => i * 100);
+  assert.equal(trackMarkOffsets(many, 500000, 100003).length, MAX_TRACK_MARKS);
+});
+
+test('끄는 동안에만 쪽 표시를 띄우고, 메모 요소가 바뀌면 표시를 다시 놓는다', () => {
+  const code = source('hwpxxx/doc-scrollbar.ts');
+  assert.match(code, /const label = drag && g\.size > 0 \? \(options\.pageLabel\?\.\(\) \?\? ''\)\.trim\(\) : '';/);
+  assert.match(code, /mutations\?\.observe\(content, \{ childList: true, subtree: true \}\)/);
+  assert.match(source('styles/hwpxxx-scrollbar.css'), /\.hwpxxx-vscroll-marks \{[^}]*pointer-events: none;/);
+});
