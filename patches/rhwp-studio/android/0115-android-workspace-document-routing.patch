+export type AndroidWorkspaceAction = 'new' | 'open' | 'recent';
+
+/** 호스트가 자식 탭의 첫 동작을 제자리(옛 경로)로 실행시키는 명령별 표식. 전역 플래그가 아니라 명령과 함께 다닌다. */
+export const ANDROID_WORKSPACE_IN_PLACE = 'androidWorkspaceInPlace';
+
+/**
+ * 열기/새 문서를 새 탭으로 보내야 하는가. 호스트가 없거나 작업 공간이 꺼졌거나, 명령이 제자리 표식을 달고 왔으면 false(옛 동작).
