@@ -0,0 +1,91 @@
+// [hwpxxx-android] 작업 공간(탭) 라우팅 시험 — 실제 file.ts 명령과 android-host.ts 라우팅 헬퍼를 합성 호스트로 실행한다.
+// 문서·핸들은 모두 합성 값이다(사용자 문서 없음).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { register } from 'node:module';
+import { spawnSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+register(new URL('./support/studio-alias-hooks.mjs', import.meta.url), import.meta.url);
+const g = globalThis as Record<string, any>;
+g.window ??= new EventTarget();
+import { readFileSync } from 'node:fs';
+const { androidWorkspaceRouting, ANDROID_WORKSPACE_IN_PLACE, routeAndroidWorkspaceAction, handleAndroidWorkspaceAction } = await import('../src/hwpxxx/android-host.ts');
+function setup(workspace: Record<string, unknown> | undefined, recents: Array<Record<string, unknown>> = []) {
+  const calls: string[] = [];
+  const emitted: string[] = [];
+  g.AndroidStudioHost = {
+    ...(workspace ? { workspace: {
+      version: 1,
+      newDocument: async () => { calls.push('new'); return true; },
+      openDocument: async () => { calls.push('open'); return true; },
+      openRecent: async (id: string) => { calls.push('recent:' + id); return true; },
+      ...workspace,
+    } } : {}),
+    recent: { list: async () => recents, open: async () => { throw new Error('legacy recent must not be used here'); } },
+  };
+  const services = { eventBus: { emit: (name: string) => { emitted.push(name); } } } as never;
+  return { calls, emitted, services };
+}
+const cleanup = () => { delete g.AndroidStudioHost; delete g.rhwpAndroidHost; };
+
+test('제자리 표식은 정확한 값(true)일 때만, 명령 params 에서만 우회한다', () => {
+  setup({ enabled: true });
+  assert.equal(ANDROID_WORKSPACE_IN_PLACE, 'androidWorkspaceInPlace');
+  assert.equal(androidWorkspaceRouting(), true);
+  assert.equal(androidWorkspaceRouting({}), true);
+  assert.equal(androidWorkspaceRouting({ androidWorkspaceInPlace: true }), false);
+  for (const value of ['true', 1, {}, null]) assert.equal(androidWorkspaceRouting({ androidWorkspaceInPlace: value }), true, String(value));
+  cleanup();
+});
+
+test('작업 공간이 없거나 꺼져 있으면 라우팅하지 않는다(옛 동작)', async () => {
+  cleanup();
+  assert.equal(androidWorkspaceRouting(), false);
+  setup(undefined);
+  assert.equal(androidWorkspaceRouting(), false);
+  const off = setup({ enabled: false });
+  assert.equal(androidWorkspaceRouting(), false);
+  assert.deepEqual(off.calls, []);
+  assert.equal(await routeAndroidWorkspaceAction('new'), false, '꺼진 작업 공간은 호스트 함수를 부르지 않고 false');
+  cleanup();
+});
+
+test('순수 헬퍼: 처리됨/처리 안 함/오류(사용자 안내 + 현재 문서 유지)', async () => {
+  let r = setup({ enabled: true });
+  const messages: string[] = [];
+  assert.equal(await handleAndroidWorkspaceAction('open', undefined, (m) => messages.push(m)), true);
+  assert.equal(await handleAndroidWorkspaceAction('recent', 'id_1', (m) => messages.push(m)), true);
+  assert.deepEqual(r.calls, ['open', 'recent:id_1']);
+  assert.equal(await routeAndroidWorkspaceAction('recent', ''), false, '빈 ID 는 보내지 않는다');
+  assert.equal(await routeAndroidWorkspaceAction('recent', undefined), false);
+  r = setup({ enabled: true, openDocument: async () => { throw new Error('탭은 최대 8개까지 열 수 있어요.'); } });
+  assert.equal(await handleAndroidWorkspaceAction('open', undefined, (m) => messages.push(m)), true, '오류여도 true: 옛 제자리 열기로 폴백하지 않는다');
+  assert.deepEqual(messages, ['새 탭을 열지 못했어요: 탭은 최대 8개까지 열 수 있어요.']);
+  r = setup({ enabled: true, newDocument: async () => false });
+  assert.equal(await handleAndroidWorkspaceAction('new', undefined, () => assert.fail('안내 없음')), false);
+  cleanup();
+});
+
+test('소스 배선: 세 명령 모두 시작 시점에 라우팅을 동기로 읽고, 옛 경로는 그대로 남아 있다', () => {
+  const file = readFileSync(new URL('../src/command/commands/file.ts', import.meta.url), 'utf8');
+  const strip = (code: string) => code.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '');
+  const code = strip(file);
+  const block = (id: string) => { const i = code.indexOf(`id: '${id}'`); return code.slice(i, code.indexOf('\n  },', i)); };
+  assert.match(block('file:new-doc'), /androidWorkspaceRouting\(params\)[\s\S]*androidWorkspaceHandled\('new'\)[\s\S]*services\.eventBus\.emit\('create-new-document'\)/);
+  assert.match(block('file:open'), /androidWorkspaceRouting\(params\)[\s\S]*androidWorkspaceHandled\('open'\)[\s\S]*openFileViaPicker\(services\)/);
+  const recent = block('file:open-recent');
+  assert.ok(recent.indexOf('androidWorkspaceRouting(params)') < recent.indexOf('await listRecentDocs()'), '제자리 표식은 첫 await 전에 읽는다');
+  assert.match(recent, /routeToWorkspace && entry\.hostManaged && await androidWorkspaceHandled\('recent', id\)/);
+  assert.match(code, /requestReopen: \(\) => \{ void openFileViaPicker\(services\); \}/, '최근 문서 재선택은 제자리 열기(새 탭을 또 만들지 않음)');
+});
+
+// 실제 file.ts 명령(새 문서·열기·최근 문서)을 합성 호스트로 실행하는 러너. file.ts 가 끌어오는 UI 모듈의 매개변수 속성 때문에
+// 기존 시험들처럼 --experimental-transform-types 자식 프로세스로 띄우고, 못 띄우면 실패로 드러낸다.
+test('명령 실행(file:new-doc / file:open / file:open-recent)이 작업 공간으로 라우팅된다 (자식 프로세스)', () => {
+  const runner = fileURLToPath(new URL('./support/android-workspace-routing.runner.mjs', import.meta.url));
+  const res = spawnSync(process.execPath, ['--experimental-transform-types', '--no-warnings', runner], { encoding: 'utf8' });
+  assert.ifError(res.error);
+  assert.equal(res.status, 0, `러너가 비정상 종료했습니다.\n--- stdout ---\n${res.stdout}\n--- stderr ---\n${res.stderr}`);
+  assert.match(res.stdout, /ANDROID_WORKSPACE_ROUTING_OK 11/, '11개 행위 검증 성공 마커');
+});
diff --git a/rhwp-studio/tests/support/android-workspace-routing.runner.mjs b/rhwp-studio/tests/support/android-workspace-routing.runner.mjs
