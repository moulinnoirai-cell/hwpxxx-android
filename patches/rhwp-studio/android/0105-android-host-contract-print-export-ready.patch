diff --git a/rhwp-studio/src/hwpxxx/android-save-verify.ts b/rhwp-studio/src/hwpxxx/android-save-verify.ts
new file mode 100644
index 0000000..1778eb6
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/android-save-verify.ts
@@ -0,0 +1,164 @@
+// [hwpxxx-android] 저장 직전 검증: 내보낸 바이트를 다시 열어 살아 있는 문서와 비교한다.
+//
+// 옛 Android 작업기(engine-worker.js)의 저장 검사(글 전체·쪽 수·쪽 그리기·서식·메모)와 같은 수준을
+// 편집 대상 추적 없이 문서 전체로 확장한 것이다. Studio 는 거의 모든 편집이 가능하므로 "건드린 곳만"
+// 비교할 수 없다. 모든 구역·문단(본문과 최상위 표 칸)의 문단/글자 속성, 표·칸 속성, 개체 목록, 메모를 비교한다.
+// 하나라도 다르면 던진다 — 호출한 쪽은 네이티브 저장 전에 멈춘다. 비밀번호는 이 모듈이 받지 않는다
+// (이미 열린 문서 두 개만 받는다).
+
+export interface VerifiableDocument {
+  getTextFileUnicode(): string;
+  pageCount(): number;
+  renderPageSvg(page: number): string;
+  getSectionCount(): number;
+  getParagraphCount(section: number): number;
+  getParagraphLength(section: number, para: number): number;
+  getCharPropertiesAt(section: number, para: number, offset: number): string;
+  getParaPropertiesAt(section: number, para: number): string;
+  getControls(): string;
+  getTableDimensions(section: number, para: number, control: number): string;
+  getTableProperties(section: number, para: number, control: number): string;
+  getCellProperties(section: number, para: number, control: number, cell: number): string;
+  getCellParagraphCount(section: number, para: number, control: number, cell: number): number;
+  getCellParagraphLength(section: number, para: number, control: number, cell: number, cellPara: number): number;
+  getCellCharPropertiesAt(section: number, para: number, control: number, cell: number, cellPara: number, offset: number): string;
+  getCellParaPropertiesAt(section: number, para: number, control: number, cell: number, cellPara: number): string;
+  getMemoList?: () => string;
+}
+
+export const ANDROID_MAX_SAVE_BYTES = 32 * 1024 * 1024;
+const MAX_PAGES = 500;
+
+/** 내보내기 때 다시 매겨지는 내부 번호(…Id)와 조판 결과로 다시 계산되는 값은 비교하지 않는다. */
+const DERIVED_KEYS = new Set(['height', 'tableHeight', 'paraShapeId', 'charShapeId']);
+/**
+ * HWP ↔ HWPX 변환(원본과 다른 형식으로 저장)에서만 건너뛰는 값: 두 형식이 기본값을 다르게 적는 필드다
+ * (예: 무늬 종류·색 -1/0, 영문 줄나눔 단위, 표의 쪽 안 제한·겹침 허용). 같은 형식 저장은 이 목록 없이 전부 비교한다.
+ */
+const CONVERSION_DEFAULT_KEYS = new Set(['patternType', 'patternColor', 'englishBreakUnit', 'restrictInPage', 'allowOverlap']);
+let skipConversionDefaults = false;
+const isIgnored = (key: string): boolean => DERIVED_KEYS.has(key) || /Id$/.test(key)
+  || (skipConversionDefaults && CONVERSION_DEFAULT_KEYS.has(key));
+
+function normalize(value: unknown): unknown {
+  if (Array.isArray(value)) return value.map(normalize);
+  if (value && typeof value === 'object') {
+    const out: Record<string, unknown> = {};
+    for (const key of Object.keys(value as object).sort()) {
+      if (isIgnored(key)) continue;
+      out[key] = normalize((value as Record<string, unknown>)[key]);
+    }
+    return out;
+  }
+  // 정수/소수 표기 차이(160 vs 160.0)는 같은 수다.
+  return typeof value === 'number' ? Math.round(value * 1000) / 1000 : value;
+}
+
+function same(a: unknown, b: unknown): boolean {
+  return JSON.stringify(normalize(a)) === JSON.stringify(normalize(b));
+}
+
+const parse = (json: string): unknown => JSON.parse(json);
+const lost = (what: string): Error =>
+  new Error(`저장한 문서에서 ${what}이(가) 달라 저장을 멈췄어요. 원본은 변경하지 않았어요.`);
+
+function samplePoints(length: number): number[] {
+  if (length <= 0) return [];
+  return [...new Set([0, Math.floor((length - 1) / 2), length - 1])];
+}
+
+function compareControls(live: VerifiableDocument, reopened: VerifiableDocument): Array<{ para: number; ctrl: number }> {
+  const key = (c: Record<string, unknown>) => ({
+    ctrlId: String(c.ctrlId ?? '').trim(), list: c.list, para: c.para,
+  });
+  const a = (parse(live.getControls()) as Array<Record<string, unknown>>);
+  const b = (parse(reopened.getControls()) as Array<Record<string, unknown>>);
+  const strip = (items: Array<Record<string, unknown>>) => items
+    .map(key)
+    .filter((c) => c.ctrlId !== '' && !c.ctrlId.startsWith('%'));
+  if (!same(strip(a), strip(b))) throw lost('개체(표·그림·도형 등) 구성');
+  return a
+    .filter((c) => String(c.ctrlId ?? '').trim() === 'tbl' && c.list === 0)
+    .map((c) => ({ para: Number(c.para), ctrl: Number(c.controlIndex) }));
+}
+
+/**
+ * 두 문서(방금 내보낸 바이트를 다시 연 것과 지금 편집 중인 것)가 같은 내용·서식인지 확인한다.
+ * `normalizeText`: HWP/HWPX 의 줄바꿈 표기 차이(\r\n)만 흡수한다.
+ */
+export function verifyReopenedDocument(
+  live: VerifiableDocument,
+  reopened: VerifiableDocument,
+  bytes: number,
+  options: { crossFormat?: boolean } = {},
+): void {
+  skipConversionDefaults = options.crossFormat === true;
+  try {
+    verifyAll(live, reopened, bytes);
+  } finally {
+    skipConversionDefaults = false;
+  }
+}
+
+function verifyAll(live: VerifiableDocument, reopened: VerifiableDocument, bytes: number): void {
+  if (bytes > ANDROID_MAX_SAVE_BYTES) throw new Error('저장 결과가 32MB를 넘어 저장을 멈췄어요. 원본은 변경하지 않았어요.');
+
+  // 1. 글 전체
+  const text = (d: VerifiableDocument) => String(JSON.parse(d.getTextFileUnicode()) ?? '').replace(/\r\n/g, '\n');
+  if (text(live) !== text(reopened)) throw new Error('저장 전후의 문서 내용이 달라 저장을 멈췄어요. 원본은 변경하지 않았어요.');
+
+  // 2. 쪽 수와 쪽 그리기
+  const pages = reopened.pageCount();
+  if (!pages || pages > MAX_PAGES) throw new Error('저장 결과의 쪽 수를 확인하지 못해 저장을 멈췄어요.');
+  reopened.renderPageSvg(0);
+  if (pages > 1) reopened.renderPageSvg(pages - 1);
+
+  // 3. 구역·문단·글자·문단 서식
+  const sections = live.getSectionCount();
+  if (sections !== reopened.getSectionCount()) throw lost('구역 수');
+  for (let s = 0; s < sections; s += 1) {
+    const paragraphs = live.getParagraphCount(s);
+    if (paragraphs !== reopened.getParagraphCount(s)) throw lost('문단 수');
+    for (let p = 0; p < paragraphs; p += 1) {
+      const length = live.getParagraphLength(s, p);
+      if (length !== reopened.getParagraphLength(s, p)) throw lost('문단 길이');
+      if (!same(parse(live.getParaPropertiesAt(s, p)), parse(reopened.getParaPropertiesAt(s, p)))) throw lost('문단 서식');
+      for (const o of samplePoints(length)) {
+        if (!same(parse(live.getCharPropertiesAt(s, p, o)), parse(reopened.getCharPropertiesAt(s, p, o)))) throw lost('글자 서식');
+      }
+    }
+  }
+
+  // 4. 개체 구성과 최상위 표(표·칸 속성, 칸 안 문단/글자 서식)
+  for (const { para, ctrl } of compareControls(live, reopened)) {
+    // 구역 번호는 getControls 가 주지 않아 첫 구역 기준으로만 열 수 있다 — 실패하면 둘 다 같은 이유로 실패해야 한다.
+    for (let s = 0; s < sections; s += 1) {
+      let dims: unknown;
+      try { dims = parse(live.getTableDimensions(s, para, ctrl)); } catch { continue; }
+      if (!same(dims, parse(reopened.getTableDimensions(s, para, ctrl)))) throw lost('표 구조');
+      if (!same(parse(live.getTableProperties(s, para, ctrl)), parse(reopened.getTableProperties(s, para, ctrl)))) throw lost('표 속성');
+      const cells = Number((dims as { cellCount?: number }).cellCount ?? 0);
+      for (let c = 0; c < cells; c += 1) {
+        if (!same(parse(live.getCellProperties(s, para, ctrl, c)), parse(reopened.getCellProperties(s, para, ctrl, c)))) throw lost('표 칸 속성');
+        const cellParas = live.getCellParagraphCount(s, para, ctrl, c);
+        if (cellParas !== reopened.getCellParagraphCount(s, para, ctrl, c)) throw lost('표 칸 문단 수');
+        for (let q = 0; q < cellParas; q += 1) {
+          const length = live.getCellParagraphLength(s, para, ctrl, c, q);
+          if (length !== reopened.getCellParagraphLength(s, para, ctrl, c, q)) throw lost('표 칸 문단 길이');
+          if (!same(parse(live.getCellParaPropertiesAt(s, para, ctrl, c, q)), parse(reopened.getCellParaPropertiesAt(s, para, ctrl, c, q)))) throw lost('표 칸 문단 서식');
