index 0000000..fb2e3b2
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/touch-editing.ts
@@ -0,0 +1,230 @@
+/**
+ * [hwpxxx] 손가락·펜 편집 연결. 제스처 판단은 touch-gesture.ts, 여기는 DOM·편집기 연결만 한다.
+ *
+ * - 가볍게 탭: 브라우저의 호환 마우스 이벤트가 그대로 캐럿을 놓는다(조합 중이면 mousedown 이 확정한다).
+ * - 길게 누르기: 그 자리에 캐럿을 놓고 낱말을 잡은 뒤 시작·끝 손잡이를 띄운다. 누른 채 끌면 끝 손잡이를 끈 것과 같다.
+ * - 손잡이 끌기: 반대쪽 끝에서 mousedown 을 새로 시작해 손가락 자리까지 mousemove 를 보낸다. 그래서 표 칸을 가로지르면
+ *   마우스 끌기와 똑같이 칸 블록이 된다.
+ * - 선택된 그림·도형·표: 핸들·몸통을 만지면 곧바로 편집기의 개체 이동·크기 조절(마우스 흐름)로 넘긴다.
+ * - 펜(touchType 'stylus'): 마우스처럼 동작한다(끌기=선택, 연속 탭=낱말·문단).
+ * - 세로로 한 손가락을 쓸면 스크롤이다(길게 누르기·개체·손잡이를 잡지 않은 한 touchstart/touchmove 를 막지 않는다).
+ */
+import {
+  TouchGesture, type GestureHost, type MouseType, type Pt, type Box,
+  isStylusTouch, snapToHandle, pointInBoxes, selectionEnds, handleDragOffset,
+} from './touch-gesture';
+
+const HANDLE_BOX = 44;
+const HANDLE_STYLE =
+  `position:fixed;z-index:60;width:${HANDLE_BOX}px;height:${HANDLE_BOX}px;display:none;touch-action:none;` +
+  'user-select:none;-webkit-user-select:none;';
+
+function boxOf(el: Element): Box {
+  const r = el.getBoundingClientRect();
+  return { left: r.left, top: r.top, right: r.right, bottom: r.bottom };
+}
+
+function makeHandle(): HTMLDivElement {
+  const el = document.createElement('div');
+  el.className = 'hwpxxx-touch-handle';
+  el.style.cssText = HANDLE_STYLE;
+  el.setAttribute('aria-hidden', 'true');
+  const dot = document.createElement('div');
+  dot.style.cssText =
+    'position:absolute;left:50%;top:6px;width:18px;height:18px;margin-left:-9px;border-radius:50%;' +
+    'background:#1a73e8;border:2px solid #fff;box-shadow:0 1px 4px rgba(0,0,0,.45);box-sizing:border-box;';
+  el.appendChild(dot);
+  return el;
+}
+
+export function installTouchEditing(handler: any, container: HTMLElement): () => void {
+  const startH = makeHandle();
+  const endH = makeHandle();
+  document.body.appendChild(startH);
+  document.body.appendChild(endH);
+
+  const isOurs = (el: Element | null) => !!el && (el === startH || el === endH || startH.contains(el) || endH.contains(el));
+  const scrollContent = () => container.querySelector<HTMLElement>('#scroll-content') ?? container;
+  const selectionBoxes = (): Box[] =>
+    Array.from(container.querySelectorAll('.selection-layer > *')).map(boxOf).filter((b) => b.right > b.left && b.bottom > b.top);
+  const inCellBlock = () => !!handler.cursor?.isInCellSelectionMode?.();
+  const objectSelected = () => !!(handler.cursor?.isInPictureObjectSelection?.() || handler.cursor?.isInTableObjectSelection?.());
+
+  function fire(type: MouseType, p: Pt, detail = 0): void {
+    let target = document.elementFromPoint(p.x, p.y);
+    if (!target || isOurs(target) || !container.contains(target)) target = scrollContent();
+    const ev = new MouseEvent(type, {
+      bubbles: true, cancelable: true, composed: true, view: window,
+      clientX: p.x, clientY: p.y, screenX: p.x, screenY: p.y,
+      button: 0, buttons: type === 'mousedown' || type === 'mousemove' ? 1 : 0, detail,
+    });
+    target.dispatchEvent(ev);
+  }
+
+  function flushDrag(): void {
+    try { if (handler.isDragging) handler.updateTextSelectionDragFromPointer?.(); } catch { /* 드래그가 이미 끝남 */ }
+  }
+
+  /** 손잡이 끌기 공통: 반대쪽 끝에서 마우스 끌기를 새로 시작한다. */
+  let dragging = false;
+  function beginDrag(which: 'start' | 'end'): boolean {
+    const ends = selectionEnds(selectionBoxes());
+    if (!ends || inCellBlock()) return false;
+    const anchor = which === 'end' ? { x: ends.start.x + 1, y: ends.start.mid } : { x: ends.end.x - 1, y: ends.end.mid };
+    fire('mousedown', anchor, 1);
+    dragging = true;
+    return true;
+  }
+  function endDrag(p?: Pt): void {
+    if (!dragging) return;
+    dragging = false;
+    flushDrag();
+    fire('mouseup', p ?? { x: 0, y: 0 }, 1);
+  }
+
+  let lastDragPt: Pt = { x: 0, y: 0 };
+  const host: GestureHost = {
+    fire,
+    claimObject(p) {
+      if (!objectSelected()) return null;
+      const kids = Array.from(container.querySelectorAll('.table-object-layer > *')).map(boxOf)
+        .filter((b) => b.right > b.left || b.bottom > b.top);
+      if (!kids.length) return null;
+      const small = kids.filter((b) => b.right - b.left <= 14 && b.bottom - b.top <= 14);
+      const centers = small.map((b) => ({ x: (b.left + b.right) / 2, y: (b.top + b.bottom) / 2 }));
+      const snapped = snapToHandle(p, centers);
+      if (snapped) return snapped;
+      return pointInBoxes(p, [{
+        left: Math.min(...kids.map((b) => b.left)), top: Math.min(...kids.map((b) => b.top)),
+        right: Math.max(...kids.map((b) => b.right)), bottom: Math.max(...kids.map((b) => b.bottom)),
+      }]) ? p : null;
+    },
+    pressInsideSelection: (p) => !inCellBlock() && pointInBoxes(p, selectionBoxes()),
+    beginHandleDrag(p) { lastDragPt = p; return beginDrag('end'); },
+    moveHandleDrag(p) { lastDragPt = p; fire('mousemove', p); },
+    endHandleDrag() { endDrag(lastDragPt); },
+    flushDrag,
+    setTimer: (fn, ms) => window.setTimeout(fn, ms),
+    clearTimer: (id) => window.clearTimeout(id as number),
+    now: () => performance.now(),
+  };
+  const gesture = new TouchGesture(host);
+
+  // --- 본문 touch 이벤트 -------------------------------------------------------------------------
+  let trackId: number | null = null;
+  const pt = (t: Touch): Pt => ({ x: t.clientX, y: t.clientY });
+  const find = (list: TouchList, id: number | null): Touch | null => {
+    for (let i = 0; i < list.length; i++) if (list[i].identifier === id) return list[i];
+    return null;
+  };
+  const onStart = (e: TouchEvent) => {
+    if (e.touches.length > 1) { gesture.cancel(); trackId = null; return; } // 두 손가락은 확대·스크롤에 맡긴다
+    const target = e.target as Element | null;
+    if (isOurs(target) || target?.closest?.('.hwpxxx-vscroll')) return;
+    const t = e.changedTouches[0];
+    trackId = t.identifier;
+    if (gesture.down(pt(t), isStylusTouch(t as any)) && e.cancelable) e.preventDefault();
+  };
+  const onMove = (e: TouchEvent) => {
+    if (e.touches.length > 1) { gesture.cancel(); trackId = null; return; }
+    const t = find(e.changedTouches, trackId);
+    if (t && gesture.move(pt(t)) && e.cancelable) e.preventDefault();
+  };
+  const onEnd = (e: TouchEvent) => {
+    const t = find(e.changedTouches, trackId);
+    if (!t) return;
+    trackId = null;
+    if (gesture.up(pt(t)) && e.cancelable) e.preventDefault();
+    schedule();
+  };
+  const onCancel = (e: TouchEvent) => {
+    if (!find(e.changedTouches, trackId)) return;
+    trackId = null;
+    gesture.cancel();
+  };
+  // 길게 눌러 방금 낱말을 잡았으면 브라우저가 이어서 띄우는 컨텍스트 메뉴(우클릭 메뉴)를 막는다.
+  const onContext = (e: MouseEvent) => {
+    if (performance.now() - gesture.longPressedAt < 1500) { e.preventDefault(); e.stopImmediatePropagation(); }
+  };
+  container.addEventListener('touchstart', onStart, { passive: false });
+  container.addEventListener('touchmove', onMove, { passive: false });
+  container.addEventListener('touchend', onEnd, { passive: false });
+  container.addEventListener('touchcancel', onCancel);
+  container.addEventListener('contextmenu', onContext, true);
+
+  // --- 선택 손잡이 ----------------------------------------------------------------------------
+  const wireHandle = (el: HTMLElement, which: 'start' | 'end') => {
+    let id: number | null = null;
+    let dy = 0;
+    el.addEventListener('touchstart', (e) => {
+      if (id !== null || gesture.active) return;
+      const t = e.changedTouches[0];
+      const ends = selectionEnds(selectionBoxes());
+      if (!ends) return;
+      e.preventDefault();
+      e.stopPropagation();
+      id = t.identifier;
+      dy = handleDragOffset(t.clientY, which === 'end' ? ends.end.mid : ends.start.mid);
+      if (!beginDrag(which)) id = null;
+      lastDragPt = { x: t.clientX, y: t.clientY + dy };
+    }, { passive: false });
+    el.addEventListener('touchmove', (e) => {
+      const t = find(e.changedTouches, id);
+      if (!t) return;
+      e.preventDefault();
+      lastDragPt = { x: t.clientX, y: t.clientY + dy };
+      fire('mousemove', lastDragPt);
+    }, { passive: false });
+    const done = (e: TouchEvent) => {
+      if (!find(e.changedTouches, id)) return;
+      id = null;
+      e.preventDefault();
+      endDrag(lastDragPt);
+      schedule();
+    };
+    el.addEventListener('touchend', done, { passive: false });
+    el.addEventListener('touchcancel', done, { passive: false });
+  };
+  wireHandle(startH, 'start');
+  wireHandle(endH, 'end');
+
+  // --- 손잡이 위치 ------------------------------------------------------------------------------
+  let raf = 0;
+  function schedule(): void {
+    if (raf) return;
+    raf = requestAnimationFrame(() => { raf = 0; place(); });
+  }
+  function place(): void {
+    const ends = inCellBlock() || objectSelected() ? null : selectionEnds(selectionBoxes());
+    const view = container.getBoundingClientRect();
+    const show = (el: HTMLElement, p: Pt | null) => {
+      if (!p || p.y < view.top || p.y > view.bottom || p.x < view.left || p.x > view.right) { el.style.display = 'none'; return; }
+      el.style.display = 'block';
+      el.style.left = `${p.x - HANDLE_BOX / 2}px`;
+      el.style.top = `${p.y}px`;
+    };
+    show(startH, ends ? ends.start : null);
+    show(endH, ends ? ends.end : null);
+  }
+  const mo = new MutationObserver(schedule);
+  const layer = container.querySelector('.selection-layer');
+  if (layer) mo.observe(layer, { subtree: true, childList: true, attributes: true, attributeFilter: ['style'] });
+  container.addEventListener('scroll', schedule, { passive: true });
+  window.addEventListener('resize', schedule);
+  schedule();
+
+  return () => {
+    gesture.cancel();
+    mo.disconnect();
+    if (raf) cancelAnimationFrame(raf);
+    container.removeEventListener('touchstart', onStart);
+    container.removeEventListener('touchmove', onMove);
+    container.removeEventListener('touchend', onEnd);
+    container.removeEventListener('touchcancel', onCancel);
+    container.removeEventListener('contextmenu', onContext, true);
+    container.removeEventListener('scroll', schedule);
+    window.removeEventListener('resize', schedule);
+    startH.remove();
+    endH.remove();
+  };
+}
diff --git a/rhwp-studio/src/hwpxxx/touch-gesture.ts b/rhwp-studio/src/hwpxxx/touch-gesture.ts
