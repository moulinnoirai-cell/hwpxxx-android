index 0000000..b703cc4
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/touch-gesture.ts
@@ -0,0 +1,185 @@
+/**
+ * [hwpxxx] 손가락·펜 편집: DOM 에 기대지 않는 제스처 판단(단위 시험 대상).
+ *
+ * 편집기의 선택·개체 이동·크기 조절은 모두 mousedown/mousemove/mouseup 위에 서 있다. 손가락 탭은 브라우저가
+ * 호환 마우스 이벤트로 바꿔 주지만, 끌기는 문서 스크롤이 되어 선택·이동이 불가능했다. 여기서는 어떤 끌기를
+ * 스크롤로 두고 어떤 것을 편집기의 마우스 흐름으로 넘길지(= 합성 마우스 이벤트)만 정한다. 기하·선택 규칙은 건드리지 않는다.
+ */
+
+export interface Pt { x: number; y: number }
+export interface Box { left: number; top: number; right: number; bottom: number }
+
+export const LONG_PRESS_MS = 400;
+/** 이만큼(화면 px) 움직이면 누르기가 아니라 끌기(스크롤)다. 크롬의 터치 슬롭(약 15px)보다 작아야 스크롤이 시작되기 전에 판정된다. */
+export const MOVE_SLOP = 8;
+/** 선택된 개체의 핸들에서 이 거리 안을 눌렀으면 핸들을 잡은 것으로 본다(편집기 자체 허용치는 6px라 손가락엔 좁다). */
+export const HANDLE_SNAP = 26;
+/** 연속 탭으로 칠 간격·거리(펜의 두 번·세 번 누르기). */
+export const MULTI_TAP_MS = 350;
+export const MULTI_TAP_DIST = 24;
+
+export function dist(a: Pt, b: Pt): number { return Math.hypot(a.x - b.x, a.y - b.y); }
+
+/** 펜 이벤트(Chrome 의 Touch.touchType === 'stylus')인가. */
+export function isStylusTouch(t: { touchType?: string }): boolean { return t.touchType === 'stylus'; }
+
+/** 연속 탭 횟수(마우스 click.detail 과 같은 규칙). */
+export class TapCounter {
+  private last: { t: number; p: Pt; n: number } | null = null;
+  hit(t: number, p: Pt): number {
+    const l = this.last;
+    const n = l && t - l.t <= MULTI_TAP_MS && dist(l.p, p) <= MULTI_TAP_DIST ? Math.min(l.n + 1, 3) : 1;
+    this.last = { t, p, n };
+    return n;
+  }
+  reset(): void { this.last = null; }
+}
+
+/** p 에서 가장 가까운(반경 안) 핸들 중심. 없으면 null. */
+export function snapToHandle(p: Pt, centers: readonly Pt[], radius = HANDLE_SNAP): Pt | null {
+  let best: Pt | null = null;
+  let bd = radius;
+  for (const c of centers) {
+    const d = dist(p, c);
+    if (d <= bd) { best = c; bd = d; }
+  }
+  return best;
+}
+
+export function pointInBoxes(p: Pt, boxes: readonly Box[], pad = 0): boolean {
+  return boxes.some((b) => p.x >= b.left - pad && p.x <= b.right + pad && p.y >= b.top - pad && p.y <= b.bottom + pad);
+}
+
+/** 선택 사각형들(문서 순서)에서 시작·끝 자리. 시작은 첫 줄 왼쪽 위, 끝은 마지막 줄 오른쪽 아래. 줄 가운데 높이(mid)도 준다. */
+export function selectionEnds(rects: readonly Box[]): { start: Pt & { mid: number }; end: Pt & { mid: number } } | null {
+  const r = rects.filter((b) => b.right - b.left > 0 && b.bottom - b.top > 0);
+  if (!r.length) return null;
+  const a = r[0];
+  const z = r[r.length - 1];
+  return {
+    start: { x: a.left, y: a.bottom, mid: (a.top + a.bottom) / 2 },
+    end: { x: z.right, y: z.bottom, mid: (z.top + z.bottom) / 2 },
+  };
+}
+
+/** 손잡이를 끌 때 손가락 대신 줄 가운데를 가리키게 하는 세로 보정(손잡이는 줄 아래에 달려 있다). */
+export function handleDragOffset(touchStartY: number, lineMidY: number): number { return lineMidY - touchStartY; }
+
+export type MouseType = 'mousedown' | 'mousemove' | 'mouseup' | 'click';
+
+export interface GestureHost {
+  /** 합성 마우스 이벤트를 편집기에 보낸다. detail 은 click 횟수. */
+  fire(type: MouseType, p: Pt, detail?: number): void;
+  /** 손가락이 선택된 개체의 핸들·몸통 위인가. 맞으면 (핸들이면 중심으로 맞춘) 좌표를 돌려준다. */
+  claimObject(p: Pt): Pt | null;
+  /** 길게 누른 자리가 이미 잡힌 글 블록 안인가(그러면 낱말을 다시 잡지 않고 네이티브 컨텍스트 메뉴에 맡긴다). */
+  pressInsideSelection(p: Pt): boolean;
+  /** 길게 누른 뒤 끌기: 끝 손잡이 끌기를 시작/갱신/종료한다. 시작에 실패하면(선택 없음) false. */
+  beginHandleDrag(p: Pt): boolean;
+  moveHandleDrag(p: Pt): void;
+  endHandleDrag(): void;
+  /** 끌기 직전 대기 중인 드래그 갱신을 반영한다(mouseup 이 rAF 로 예약된 마지막 이동을 버리기 때문). */
+  flushDrag(): void;
+  setTimer(fn: () => void, ms: number): unknown;
+  clearTimer(id: unknown): void;
+  now(): number;
+}
+
+type Mode = 'idle' | 'pending' | 'scroll' | 'mouse' | 'held' | 'handle';
+
+export class TouchGesture {
+  private mode: Mode = 'idle';
+  private start: Pt = { x: 0, y: 0 };
+  private timer: unknown = null;
+  private taps = new TapCounter();
+  private tapCount = 1;
+  private moved = false;
+  /** 길게 누르기로 선택이 만들어진 직후인지(네이티브 컨텍스트 메뉴를 막을 때 쓴다). */
+  longPressedAt = -Infinity;
+
+  private host: GestureHost;
+  constructor(host: GestureHost) { this.host = host; }
+
+  get active(): boolean { return this.mode === 'mouse' || this.mode === 'held' || this.mode === 'handle'; }
+
+  /** @returns touchstart 를 preventDefault 해야 하면 true(스크롤·호환 마우스 이벤트를 막는다). */
+  down(p: Pt, stylus: boolean): boolean {
+    this.cancel();
+    this.start = p;
+    this.moved = false;
+    const obj = stylus ? null : this.host.claimObject(p);
+    if (stylus || obj) {
+      // 펜은 마우스처럼, 선택된 개체를 만진 손가락은 개체 끌기로 곧바로 편집기에 넘긴다.
+      this.mode = 'mouse';
+      this.tapCount = stylus ? this.taps.hit(this.host.now(), p) : 1;
+      this.host.fire('mousedown', obj ?? p, this.tapCount);
+      return true;
+    }
+    this.mode = 'pending';
+    this.timer = this.host.setTimer(() => this.onLongPress(), LONG_PRESS_MS);
+    return false;
+  }
+
+  private onLongPress(): void {
+    this.timer = null;
+    if (this.mode !== 'pending') return;
+    const p = this.start;
+    if (this.host.pressInsideSelection(p)) { this.mode = 'scroll'; return; }
+    // 눌러 둔 자리로 캐럿을 옮기고(조합 중이면 mousedown 이 먼저 확정한다) 낱말을 잡는다.
+    this.host.fire('mousedown', p, 1);
+    this.host.fire('mouseup', p, 1);
+    this.host.fire('click', p, 2);
+    this.longPressedAt = this.host.now();
+    this.mode = 'held';
+  }
+
+  /** @returns touchmove 를 preventDefault 해야 하면 true. */
+  move(p: Pt): boolean {
+    switch (this.mode) {
+      case 'pending':
+        if (dist(p, this.start) > MOVE_SLOP) { this.clearTimer(); this.mode = 'scroll'; }
+        return false;
+      case 'mouse':
+        this.moved = true;
+        this.host.fire('mousemove', p);
+        return true;
+      case 'held':
+        if (dist(p, this.start) <= MOVE_SLOP) return true;
+        if (this.host.beginHandleDrag(this.start)) { this.mode = 'handle'; this.host.moveHandleDrag(p); }
+        return true;
+      case 'handle':
+        this.host.moveHandleDrag(p);
+        return true;
+      default:
+        return false;
+    }
+  }
+
+  /** @returns touchend 를 preventDefault 해야 하면 true(합성 호환 마우스·click 을 막는다). */
+  up(p: Pt): boolean {
+    const mode = this.mode;
+    this.clearTimer();
+    this.mode = 'idle';
+    if (mode === 'mouse') {
+      this.host.flushDrag();
+      this.host.fire('mouseup', p, this.tapCount);
+      // 펜의 두 번·세 번 누르기: 편집기의 낱말·문단 블록은 click.detail 로 판단한다.
+      if (!this.moved && this.tapCount >= 2) this.host.fire('click', p, this.tapCount);
+      return true;
+    }
+    if (mode === 'handle') { this.host.flushDrag(); this.host.endHandleDrag(); return true; }
+    return mode === 'held';
+  }
+
+  cancel(): void {
+    const mode = this.mode;
+    this.clearTimer();
+    this.mode = 'idle';
+    if (mode === 'mouse') { this.host.flushDrag(); this.host.fire('mouseup', this.start, 1); }
+    else if (mode === 'handle') { this.host.flushDrag(); this.host.endHandleDrag(); }
+  }
+
+  private clearTimer(): void {
+    if (this.timer !== null) { this.host.clearTimer(this.timer); this.timer = null; }
+  }
+}
