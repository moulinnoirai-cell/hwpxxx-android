diff --git a/rhwp-studio/tests/hwpxxx-touch-gesture.test.ts b/rhwp-studio/tests/hwpxxx-touch-gesture.test.ts
new file mode 100644
index 0000000..d192d93
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-touch-gesture.test.ts
@@ -0,0 +1,183 @@
+// [hwpxxx] 손가락·펜 편집: 어떤 끌기를 스크롤로 두고 어떤 것을 편집기 마우스 흐름으로 넘기는지.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import {
+  TouchGesture, TapCounter, snapToHandle, pointInBoxes, selectionEnds, handleDragOffset, isStylusTouch,
+  LONG_PRESS_MS, MOVE_SLOP, HANDLE_SNAP, type GestureHost, type Pt,
+} from '../src/hwpxxx/touch-gesture.ts';
+
+function makeHost(over: Partial<GestureHost> = {}) {
+  const log: string[] = [];
+  let timer: (() => void) | null = null;
+  let clock = 0;
+  const host: GestureHost & { fireTimer(): void; advance(ms: number): void; log: string[] } = {
+    log,
+    fire: (type, p, detail) => log.push(`${type}@${p.x},${p.y}${detail ? `#${detail}` : ''}`),
+    claimObject: () => null,
+    pressInsideSelection: () => false,
+    beginHandleDrag: () => { log.push('beginHandle'); return true; },
+    moveHandleDrag: (p) => log.push(`moveHandle@${p.x},${p.y}`),
+    endHandleDrag: () => log.push('endHandle'),
+    flushDrag: () => log.push('flush'),
+    setTimer: (fn) => { timer = fn; return 1; },
+    clearTimer: () => { timer = null; },
+    now: () => clock,
+    fireTimer() { const t = timer; timer = null; t?.(); },
+    advance(ms) { clock += ms; },
+    ...over,
+  };
+  return host;
+}
+const P = (x: number, y: number): Pt => ({ x, y });
+
+test('한 손가락 세로 쓸기는 스크롤이다: 아무 이벤트도 편집기에 가지 않고 막지도 않는다', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  assert.equal(g.down(P(100, 100), false), false);
+  assert.equal(g.move(P(100, 100 + MOVE_SLOP + 5)), false);
+  assert.equal(g.move(P(100, 300)), false);
+  h.fireTimer(); // 타이머는 이미 취소됐다
+  assert.equal(g.up(P(100, 300)), false);
+  assert.deepEqual(h.log, []);
+});
+
+test('가볍게 탭하면 편집기에 아무것도 보내지 않고 호환 마우스 이벤트(캐럿)에 맡긴다', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  assert.equal(g.down(P(10, 10), false), false);
+  assert.equal(g.up(P(10, 10)), false);
+  assert.deepEqual(h.log, []);
+});
+
+test('길게 누르면 mousedown(조합 확정·캐럿) → mouseup → click#2(낱말)가 순서대로 나가고 이후 입력을 막는다', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  g.down(P(50, 60), false);
+  h.advance(LONG_PRESS_MS);
+  h.fireTimer();
+  assert.deepEqual(h.log, ['mousedown@50,60#1', 'mouseup@50,60#1', 'click@50,60#2']);
+  assert.equal(g.longPressedAt, LONG_PRESS_MS);
+  assert.equal(g.move(P(52, 61)), true); // 슬롭 안: 흔들림은 무시하되 스크롤은 막는다
+  assert.equal(g.up(P(52, 61)), true);   // 호환 마우스·click 을 막는다
+  assert.equal(h.log.length, 3);
+});
+
+test('길게 누른 뒤 끌면 끝 손잡이를 끈 것과 같고, 뗄 때 대기 중인 이동을 반영한 뒤 끝낸다', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  g.down(P(50, 60), false);
+  h.fireTimer();
+  h.log.length = 0;
+  assert.equal(g.move(P(90, 60)), true);
+  assert.equal(g.move(P(140, 80)), true);
+  assert.equal(g.up(P(140, 80)), true);
+  assert.deepEqual(h.log, ['beginHandle', 'moveHandle@90,60', 'moveHandle@140,80', 'flush', 'endHandle']);
+});
+
+test('길게 누르기 전에 움직였으면 길게 누르기는 취소된다(스크롤 시작)', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  g.down(P(0, 0), false);
+  g.move(P(0, 30));
+  h.fireTimer();
+  assert.deepEqual(h.log, []);
+});
+
+test('이미 잡힌 글 블록 안을 길게 누르면 낱말을 다시 잡지 않는다(컨텍스트 메뉴에 맡김)', () => {
+  const h = makeHost({ pressInsideSelection: () => true });
+  const g = new TouchGesture(h);
+  g.down(P(5, 5), false);
+  h.fireTimer();
+  assert.deepEqual(h.log, []);
+  assert.equal(g.up(P(5, 5)), false);
+});
+
+test('선택된 개체를 만지면 곧바로 마우스 끌기(이동·크기 조절)로 넘기고 스크롤을 막는다', () => {
+  const h = makeHost({ claimObject: (p) => (p.x < 200 ? P(100, 100) : null) });
+  const g = new TouchGesture(h);
+  assert.equal(g.down(P(110, 95), false), true);  // 핸들 중심(100,100)으로 맞춘다
+  assert.equal(g.move(P(150, 130)), true);
+  assert.equal(g.up(P(160, 140)), true);
+  assert.deepEqual(h.log, ['mousedown@100,100#1', 'mousemove@150,130', 'flush', 'mouseup@160,140#1']);
+  // 개체 밖은 스크롤/탭 흐름
+  const h2 = makeHost({ claimObject: () => null });
+  assert.equal(new TouchGesture(h2).down(P(300, 300), false), false);
+  assert.deepEqual(h2.log, []);
+});
+
+test('펜은 마우스처럼: 눌러 끌면 선택, 연속 탭은 click.detail 2·3', () => {
+  const h = makeHost();
+  const g = new TouchGesture(h);
+  assert.equal(g.down(P(10, 10), true), true);
+  g.move(P(60, 10));
+  g.up(P(60, 10));
+  assert.deepEqual(h.log, ['mousedown@10,10#1', 'mousemove@60,10', 'flush', 'mouseup@60,10#1']);
+
+  h.log.length = 0;
+  h.advance(1000);
+  g.down(P(10, 10), true); g.up(P(10, 10));
+  h.advance(100);
+  g.down(P(11, 10), true); g.up(P(11, 10));
+  assert.deepEqual(h.log.filter((l) => l.startsWith('click')), ['click@11,10#2']);
+  h.advance(100);
+  g.down(P(11, 10), true); g.up(P(11, 10));
+  assert.deepEqual(h.log.filter((l) => l.startsWith('click')), ['click@11,10#2', 'click@11,10#3']);
+});
+
+test('취소(두 손가락·touchcancel)는 진행 중인 편집기 끌기를 mouseup 으로 정리한다', () => {
+  const h = makeHost({ claimObject: () => P(1, 1) });
+  const g = new TouchGesture(h);
+  g.down(P(1, 1), false);
+  g.cancel();
+  assert.deepEqual(h.log, ['mousedown@1,1#1', 'flush', 'mouseup@1,1#1']);
+  assert.equal(g.active, false);
+});
+
+test('TapCounter 는 시간·거리 안에서만 횟수를 올리고 3에서 멈춘다', () => {
+  const t = new TapCounter();
+  assert.equal(t.hit(0, P(0, 0)), 1);
+  assert.equal(t.hit(100, P(5, 5)), 2);
+  assert.equal(t.hit(200, P(5, 5)), 3);
+  assert.equal(t.hit(300, P(5, 5)), 3);
+  assert.equal(t.hit(1000, P(5, 5)), 1);
+  assert.equal(t.hit(1100, P(500, 5)), 1);
+});
+
+test('핸들 맞추기·영역 판정·선택 양끝 계산', () => {
+  const cs = [P(0, 0), P(100, 0)];
+  assert.deepEqual(snapToHandle(P(HANDLE_SNAP - 1, 0), cs), P(0, 0));
+  assert.equal(snapToHandle(P(HANDLE_SNAP + 5, 0), cs), null);
+  assert.deepEqual(snapToHandle(P(80, 0), cs), P(100, 0));
+  assert.equal(pointInBoxes(P(5, 5), [{ left: 0, top: 0, right: 10, bottom: 10 }]), true);
+  assert.equal(pointInBoxes(P(12, 5), [{ left: 0, top: 0, right: 10, bottom: 10 }], 3), true);
+  assert.equal(pointInBoxes(P(20, 5), [{ left: 0, top: 0, right: 10, bottom: 10 }]), false);
+
+  assert.equal(selectionEnds([]), null);
+  assert.equal(selectionEnds([{ left: 1, top: 1, right: 1, bottom: 9 }]), null); // 숨겨진(폭 0) 사각형
+  const e = selectionEnds([
+    { left: 50, top: 100, right: 300, bottom: 120 },
+    { left: 40, top: 120, right: 90, bottom: 140 },
+  ])!;
+  assert.deepEqual(e.start, { x: 50, y: 120, mid: 110 });
+  assert.deepEqual(e.end, { x: 90, y: 140, mid: 130 });
+  assert.equal(handleDragOffset(150, 130), -20);
+  assert.equal(isStylusTouch({ touchType: 'stylus' }), true);
+  assert.equal(isStylusTouch({ touchType: 'direct' }), false);
+  assert.equal(isStylusTouch({}), false);
+});
+
+test('편집기 연결: 터치 모듈 설치·눈금자 터치 허용·마우스 경로는 그대로', () => {
+  const src = (p: string) => readFileSync(new URL(`../src/${p}`, import.meta.url), 'utf8');
+  const ih = src('engine/input-handler.ts');
+  assert.match(ih, /installTouchEditing\(this, container\)/);
+  assert.match(ih, /container\.addEventListener\('mousedown', this\.onClickBound\)/);
+  const ruler = src('view/ruler.ts');
+  assert.doesNotMatch(ruler, /pointerType === 'mouse' && e\.isPrimary/);
+  assert.match(ruler, /pinHitRadius\(e\)/);
+  assert.match(ruler, /touchAction = 'none'/);
+  // 조합 중 클릭은 mousedown 이 확정한다 — 합성 mousedown 도 같은 경로를 탄다.
+  assert.match(src('engine/input-handler-mouse.ts'), /isComposing && e\.button === 0\) this\.finishCompositionNow/);
+  const te = src('hwpxxx/touch-editing.ts');
+  assert.match(te, /fire\('mousedown'/);
+});
