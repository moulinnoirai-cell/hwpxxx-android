+/**
+ * [hwpxxx-android] 문서 수준의 글꼴 이름만으로 고를 수 있는 호스트 face.
+ * 쪽 트리의 글자 런은 (글꼴 이름, 굵게, 기울임)으로 face 를 고르므로, 문서가 선언한 이름마다 네 조합을 모두 고르면
+ * 쪽 트리를 읽지 않고도 같은 face 를(쓰이지 않는 굵기·기울임이 조금 더 들어갈 뿐) 얻는다.
+ * 엔진이 문서에 없는 이름을 끼워 넣는 드문 경우는 여기서 빠질 수 있어, 호출자가 뒤에서 `collectHostFontRequests` 로 한 번 확인한다.
+ */
+export function collectHostFontRequestsForFamilies(families: Iterable<string>): LocalFontRecord[] {
+  const selected = new Map<string, LocalFontRecord>();
+  const select = (name: string, weight: number, slant: 'normal' | 'italic') => {
+    const record = resolveRendererLocalFont(name, { weight, slant });
+    if (record?.hostReference) selected.set(localFontFaceKey(record), record);
+  };
+  for (const family of new Set(families)) {
+    if (!family) continue;
+    const candidates = ordinaryTextFontFamilies(family);
+    for (const weight of [400, 700]) {
+      for (const slant of ['normal', 'italic'] as const) {
+        for (const candidate of candidates) select(candidate, weight, slant);
+      }
+    }
+  }
+  // 수식의 기본 글꼴과 원문자 안쪽 글꼴은 문서의 글꼴 목록에 나오지 않는다.
+  select('HyhwpEQ', 400, 'normal');
+  select(enclosedPuaMetrics.innerFace, 400, 'normal');
+  return [...selected.values()];
+}
