--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-android-host-font-scan.test.ts
@@ -0,0 +1,82 @@
+// [hwpxxx-android] 호스트 글꼴 탐색: 문서의 글꼴 이름으로 바로 고르고, 모든 쪽을 훑는 확인은 첫 화면 뒤에 한 번만 한다(큰 문서 여는 시간·편집 반응).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import type { HostFontProvider, HostFontSnapshot } from '../src/core/host-font-provider.ts';
+import { setHostFontProvider } from '../src/core/local-fonts.ts';
+import { collectHostFontRequests, collectHostFontRequestsForFamilies } from '../src/core/host-font-requests.ts';
+import type { PageLayerTree } from '../src/core/types.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+function provider(): { provider: HostFontProvider; reads: () => number } {
+  let reads = 0;
+  const snapshot: HostFontSnapshot = { revision: 'r1', faces: [
+    { id: 'regular', family: 'Host Only', fullName: 'Host Only Regular', postscriptName: 'HostOnly-Regular',
+      style: 'Regular', weight: 400, slant: 'normal', aliases: ['호스트전용'] },
+    { id: 'bold', family: 'Host Only', fullName: 'Host Only Bold', postscriptName: 'HostOnly-Bold',
+      style: 'Bold', weight: 700, slant: 'normal', aliases: ['호스트전용'] },
+    { id: 'other', family: 'Unused Host', fullName: 'Unused Host Regular', postscriptName: 'UnusedHost-Regular',
+      style: 'Regular', weight: 400, slant: 'normal', aliases: [] },
+  ] };
+  return { reads: () => reads, provider: {
+    getSnapshot: async () => snapshot,
+    readFace: async () => { reads++; return { bytes: Uint8Array.of(1).buffer }; },
+    subscribe: () => () => {},
+  } };
+}
+const ids = (records: ReturnType<typeof collectHostFontRequests>) => records.map(record => record.hostReference?.face.id).sort();
+
+test('문서의 글꼴 이름만으로 쪽 트리 탐색이 고르는 face 를 모두(그 이상) 고른다', async () => {
+  const f = provider();
+  const bounds = { x: 0, y: 0, width: 200, height: 100 };
+  const tree: PageLayerTree = { pageWidth: 200, pageHeight: 100,
+    root: { kind: 'leaf', bounds, ops: [
+      { type: 'textRun', text: '가', bbox: bounds, style: { fontFamily: 'Host Only', bold: true } },
+      { type: 'textRun', text: '나', bbox: bounds, style: { fontFamily: 'Missing Source, "호스트전용"' } },
+      { type: 'textRun', text: '다', bbox: bounds, style: { fontFamily: '함초롬바탕' } },
+    ] } };
+  try {
+    await setHostFontProvider(f.provider);
+    const exact = ids(collectHostFontRequests(tree));
+    assert.deepEqual(exact, ['bold', 'regular']);
+    // 문서가 선언한 이름: 원본, 대체 후보(별칭 포함), 가져오지 않은 글꼴
+    const fast = ids(collectHostFontRequestsForFamilies(['Host Only', 'Missing Source', '호스트전용', '함초롬바탕', 'Host Only']));
+    for (const id of exact) assert.ok(fast.includes(id), `${id} 를 놓치지 않는다`);
+    assert.ok(!fast.includes('other'), '문서가 이름을 대지 않은 가져온 글꼴은 준비하지 않는다');
+    assert.equal(f.reads(), 0, '고르는 데에는 글꼴 파일을 읽지 않는다');
+    assert.deepEqual(ids(collectHostFontRequestsForFamilies(['Missing Source', '함초롬바탕', ''])), []);
+    assert.deepEqual(ids(collectHostFontRequestsForFamilies([])), []);
+  } finally { await setHostFontProvider(null); }
+});
+
+test('연결: 준비 단계는 쪽 트리를 내보내지 않고, 확인은 틈틈이 한 번만 한다', () => {
+  const bridge = source('core/wasm-bridge.ts');
+  const start = bridge.indexOf('async prepareCanvasMetrics(');
+  assert.ok(start >= 0);
+  const prepare = bridge.slice(start, bridge.indexOf('await this.hostCanvasFonts.prepare(records', start));
+  assert.ok(!prepare.includes('getPageLayerTreeObject('), '첫 화면 전에는 쪽 트리를 읽지 않는다');
+  assert.match(prepare, /if \(getHostFontState\(\)\.count > 0\) \{\s+for \(const record of collectHostFontRequestsForFamilies\(this\.documentFontFamilyNames\(\)\)\)/);
+  assert.match(prepare, /for \(const record of hostFontScan\.extras\.values\(\)\)/, '확인이 찾은 face 는 다음 준비부터 포함한다');
+  assert.ok(prepare.indexOf('await prepareHostFontCatalog()') < prepare.indexOf('getHostFontState().count > 0'), '개수는 카탈로그 준비 뒤에 읽는다');
+  assert.match(prepare, /this\.nativePuaFonts\.records\(/, 'PUA 글꼴 기록은 그대로 고른다');
+
+  const verify = bridge.slice(bridge.indexOf('private verifyHostFontScan('), start);
+  assert.match(verify, /if \(scan\.verified \|\| scan\.running\) return;/, '문서·글꼴 목록마다 한 번');
+  assert.match(verify, /Date\.now\(\) - started < 12/, '한 번에 오래 붙잡지 않는다');
+  assert.match(verify, /if \(stale\(\)\) \{ scan\.running = false; return; \}/, '문서나 글꼴 목록이 바뀌면 그만둔다');
+  assert.match(verify, /if \(found\) this\.hostFontScanListener\?\.\(\);/, '새로 찾았을 때만 알린다');
+  assert.equal(bridge.split('collectHostFontRequests(tree)').length - 1, 1);
+
+  const main = source('main.ts');
+  assert.match(main, /wasm\.onHostFontScanFound\(\(\) => \{\s+if \(!canvasView \|\| wasm\.pageCount === 0\) return;\s+wasm\.invalidateCanvasMetricFonts\(\);\s+void canvasView\.refreshFontResources\(\)/);
+});
+
+test('쪽 트리 탐색이 고르는 것은 hostReference 가 있는 기록뿐이다(호스트 글꼴이 없으면 건너뛰어도 결과가 같다는 근거)', () => {
+  const requests = source('core/host-font-requests.ts');
+  const body = requests.slice(requests.indexOf('export function collectHostFontRequests('));
+  const sets = body.match(/selected\.set\(/g) ?? [];
+  const guarded = body.match(/if \(\w+\??\.hostReference\) selected\.set\(/g) ?? [];
+  assert.ok(sets.length > 0);
+  assert.equal(guarded.length, sets.length, 'hostReference 없이 고르는 경로가 없다');
+});
