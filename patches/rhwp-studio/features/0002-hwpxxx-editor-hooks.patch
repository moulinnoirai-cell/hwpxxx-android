+}
+
+/** [hwpxxx] 메모 API 가 던지는 `{ok:false, code, message}` 문자열을 사람이 읽는 오류로 바꾼다. */
+export function memoApiError(error: unknown): Error {
+  const raw = typeof error === 'string' ? error : error instanceof Error ? error.message : String(error);
+  try {
+    const parsed = JSON.parse(raw) as { message?: string };
+    if (parsed && typeof parsed.message === 'string') return new Error(parsed.message);
+  } catch { /* JSON 이 아니면 그대로 보인다 */ }
+  return new Error(raw);
+}
