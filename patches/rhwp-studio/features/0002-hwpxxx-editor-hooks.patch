     };
+    return this.coverMergedCells(range);
+  }
+
+  /**
+   * 범위가 걸친 병합 셀을 통째로 포함할 때까지 넓힌다(한컴과 같은 방식).
+   * 병합 셀을 일부만 걸치면 칸 합치기가 "병합 범위를 벗어납니다"로 거부된다.
+   */
+  private coverMergedCells<T extends { startRow: number; startCol: number; endRow: number; endCol: number }>(range: T): T {
+    const ctx = this.cellTableCtx;
+    if (!ctx) return range;
+    let bboxes: CellBbox[];
+    try {
+      bboxes = ctx.cellPath
+        ? this.wasm.getTableCellBboxesByPath(ctx.sec, ctx.ppi, JSON.stringify(ctx.cellPath))
+        : this.wasm.getTableCellBboxes(ctx.sec, ctx.ppi, ctx.ci);
+    } catch { return range; }
+    const merged = bboxes.filter((b) => b.rowSpan > 1 || b.colSpan > 1);
+    if (merged.length === 0) return range;
+    const out = { ...range };
+    for (let changed = true; changed;) {
+      changed = false;
+      for (const b of merged) {
+        const overlaps = b.row <= out.endRow && b.row + b.rowSpan - 1 >= out.startRow
+          && b.col <= out.endCol && b.col + b.colSpan - 1 >= out.startCol;
+        if (!overlaps) continue;
+        const next = {
+          startRow: Math.min(out.startRow, b.row),
+          startCol: Math.min(out.startCol, b.col),
+          endRow: Math.max(out.endRow, b.row + b.rowSpan - 1),
+          endCol: Math.max(out.endCol, b.col + b.colSpan - 1),
+        };
+        if (next.startRow !== out.startRow || next.startCol !== out.startCol
+          || next.endRow !== out.endRow || next.endCol !== out.endCol) {
+          Object.assign(out, next);
+          changed = true;
+        }
+      }
+    }
+    return out;
   }
 
   /** 제외된 셀 목록을 반환한다. */
