   // 줌
   [{ key: '=', ctrl: true }, 'view:zoom-in'],
   [{ key: '+', ctrl: true }, 'view:zoom-in'],
@@ -156,6 +161,46 @@ export function matchShortcut(
     if ((def.alt ?? false) !== e.altKey) continue;
     if (eventKey === def.key) return cmdId;
     if (def.code && eventCode === def.code.toLowerCase()) return cmdId;
+    // [hwpxxx] 한글 입력 상태에서는 e.key 가 'ㄴ'·'Process' 등이 되어 Ctrl/Alt 조합 단축키가
+    // 엇갈린다. 문자가 영문·숫자가 아닐 때만 물리 키(e.code)로 맞춘다 — 영문 배열은 그대로다.
+    if ((def.ctrl || def.alt) && !/^[a-z0-9]$/.test(eventKey)) {
+      const physical = physicalCodeOf(def.key);
+      if (physical && (eventCode === physical || (physical === 'enter' && eventCode === 'numpadenter'))) return cmdId;
+    }
   }
   return null;
 }
+
+/** [hwpxxx] 단축키 정의를 'Ctrl+Shift+L' 같은 표기로 바꾼다. 한글 자모 대체 항목은 null. */
+export function shortcutDefLabel(def: ShortcutDef): string | null {
+  if (!/^[ -~]+$/.test(def.key)) return null;
+  const key = def.key.length === 1 ? def.key.toUpperCase() : def.key.replace(/^f(\d+)$/, 'F$1').replace(/^./, c => c.toUpperCase());
+  return [def.ctrl && 'Ctrl', def.alt && 'Alt', def.shift && 'Shift', key].filter(Boolean).join('+');
+}
+
+/** [hwpxxx] 명령에 실제로 배정된 단축키 표기(기본 표 순서). */
+export function shortcutLabelsFor(commandId: string, platform: PlatformKind = detectPlatformKind()): string[] {
+  const labels: string[] = [];
+  for (const [def, id] of defaultShortcuts) {
+    if (id !== commandId || (def.platform && def.platform !== platform)) continue;
+    const label = shortcutDefLabel(def);
+    if (label && !labels.includes(label)) labels.push(label);
+  }
+  return labels;
+}
+
+/** 단축키 문자에 대응하는 물리 키 코드(소문자). 대응이 없으면 null. */
+export function physicalCodeOf(key: string): string | null {
+  if (/^[a-z]$/.test(key)) return 'key' + key;
+  if (/^[0-9]$/.test(key)) return 'digit' + key;
+  // [hwpxxx] Enter 도 물리 키로 맞춘다: 한글 조합 중에는 e.key 가 'Process' 라 Ctrl+Enter(쪽 나누기) 등이 안 먹었다.
+  return ({ '=': 'equal', '-': 'minus', '[': 'bracketleft', ']': 'bracketright', 'enter': 'enter' } as Record<string, string>)[key] ?? null;
+}
+
+/** 연속 키 두 번째 글자 — 한글 입력 상태·조합 중에도 물리 키로 영문 글자를 구한다. */
+export function chordLetter(e: KeyboardEvent): string {
+  const key = e.key.toLowerCase();
+  if (/^[a-z]$/.test(key)) return key;
+  const physical = /^Key([A-Z])$/.exec(e.code ?? '');
+  return physical ? physical[1].toLowerCase() : key;
+}
