+/** [hwpxxx] `getMemoList()` 한 항목 전체. 메모 창이 목록·수정·삭제에 쓴다. */
+export interface MemoEntry extends MemoAnchor {
+  id: number;
+  index: number;
+  author: string;
+  date: string;
+  text: string;
+  place: string;
+  page: number | null;
+  editable: boolean;
