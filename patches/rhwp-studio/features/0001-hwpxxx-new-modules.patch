+/* hwpxxx 메모 창: 편집 영역 오른쪽에 붙는 패널. 색은 앱 토큰을 따라 밝은/어두운 테마에서 함께 바뀐다. */
+body.hwpxxx-memo-open #editor-area { margin-right: 320px; }
+#hwpxxx-memo-panel {
+  position: fixed;
+  right: 0;
+  width: 320px;
+  box-sizing: border-box;
+  display: none;
+  flex-direction: column;
+  background: var(--ui-bg-light);
+  color: var(--ui-text);
+  border-left: 1px solid var(--ui-border);
+  font-size: 13px;
+  z-index: 50;
+}
+#hwpxxx-memo-panel.open { display: flex; }
+#hwpxxx-memo-panel .hm-head { display: flex; align-items: center; gap: 6px; padding: 8px 10px; border-bottom: 1px solid var(--ui-border-light); background: var(--ui-surface-raised); font-weight: 600; }
+#hwpxxx-memo-panel .hm-head .hm-title { flex: 1; }
+#hwpxxx-memo-panel button { font: inherit; color: var(--ui-text); background: var(--ui-surface); border: 1px solid var(--ui-border); border-radius: 3px; padding: 3px 8px; cursor: pointer; }
+#hwpxxx-memo-panel button:hover:not(:disabled) { background: var(--ui-hover); }
+#hwpxxx-memo-panel button:disabled { color: var(--ui-text-disabled); cursor: default; }
+#hwpxxx-memo-panel button.hm-primary { background: var(--ui-menu-open); border-color: var(--ui-menu-open-border); color: var(--ui-text-on-accent); }
+#hwpxxx-memo-panel button.hm-danger { color: var(--ui-danger-strong); }
+#hwpxxx-memo-panel .hm-add { margin: 8px 10px 0; }
+#hwpxxx-memo-panel .hm-notice { margin: 8px 10px 0; padding: 6px 8px; background: var(--ui-note-bg); border: 1px solid var(--ui-note-border); color: var(--ui-note-text); border-radius: 3px; line-height: 1.45; }
+#hwpxxx-memo-panel .hm-notice.warn { background: var(--ui-warning-bg); border-color: var(--ui-warning-border); color: var(--ui-warning-text); }
+#hwpxxx-memo-panel .hm-compose { margin: 8px 10px 0; padding: 8px; background: var(--ui-surface); border: 1px solid var(--ui-border); border-radius: 3px; display: grid; gap: 6px; }
+#hwpxxx-memo-panel .hm-target { color: var(--ui-text-secondary); word-break: break-all; }
+#hwpxxx-memo-panel textarea, #hwpxxx-memo-panel input[type="text"] { font: inherit; color: var(--ui-text); background: var(--ui-surface); border: 1px solid var(--ui-border); border-radius: 3px; padding: 4px 6px; box-sizing: border-box; width: 100%; }
+#hwpxxx-memo-panel textarea { min-height: 72px; resize: vertical; }
+#hwpxxx-memo-panel .hm-row { display: flex; gap: 6px; justify-content: flex-end; }
+#hwpxxx-memo-panel .hm-list { flex: 1; overflow-y: auto; padding: 8px 10px 10px; display: grid; gap: 8px; align-content: start; }
+#hwpxxx-memo-panel .hm-empty { color: var(--ui-text-hint); padding: 12px 2px; }
+#hwpxxx-memo-panel .hm-card { background: var(--ui-surface); border: 1px solid var(--ui-border); border-left: 3px solid var(--ui-menu-open); border-radius: 3px; padding: 6px 8px; display: grid; gap: 4px; }
+#hwpxxx-memo-panel .hm-meta { color: var(--ui-text-muted); font-size: 12px; display: flex; gap: 6px; flex-wrap: wrap; }
+#hwpxxx-memo-panel .hm-anchor { text-align: left; background: var(--ui-accent-bg-light); border: 0; padding: 2px 6px; color: var(--ui-link); word-break: break-all; }
+#hwpxxx-memo-panel .hm-text { white-space: pre-wrap; word-break: break-word; line-height: 1.45; }
+#hwpxxx-memo-panel .hm-actions { display: flex; gap: 6px; justify-content: flex-end; }
+#hwpxxx-memo-panel .hm-foot { padding: 6px 10px; border-top: 1px solid var(--ui-border-light); color: var(--ui-text-hint); font-size: 12px; line-height: 1.4; }
+
+/* hwpxxx 문서 화면의 메모 표시: 글자 칠 + [ ] + 오른쪽 여백의 메모 상자와 점선 안내선 (한글의 메모 보이기 모양) */
+.hwpxxx-memo-marks { position: absolute; left: 0; top: 0; width: 0; height: 0; z-index: 8; pointer-events: none; }
