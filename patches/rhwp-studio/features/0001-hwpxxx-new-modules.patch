+    if (path.some(step => step.type !== 'cell')) return [];
+    try {
+      const wasm = this.services.wasm;
+      if (!path.length) return wasm.getSelectionRects(memo.sectionIndex, memo.paraIndex, memo.startCharIdx, memo.paraIndex, memo.endCharIdx);
