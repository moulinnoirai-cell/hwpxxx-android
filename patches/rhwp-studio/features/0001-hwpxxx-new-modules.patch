@@ -0,0 +1,22 @@
+// [hwpxxx] PDF 가져오기 지원 확인: 엔진이 아직 초기화되지 않아 호출이 던져도 '지원 안 함'으로 보고 계속한다(새 탭의 첫 file:open 이 엔진보다 먼저 불릴 수 있다).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { hasPdfImportCapability } from '../src/core/pdf-import-capability.ts';
+
+test('지원 함수가 true 를 돌려줄 때만 true 다', () => {
+  assert.equal(hasPdfImportCapability({ supportsPdfImport: () => true }), true);
+  assert.equal(hasPdfImportCapability({ supportsPdfImport: () => false }), false);
+  assert.equal(hasPdfImportCapability({ supportsPdfImport: () => 1 }), false);
+});
+
+test('함수가 없거나 엔진이 없으면 false 다', () => {
+  assert.equal(hasPdfImportCapability(null), false);
+  assert.equal(hasPdfImportCapability({}), false);
+  assert.equal(hasPdfImportCapability(undefined), false);
+});
+
+test('엔진이 초기화되지 않아 호출이 던져도 던지지 않고 false 다', () => {
+  const uninitialized = { supportsPdfImport: () => { throw new TypeError("Cannot read properties of undefined (reading 'hwpdocument_supportsPdfImport')"); } };
+  assert.doesNotThrow(() => hasPdfImportCapability(uninitialized));
+  assert.equal(hasPdfImportCapability(uninitialized), false);
+});
diff --git a/rhwp-studio/tests/hwpxxx-perf-probe.test.ts b/rhwp-studio/tests/hwpxxx-perf-probe.test.ts
new file mode 100644
index 0000000..3279c21
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-perf-probe.test.ts
@@ -0,0 +1,66 @@
+// [hwpxxx] 성능 계측기: 숫자만 담고, 동작(반환·this·예외)을 바꾸지 않으며, 고리 버퍼가 넘치지 않는다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { recordPerf, timed, timedAsync, wrapMethods, perfSnapshot, resetPerf } from '../src/hwpxxx/perf-probe.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+test('timed/timedAsync 는 결과를 그대로 돌려주고 시간을 기록하며, 던지면 기록한 뒤 다시 던진다', async () => {
+  resetPerf();
+  assert.equal(timed('a', () => 7, (r) => ({ bytes: r ?? 0 })), 7);
+  assert.equal(await timedAsync('b', async () => 'x'), 'x');
+  assert.throws(() => timed('c', () => { throw new Error('boom'); }), /boom/);
+  await assert.rejects(timedAsync('d', async () => { throw new Error('async boom'); }), /async boom/);
+  const { summary } = perfSnapshot();
+  for (const name of ['a', 'b', 'c', 'd']) assert.equal(summary[name].count, 1, name);
+  assert.deepEqual(perfSnapshot().recent.find((e) => e.name === 'a')?.extra, { bytes: 7 });
+});
+
+test('extra 계산이 던져도 계측이 동작을 바꾸지 않는다', () => {
+  resetPerf();
+  assert.equal(timed('x', () => 1, () => { throw new Error('extra'); }), 1);
+  assert.equal(perfSnapshot().summary.x.count, 1);
+});
+
+test('wrapMethods: this·인자·반환·예외를 보존하고 이중 래핑하지 않으며 없는 메서드는 건너뛴다', () => {
+  resetPerf();
+  const target: Record<string, any> = {
+    n: 2,
+    add(this: { n: number }, k: number) { return this.n + k; },
+    fail() { throw new Error('nope'); },
+  };
+  wrapMethods(target, ['add', 'fail', 'missing'], 'input');
+  wrapMethods(target, ['add'], 'input');
+  assert.equal(target.add(3), 5);
+  assert.throws(() => target.fail(), /nope/);
+  assert.equal('missing' in target, false);
+  const { summary } = perfSnapshot();
+  assert.equal(summary['input.add'].count, 1, '한 번 호출 → 한 번 기록');
+  assert.equal(summary['input.fail'].count, 1);
+});
+
+test('고리 버퍼는 300개를 넘지 않고, 요약은 횟수·합계·최대·p95 를 낸다', () => {
+  resetPerf();
+  for (let i = 1; i <= 350; i++) recordPerf('loop', i);
+  recordPerf('nan', Number.NaN);
+  const snap = perfSnapshot();
+  assert.equal(snap.summary.loop.count, 300);
+  assert.equal(snap.dropped, 50);
+  assert.equal(snap.summary.loop.maxMs, 350);
+  assert.equal(snap.summary.loop.p95Ms, 335);
+  assert.equal(snap.summary.nan, undefined, '유한하지 않은 값은 기록하지 않는다');
+  assert.ok(snap.recent.length <= 60);
+});
+
+test('연결: 자동 저장의 내보내기·보호·저장소 단계와 입력 경로가 계측되고, 문서 내용은 담지 않는다', () => {
+  const manager = source('recovery/autosave-manager.ts');
+  assert.match(manager, /timed\('autosave\.export'/);
+  assert.match(manager, /timedAsync\('autosave\.protect'/);
+  assert.match(manager, /timedAsync\('autosave\.store'/);
+  const main = source('main.ts');
+  assert.match(main, /installPerfProbe\(\);/);
+  assert.match(main, /installInputPerfProbes\(inputHandler/);
+  const probe = source('hwpxxx/perf-probe.ts');
+  assert.ok(!/fileName|textContent|innerText|getText/.test(probe.replace(/\/\*\*[\s\S]*?\*\//g, '')), '계측기는 이름·내용을 읽지 않는다');
+});
diff --git a/rhwp-studio/tests/support/studio-alias-hooks.mjs b/rhwp-studio/tests/support/studio-alias-hooks.mjs
new file mode 100644
index 0000000..cd705a3
--- /dev/null
+++ b/rhwp-studio/tests/support/studio-alias-hooks.mjs
@@ -0,0 +1,36 @@
+// 시험용 모듈 해석 훅: Vite 처럼 별칭(`@/` → src/, `@wasm/` → ../pkg/)과 확장자 없는 상대 경로를 Node 가 따라가게 한다. 시험 전용이다.
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { existsSync, statSync } from 'node:fs';
+import path from 'node:path';
+const src = fileURLToPath(new URL('../../src/', import.meta.url));
+const pkg = fileURLToPath(new URL('../../../pkg/', import.meta.url));
+const isFile = (p) => existsSync(p) && statSync(p).isFile();
+function withExtension(base) {
+  for (const candidate of [base, `${base}.ts`, path.join(base, 'index.ts')]) if (isFile(candidate)) return candidate;
+  return null;
+}
+export async function resolve(specifier, context, next) {
+  let base = null;
+  if (specifier.startsWith('@wasm/')) base = pkg + specifier.slice(6);
+  else if (specifier.startsWith('@/')) base = src + specifier.slice(2);
+  else if ((specifier.startsWith('./') || specifier.startsWith('../')) && context.parentURL?.startsWith('file:') && !path.extname(specifier)) {
+    base = path.resolve(path.dirname(fileURLToPath(context.parentURL)), specifier);
+  }
+  if (base) {
+    const found = withExtension(base);
+    if (found) return next(pathToFileURL(found).href, context);
+  }
+  return next(specifier, context);
+}
+
+// Vite 가 채우는 `import.meta.env` 를 프로덕션 값으로 대신한다(DEV 아님).
+export async function load(url, context, next) {
+  const result = await next(url, context);
+  if (url.includes('/rhwp-studio/src/') && result.source != null) {
+    const text = result.source.toString();
+    if (text.includes('import.meta.env')) {
+      return { ...result, source: text.replaceAll('import.meta.env', '({ DEV: false, PROD: true, MODE: "production", BASE_URL: "/studio/" })') };
+    }
+  }
+  return result;
+}
