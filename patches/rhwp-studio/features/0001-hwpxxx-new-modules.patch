+.hwpxxx-memo-box:hover { background: #dcf7c4; }
+.hwpxxx-memo-box-head { font-weight: 600; font-size: 10px; color: #335a1d; border-bottom: 1px solid #8fc06a; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.hwpxxx-memo-box-body { white-space: pre-wrap; word-break: break-word; max-height: 160px; overflow: hidden; }
