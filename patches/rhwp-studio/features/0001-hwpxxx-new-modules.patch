+++ b/rhwp-studio/src/hwpxxx/signature-memo.ts
@@ -0,0 +1,30 @@
+/**
+ * [hwpxxx] 입력 지연 완화: 글꼴 이름 치환 결과의 서명 기반 메모.
+ *
+ * 캔버스 `ctx.font` 대입마다 Studio 는 글꼴 체인을 처음부터 다시 만든다(`substituteCssFontFamily`: 이름 정규화·후보 병합·중복 검사).
+ * 한 번 다시 그릴 때 글자 덩어리마다 불리고 키 입력마다 다시 그리므로, 태블릿에서는 키 하나에 수백 ms 가 여기서 나갔다
+ * (CPU 프로파일에서 메인 스레드의 대부분). 같은 입력의 결과는 글꼴 환경이 같은 동안 같으므로 입력 문자열별로 한 번만 계산한다.
+ *
+ * 글꼴 환경이 바뀌면(문서 교체로 선언 치환이 바뀜, 로컬·호스트 글꼴 목록이 바뀜) `signature()` 가 달라져 메모를 통째로 비운다.
+ * 서명은 숫자 몇 개를 이어 붙인 값이라 호출마다 읽어도 싸다. 메모는 크기 상한이 있어 무한히 자라지 않는다.
+ */
+export function memoizeBySignature(
+  compute: (input: string) => string,
+  signature: () => string,
+  limit = 2000,
+): (input: string) => string {
+  let current = signature();
+  const memo = new Map<string, string>();
+  return (input: string): string => {
+    // 진단용 스위치: 시험이 메모를 끄고 같은 장면을 다시 그려 메모가 결과를 바꾸는지 가린다.
+    if ((globalThis as { __hwpxxxNoFontMemo?: boolean }).__hwpxxxNoFontMemo === true) return compute(input);
+    const now = signature();
+    if (now !== current) { memo.clear(); current = now; }
+    const hit = memo.get(input);
+    if (hit !== undefined) return hit;
+    const value = compute(input);
+    if (memo.size >= limit) memo.clear();
+    memo.set(input, value);
+    return value;
+  };
+}
