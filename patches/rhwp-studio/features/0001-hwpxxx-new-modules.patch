+++ b/rhwp-studio/src/command/chord-map.ts
@@ -0,0 +1,57 @@
+// [hwpxxx] 연속 키 표 — 입력 처리(engine/input-handler-keyboard)와 툴팁이 함께 쓴다(원래 input-handler-keyboard 안에 있던 표).
+
+/** 코드 단축키 → 커맨드 ID 매핑 (Ctrl+K,? 형태) */
+export const chordMapK: Record<string, string> = {
+  h: 'insert:hyperlink',
+  ㅗ: 'insert:hyperlink', // 한글 IME 상태
+  b: 'insert:bookmark',
+  ㅠ: 'insert:bookmark', // 한글 IME 상태
+  n: 'format:para-num-shape',
+  ㅜ: 'format:para-num-shape', // 한글 IME 상태
+  e: 'insert:field', // [hwpxxx] 누름틀 넣기 — 안내(Ctrl+K,E)는 있었으나 연결이 없었다
+};
+
+/** 코드 단축키 → 커맨드 ID 매핑 (Ctrl+M,? 형태)
+ *
+ * 한컴 표준 영역 영역 Ctrl+N 영역 영역 chord 시작 영역 영역 Chrome 영역 영역 reserved shortcut
+ * (새 창) 영역 영역 JS 차단 불가 영역 영역 Ctrl+M 영역 영역 변경 (PR #786 후속 정정).
+ */
+export const chordMapM: Record<string, string> = {
+  a: 'table:split',   // 한컴 Ctrl+N,A — Chrome 이 Ctrl+N 을 차단해 Ctrl+M 계열로 이관
+  ㅁ: 'table:split',  // 한글 IME
+  z: 'table:attach',  // 한컴 Ctrl+N,Z
+  ㅋ: 'table:attach', // 한글 IME
+  n: 'insert:footnote',
+  ㅜ: 'insert:footnote', // 한글 IME
+  s: 'page:hide',
+  ㄴ: 'page:hide', // 한글 IME
+  m: 'insert:equation',
+  ㅡ: 'insert:equation', // 한글 IME
+  k: 'field:edit',    // [hwpxxx] 누름틀 고치기 — 안내(Ctrl+M,K)는 있었으나 연결이 없었다
+  f: 'table:formula', // [hwpxxx] 계산식 — 안내(Ctrl+M,F)는 있었으나 연결이 없었다
+};
+
+/** 코드 단축키 → 커맨드 ID 매핑 (Alt+V,? 형태 — 보기 메뉴) */
+export const chordMapV: Record<string, string> = {
+  t: 'view:border-transparent',
+  ㅅ: 'view:border-transparent', // 한글 IME
+};
+
+/** 코드 단축키 → 커맨드 ID 매핑 (Ctrl+G,? 형태 — 보기/조판 메뉴) */
+export const chordMapG: Record<string, string> = {
+  c: 'view:ctrl-mark',        // 조판 부호
+  ㅊ: 'view:ctrl-mark',       // 한글 IME
+  t: 'view:para-mark',        // 문단 부호
+  ㅅ: 'view:para-mark',       // 한글 IME
+  p: 'view:zoom-fit-page',    // 쪽 맞춤
+  ㅍ: 'view:zoom-fit-page',   // 한글 IME
+  w: 'view:zoom-fit-width',   // 폭 맞춤
+  ㅈ: 'view:zoom-fit-width',  // 한글 IME
+  q: 'view:zoom-100',         // 100%
+  ㅂ: 'view:zoom-100',        // 한글 IME
+};
+
+/** [hwpxxx] 연속 키 표 — 툴팁이 실제로 처리되는 키를 안내하도록 같은 표를 공개한다. */
+export const chordShortcutTables: ReadonlyArray<readonly [string, Readonly<Record<string, string>>]> = [
+  ['Ctrl+K', chordMapK], ['Ctrl+M', chordMapM], ['Ctrl+G', chordMapG], ['Alt+V', chordMapV],
+];
diff --git a/rhwp-studio/src/command/commands/memo.ts b/rhwp-studio/src/command/commands/memo.ts
new file mode 100644
index 0000000..aaf6e4b
--- /dev/null
+++ b/rhwp-studio/src/command/commands/memo.ts
@@ -0,0 +1,53 @@
+// [hwpxxx] 메모 명령 — 실제 동작은 hwpxxx/memo-panel.ts 에 있다.
+import type { CommandDef } from '../types';
+import { memoPanel } from '@/hwpxxx/memo-panel';
+import { takeContextMemo } from '@/hwpxxx/memo-context';
+import { memoMarks } from '@/hwpxxx/memo-marks';
+
+export const memoInsertCommand: CommandDef = {
+  id: 'insert:memo',
+  label: '메모 삽입',
+  canExecute: ctx => ctx.hasDocument && ctx.isEditable && !ctx.isFormMode,
+  execute(services) {
+    memoPanel(services).beginCompose();
+  },
+};
+
+export const memoPanelCommand: CommandDef = {
+  id: 'view:memo-panel',
+  label: '메모 창',
+  canExecute: ctx => ctx.hasDocument,
+  execute(services) {
+    memoPanel(services).toggle();
+  },
+};
+
+export const memoDeleteContextCommand: CommandDef = {
+  id: 'memo:delete-context',
+  label: '메모 삭제',
+  canExecute: ctx => ctx.hasDocument && ctx.isEditable && !ctx.isFormMode,
+  execute(services) {
+    const id = takeContextMemo();
+    if (id !== null) void memoPanel(services).deleteById(id);
+  },
+};
+
+export const memoShowCommand: CommandDef = {
+  id: 'view:memo-show',
+  label: '메모 보이기/숨기기',
+  canExecute: ctx => ctx.hasDocument,
+  execute(services) {
+    const marks = memoMarks(services);
+    marks.setShown(!marks.isShown());
+  },
+};
+
+export const memoGuideCommand: CommandDef = {
+  id: 'view:memo-guide',
+  label: '메모 안내선 표시',
+  canExecute: ctx => ctx.hasDocument,
+  execute(services) {
+    const marks = memoMarks(services);
+    marks.setGuide(!marks.isGuideShown());
+  },
+};
diff --git a/rhwp-studio/src/core/lineseg-autoreflow.ts b/rhwp-studio/src/core/lineseg-autoreflow.ts
new file mode 100644
index 0000000..c59ca85
--- /dev/null
+++ b/rhwp-studio/src/core/lineseg-autoreflow.ts
@@ -0,0 +1,16 @@
+// [hwpxxx] 줄 정보(linesegarray)가 없는 HWPX 의 열기 보정.
+//
+// 다른 도구(예: AI 가 만든 HWPX)가 저장한 문서는 본문 문단에 linesegarray 가 없을 수 있다. 화면 글자는
+// 렌더 단계에서 다시 줄바꿈되지만, 선택 영역·줄 이동·줄 수 조회는 저장 줄 정보를 쓰므로 여러 줄 문단이
+// "한 줄"로 취급되어 첫 줄만 선택된 것처럼 보인다. 경고가 전부 '줄 배열 없음'일 때만 열면서 한 번 계산한다.
+// 한컴이 계산해 둔 줄 정보(LinesegTextRunReflow 등)가 섞인 문서는 쪽 수가 바뀔 수 있으므로 건드리지 않는다.
+export interface ValidationReportLike {
+  count: number;
+  warnings?: Array<{ kind?: string }>;
+}
+
+export function onlyEmptyLinesegWarnings(report: ValidationReportLike | null | undefined): boolean {
+  if (!report || report.count <= 0) return false;
+  const warnings = report.warnings ?? [];
+  return warnings.length > 0 && warnings.every(w => w.kind === 'LinesegArrayEmpty');
+}
diff --git a/rhwp-studio/src/hwpxxx/composition-font.ts b/rhwp-studio/src/hwpxxx/composition-font.ts
new file mode 100644
index 0000000..bef76a6
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/composition-font.ts
@@ -0,0 +1,50 @@
+/**
+ * [hwpxxx] IME 조합 오버레이의 글꼴.
+ *
+ * 조합 중인 글자는 문서에 이미 들어가 있지만, 그 위에 덮는 오버레이는 DOM 이라 캔버스와 다른 경로로 글꼴을 찾는다.
+ * 캔버스는 `ctx.font` 대입이 Studio 의 글꼴 치환(`substituteCssFontFamily`: 문서에 없는 글꼴 → 표시 가능한 대체 체인)을
+ * 거치지만, 오버레이는 글꼴 이름만 그대로 CSS 에 넣어 Android 처럼 해당 글꼴이 없는 기기에서 기본 글꼴로 떨어졌다.
+ * 그래서 조합 중에는 다른 글꼴로 보이다가 확정되면 설정한 글꼴로 바뀌어 보였다.
+ * 여기서는 캔버스와 같은 대입 경로(오프스크린 캔버스의 `ctx.font`)로 글꼴을 풀고, 실제 글자 크기·굵기·기울임도 따른다.
+ */
+export interface CompositionFontInput {
+  fontFamily?: string;
+  /** HWPUNIT (1pt = 100) */
+  fontSize?: number;
+  bold?: boolean;
+  italic?: boolean;
+  zoom: number;
+  /** 글자 크기를 모를 때 쓰는 오버레이 상자 높이(CSS px, 줌 적용 전) */
+  boxHeight: number;
+}
+
+export type FontResolver = (font: string) => string;
+
+let sharedContext: CanvasRenderingContext2D | null | undefined;
+
+/** 캔버스 `ctx.font` 대입을 거쳐 풀린 글꼴(치환 체인 포함). 캔버스를 못 쓰면 그대로 돌려준다. */
+export function resolveFontLikeCanvas(font: string): string {
+  try {
+    if (sharedContext === undefined) {
+      sharedContext = typeof document !== 'undefined' ? document.createElement('canvas').getContext('2d') : null;
+    }
+    if (!sharedContext) return font;
+    sharedContext.font = font;
+    return sharedContext.font || font;
+  } catch {
+    return font;
+  }
+}
+
+function quoteFamily(name: string): string {
+  return `"${name.replace(/["\\\n\r]/g, '')}"`;
+}
+
+/** 오버레이에 쓸 CSS `font` 값. 글자 크기는 문서의 실제 크기(없으면 상자 높이의 85%)에 줌을 곱한다. */
+export function compositionCssFont(input: CompositionFontInput, resolve: FontResolver = resolveFontLikeCanvas): string {
+  const pt = typeof input.fontSize === 'number' && Number.isFinite(input.fontSize) && input.fontSize > 0 ? input.fontSize / 100 : null;
+  const px = Math.max(1, (pt !== null ? pt * 96 / 72 : input.boxHeight * 0.85) * input.zoom);
+  const family = input.fontFamily && input.fontFamily.trim() ? `${quoteFamily(input.fontFamily.trim())}, sans-serif` : 'sans-serif';
+  const style = `${input.italic ? 'italic ' : ''}${input.bold ? 'bold ' : ''}`;
+  return resolve(`${style}${Math.round(px * 100) / 100}px ${family}`);
+}
diff --git a/rhwp-studio/src/hwpxxx/content-loss.ts b/rhwp-studio/src/hwpxxx/content-loss.ts
new file mode 100644
index 0000000..b9420e9
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/content-loss.ts
@@ -0,0 +1,26 @@
+/**
+ * [hwpxxx] 내보내기 내용 손실 보고에서 '저장을 막아야 하는 손실'만 가려낸다.
+ *
+ * rhwp v0.9.0 은 `metadataReduced` 도 보고한다(예: 병합한 표의 잠재 행 격자 — "rhwp 왕복 보존, 한컴에는 실제 셀 경계만 투영").
+ * 이는 문서의 글·개체를 잃는 것이 아니라 편집 메타데이터가 줄어드는 안내라서, 이것만으로 Android 의 안전 저장(손실이 있으면
+ * 저장하지 않음)을 막으면 병합한 표가 있는 문서를 HWPX 로 저장할 수 없다. 반대로 `binaryContentEmptied`(자원 내용이 빔)·
+ * `controlOmitted`(컨트롤이 빠짐)와 처음 보는 코드는 사용자 내용을 잃을 수 있으므로 그대로 막는다(알 수 없으면 막는 쪽).
+ */
+export interface ContentLossLike {
+  count?: number;
+  losses?: ReadonlyArray<{ code?: unknown; path?: unknown }>;
+}
+
+/** 이 코드만 저장을 막지 않는다. */
+export const NON_BLOCKING_LOSS_CODES: ReadonlySet<string> = new Set(['metadataReduced']);
+
+export function blockingContentLosses<T extends { code?: unknown }>(losses: ReadonlyArray<T> | undefined): T[] {
+  return (losses ?? []).filter((loss) => !(typeof loss?.code === 'string' && NON_BLOCKING_LOSS_CODES.has(loss.code)));
+}
+
+export function hasBlockingContentLoss(report: ContentLossLike | null | undefined): boolean {
+  if (!report) return false;
+  if (blockingContentLosses(report.losses).length > 0) return true;
+  // 항목 없이 개수만 있는 보고는 무엇을 잃는지 알 수 없어 막는다.
+  return (report.count ?? 0) > (report.losses?.length ?? 0);
+}
diff --git a/rhwp-studio/src/hwpxxx/memo-context.ts b/rhwp-studio/src/hwpxxx/memo-context.ts
new file mode 100644
index 0000000..cd6016a
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/memo-context.ts
@@ -0,0 +1,74 @@
+// [hwpxxx] 우클릭 메뉴용 메모 판별: 글자를 선택했으면 '메모 삽입', 메모가 달린 글자 위면 '메모 삭제'.
+import type { ContextMenuItem } from '@/ui/context-menu';
+import type { MemoEntry } from '@/core/memo';
+
+let pending: number | null = null;
+/** 우클릭 메뉴의 '메모 삭제' 가 가리키는 메모 id 를 한 번만 꺼낸다. */
+export function takeContextMemo(): number | null {
+  const id = pending;
+  pending = null;
+  return id;
+}
+
+/** 클릭 위치(hitTest 결과)와 같은 문단·칸 경로에 있는 메모만 고른다. */
+function memosAt(entries: MemoEntry[], hit: any): MemoEntry[] {
+  const path: Array<{ controlIndex: number; cellIndex?: number; cellParaIndex: number }> = hit.cellPath?.length
+    ? hit.cellPath
+    : hit.parentParaIndex !== undefined ? [{ controlIndex: hit.controlIndex, cellIndex: hit.cellIndex, cellParaIndex: hit.cellParaIndex }] : [];
+  const top = hit.parentParaIndex ?? hit.paragraphIndex;
+  return entries.filter(entry => {
+    if (entry.sectionIndex !== hit.sectionIndex || entry.paraIndex !== top) return false;
+    const where = entry.path ?? [];
+    return where.length === path.length && where.every((step, at) => step.controlIndex === path[at].controlIndex && step.paraIndex === path[at].cellParaIndex
+      && (step.type === 'textbox' || step.cellIndex === path[at].cellIndex));
+  });
+}
+
+/** 마우스 아래 글자가 메모 범위 안이면 그 메모를 돌려준다. */
+function memoAtPointer(self: any, e: MouseEvent): MemoEntry | null {
+  const content = self.container.querySelector('#scroll-content');
+  if (!content) return null;
+  const box = content.getBoundingClientRect();
+  const x = e.clientX - box.left, y = e.clientY - box.top;
+  const page = self.virtualScroll.getPageAtPoint(x, y);
+  if (page < 0 || page >= self.wasm.pageCount) return null;
+  const zoom = self.viewportManager.getZoom();
+  const px = (x - self.virtualScroll.getPageLeftResolved(page, content.clientWidth)) / zoom;
+  const py = (y - self.virtualScroll.getPageOffset(page)) / zoom;
+  const hit = self.wasm.hitTest(page, px, py);
+  const offset: number = hit.charOffset;
+  const candidates = memosAt(self.wasm.getMemoList(), hit)
+    .filter(entry => entry.startCharIdx !== null && entry.endCharIdx !== null && offset >= entry.startCharIdx && offset <= entry.endCharIdx)
+    .sort((a, b) => ((a.endCharIdx ?? 0) - (a.startCharIdx ?? 0)) - ((b.endCharIdx ?? 0) - (b.startCharIdx ?? 0)));
+  for (const entry of candidates) {
+    const from = entry.startCharIdx ?? 0, to = entry.endCharIdx ?? 0;
+    // 글자 오른쪽 절반을 누르면 다음 offset 이 나오므로, 실제로 그 글자 영역 위에 있는지 한 번 더 본다(하이퍼링크와 같은 방식).
+    let over: boolean;
+    try {
+      const steps: Array<{ controlIndex: number; cellIndex?: number; cellParaIndex: number }> = hit.cellPath?.length
+        ? hit.cellPath
+        : hit.parentParaIndex !== undefined ? [{ controlIndex: hit.controlIndex, cellIndex: hit.cellIndex, cellParaIndex: hit.cellParaIndex }] : [];
+      const rects = steps.length
+        ? self.wasm.getSelectionRectsInCellByPath(hit.sectionIndex, hit.parentParaIndex, JSON.stringify(steps), steps[steps.length - 1].cellParaIndex, from, steps[steps.length - 1].cellParaIndex, to)
+        : self.wasm.getSelectionRects(hit.sectionIndex, hit.paragraphIndex, from, hit.paragraphIndex, to);
+      over = rects.some((r: any) => r.pageIndex === page && px >= r.x && px <= r.x + r.width && py >= r.y && py <= r.y + r.height);
+    } catch { over = offset >= from && offset < to; }
+    if (over) return entry;
+  }
+  return null;
+}
+
+export function memoContextItems(self: any, e: MouseEvent): ContextMenuItem[] {
+  pending = null;
+  try {
+    if (!self.wasm?.hasLoadedDocument?.() || !self.canEditHyperlink?.()) return [];
+    const memo = memoAtPointer(self, e);
+    if (memo) {
+      if (!memo.editable) return [];
+      pending = memo.id;
+      return [{ type: 'separator' }, { type: 'command', commandId: 'memo:delete-context', label: '메모 삭제' }];
+    }
+    if (self.hasSelection?.()) return [{ type: 'separator' }, { type: 'command', commandId: 'insert:memo', label: '메모 삽입' }];
+  } catch { /* 메모 판별이 안 되는 위치는 일반 메뉴만 보인다 */ }
+  return [];
+}
diff --git a/rhwp-studio/src/hwpxxx/memo-marks.ts b/rhwp-studio/src/hwpxxx/memo-marks.ts
new file mode 100644
index 0000000..04a5aaa
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/memo-marks.ts
@@ -0,0 +1,240 @@
+// [hwpxxx] 문서 화면의 메모 표시: 한글처럼 메모가 달린 글자를 초록색 [ ] 로 칠하고, 용지 오른쪽 여백의 메모 상자와 점선 안내선으로 잇는다.
+// 보기 > 메모 보이기/숨기기, 메모 안내선 표시로 켜고 끈다. 화면에만 그리는 표시라 문서 내용·저장 파일에는 영향이 없다.
+import '@/styles/hwpxxx-memo.css';
+import type { CommandServices } from '@/command/types';
+import type { MemoEntry } from '@/core/memo';
+import { memoPanel } from '@/hwpxxx/memo-panel';
+
+const SHOW_KEY = 'hwpxxx.memoShow';
+const GUIDE_KEY = 'hwpxxx.memoGuide';
+const read = (key: string): boolean => { try { return localStorage.getItem(key) !== '0'; } catch { return true; } };
+const write = (key: string, value: boolean): void => { try { localStorage.setItem(key, value ? '1' : '0'); } catch { /* 저장소를 못 쓰면 이번 실행에서만 유지한다 */ } };
+// 한글은 작성 시각을 현지 시각에 Z 를 붙여 기록한다.
+const when = (value: string | null): string => typeof value !== 'string' ? '' : /^\d{4}-\d\d-\d\dT\d\d:\d\d/.test(value) ? value.slice(0, 16).replace('T', ' ') : value;
+
+const BOX_WIDTH = 228;
+const BOX_GAP = 16;
+const BOX_SPACING = 4;
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+interface Rect { pageIndex: number; x: number; y: number; width: number; height: number }
+interface Mark { memo: MemoEntry; rects: Rect[] }
+interface MarkView { content: HTMLElement; scroll: { getPageOffset(i: number): number; getPageWidth(i: number): number; getPageLeftResolved(i: number, w: number): number }; zoom: number }
+type Step = { controlIndex: number; cellIndex: number; cellParaIndex: number };
+
+export class MemoMarks {
+  private show = read(SHOW_KEY);
+  private guide = read(GUIDE_KEY);
+  private layer: HTMLDivElement | null = null;
+  private svg: SVGSVGElement | null = null;
+  private marks: Mark[] = [];
+  private timer: number | undefined;
+  private editingId: number | null = null;
+
+  constructor(private readonly services: CommandServices) {
+    const later = () => this.schedule();
+    for (const name of ['document-swapped', 'document-changed', 'document-layout-refreshed', 'document-view-loaded', 'document-view-changed', 'document-page-invalidated', 'zoom-changed', 'viewport-resize'])
+      services.eventBus.on(name, later);
+    window.addEventListener('resize', later);
