index 0000000..6157704
--- /dev/null
+++ b/rhwp-studio/src/ui/command-tooltip.ts
@@ -0,0 +1,185 @@
+/**
+ * [hwpxxx] 도구 막대 버튼 툴팁 — 기능 이름 + 실제 단축키.
+ *
+ * 이름과 단축키는 명령 등록부(CommandRegistry)의 label·shortcutLabel을 그대로 쓴다. 메뉴의 단축키
+ * 표시(menu-shortcut-labels)와 같은 원천이라 따로 하드코딩하지 않는다. 명령이 연결되지 않은 버튼은
+ * 기존 title 문구를 이름으로 쓴다. 브라우저 기본 title 도움말과 겹치지 않도록 hover/focus 동안 title을
+ * 잠시 비워 두고, 사라질 때 되돌린다(언어 전환이 title을 다시 쓰는 경로를 그대로 둔다).
+ */
+import type { CommandRegistry } from '../command/registry';
+import type { CommandDispatcher } from '../command/dispatcher';
+import { formatShortcutLabel } from '../engine/navigation-keymap.ts';
+import { shortcutLabelsFor } from '../command/shortcut-map.ts';
+import { chordShortcutTables } from '../command/chord-map.ts';
+
+const TARGETS = [
+  '#icon-toolbar button', '#style-bar button', '#style-bar select', '#style-bar input',
+  '.tb-btn', '.sb-btn', '.sb-arrow', '[data-cmd]:not(.md-item)',
+].join(',');
+// 메뉴 항목·대화상자 안 요소는 자체 표시가 있으므로 제외한다.
+const EXCLUDED = '.md-item, .md-dropdown, .dialog, [role="dialog"], .sb-dropdown-item';
+const SHOW_DELAY = 500;
+
+// data-cmd 가 없는 기존 버튼이 실제로 실행하는 명령.
+const COMMAND_BY_ID: Record<string, string> = {
+  'btn-bold': 'format:bold', 'btn-italic': 'format:italic', 'btn-underline': 'format:underline',
+  'btn-strike': 'format:strikethrough',
+  'btn-size-up': 'format:font-size-increase', 'btn-size-down': 'format:font-size-decrease',
+  'btn-ls-up': 'format:line-spacing-increase', 'btn-ls-down': 'format:line-spacing-decrease',
+  'btn-align-left': 'format:align-left', 'btn-align-center': 'format:align-center',
+  'btn-align-right': 'format:align-right', 'btn-align-justify': 'format:align-justify',
+  'btn-align-distribute': 'format:align-distribute', 'btn-align-split': 'format:align-split',
+  'btn-ratio-up': 'format:char-ratio-increase', 'btn-ratio-down': 'format:char-ratio-decrease',
+  'btn-spacing-up': 'format:char-spacing-increase', 'btn-spacing-down': 'format:char-spacing-decrease',
+};
+const COMMAND_BY_SPRITE: Record<string, string> = {
+  'icon-cut': 'edit:cut', 'icon-copy': 'edit:copy', 'icon-paste': 'edit:paste',
+};
+
+/** 'Ctrl+M,K' → ['Ctrl+M', 'K'] — 연속 키는 순서대로 배지를 나눈다. */
+export function shortcutParts(label: string): string[] {
+  return label.split(/\s*,\s*/).map(part => formatShortcutLabel(part.trim())).filter(Boolean);
+}
+
+/**
+ * 명령의 단축키 — 등록부 안내(shortcutLabel)가 있으면 그것, 없으면 실제 키 처리 표(기본 단축키 표 →
+ * 연속 키 표)에서 찾는다. 표에 없는 키를 지어내지 않는다.
+ */
+export function commandShortcut(commandId: string, registryLabel?: string): string | undefined {
+  if (registryLabel) return registryLabel;
+  const direct = shortcutLabelsFor(commandId)[0];
+  if (direct) return direct;
+  for (const [prefix, map] of chordShortcutTables) {
+    const letter = Object.keys(map).find(key => /^[a-z]$/.test(key) && map[key] === commandId);
+    if (letter) return prefix + ',' + letter.toUpperCase();
+  }
+  return undefined;
+}
+
+/** title 끝의 "(Ctrl+X)" 같은 단축키 표기. 없으면 undefined. */
+export function shortcutFromTitle(title: string): string | undefined {
+  return /\(((?:Ctrl|Alt|Shift|Cmd)\+[^)]+|F\d+)\)\s*$/i.exec(title)?.[1];
+}
+
+/** 기존 title 의 끝에 붙은 "(Ctrl+X)" 같은 단축키 표기를 떼어 낸 이름. */
+export function nameFromTitle(title: string): string {
+  return title.replace(/\s*\((?:Ctrl|Alt|Shift|Cmd|F\d)[^)]*\)\s*$/i, '').trim();
+}
+
+function commandOf(el: HTMLElement): string | undefined {
+  if (el.dataset.cmd) return el.dataset.cmd;
+  if (el.id && COMMAND_BY_ID[el.id]) return COMMAND_BY_ID[el.id];
+  const sprite = el.querySelector('.tb-sprite');
+  if (sprite) for (const cls of sprite.classList) if (COMMAND_BY_SPRITE[cls]) return COMMAND_BY_SPRITE[cls];
+  return undefined;
+}
+
+export function initCommandTooltips(registry: CommandRegistry, dispatcher: CommandDispatcher): void {
+  const tip = document.createElement('div');
+  tip.id = 'hwpxxx-command-tooltip';
+  tip.className = 'hwpxxx-tooltip';
+  tip.setAttribute('role', 'tooltip');
+  tip.hidden = true;
+  document.body.appendChild(tip);
+
+  let target: HTMLElement | null = null;
+  let timer = 0;
+  let stashedTitle: string | null = null;
+
+  const restoreTitle = () => {
+    if (target && stashedTitle !== null && !target.getAttribute('title')) target.setAttribute('title', stashedTitle);
+    stashedTitle = null;
+  };
+  const hide = () => {
+    window.clearTimeout(timer);
+    if (target) { restoreTitle(); if (target.getAttribute('aria-describedby') === tip.id) target.removeAttribute('aria-describedby'); }
+    target = null;
+    tip.classList.remove('visible');
+    tip.hidden = true;
+  };
+
+  const render = (el: HTMLElement): boolean => {
+    const commandId = commandOf(el);
+    const def = commandId ? registry.get(commandId) : undefined;
+    const title = stashedTitle ?? el.getAttribute('title') ?? '';
+    const name = (def?.label && def.label.trim()) || nameFromTitle(title) || el.getAttribute('aria-label') || '';
+    if (!name) return false;
+    const disabled = el.matches(':disabled, .disabled, [aria-disabled="true"]')
+      || (!!def && !!commandId && !dispatcher.isEnabled(commandId));
+    tip.replaceChildren();
+    const label = document.createElement('span');
+    label.className = 'hwpxxx-tooltip-name';
+    label.textContent = name;
+    tip.appendChild(label);
+    // 실제로 실행할 수 없는 상태에서는 단축키를 정상 지원처럼 보이지 않게 한다.
+    const shortcut = (commandId && commandShortcut(commandId, def?.shortcutLabel)) || shortcutFromTitle(title);
+    if (shortcut && !disabled) {
+      const keys = document.createElement('span');
+      keys.className = 'hwpxxx-tooltip-keys';
+      shortcutParts(shortcut).forEach((part, index) => {
+        if (index) keys.append(' → ');
+        const kbd = document.createElement('kbd');
+        kbd.textContent = part;
+        keys.appendChild(kbd);
+      });
+      tip.appendChild(keys);
+    }
+    if (disabled) {
+      const reason = document.createElement('span');
+      reason.className = 'hwpxxx-tooltip-reason';
+      reason.textContent = '지금은 사용할 수 없습니다';
+      tip.appendChild(reason);
+    }
+    return true;
+  };
+
+  const place = (el: HTMLElement) => {
+    const r = el.getBoundingClientRect();
+    tip.style.left = '0px'; tip.style.top = '0px';
+    const t = tip.getBoundingClientRect();
+    const margin = 6, vw = document.documentElement.clientWidth, vh = document.documentElement.clientHeight;
+    let top = r.bottom + margin;
+    if (top + t.height > vh - margin) top = Math.max(margin, r.top - margin - t.height);
+    const left = Math.min(Math.max(margin, r.left + r.width / 2 - t.width / 2), vw - t.width - margin);
+    tip.style.left = Math.round(left) + 'px';
+    tip.style.top = Math.round(top) + 'px';
+  };
+
+  const arm = (el: HTMLElement, immediate = false) => {
+    if (el === target) return;
+    hide();
+    target = el;
+    stashedTitle = el.getAttribute('title');
+    if (stashedTitle !== null) el.removeAttribute('title');
+    timer = window.setTimeout(() => {
+      if (target !== el || !el.isConnected || !render(el)) return;
+      tip.hidden = false;
+      place(el);
+      el.setAttribute('aria-describedby', tip.id);
+      requestAnimationFrame(() => tip.classList.add('visible'));
+    }, immediate ? 0 : SHOW_DELAY);
+  };
+
+  const find = (node: EventTarget | null): HTMLElement | null => {
+    const el = node instanceof Element ? node.closest(TARGETS) as HTMLElement | null : null;
+    return el && !el.closest(EXCLUDED) ? el : null;
+  };
+
+  // 비활성 버튼은 마우스 이벤트를 받지 못하므로 좌표로 버튼을 찾는다.
+  document.addEventListener('pointermove', e => {
+    if (e.pointerType === 'touch') return;
+    const el = find(document.elementFromPoint(e.clientX, e.clientY));
+    if (el) arm(el); else if (target && document.activeElement !== target) hide();
+  }, { passive: true });
+  document.addEventListener('focusin', e => {
+    const el = find(e.target);
+    if (el && el.matches(':focus-visible')) arm(el, false);
+  });
+  document.addEventListener('focusout', e => { if (e.target === target) hide(); });
+  document.addEventListener('pointerdown', hide, true);
+  document.addEventListener('keydown', e => { if (e.key === 'Escape' || target && e.target !== target) hide(); }, true);
+  document.addEventListener('wheel', hide, { passive: true, capture: true });
+  window.addEventListener('blur', hide);
+  window.addEventListener('resize', hide);
+  document.addEventListener('pointerleave', hide);
+}
diff --git a/rhwp-studio/src/ui/format-copy-dialog.ts b/rhwp-studio/src/ui/format-copy-dialog.ts
new file mode 100644
index 0000000..7a89499
--- /dev/null
+++ b/rhwp-studio/src/ui/format-copy-dialog.ts
@@ -0,0 +1,174 @@
+import { ModalDialog } from './dialog';
+
+/** [hwpxxx] 모양 복사 옵션 — 한/글 Alt+C 대화상자(모양 복사)와 같은 구성 */
+export interface FormatCopyOptions {
+  /** 본문 모양 복사: 글자 모양 / 문단 모양 / 둘 다 / 글자 스타일 / 문단 스타일 */
+  body: 'char' | 'para' | 'both' | 'charStyle' | 'paraStyle';
+  /** 셀 모양 복사 (표 안에서만) */
+  cellAttr: boolean;
+  cellBorder: boolean;
+  cellBackground: boolean;
+  /** 표에서 적용 대상: 본문 모양과 셀 모양 둘 다 / 셀 모양만 */
+  tableTarget: 'both' | 'cellOnly';
+  /** 연속 적용: 복사한 모양을 Esc·새 복사·문서 전환 전까지 여러 번 붙인다(기본 켬) */
+  continuous: boolean;
+}
+
+export const DEFAULT_FORMAT_COPY_OPTIONS: FormatCopyOptions = {
+  body: 'char',
+  cellAttr: false,
+  cellBorder: false,
+  cellBackground: false,
+  tableTarget: 'both',
+  continuous: true,
+};
+
+export interface FormatCopyContext {
+  /** 커서가 표 셀 안에 있는가 (셀 모양 항목 활성화) */
+  inCell: boolean;
+  /** 글자 스타일 복사를 쓸 수 있는가 (엔진이 글자 스타일 위치를 알려주지 않아 현재는 항상 false) */
+  charStyleAvailable: boolean;
+}
+
+const BODY_OPTIONS: ReadonlyArray<{ value: FormatCopyOptions['body']; label: string }> = [
+  { value: 'char', label: '글자 모양' },
+  { value: 'para', label: '문단 모양' },
+  { value: 'both', label: '글자 모양과 문단 모양 둘 다 복사' },
+  { value: 'charStyle', label: '글자 스타일' },
+  { value: 'paraStyle', label: '문단 스타일' },
+];
+
+/** 모양 복사 대화상자 — 커서 위치에서 복사할 서식 범위를 고른다 */
+export class FormatCopyDialog extends ModalDialog {
+  private bodyRadios: HTMLInputElement[] = [];
+  private cellBoxes: Record<'cellAttr' | 'cellBorder' | 'cellBackground', HTMLInputElement> | null = null;
+  private targetRadios: HTMLInputElement[] = [];
+  private continuousBox: HTMLInputElement | null = null;
+
+  private context: FormatCopyContext;
+  private onCopy: (options: FormatCopyOptions) => void;
+
+  // (생성자 매개변수 속성은 쓰지 않는다: Node 의 type-stripping 시험 실행기가 지원하지 않는다)
+  constructor(context: FormatCopyContext, onCopy: (options: FormatCopyOptions) => void) {
+    super('모양 복사', 300);
+    this.context = context;
+    this.onCopy = onCopy;
+  }
+
+  protected createBody(): HTMLElement {
+    const body = document.createElement('div');
+    body.appendChild(this.section('본문 모양 복사', this.buildBody()));
+    body.appendChild(this.section('셀 모양 복사', this.buildCells()));
+    body.appendChild(this.section('표에서 적용 대상', this.buildTarget()));
+    body.appendChild(this.buildContinuous());
+    this.syncTarget();
+    return body;
+  }
+
+  private section(title: string, content: HTMLElement): HTMLElement {
+    const section = document.createElement('div');
+    section.style.marginBottom = '10px';
+    const heading = document.createElement('div');
+    heading.textContent = title;
+    heading.style.cssText = 'font-weight:bold;border-bottom:1px solid #99a;margin-bottom:4px;color:#335';
+    section.appendChild(heading);
+    section.appendChild(content);
+    return section;
+  }
+
+  private option(input: HTMLInputElement, label: string): HTMLLabelElement {
+    const lbl = document.createElement('label');
+    lbl.appendChild(input);
+    lbl.appendChild(document.createTextNode(label));
+    return lbl;
+  }
+
+  /**
+   * 라디오·체크박스에서 Enter 는 확인이다. 대화상자의 문서 단위 capture 핸들러가 입력 칸의 키를 먼저 가로채
+   * 칸 자신의 keydown 핸들러에는 닿지 않으므로, 기반 클래스의 확인 판정 훅으로 알린다.
+   */
+  protected override shouldConfirmOnEnter(target: HTMLElement): boolean {
+    return target instanceof HTMLInputElement && (target.type === 'radio' || target.type === 'checkbox');
+  }
+
+  private buildContinuous(): HTMLElement {
+    const group = document.createElement('div');
+    group.className = 'dialog-radio-group';
+    const input = document.createElement('input');
+    input.type = 'checkbox';
+    input.checked = DEFAULT_FORMAT_COPY_OPTIONS.continuous;
+    input.name = 'format-copy-continuous';
+    group.appendChild(this.option(input, '연속 적용 (Esc 로 해제할 때까지 여러 번 붙이기)'));
+    this.continuousBox = input;
+    return group;
+  }
+
+  private buildBody(): HTMLElement {
+    const group = document.createElement('div');
+    group.className = 'dialog-radio-group';
+    for (const { value, label } of BODY_OPTIONS) {
+      const input = document.createElement('input');
+      input.type = 'radio';
+      input.name = 'format-copy-body';
+      input.value = value;
+      input.checked = value === DEFAULT_FORMAT_COPY_OPTIONS.body;
+      input.disabled = value === 'charStyle' && !this.context.charStyleAvailable;
+      group.appendChild(this.option(input, label));
+      this.bodyRadios.push(input);
+    }
+    return group;
+  }
+
+  private buildCells(): HTMLElement {
+    const group = document.createElement('div');
+    group.className = 'dialog-radio-group';
+    const make = (label: string): HTMLInputElement => {
+      const input = document.createElement('input');
+      input.type = 'checkbox';
+      input.disabled = !this.context.inCell;
+      input.addEventListener('change', () => this.syncTarget());
+      group.appendChild(this.option(input, label));
+      return input;
+    };
+    this.cellBoxes = { cellAttr: make('셀 속성'), cellBorder: make('셀 테두리'), cellBackground: make('셀 배경') };
+    return group;
+  }
+
+  private buildTarget(): HTMLElement {
+    const group = document.createElement('div');
+    group.className = 'dialog-radio-group';
+    for (const [value, label] of [['both', '본문 모양과 셀 모양 둘 다'], ['cellOnly', '셀 모양만']] as const) {
+      const input = document.createElement('input');
+      input.type = 'radio';
+      input.name = 'format-copy-target';
+      input.value = value;
+      input.checked = value === DEFAULT_FORMAT_COPY_OPTIONS.tableTarget;
+      group.appendChild(this.option(input, label));
+      this.targetRadios.push(input);
+    }
+    return group;
+  }
+
+  /** 셀 모양 항목을 하나라도 골라야 표 적용 대상을 고를 수 있다 */
+  private syncTarget(): void {
+    const any = this.cellBoxes !== null && Object.values(this.cellBoxes).some((box) => box.checked);
+    for (const radio of this.targetRadios) radio.disabled = !any;
+  }
+
+  show(): void {
+    super.show();
+    (this.bodyRadios.find((r) => r.checked) ?? this.bodyRadios[0])?.focus();
+  }
+
+  protected onConfirm(): void {
+    const boxes = this.cellBoxes;
+    this.onCopy({
+      body: (this.bodyRadios.find((r) => r.checked)?.value ?? DEFAULT_FORMAT_COPY_OPTIONS.body) as FormatCopyOptions['body'],
+      cellAttr: boxes?.cellAttr.checked ?? false,
+      cellBorder: boxes?.cellBorder.checked ?? false,
+      cellBackground: boxes?.cellBackground.checked ?? false,
+      tableTarget: (this.targetRadios.find((r) => r.checked)?.value ?? DEFAULT_FORMAT_COPY_OPTIONS.tableTarget) as FormatCopyOptions['tableTarget'],
+      continuous: this.continuousBox?.checked ?? DEFAULT_FORMAT_COPY_OPTIONS.continuous,
+    });
+  }
+}
diff --git a/rhwp-studio/tests/hwpxxx-composition-font.test.ts b/rhwp-studio/tests/hwpxxx-composition-font.test.ts
new file mode 100644
index 0000000..a0cce36
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-composition-font.test.ts
@@ -0,0 +1,43 @@
+// [hwpxxx] IME 조합 오버레이 글꼴: 캔버스와 같은 해석 경로를 쓰고, 실제 크기·굵기·기울임을 따른다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { compositionCssFont } from '../src/hwpxxx/composition-font.ts';
+
+const identity = (font: string) => font;
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+test('글꼴 이름은 따옴표로 감싸 대체 글꼴을 뒤에 붙이고, 해석기를 거친다', () => {
+  const seen: string[] = [];
+  const out = compositionCssFont({ fontFamily: '함초롬바탕', zoom: 1, boxHeight: 20 }, (f) => { seen.push(f); return `resolved:${f}`; });
+  assert.equal(seen.length, 1);
+  assert.equal(out, 'resolved:17px "함초롬바탕", sans-serif');
+});
+
+test('실제 글자 크기(HWPUNIT)·줌·굵기·기울임을 따른다', () => {
+  // 10pt = 13.333px, 줌 1.5 → 20px
+  assert.equal(compositionCssFont({ fontFamily: 'A', fontSize: 1000, bold: true, italic: true, zoom: 1.5, boxHeight: 99 }, identity), 'italic bold 20px "A", sans-serif');
+  assert.equal(compositionCssFont({ fontFamily: 'A', fontSize: 1000, zoom: 1, boxHeight: 99 }, identity), '13.33px "A", sans-serif');
+});
+
+test('크기를 모르거나 이상하면 상자 높이의 85%로 물러난다', () => {
+  for (const fontSize of [undefined, 0, -5, Number.NaN, Number.POSITIVE_INFINITY]) {
+    assert.equal(compositionCssFont({ fontFamily: 'A', fontSize, zoom: 2, boxHeight: 10 }, identity), '17px "A", sans-serif', String(fontSize));
+  }
+});
+
+test('글꼴 이름이 없거나 따옴표·역슬래시·줄바꿈이 섞여도 CSS 가 깨지지 않는다', () => {
+  assert.equal(compositionCssFont({ zoom: 1, boxHeight: 20 }, identity), '17px sans-serif');
+  assert.equal(compositionCssFont({ fontFamily: '   ', zoom: 1, boxHeight: 20 }, identity), '17px sans-serif');
+  const evil = compositionCssFont({ fontFamily: 'A", serif; x:"\\\n', zoom: 1, boxHeight: 20 }, identity);
+  assert.equal(evil, '17px "A, serif; x:", sans-serif');
+});
+
+test('연결: 조합 오버레이가 해석된 글꼴을 받고, 못 쓰면 기존 값으로 물러난다', () => {
+  const handler = source('engine/input-handler.ts');
+  assert.match(handler, /overlayFont = compositionCssFont\(\{/);
+  assert.match(handler, /this\.caret\.showComposition\(startRect, charWidth, zoom, text, fontFamily, overlayFont\)/);
+  const caret = source('engine/caret-renderer.ts');
+  assert.match(caret, /if \(font\) \{\s+this\.compEl\.style\.font = font;/);
+  assert.match(caret, /this\.compEl\.style\.lineHeight = `\$\{h\}px`;/, '줄 높이는 shorthand 뒤에 다시 정한다');
+});
diff --git a/rhwp-studio/tests/hwpxxx-content-loss.test.ts b/rhwp-studio/tests/hwpxxx-content-loss.test.ts
new file mode 100644
index 0000000..ce35e9e
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-content-loss.test.ts
@@ -0,0 +1,40 @@
+// [hwpxxx] 내용 손실 보고: 메타데이터 축소만으로는 저장을 막지 않고, 내용을 잃는 손실·알 수 없는 코드·개수만 있는 보고는 막는다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { hasBlockingContentLoss, blockingContentLosses } from '../src/hwpxxx/content-loss.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+const loss = (code: string, path = 'p') => ({ code, subject: 'control', path, reason: 'unsupportedByOutputFormat' });
+
+test('손실 없음·null 은 막지 않는다', () => {
+  assert.equal(hasBlockingContentLoss(null), false);
+  assert.equal(hasBlockingContentLoss(undefined), false);
+  assert.equal(hasBlockingContentLoss({ count: 0, losses: [] }), false);
+});
+
+test('메타데이터 축소(병합 표의 잠재 행 격자 등)만 있으면 막지 않는다', () => {
+  const report = { count: 1, losses: [loss('metadataReduced', '표의 잠재 행 격자')] };
+  assert.equal(hasBlockingContentLoss(report), false);
+  assert.deepEqual(blockingContentLosses(report.losses), []);
+});
+
+test('자원 내용이 빔·컨트롤이 빠짐·처음 보는 코드는 막고, 섞여 있으면 막는 항목만 고른다', () => {
+  assert.equal(hasBlockingContentLoss({ count: 1, losses: [loss('binaryContentEmptied')] }), true);
+  assert.equal(hasBlockingContentLoss({ count: 1, losses: [loss('controlOmitted')] }), true);
+  assert.equal(hasBlockingContentLoss({ count: 1, losses: [loss('somethingNew')] }), true);
+  assert.equal(hasBlockingContentLoss({ count: 1, losses: [{ path: 'x' }] }), true, '코드가 없으면 알 수 없으므로 막는다');
+  const mixed = [loss('metadataReduced', 'a'), loss('controlOmitted', 'b')];
+  assert.equal(hasBlockingContentLoss({ count: 2, losses: mixed }), true);
+  assert.deepEqual(blockingContentLosses(mixed).map((l) => l.path), ['b']);
+});
+
+test('항목 없이 개수만 있는 보고는 무엇을 잃는지 몰라 막는다', () => {
+  assert.equal(hasBlockingContentLoss({ count: 2 }), true);
+  assert.equal(hasBlockingContentLoss({ count: 1, losses: [] }), true);
+});
+
+test('연결: 저장 검사·복구본 손실 표시가 같은 기준을 쓴다', () => {
+  assert.match(source('command/commands/file.ts'), /if \(hasBlockingContentLoss\(artifact\.contentLoss\)\)/);
+  assert.match(source('core/wasm-bridge.ts'), /if \(hasBlockingContentLoss\(loss\)\) bytes\.lossy = true;/);
+});
diff --git a/rhwp-studio/tests/hwpxxx-desktop-shortcuts.test.ts b/rhwp-studio/tests/hwpxxx-desktop-shortcuts.test.ts
new file mode 100644
index 0000000..b8b9de1
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-desktop-shortcuts.test.ts
@@ -0,0 +1,92 @@
+// [hwpxxx] 데스크톱 보강 회귀 시험 — 한글 입력 상태 단축키, 연속 키 글자, 툴팁 단축키 표기, 저장 중 편집 보호.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+import { defaultShortcuts, matchShortcut, chordLetter } from '../src/command/shortcut-map.ts';
+import { EventBus } from '../src/core/event-bus.ts';
+import { DocumentDirtyState } from '../src/core/document-dirty-state.ts';
+import { shortcutParts, nameFromTitle, commandShortcut, shortcutFromTitle } from '../src/ui/command-tooltip.ts';
+
+function key(input: Partial<KeyboardEvent>): KeyboardEvent {
+  return {
+    key: input.key ?? '', code: input.code ?? '',
+    shiftKey: input.shiftKey ?? false, ctrlKey: input.ctrlKey ?? false,
+    metaKey: input.metaKey ?? false, altKey: input.altKey ?? false,
+  } as KeyboardEvent;
+}
+const command = (input: Partial<KeyboardEvent>) => matchShortcut(key(input), defaultShortcuts, 'other');
+
+test('한글 입력 상태의 Ctrl 조합은 물리 키로 맞춘다', () => {
+  // 0.8.7 배포본에서는 아래 셋이 null 이었다(Ctrl+S·Ctrl+B 무반응).
+  assert.equal(command({ key: 'ㄴ', code: 'KeyS', ctrlKey: true }), 'file:save');
+  assert.equal(command({ key: 'ㅠ', code: 'KeyB', ctrlKey: true }), 'format:bold');
+  assert.equal(command({ key: 'Process', code: 'KeyB', ctrlKey: true }), 'format:bold');
+  assert.equal(command({ key: 'Process', code: 'KeyZ', ctrlKey: true }), 'edit:undo');
+  assert.equal(command({ key: 'Process', code: 'KeyY', ctrlKey: true }), 'edit:redo');
+  assert.equal(command({ key: 'Process', code: 'KeyI', ctrlKey: true }), 'format:italic');
+  assert.equal(command({ key: 'Process', code: 'KeyU', ctrlKey: true }), 'format:underline');
+  assert.equal(command({ key: 'Process', code: 'Equal', ctrlKey: true }), 'view:zoom-in');
+});
+
+test('영문 입력과 수정키 없는 입력은 그대로 둔다', () => {
+  assert.equal(command({ key: 's', code: 'KeyS', ctrlKey: true }), 'file:save');
+  // 다른 배열(예: 물리 KeyS 가 다른 글자)에서 영문 글자가 오면 글자 기준이 우선한다.
+  assert.equal(command({ key: 'o', code: 'KeyS', ctrlKey: true }), 'file:open');
+  // 수정키 없는 한글 입력은 단축키로 가로채지 않는다.
+  assert.equal(command({ key: 'ㄴ', code: 'KeyS' }), null);
+  // Shift 가 다르면 맞추지 않는다.
+  assert.equal(command({ key: 'Process', code: 'KeyB', ctrlKey: true, shiftKey: true }), null);
+});
+
+test('연속 키 두 번째 글자는 한글·조합 중에도 영문 글자로 읽는다', () => {
+  assert.equal(chordLetter(key({ key: 'ㄷ', code: 'KeyE' })), 'e');
+  assert.equal(chordLetter(key({ key: 'Process', code: 'KeyK' })), 'k');
+  assert.equal(chordLetter(key({ key: 'F', code: 'KeyF' })), 'f');
+  assert.equal(chordLetter(key({ key: 'Escape', code: 'Escape' })), 'escape');
+});
+
+test('툴팁 단축키 표기는 연속 키를 나누고 title 의 단축키를 뗀다', () => {
+  assert.deepEqual(shortcutParts('Ctrl+M,K'), ['Ctrl+M', 'K']);
+  assert.deepEqual(shortcutParts('Ctrl+K,E'), ['Ctrl+K', 'E']);
+  assert.deepEqual(shortcutParts('Ctrl+B'), ['Ctrl+B']);
+  assert.equal(nameFromTitle('오려두기 (Ctrl+X)'), '오려두기');
+  assert.equal(nameFromTitle('줄 간격 증가 (+5%)'), '줄 간격 증가 (+5%)');
+});
+
+test('저장 중에 생긴 편집은 저장 완료 후에도 변경 상태로 남는다', () => {
+  const state = new DocumentDirtyState(new EventBus());
+  state.markDirty('edit');
+  const revision = state.getRevision();
+  state.markDirty('edit-during-save');
+  assert.equal(state.markClean('save', revision), false);
+  assert.equal(state.isDirty(), true);
+  assert.equal(state.markClean('save', state.getRevision()), true);
+  assert.equal(state.isDirty(), false);
+  // revision 없이 부르는 기존 경로(문서 초기화 등)는 그대로 clean 으로 만든다.
+  state.markDirty('edit');
+  assert.equal(state.markClean('document-initialized'), true);
+  assert.equal(state.isDirty(), false);
+});
+
+test('툴팁 단축키는 실제 키 처리 표에서 찾는다', () => {
+  // 등록부에 안내 문구가 없어도 실제로 배정된 키를 보여 준다(1.3.0 초판에서는 이름만 나왔다).
+  assert.equal(commandShortcut('format:para-shape'), 'Alt+T');
+  assert.equal(commandShortcut('format:char-shape'), 'Alt+L');
+  assert.equal(commandShortcut('format:align-left'), 'Ctrl+Shift+L');
+  assert.equal(commandShortcut('format:align-center'), 'Alt+Shift+C');
+  assert.equal(commandShortcut('format:font-size-increase'), 'Alt+Shift+E');
+  assert.equal(commandShortcut('insert:footnote'), 'Ctrl+M,N');
+  assert.equal(commandShortcut('insert:hyperlink'), 'Ctrl+K,H');
+  assert.equal(commandShortcut('view:ctrl-mark'), 'Ctrl+G,C');
+  assert.equal(commandShortcut('edit:find'), 'Ctrl+F');
+  // 등록부 안내가 있으면 그것이 우선이고, 배정이 없는 명령은 지어내지 않는다.
+  assert.equal(commandShortcut('format:bold', 'Ctrl+B'), 'Ctrl+B');
+  assert.equal(commandShortcut('insert:image'), undefined);
+  assert.equal(shortcutFromTitle('찾기 (Ctrl+F)'), 'Ctrl+F');
+  // 숫자 키패드 -/+ 는 수준 증가/감소, 일반 -/+ 는 문서 배율.
+  assert.equal(command({ key: '-', code: 'NumpadSubtract', ctrlKey: true }), 'format:level-increase');
+  assert.equal(command({ key: '+', code: 'NumpadAdd', ctrlKey: true }), 'format:level-decrease');
+  assert.equal(command({ key: '-', code: 'Minus', ctrlKey: true }), 'view:zoom-out');
+  assert.equal(command({ key: '=', code: 'Equal', ctrlKey: true }), 'view:zoom-in');
+  assert.equal(shortcutFromTitle('줄 간격 증가 (+5%)'), undefined);
+});
diff --git a/rhwp-studio/tests/hwpxxx-format-copy.test.ts b/rhwp-studio/tests/hwpxxx-format-copy.test.ts
new file mode 100644
index 0000000..da6e9bb
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-format-copy.test.ts
@@ -0,0 +1,71 @@
+// [hwpxxx] 모양 복사(Alt+C): 연속 적용 기본 켬, 대화상자에서 라디오·체크박스 Enter 확인, Esc·문서 전환 해제.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { register } from 'node:module';
+
+const g = globalThis as Record<string, any>;
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+class FakeElement {
+  tagName: string; children: any[] = []; style: Record<string, string> = {};
+  className = ''; type = ''; name = ''; value = ''; checked = false; disabled = false; textContent = '';
+  constructor(tag: string) { this.tagName = tag.toUpperCase(); }
+  appendChild(c: any) { this.children.push(c); return c; }
+  addEventListener() {}
+  setAttribute() {}
+  find(pred: (e: FakeElement) => boolean): FakeElement[] {
+    const out: FakeElement[] = []; const walk = (e: any) => { if (e instanceof FakeElement) { if (pred(e)) out.push(e); e.children.forEach(walk); } };
+    walk(this); return out;
+  }
+}
+g.document = { createElement: (t: string) => new FakeElement(t), createTextNode: (t: string) => ({ text: t }) };
+g.HTMLInputElement = FakeElement;
+g.window ??= new EventTarget();
+register(new URL('./support/studio-alias-hooks.mjs', import.meta.url), import.meta.url);
+const { FormatCopyDialog, DEFAULT_FORMAT_COPY_OPTIONS } = await import('../src/ui/format-copy-dialog.ts');
+
+const makeDialog = () => {
+  const copied: any[] = [];
+  const dialog: any = new FormatCopyDialog({ inCell: false, charStyleAvailable: false }, (o: unknown) => copied.push(o));
+  const body = dialog.createBody() as FakeElement;
+  return { dialog, body, copied };
+};
+const inputs = (body: FakeElement) => body.find((e) => e.tagName === 'INPUT');
+
+test('연속 적용은 기본으로 켜져 있고, 끄면 옵션에 false 로 담긴다', () => {
+  assert.equal(DEFAULT_FORMAT_COPY_OPTIONS.continuous, true);
+  const { dialog, body, copied } = makeDialog();
+  const box = inputs(body).find((i) => i.name === 'format-copy-continuous')!;
+  assert.equal(box.checked, true);
+  dialog.onConfirm();
+  assert.equal(copied[0].continuous, true);
+  box.checked = false;
+  dialog.onConfirm();
+  assert.equal(copied[1].continuous, false);
+});
+
+test('Enter 확인: 라디오·체크박스는 확인으로 판정하고, 버튼·텍스트 칸은 아니다', () => {
+  const { dialog, body } = makeDialog();
+  for (const input of inputs(body)) assert.equal(dialog.shouldConfirmOnEnter(input), true, `${input.name}/${input.type}`);
+  const text = new FakeElement('input'); text.type = 'text';
+  assert.equal(dialog.shouldConfirmOnEnter(text), false);
+});
+
+test('입력 처리 연결: 연속 상태는 붙인 뒤에도 남고, Esc·새 복사·문서 전환에서 해제된다', () => {
+  const handler = source('engine/input-handler.ts');
+  assert.match(handler, /if \(!state\.continuous\) this\.formatCopyState = null;/);
+  assert.equal((handler.match(/if \(!state\.continuous\) this\.formatCopyState = null;/g) ?? []).length, 2, '셀 블록·본문 두 경로 모두');
+  assert.ok(!/\/\/ 한컴 호환: 복사한 모양은 한 번 붙여넣으면 자동 해제한다\.\n\s+this\.formatCopyState = null;/.test(handler), '무조건 해제가 남아 있지 않다');
+  assert.match(handler, /continuous: options\.continuous !== false/);
+  const swapped = handler.slice(handler.indexOf("eventBus.on('document-swapped'"), handler.indexOf("eventBus.on('highlight-pick'"));
+  assert.match(swapped, /this\.formatCopyState = null;/);
+  const keyboard = source('engine/input-handler-keyboard.ts');
+  assert.match(keyboard, /e\.key === 'Escape' && !e\.isComposing && this\.releaseCopiedFormat\(\)/);
+});
+
+test('명령 연결: 복사한 모양이 있어도 선택이 없으면 Alt+C 는 새 복사 대화상자를 연다', () => {
+  const edit = source('command/commands/edit.ts');
+  const cmd = edit.slice(edit.indexOf("id: 'edit:format-copy'"), edit.indexOf("id: 'edit:format-paste'"));
+  assert.match(cmd, /if \(!handler \|\| handler\.tryApplyCopiedFormat\(\)\) return;\s+new FormatCopyDialog/);
+});
diff --git a/rhwp-studio/tests/hwpxxx-highlighter-split.test.ts b/rhwp-studio/tests/hwpxxx-highlighter-split.test.ts
new file mode 100644
index 0000000..eb15f1a
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-highlighter-split.test.ts
@@ -0,0 +1,32 @@
+// [hwpxxx] 형광펜 분할 단추: 본체 단추는 현재 색으로 즉시 형광펜(블록이 있으면 칠하고, 없으면 연속 모드 진입)이고,
+// 오른쪽 ▾ 단추만 팔레트를 연다. 소스 구조 보호 시험(DOM 실행 없이 연결이 유지되는지 확인한다).
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+
+const source = (path: string) => readFileSync(new URL(`../${path}`, import.meta.url), 'utf8');
+
+test('마크업: 본체 단추와 팔레트 단추가 따로 있고, 팔레트 단추가 접근성 속성을 가진다', () => {
+  const html = source('index.html');
+  const body = html.match(/<button id="btn-highlight"[^>]*>/)?.[0] ?? '';
+  const arrow = html.match(/<button id="btn-highlight-palette"[^>]*>/)?.[0] ?? '';
+  assert.ok(body && !body.includes('sb-has-arrow'), '본체 단추에는 ▾ 가 붙지 않는다');
+  assert.ok(arrow.includes('aria-haspopup="true"') && arrow.includes('aria-expanded="false"'));
+  assert.ok(html.indexOf('id="btn-highlight"') < html.indexOf('id="btn-highlight-palette"'), '팔레트 단추는 본체 오른쪽이다');
+  assert.ok(html.indexOf('id="btn-highlight-palette"') < html.indexOf('id="highlight-palette"'));
+});
+
+test('동작 연결: 본체 클릭은 즉시 highlight-pick(현재 색)·활성이면 종료, ▾ 클릭만 팔레트를 토글한다', () => {
+  const toolbar = source('src/ui/toolbar.ts');
+  const setup = toolbar.slice(toolbar.indexOf('private setupHighlightPicker'), toolbar.indexOf('/** 문단 정렬 버튼'));
+  const bodyClick = setup.slice(setup.indexOf("this.btnHighlight.addEventListener('click'"), setup.indexOf("this.btnHighlightPalette.addEventListener('mousedown'"));
+  assert.match(bodyClick, /emit\('highlight-pen-exit'\)/);
+  assert.match(bodyClick, /emit\('highlight-pick', this\.highlightColor\)/);
+  assert.ok(!bodyClick.includes("toggle('open')"), '본체 클릭은 팔레트를 토글하지 않는다');
+  const arrowClick = setup.slice(setup.indexOf("this.btnHighlightPalette.addEventListener('click'"));
+  assert.match(arrowClick, /classList\.toggle\('open'\)/);
+});
+
+test('i18n: 새 단추 설명이 ko/en 모두에 있다', () => {
+  for (const locale of ['ko', 'en']) assert.match(source(`src/i18n/locales/${locale}.ts`), /"ui\.btnHighlightPalette\.tooltip":/);
+});
diff --git a/rhwp-studio/tests/hwpxxx-input-latency.test.ts b/rhwp-studio/tests/hwpxxx-input-latency.test.ts
new file mode 100644
index 0000000..c864bf2
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-input-latency.test.ts
@@ -0,0 +1,59 @@
+// [hwpxxx] 입력 지연 완화(키 입력마다 다시 그릴 때 글꼴 이름 해석을 되풀이하던 비용): 메모가 결과를 바꾸지 않고, 환경이 바뀌면 비워지고, 호출자가 결과를 망가뜨릴 수 없다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { memoizeBySignature } from '../src/hwpxxx/signature-memo.ts';
+import { ordinaryTextFontFamilies, getDocumentFontSubstitutionRevision, setDocumentFontSubstitutions } from '../src/core/font-substitution.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+
+test('memoizeBySignature: 같은 입력은 한 번만 계산하고, 서명이 바뀌면 비운다', () => {
+  let calls = 0, sig = 'a';
+  const f = memoizeBySignature((s) => { calls++; return s.toUpperCase(); }, () => sig);
+  assert.equal(f('x'), 'X'); assert.equal(f('x'), 'X'); assert.equal(f('y'), 'Y');
+  assert.equal(calls, 2);
+  sig = 'b';
+  assert.equal(f('x'), 'X');
+  assert.equal(calls, 3, '서명이 바뀌어 다시 계산한다');
+  assert.equal(f('x'), 'X'); assert.equal(calls, 3);
+});
+
+test('memoizeBySignature: 빈 문자열 결과도 기억하고, 크기 상한을 넘으면 비워 무한히 자라지 않는다', () => {
+  let calls = 0;
+  const f = memoizeBySignature(() => { calls++; return ''; }, () => '1', 3);
+  f('a'); f('a'); assert.equal(calls, 1, '빈 문자열도 캐시 적중');
+  f('b'); f('c'); f('d'); // 4번째 입력에서 상한(3)을 넘어 비운다
+  const before = calls; f('d'); assert.equal(calls, before, '방금 넣은 항목은 남아 있다');
+  f('a'); assert.equal(calls, before + 1, '상한 때 비워진 항목은 다시 계산한다');
+});
+
+test('ordinaryTextFontFamilies: 메모가 결과를 바꾸지 않고, 돌려받은 배열을 고쳐도 다음 결과가 오염되지 않는다', () => {
+  const first = ordinaryTextFontFamilies('"함초롬바탕", serif');
+  const second = ordinaryTextFontFamilies('"함초롬바탕", serif');
+  assert.deepEqual(first, second);
+  assert.ok(first.length > 2 && first[0] === '함초롬바탕');
+  first.length = 0; first.push('오염');
+  assert.deepEqual(ordinaryTextFontFamilies('"함초롬바탕", serif'), second, '호출자의 변경이 메모에 닿지 않는다');
+  assert.deepEqual(ordinaryTextFontFamilies(''), []);
+  assert.equal(new Set(second.map((n) => n.toLocaleLowerCase('en-US'))).size, second.length, '중복 없음(원래 규칙)');
+});
+
+test('문서 선언 치환이 바뀌면 서명(리비전)이 올라간다', () => {
+  const before = getDocumentFontSubstitutionRevision();
+  setDocumentFontSubstitutions([['원본', '대체']]);
+  assert.equal(getDocumentFontSubstitutionRevision(), before + 1);
+  setDocumentFontSubstitutions(undefined);
+  assert.equal(getDocumentFontSubstitutionRevision(), before + 2);
+});
+
+test('연결: 글꼴 해석은 환경 서명으로 메모하고, 쪽마다 같은 글꼴·굵기·기울임은 한 번만 푼다', () => {
+  const bridge = source('core/wasm-bridge.ts');
+  assert.match(bridge, /const memoizedSubstituteCssFontFamily = memoizeBySignature\(/);
+  assert.match(bridge, /getDocumentFontSubstitutionRevision\(\)\}:\$\{getLocalFontEnvironmentRevision\(\)/);
+  assert.ok(!/\?\? substituteCssFontFamily\(font\)/.test(bridge), '메모를 거치지 않는 호출이 남아 있지 않다');
+  const local = source('core/local-fonts.ts');
+  const bumps = (local.match(/fontEnvironmentRevision\+\+/g) ?? []).length;
+  assert.ok(bumps >= 3, `목록 변경 지점(스냅샷·호스트 구독·호스트 재구성)마다 리비전을 올린다: ${bumps}`);
+  const requests = source('core/host-font-requests.ts');
+  assert.match(requests, /textFamilies\.has\(key\)/); // 본가 v0.9.1 이 같은 메모를 가져 hwpxxx 쪽 seenFaces 는 뺐다
+});
diff --git a/rhwp-studio/tests/hwpxxx-line-page-break.test.ts b/rhwp-studio/tests/hwpxxx-line-page-break.test.ts
new file mode 100644
index 0000000..4aac2ef
--- /dev/null
+++ b/rhwp-studio/tests/hwpxxx-line-page-break.test.ts
@@ -0,0 +1,59 @@
+// [hwpxxx] 본문 강제 줄바꿈(Shift+Enter)과 쪽 나누기(Ctrl+Enter): 한글 조합 중에도 물리 Enter 로 맞고,
+// 본문 밖(표 칸·머리말/꼬리말·각주)에서는 쪽·단 나누기를 넣지 않으며, 조합을 먼저 확정한다.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { defaultShortcuts, matchShortcut, physicalCodeOf } from '../src/command/shortcut-map.ts';
+
+const source = (path: string) => readFileSync(new URL(`../src/${path}`, import.meta.url), 'utf8');
+function key(input: Partial<KeyboardEvent>): KeyboardEvent {
+  return {
+    key: input.key ?? '', code: input.code ?? '',
+    shiftKey: input.shiftKey ?? false, ctrlKey: input.ctrlKey ?? false,
+    metaKey: input.metaKey ?? false, altKey: input.altKey ?? false,
+  } as KeyboardEvent;
+}
+const command = (input: Partial<KeyboardEvent>) => matchShortcut(key(input), defaultShortcuts, 'other');
+
+test('Ctrl+Enter 는 쪽 나누기, Ctrl+Shift+Enter 는 단 나누기, Ctrl+Alt+Enter 는 단 설정', () => {
+  assert.equal(command({ key: 'Enter', code: 'Enter', ctrlKey: true }), 'page:break');
+  assert.equal(command({ key: 'Enter', code: 'Enter', ctrlKey: true, shiftKey: true }), 'page:column-break');
+  assert.equal(command({ key: 'Enter', code: 'Enter', ctrlKey: true, altKey: true }), 'page:col-settings');
+});
+
+test('한글 조합 중(e.key 가 Process)에도 물리 Enter·숫자패드 Enter 로 맞는다', () => {
+  assert.equal(command({ key: 'Process', code: 'Enter', ctrlKey: true }), 'page:break');
+  assert.equal(command({ key: 'Process', code: 'NumpadEnter', ctrlKey: true }), 'page:break');
+  assert.equal(command({ key: 'Process', code: 'Enter', ctrlKey: true, shiftKey: true }), 'page:column-break');
+  assert.equal(physicalCodeOf('enter'), 'enter');
+});
+
+test('일반 Enter·Shift+Enter 는 단축키 명령이 아니다(본문 입력 경로가 처리한다)', () => {
+  assert.equal(command({ key: 'Enter', code: 'Enter' }), null);
+  assert.equal(command({ key: 'Enter', code: 'Enter', shiftKey: true }), null);
+  assert.equal(command({ key: 'Process', code: 'Enter' }), null, 'Ctrl 없는 조합 중 Enter 는 건드리지 않는다');
+  assert.equal(command({ key: 'Process', code: 'Enter', shiftKey: true }), null);
+});
+
+test('Shift+Enter 는 선택을 지운 뒤 강제 줄바꿈 명령을 넣는다(표 칸 분기보다 먼저)', () => {
+  const keyboard = source('engine/input-handler-keyboard.ts');
+  const enter = keyboard.slice(keyboard.indexOf("case 'Enter': {"), keyboard.indexOf("case 'Enter': {") + 900);
+  assert.ok(enter.indexOf('deleteSelection()') < enter.indexOf('e.shiftKey'));
+  assert.ok(enter.indexOf('e.shiftKey') < enter.indexOf('InsertLineBreakCommand'));
+  assert.ok(enter.indexOf('InsertLineBreakCommand') < enter.indexOf('else if (inCell)'), '표 칸에서도 Shift+Enter 는 줄바꿈이다');
+});
+
+test('쪽·단 나누기: 조합 확정 → 본문 위치 확인 → 삽입 순서이고, 본문 밖에서는 안내만 한다', () => {
+  const page = source('command/commands/page.ts');
+  const helper = page.slice(page.indexOf('function prepareBodyBreak'), page.indexOf('export const pageCommands'));
+  assert.ok(helper.indexOf('ih.commitComposition()') < helper.indexOf('ih.isInBodyText()'));
+  assert.match(helper, /showToast\(/);
+  for (const id of ['page:break', 'page:column-break']) {
+    const cmd = page.slice(page.indexOf(`id: '${id}'`), page.indexOf(`id: '${id}'`) + 600);
+    assert.match(cmd, /prepareBodyBreak\(services\.getInputHandler\(\)/, id);
+    assert.ok(cmd.indexOf('prepareBodyBreak(') < cmd.indexOf('ih.getPosition()'), `${id}: 위치는 조합 확정 뒤에 읽는다`);
+    assert.match(cmd, /canExecute: \(ctx\) => ctx\.hasDocument && !ctx\.isFormMode/, id);
+  }
+  const handler = source('engine/input-handler.ts');
+  assert.match(handler, /isInBodyText\(\): boolean \{\s+return this\.cursor\.getPosition\(\)\.parentParaIndex === undefined\s+&& !this\.cursor\.isInHeaderFooter\(\) && !this\.cursor\.isInFootnote\(\);/);
+});
