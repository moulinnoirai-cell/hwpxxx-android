+.hwpxxx-memo-bracket::before { top: 0; }
+.hwpxxx-memo-bracket::after { bottom: 0; }
+.hwpxxx-memo-bracket.end { border-left: 0; border-right: 1.5px solid #2e7d1c; }
+.hwpxxx-memo-bracket.end::before, .hwpxxx-memo-bracket.end::after { left: auto; right: -1.5px; }
+.hwpxxx-memo-box { position: absolute; box-sizing: border-box; pointer-events: auto; cursor: pointer; background: #d4f3b6; color: #1c2b12; border: 1px solid #5d9a3a; font-size: 11px; line-height: 1.4; padding: 3px 5px; box-shadow: 1px 1px 2px rgba(0, 0, 0, 0.18); }
+.hwpxxx-memo-box:hover { background: #dcf7c4; }
+.hwpxxx-memo-box-head { font-weight: 600; font-size: 10px; color: #335a1d; border-bottom: 1px solid #8fc06a; margin-bottom: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.hwpxxx-memo-box-body { white-space: pre-wrap; word-break: break-word; max-height: 160px; overflow: hidden; }
+.hwpxxx-memo-box textarea { width: 100%; box-sizing: border-box; font: inherit; color: inherit; background: #f2fce6; border: 1px solid #5d9a3a; resize: vertical; }
+@media print { .hwpxxx-memo-marks { display: none; } }
diff --git a/rhwp-studio/src/ui/command-tooltip.ts b/rhwp-studio/src/ui/command-tooltip.ts
