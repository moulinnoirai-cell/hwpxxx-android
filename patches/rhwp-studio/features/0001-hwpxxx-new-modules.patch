+      svg.append(path);
+    }
+  }
+
+  /** 메모가 달린 글자 위의 초록 칠과 앞뒤 [ ] 표시. 문서의 글자는 그대로 보이게 투명하게 칠한다. */
+  private highlight(layer: HTMLElement, mark: Mark, page: (i: number) => { left: number; top: number }, zoom: number): void {
+    mark.rects.forEach((rect, at) => {
+      const origin = page(rect.pageIndex);
+      const fill = document.createElement('div');
+      fill.className = 'hwpxxx-memo-fill';
+      fill.style.left = `${origin.left + rect.x * zoom}px`;
+      fill.style.top = `${origin.top + rect.y * zoom}px`;
+      fill.style.width = `${Math.max(1, rect.width * zoom)}px`;
+      fill.style.height = `${rect.height * zoom}px`;
+      layer.append(fill);
+      const bracket = (side: 'start' | 'end') => {
+        const mark = document.createElement('div');
+        mark.className = `hwpxxx-memo-bracket ${side}`;
+        mark.style.left = `${origin.left + (side === 'start' ? rect.x : rect.x + rect.width) * zoom}px`;
+        mark.style.top = `${origin.top + rect.y * zoom}px`;
+        mark.style.height = `${rect.height * zoom}px`;
+        layer.append(mark);
+      };
+      if (at === 0) bracket('start');
+      if (at === mark.rects.length - 1) bracket('end');
+    });
+  }
+
+  private box(memo: MemoEntry): HTMLElement {
+    const box = document.createElement('div');
+    box.className = 'hwpxxx-memo-box';
+    box.style.width = `${BOX_WIDTH}px`;
+    box.dataset.memoId = String(memo.id);
+    const head = document.createElement('div');
+    head.className = 'hwpxxx-memo-box-head';
+    head.textContent = `[메모 ${memo.index}] ${memo.author}  ${when(memo.date)}`.trimEnd();
+    box.append(head);
+    if (this.editingId === memo.id && memo.editable) {
+      const text = document.createElement('textarea');
+      text.value = memo.text;
+      text.rows = 3;
+      const done = (save: boolean) => {
+        this.editingId = null;
+        if (save && text.value.trim() && text.value !== memo.text) memoPanel(this.services).saveFromBox(memo.id, text.value);
