+// [hwpxxx] 메모 창: 문서의 한글 메모(HWP·HWPX)를 보고, 선택한 글자에 달고, 고치고, 지운다.
+// 엔진의 메모 API(getMemoList / insertMemo / setMemoText / removeMemo)를 편집 작업(snapshot)으로 부르므로
+// 문서를 다시 불러오지 않고, 되돌리기(Ctrl+Z)로 취소할 수 있다.
+import '@/styles/hwpxxx-memo.css';
+import type { CommandServices } from '@/command/types';
+import type { InputHandler } from '@/engine/input-handler';
+import { hyperlinkRange, type HyperlinkTarget } from '@/core/hyperlink';
+import type { MemoEntry } from '@/core/memo';
+import { showToast } from '@/ui/toast';
+import { showConfirm } from '@/ui/confirm-dialog';
+
+const AUTHOR_KEY = 'hwpxxx.memoAuthor';
+const readAuthor = (): string => { try { return localStorage.getItem(AUTHOR_KEY) || 'hwpxxx'; } catch { return 'hwpxxx'; } };
+const saveAuthor = (value: string): void => { try { localStorage.setItem(AUTHOR_KEY, value); } catch { /* 저장소를 못 쓰면 이번 실행에서만 기억한다 */ } };
+const trim = (text: string, max: number): string => { const chars = Array.from(text); return chars.length > max ? chars.slice(0, max).join('') + '…' : text; };
+// 한글은 작성 시각을 현지 시각에 Z 를 붙여 기록한다.
+const when = (value: string | null): string => typeof value !== 'string' ? '' : /^\d{4}-\d\d-\d\dT\d\d:\d\d/.test(value) ? value.slice(0, 16).replace('T', ' ') : value;
+const cellPathOf = (memo: MemoEntry): [number, number, number][] =>
+  (memo.path ?? []).map(step => [step.controlIndex, step.type === 'cell' ? step.cellIndex : 0, step.paraIndex]);
+
+interface Draft {
+  target: HyperlinkTarget;
+  start: number;
+  end: number;
+  find: string;
+}
+type PanelMemo = MemoEntry & { anchor: string };
+
+function element<K extends keyof HTMLElementTagNameMap>(tag: K, className?: string, text?: string): HTMLElementTagNameMap[K] {
+  const node = document.createElement(tag);
+  if (className) node.className = className;
+  if (text !== undefined) node.textContent = text;
+  return node;
+}
+
+export class MemoPanel {
+  private readonly root = element('aside');
+  private readonly head = element('div', 'hm-head');
+  private readonly title = element('span', 'hm-title', '메모');
+  private readonly body = element('div');
+  private readonly list = element('div', 'hm-list');
+  private memos: PanelMemo[] = [];
+  private draft: Draft | null = null;
+  private editing: number | null = null;
+  private notice: { text: string; warn: boolean } | null = null;
+  private refreshTimer: number | undefined;
+
+  constructor(private readonly services: CommandServices) {
+    this.root.id = 'hwpxxx-memo-panel';
+    this.root.setAttribute('aria-label', '메모 창');
+    const refresh = element('button', undefined, '새로고침');
+    refresh.title = '문서에서 메모 목록을 다시 읽습니다';
+    refresh.addEventListener('click', () => this.refresh());
+    const close = element('button', undefined, '닫기');
+    close.addEventListener('click', () => this.hide());
+    this.head.append(this.title, refresh, close);
+    this.body.style.cssText = 'display:flex;flex-direction:column;flex:1;min-height:0';
+    this.root.append(this.head, this.body);
+    document.body.append(this.root);
+    window.addEventListener('resize', () => this.place());
+    // 문서를 바꾸거나 고칠 때(되돌리기 포함) 목록의 위치가 어긋나지 않게 다시 읽는다.
+    const later = () => { if (!this.isOpen()) return; window.clearTimeout(this.refreshTimer); this.refreshTimer = window.setTimeout(() => this.refresh(), 250); };
+    services.eventBus.on('document-swapped', later);
+    services.eventBus.on('document-changed', later);
+  }
+
+  isOpen(): boolean { return this.root.classList.contains('open'); }
+  toggle(): void { if (this.isOpen()) this.hide(); else this.show(); }
+  show(): void {
+    this.root.classList.add('open');
+    document.body.classList.add('hwpxxx-memo-open');
+    this.place();
+    this.refresh();
+  }
+  hide(): void {
+    this.root.classList.remove('open');
+    document.body.classList.remove('hwpxxx-memo-open');
+  }
+  private place(): void {
+    const area = document.getElementById('editor-area')?.getBoundingClientRect();
+    if (!area) return;
+    this.root.style.top = `${Math.round(area.top)}px`;
+    this.root.style.height = `${Math.round(area.height)}px`;
+  }
+
+  /** 선택한 글자에 메모를 달기 위한 작성 상자를 연다. */
+  beginCompose(): void {
+    if (!this.isOpen()) this.show();
+    try {
+      this.draft = this.captureSelection();
+      this.notice = null;
+    } catch (error) {
+      this.draft = null;
+      this.say(error instanceof Error ? error.message : String(error), true);
+    }
+    this.render();
+    this.root.querySelector<HTMLTextAreaElement>('.hm-compose textarea')?.focus();
+  }
+
+  private captureSelection(): Draft {
+    const handler = this.services.getInputHandler();
+    if (!handler) throw new Error('문서를 먼저 열어 주세요.');
+    if (!handler.hasSelection()) throw new Error('메모를 달 글자를 먼저 선택해 주세요.');
+    const { target, start, end } = hyperlinkRange(handler.getCursorPosition(), structuredClone(handler.getSelection()));
+    if (start === end) throw new Error('메모를 달 글자를 먼저 선택해 주세요.');
+    const find = Array.from(this.services.wasm.getHyperlinkContext(target).text).slice(start, end).join('');
+    return { target, start, end, find };
+  }
+
+  /** 문서에서 메모 목록을 다시 읽는다. */
+  refresh(): void {
+    const wasm = this.services.wasm;
+    if (!wasm.hasLoadedDocument()) { this.memos = []; this.render(); return; }
+    try {
+      this.memos = wasm.getMemoList().map(memo => ({ ...memo, anchor: this.anchorText(memo) }));
+    } catch (error) {
+      this.memos = [];
+      this.say('메모 목록을 읽지 못했습니다: ' + (error instanceof Error ? error.message : String(error)), true);
+    }
+    this.render();
+  }
+
+  private anchorText(memo: MemoEntry): string {
+    if (memo.paraIndex === null || memo.startCharIdx === null || memo.endCharIdx === null) return '';
+    try {
+      const context = this.services.wasm.getHyperlinkContext({ section: memo.sectionIndex, para: memo.paraIndex, cellPath: cellPathOf(memo) });
+      return Array.from(context.text).slice(memo.startCharIdx, memo.endCharIdx).join('');
+    } catch { return ''; }
+  }
+
+  private say(text: string, warn = false): void {
+    this.notice = { text, warn };
+    if (!this.isOpen()) showToast({ message: text });
+  }
+
+  /** 편집 작업(snapshot)으로 실행한다: 실패하면 문서는 바뀌지 않고, 성공하면 되돌리기로 취소할 수 있다. */
+  private apply(type: string, run: (wasm: CommandServices['wasm']) => void): boolean {
+    const handler: InputHandler | null = this.services.getInputHandler();
+    if (!handler) { this.say('문서를 먼저 열어 주세요.', true); return false; }
+    if (!this.services.getContext().isEditable) { this.say('이 문서는 편집할 수 없는 상태입니다.', true); return false; }
+    const position = structuredClone(handler.getCursorPosition());
+    try {
+      handler.executeOperation({ kind: 'snapshot', operationType: type, operation: wasm => { run(wasm); return position; } });
+      this.notice = null;
+      return true;
+    } catch (error) {
+      this.say(error instanceof Error ? error.message : String(error), true);
+      return false;
+    }
+  }
+
+  private submitDraft(text: string, author: string): void {
+    const draft = this.draft;
+    if (!draft) return;
+    if (!text.trim()) { this.say('메모 내용을 입력해 주세요.', true); this.render(); return; }
+    const name = author.trim() || 'hwpxxx';
+    saveAuthor(name);
+    const { target, start, end } = draft;
+    const ok = this.apply('insertMemo', wasm => {
+      if (target.cellPath.length) wasm.insertMemoByPath(target.section, target.para, target.cellPath, start, end, name, text);
+      else wasm.insertMemo(target.section, target.para, start, end, name, text);
+    });
+    if (ok) this.draft = null;
+    this.refresh();
+  }
+
+  private saveEdit(id: number, text: string): void {
+    if (!text.trim()) { this.say('메모 내용을 입력해 주세요.', true); this.render(); return; }
+    if (this.apply('setMemoText', wasm => wasm.setMemoText(id, text))) this.editing = null;
+    this.refresh();
+  }
+
+  private async remove(memo: PanelMemo): Promise<void> {
+    if (!await showConfirm('메모 삭제', `메모 ${memo.index}을(를) 삭제할까요?\n메모가 달려 있던 본문 글자는 그대로 남습니다.\n(삭제는 되돌리기로 취소할 수 있습니다.)`)) return;
+    this.apply('removeMemo', wasm => wasm.removeMemo(memo.id));
+    this.refresh();
+  }
+
+  /** 우클릭 메뉴의 '메모 삭제'. */
+  async deleteById(id: number): Promise<void> {
+    if (!this.memos.some(item => item.id === id)) this.refresh();
+    const memo = this.memos.find(item => item.id === id);
+    if (!memo) { showToast({ message: '삭제할 메모를 문서에서 찾지 못했습니다.' }); return; }
+    await this.remove(memo);
+  }
+
+  /** 메모가 달린 글자로 이동하고 그 글자를 선택한다. 본문과 표 칸 안의 메모만 이동한다. */
+  selectAnchor(memo: MemoEntry): void { this.goTo(memo as PanelMemo); }
+
+  /** 문서 화면의 메모 상자에서 고친 내용을 저장한다. */
+  saveFromBox(id: number, text: string): void {
+    if (!text.trim()) return;
+    this.apply('setMemoText', wasm => wasm.setMemoText(id, text));
+    this.refresh();
+  }
+
+  private goTo(memo: PanelMemo): void {
+    try {
+      const path = memo.path ?? [];
+      if (memo.paraIndex === null || memo.startCharIdx === null || memo.endCharIdx === null) throw new Error('이 메모는 위치로 이동할 수 없습니다.');
+      if (path.length > 1 || path.some(step => step.type !== 'cell')) throw new Error('글상자나 중첩된 표 안의 메모는 위치 이동을 지원하지 않습니다.');
+      const handler = this.services.getInputHandler();
+      if (!handler) return;
+      const cell = path[0];
+      const base = cell && cell.type === 'cell'
+        ? { sectionIndex: memo.sectionIndex, paragraphIndex: memo.paraIndex, charOffset: memo.startCharIdx, parentParaIndex: memo.paraIndex, controlIndex: cell.controlIndex, cellIndex: cell.cellIndex, cellParaIndex: cell.paraIndex }
+        : { sectionIndex: memo.sectionIndex, paragraphIndex: memo.paraIndex, charOffset: memo.startCharIdx };
+      const cursor = (handler as unknown as { cursor?: { clearSelection(): void; moveTo(pos: unknown): void; setAnchor(): void } }).cursor;
+      if (cell) { cursor?.clearSelection(); cursor?.moveTo(base); } else handler.moveCursorTo(base);
+      cursor?.setAnchor();
+      cursor?.moveTo({ ...base, charOffset: memo.endCharIdx });
+      (handler as unknown as { updateCaret?: () => void }).updateCaret?.();
+    } catch (error) {
+      showToast({ message: error instanceof Error ? error.message : String(error) });
+    }
+  }
+
+  private render(): void {
+    this.title.textContent = `메모 (${this.memos.length})`;
+    this.body.replaceChildren();
+    if (this.notice) this.body.append(element('div', this.notice.warn ? 'hm-notice warn' : 'hm-notice', this.notice.text));
+    if (this.draft) this.body.append(this.composeBox(this.draft));
+    else {
+      const add = element('button', 'hm-add hm-primary', '선택한 글자에 메모 삽입');
+      add.disabled = !this.services.wasm.hasLoadedDocument();
+      add.addEventListener('click', () => this.beginCompose());
+      this.body.append(add);
+    }
+    this.list.replaceChildren();
+    if (!this.memos.length) this.list.append(element('div', 'hm-empty', '이 문서에는 메모가 없습니다.'));
+    for (const memo of this.memos) this.list.append(this.card(memo));
+    this.body.append(this.list, element('div', 'hm-foot', '메모를 달거나 고치거나 지우는 일은 되돌리기(Ctrl+Z)로 취소할 수 있습니다. 저장하기 전까지 파일에는 반영되지 않습니다.'));
+  }
+
+  private composeBox(draft: Draft): HTMLElement {
+    const box = element('div', 'hm-compose');
+    const target = element('div', 'hm-target', `대상 글자: “${trim(draft.find, 60)}”`);
+    const author = element('input');
+    author.type = 'text'; author.value = readAuthor(); author.maxLength = 40; author.placeholder = '작성자'; author.setAttribute('aria-label', '작성자');
+    const text = element('textarea');
+    text.placeholder = '메모 내용을 입력하세요 (Ctrl+Enter: 삽입)';
+    const ok = element('button', 'hm-primary', '삽입');
+    const cancel = element('button', undefined, '취소');
+    ok.addEventListener('click', () => this.submitDraft(text.value, author.value));
+    cancel.addEventListener('click', () => { this.draft = null; this.render(); });
+    text.addEventListener('keydown', event => { if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { event.preventDefault(); this.submitDraft(text.value, author.value); } });
+    const row = element('div', 'hm-row'); row.append(cancel, ok);
+    box.append(target, author, text, row);
+    return box;
+  }
+
+  private card(memo: PanelMemo): HTMLElement {
+    const card = element('div', 'hm-card');
+    const meta = element('div', 'hm-meta');
+    meta.append(element('b', undefined, `#${memo.index}`), element('span', undefined, memo.author), ...(memo.date ? [element('span', undefined, when(memo.date))] : []));
+    card.append(meta);
+    if (memo.anchor) {
+      const anchor = element('button', 'hm-anchor', `“${trim(memo.anchor, 40)}”`);
+      anchor.title = '본문의 해당 글자로 이동';
+      anchor.addEventListener('click', () => this.goTo(memo));
+      card.append(anchor);
+    }
+    if (this.editing === memo.id && memo.editable) {
+      const text = element('textarea'); text.value = memo.text;
+      const save = element('button', 'hm-primary', '저장'), cancel = element('button', undefined, '취소');
+      save.addEventListener('click', () => this.saveEdit(memo.id, text.value));
+      cancel.addEventListener('click', () => { this.editing = null; this.render(); });
+      text.addEventListener('keydown', event => { if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { event.preventDefault(); this.saveEdit(memo.id, text.value); } });
+      const row = element('div', 'hm-row'); row.append(cancel, save);
+      card.append(text, row);
+    } else {
+      const actions = element('div', 'hm-actions');
+      const edit = element('button', undefined, '수정'), del = element('button', 'hm-danger', '삭제');
+      edit.disabled = del.disabled = !memo.editable;
+      if (!memo.editable) edit.title = del.title = memo.readOnlyReason ?? '이 메모는 고칠 수 없습니다.';
+      edit.addEventListener('click', () => { this.editing = memo.id; this.render(); });
+      del.addEventListener('click', () => { void this.remove(memo); });
+      actions.append(edit, del);
+      card.append(element('div', 'hm-text', memo.text), actions);
+    }
+    return card;
+  }
+}
+
+let panel: MemoPanel | null = null;
+export const memoPanel = (services: CommandServices): MemoPanel => (panel ??= new MemoPanel(services));
diff --git a/rhwp-studio/src/styles/hwpxxx-memo.css b/rhwp-studio/src/styles/hwpxxx-memo.css
