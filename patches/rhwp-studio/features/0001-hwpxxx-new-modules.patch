index 0000000..238c57e
--- /dev/null
+++ b/rhwp-studio/src/hwpxxx/perf-probe.ts
@@ -0,0 +1,127 @@
+/**
+ * [hwpxxx] 성능 계측: 입력·자동 복구 저장이 메인 스레드를 얼마나 잡는지 기기에서 재기 위한 가벼운 기록기.
+ *
+ * - 시간 값(ms)과 바이트 수 같은 숫자만 기록한다. 문서 내용·파일 이름·경로는 절대 담지 않는다.
+ * - 항목은 고리 버퍼(최근 300개)에만 둔다. 저장하거나 어디로 보내지 않는다(Studio 는 오프라인 앱이다).
+ * - 읽기: `window.rhwpPerfSnapshot()` — 이름별 횟수·합계·최대·p95 와 최근 항목, 50ms 이상 메인 스레드를 막은 긴 작업(longtask).
+ * 기능 동작에는 영향이 없다(계측이 던져도 삼킨다).
+ */
+export interface PerfEntry {
+  name: string;
+  ms: number;
+  /** performance.now() 기준 기록 시각 */
+  at: number;
+  extra?: Record<string, number>;
+}
+
+export interface PerfSummaryItem { count: number; totalMs: number; maxMs: number; p95Ms: number }
+export interface PerfSnapshot { summary: Record<string, PerfSummaryItem>; recent: PerfEntry[]; dropped: number }
+
+const MAX_ENTRIES = 300;
+const entries: PerfEntry[] = [];
+let dropped = 0;
+
+const nowMs = (): number => (typeof performance !== 'undefined' ? performance.now() : Date.now());
+
+export function recordPerf(name: string, ms: number, extra?: Record<string, number>): void {
+  try {
+    if (!Number.isFinite(ms)) return;
+    entries.push({ name, ms: Math.round(ms * 100) / 100, at: Math.round(nowMs()), ...(extra ? { extra } : {}) });
+    if (entries.length > MAX_ENTRIES) { entries.shift(); dropped += 1; }
+  } catch { /* 계측은 동작을 바꾸지 않는다 */ }
+}
+
+/** 동기 작업의 시간을 재고 결과를 그대로 돌려준다(던지면 시간을 기록한 뒤 다시 던진다). */
+export function timed<T>(name: string, fn: () => T, extra?: (result: T | undefined) => Record<string, number> | undefined): T {
+  const t0 = nowMs();
+  let result: T | undefined;
+  try {
+    result = fn();
+    return result;
+  } finally {
+    let more: Record<string, number> | undefined;
+    try { more = extra?.(result); } catch { more = undefined; }
+    recordPerf(name, nowMs() - t0, more);
+  }
+}
+
+export async function timedAsync<T>(name: string, fn: () => Promise<T>, extra?: (result: T | undefined) => Record<string, number> | undefined): Promise<T> {
+  const t0 = nowMs();
+  let result: T | undefined;
+  try {
+    result = await fn();
+    return result;
+  } finally {
+    let more: Record<string, number> | undefined;
+    try { more = extra?.(result); } catch { more = undefined; }
+    recordPerf(name, nowMs() - t0, more);
+  }
+}
+
+/** 객체의 메서드를 시간 재는 래퍼로 바꾼다(this·인자·반환·예외 그대로). 없는 메서드는 건너뛴다. */
+export function wrapMethods(target: Record<string, any>, names: readonly string[], prefix: string): void {
+  for (const name of names) {
+    const original = target[name];
+    if (typeof original !== 'function' || (original as { __perfWrapped?: boolean }).__perfWrapped) continue;
+    const wrapped = function (this: unknown, ...args: unknown[]): unknown {
+      const t0 = nowMs();
+      try {
+        return original.apply(this, args);
+      } finally {
+        recordPerf(`${prefix}.${name}`, nowMs() - t0);
+      }
+    };
+    (wrapped as { __perfWrapped?: boolean }).__perfWrapped = true;
+    target[name] = wrapped;
+  }
+}
+
+export function perfSnapshot(): PerfSnapshot {
+  const byName = new Map<string, number[]>();
+  for (const entry of entries) {
+    const list = byName.get(entry.name) ?? [];
+    list.push(entry.ms);
+    byName.set(entry.name, list);
+  }
+  const summary: Record<string, PerfSummaryItem> = {};
+  for (const [name, list] of byName) {
+    const sorted = [...list].sort((a, b) => a - b);
+    const total = sorted.reduce((a, b) => a + b, 0);
+    summary[name] = {
+      count: sorted.length,
+      totalMs: Math.round(total * 100) / 100,
+      maxMs: sorted[sorted.length - 1],
+      p95Ms: sorted[Math.min(sorted.length - 1, Math.ceil(sorted.length * 0.95) - 1)],
+    };
+  }
+  return { summary, recent: entries.slice(-60), dropped };
+}
+
+export function resetPerf(): void {
+  entries.length = 0;
+  dropped = 0;
+}
+
+let installed = false;
+
+/** 긴 작업(50ms+) 관찰기와 읽기 함수를 한 번만 설치한다. */
+export function installPerfProbe(win: Record<string, any> | undefined = typeof window !== 'undefined' ? (window as any) : undefined): void {
+  if (installed || !win) return;
+  installed = true;
+  try {
+    Object.defineProperty(win, 'rhwpPerfSnapshot', { value: perfSnapshot, configurable: true });
+    Object.defineProperty(win, 'rhwpPerfReset', { value: resetPerf, configurable: true });
+  } catch { /* 이미 있으면 그대로 */ }
+  try {
+    const Observer = (globalThis as { PerformanceObserver?: typeof PerformanceObserver }).PerformanceObserver;
+    if (!Observer || !(Observer.supportedEntryTypes ?? []).includes('longtask')) return;
+    new Observer((list) => {
+      for (const item of list.getEntries()) recordPerf('longtask', item.duration);
+    }).observe({ entryTypes: ['longtask'] });
+  } catch { /* 지원하지 않는 WebView */ }
+}
+
+/** 입력 경로의 비싼 단계들을 계측한다(생성자에서 묶인 리스너가 아니라 동적으로 불리는 메서드만 잡힌다). */
+export function installInputPerfProbes(handler: Record<string, any>): void {
+  wrapMethods(handler, ['afterEdit', 'updateCaret', 'executeOperation', 'flushDeferredPaginationIfNeeded'], 'input');
+}
