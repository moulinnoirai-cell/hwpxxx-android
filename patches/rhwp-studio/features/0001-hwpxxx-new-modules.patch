+      const cell = path[0];
+      const base = cell && cell.type === 'cell'
+        ? { sectionIndex: memo.sectionIndex, paragraphIndex: memo.paraIndex, charOffset: memo.startCharIdx, parentParaIndex: memo.paraIndex, controlIndex: cell.controlIndex, cellIndex: cell.cellIndex, cellParaIndex: cell.paraIndex }
+        : { sectionIndex: memo.sectionIndex, paragraphIndex: memo.paraIndex, charOffset: memo.startCharIdx };
+      const cursor = (handler as unknown as { cursor?: { clearSelection(): void; moveTo(pos: unknown): void; setAnchor(): void } }).cursor;
+      if (cell) { cursor?.clearSelection(); cursor?.moveTo(base); } else handler.moveCursorTo(base);
+      cursor?.setAnchor();
+      cursor?.moveTo({ ...base, charOffset: memo.endCharIdx });
+      (handler as unknown as { updateCaret?: () => void }).updateCaret?.();
+    } catch (error) {
+      showToast({ message: error instanceof Error ? error.message : String(error) });
+    }
+  }
+
+  private render(): void {
+    this.title.textContent = `메모 (${this.memos.length})`;
+    this.body.replaceChildren();
+    if (this.notice) this.body.append(element('div', this.notice.warn ? 'hm-notice warn' : 'hm-notice', this.notice.text));
+    if (this.draft) this.body.append(this.composeBox(this.draft));
+    else {
+      const add = element('button', 'hm-add hm-primary', '선택한 글자에 메모 삽입');
+      add.disabled = !this.services.wasm.hasLoadedDocument();
+      add.addEventListener('click', () => this.beginCompose());
+      this.body.append(add);
+    }
+    this.list.replaceChildren();
+    if (!this.memos.length) this.list.append(element('div', 'hm-empty', '이 문서에는 메모가 없습니다.'));
+    for (const memo of this.memos) this.list.append(this.card(memo));
+    this.body.append(this.list, element('div', 'hm-foot', '메모를 달거나 고치거나 지우는 일은 되돌리기(Ctrl+Z)로 취소할 수 있습니다. 저장하기 전까지 파일에는 반영되지 않습니다.'));
+  }
+
+  private composeBox(draft: Draft): HTMLElement {
+    const box = element('div', 'hm-compose');
+    const target = element('div', 'hm-target', `대상 글자: “${trim(draft.find, 60)}”`);
+    const author = element('input');
+    author.type = 'text'; author.value = readAuthor(); author.maxLength = 40; author.placeholder = '작성자'; author.setAttribute('aria-label', '작성자');
+    const text = element('textarea');
+    text.placeholder = '메모 내용을 입력하세요 (Ctrl+Enter: 삽입)';
+    const ok = element('button', 'hm-primary', '삽입');
+    const cancel = element('button', undefined, '취소');
+    ok.addEventListener('click', () => this.submitDraft(text.value, author.value));
+    cancel.addEventListener('click', () => { this.draft = null; this.render(); });
+    text.addEventListener('keydown', event => { if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { event.preventDefault(); this.submitDraft(text.value, author.value); } });
+    const row = element('div', 'hm-row'); row.append(cancel, ok);
+    box.append(target, author, text, row);
+    return box;
+  }
+
+  private card(memo: PanelMemo): HTMLElement {
+    const card = element('div', 'hm-card');
+    const meta = element('div', 'hm-meta');
+    meta.append(element('b', undefined, `#${memo.index}`), element('span', undefined, memo.author), ...(memo.date ? [element('span', undefined, when(memo.date))] : []));
+    card.append(meta);
+    if (memo.anchor) {
+      const anchor = element('button', 'hm-anchor', `“${trim(memo.anchor, 40)}”`);
+      anchor.title = '본문의 해당 글자로 이동';
+      anchor.addEventListener('click', () => this.goTo(memo));
+      card.append(anchor);
+    }
+    if (this.editing === memo.id && memo.editable) {
+      const text = element('textarea'); text.value = memo.text;
+      const save = element('button', 'hm-primary', '저장'), cancel = element('button', undefined, '취소');
+      save.addEventListener('click', () => this.saveEdit(memo.id, text.value));
+      cancel.addEventListener('click', () => { this.editing = null; this.render(); });
+      text.addEventListener('keydown', event => { if (event.key === 'Enter' && (event.ctrlKey || event.metaKey)) { event.preventDefault(); this.saveEdit(memo.id, text.value); } });
+      const row = element('div', 'hm-row'); row.append(cancel, save);
+      card.append(text, row);
+    } else {
+      const actions = element('div', 'hm-actions');
+      const edit = element('button', undefined, '수정'), del = element('button', 'hm-danger', '삭제');
+      edit.disabled = del.disabled = !memo.editable;
+      if (!memo.editable) edit.title = del.title = memo.readOnlyReason ?? '이 메모는 고칠 수 없습니다.';
+      edit.addEventListener('click', () => { this.editing = memo.id; this.render(); });
+      del.addEventListener('click', () => { void this.remove(memo); });
+      actions.append(edit, del);
+      card.append(element('div', 'hm-text', memo.text), actions);
+    }
+    return card;
+  }
+}
+
+let panel: MemoPanel | null = null;
+export const memoPanel = (services: CommandServices): MemoPanel => (panel ??= new MemoPanel(services));
diff --git a/rhwp-studio/src/hwpxxx/perf-probe.ts b/rhwp-studio/src/hwpxxx/perf-probe.ts
