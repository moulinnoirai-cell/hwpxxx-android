+/* hwpxxx 메모 창: 편집 영역 오른쪽에 붙는 패널. 색은 앱 토큰을 따라 밝은/어두운 테마에서 함께 바뀐다. */
+body.hwpxxx-memo-open #editor-area { margin-right: 320px; }
+#hwpxxx-memo-panel {
+  position: fixed;
+  right: 0;
+  width: 320px;
+  box-sizing: border-box;
+  display: none;
+  flex-direction: column;
+  background: var(--ui-bg-light);
+  color: var(--ui-text);
+  border-left: 1px solid var(--ui-border);
+  font-size: 13px;
+  z-index: 50;
+}
+#hwpxxx-memo-panel.open { display: flex; }
