+// 문서를 다시 불러오지 않고, 되돌리기(Ctrl+Z)로 취소할 수 있다.
+import '@/styles/hwpxxx-memo.css';
+import type { CommandServices } from '@/command/types';
+import type { InputHandler } from '@/engine/input-handler';
+import { hyperlinkRange, type HyperlinkTarget } from '@/core/hyperlink';
+import type { MemoEntry } from '@/core/memo';
+import { showToast } from '@/ui/toast';
+import { showConfirm } from '@/ui/confirm-dialog';
+
+const AUTHOR_KEY = 'hwpxxx.memoAuthor';
+const readAuthor = (): string => { try { return localStorage.getItem(AUTHOR_KEY) || 'hwpxxx'; } catch { return 'hwpxxx'; } };
+const saveAuthor = (value: string): void => { try { localStorage.setItem(AUTHOR_KEY, value); } catch { /* 저장소를 못 쓰면 이번 실행에서만 기억한다 */ } };
+const trim = (text: string, max: number): string => { const chars = Array.from(text); return chars.length > max ? chars.slice(0, max).join('') + '…' : text; };
+// 한글은 작성 시각을 현지 시각에 Z 를 붙여 기록한다.
+const when = (value: string | null): string => typeof value !== 'string' ? '' : /^\d{4}-\d\d-\d\dT\d\d:\d\d/.test(value) ? value.slice(0, 16).replace('T', ' ') : value;
+const cellPathOf = (memo: MemoEntry): [number, number, number][] =>
+  (memo.path ?? []).map(step => [step.controlIndex, step.type === 'cell' ? step.cellIndex : 0, step.paraIndex]);
+
+interface Draft {
+  target: HyperlinkTarget;
+  start: number;
+  end: number;
+  find: string;
+}
+type PanelMemo = MemoEntry & { anchor: string };
