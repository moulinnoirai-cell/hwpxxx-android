+      const body = document.createElement('div');
+      body.className = 'hwpxxx-memo-box-body';
+      body.textContent = memo.text;
+      box.append(body);
+      box.title = memo.editable ? '누르면 메모가 달린 글자를 선택합니다. 두 번 누르면 메모 내용을 고칩니다.' : (memo.readOnlyReason ?? '이 메모는 고칠 수 없습니다.');
+    }
+    // 글자 입력·선택을 처리하는 문서 창으로 이벤트가 넘어가 캐럿이 옮겨 가지 않게 막는다.
+    for (const type of ['mousedown', 'mouseup', 'click', 'dblclick', 'contextmenu', 'wheel'] as const)
