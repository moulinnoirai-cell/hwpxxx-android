+        &mut self,
+        section_idx: usize,
+        para_idx: usize,
+        start_char_idx: usize,
+        end_char_idx: usize,
+        json: &str,
+    ) -> Result<String, MemoError> {
+        let (author, text) = parse_memo_input(json)?;
+        self.insert_memo_at(
