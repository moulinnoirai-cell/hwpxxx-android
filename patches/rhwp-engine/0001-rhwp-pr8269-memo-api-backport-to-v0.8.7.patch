+        .unwrap();
+    let field = memo_fields(std::slice::from_ref(first_para(&core)))[0];
+    let texts: Vec<&str> = field
+        .memo_paragraphs
+        .iter()
+        .map(|para| para.text.as_str())
+        .collect();
